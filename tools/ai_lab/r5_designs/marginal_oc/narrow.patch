 				closer = alt
diff --git a/40k/tests/unit/test_ai_fix_marginal_oc.gd b/40k/tests/unit/test_ai_fix_marginal_oc.gd
new file mode 100644
index 00000000..c20186d1
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_marginal_oc.gd
@@ -0,0 +1,157 @@
+extends SceneTree
+
+# MARGINAL-OC (FIX_MARGINAL_OC): a unit's OC goes where it changes who controls
+# an objective, not where it only adds margin. LLM-critic cluster marginal_oc
+# (round 5, value-checked over 24 seeds):
+#   s7475 r3 P1 — Custodian Guard Beta held obj_center ("holding under threat
+#   (enemy OC 9 nearby)") while the units that could not move held it with OC
+#   11 on their own; a Normal move to the enemy-held obj_nml_1 measured +8.00
+#   [3.15, 12.85]. The held_threatened clause of pass 1 forced EVERY movable
+#   unit on the objective to hold and came before KEEP-OC, so KEEP-OC's
+#   release never ran there.
+#   s7478 r3 P2 — OBJ-ASSIGN-1 swapped Custodian Guard Beta (OC 9) in for the
+#   Prosecutors (OC 8) on an empty home objective nobody could contest, because
+#   it arrived the same turn with 4" more spare movement; the Prosecutors went
+#   to the contested centre instead. A Normal move to the centre measured
+#   +5.58 [1.41, 9.76].
+# Guards: when the locked OC does NOT beat the enemy threat the unit still
+# holds; a swap that arrives a whole turn sooner still happens (s7457 r1 P2,
+# where the quicker unit's capture was right); 0 restores the base.
+#
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_marginal_oc.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDM = preload("res://scripts/AIDecisionMaker.gd")
+const PPI := 40.0
+const MOVE_ALL := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const OBJ_1 := Vector2(600, 600)
+const OBJ_2 := Vector2(1100, 600)
+const OBJ_2_FAR := Vector2(1500, 400)
+
+var _pass_count := 0
+var _fail_count := 0
+
+func _initialize():
+	await create_timer(0.2).timeout
+	print("\n=== MARGINAL-OC: OC goes where it changes control ===\n")
+	AIDM._config_overrides["FIX_MARGINAL_OC"] = 1.0
+	test_surplus_holder_is_freed()
+	test_needed_holder_still_holds()
+	test_same_turn_swap_skipped_on_uncontested_objective()
+	test_whole_turn_swap_still_happens()
+	test_param_zero_restores_base()
+	AIDM._config_overrides.erase("FIX_MARGINAL_OC")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _unit(owner: int, name: String, positions: Array, oc: int, move: int = 6) -> Dictionary:
+	var models = []
+	for i in range(positions.size()):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32, "base_type": "circular",
+			"base_dimensions": {}, "wounds": 3, "current_wounds": 3,
+			"position": Vector2(positions[i].x, positions[i].y)})
+	return {"id": name, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED, "models": models, "flags": {},
+		"meta": {"name": name, "points": 80, "keywords": ["INFANTRY"], "weapons": [],
+			"stats": {"move": move, "objective_control": oc, "toughness": 4, "save": 5}}}
+
+func _snapshot(units: Dictionary, battle_round: int = 3, obj_2: Vector2 = OBJ_2) -> Dictionary:
+	units["U_ENEMY_FAR"] = _unit(1, "Far Guard", [Vector2(1400.0, 2300.0)], 1)
+	return {
+		"meta": {"battle_round": battle_round, "player1_vp": 0, "player2_vp": 0},
+		"battle_round": battle_round,
+		"board": {"terrain_features": [], "objectives": [
+			{"id": "obj_1", "position": OBJ_1, "zone": "no_mans_land"},
+			{"id": "obj_2", "position": obj_2, "zone": "no_mans_land"},
+		]},
+		"units": units,
+	}
+
+func _assign(snapshot: Dictionary, movable_ids: Array) -> Dictionary:
+	AIDM.reset_caches()
+	AIDM._current_player = 2
+	var br := int(snapshot.get("battle_round", 3))
+	var objectives = AIDM._get_objectives(snapshot)
+	var enemies = AIDM._get_enemy_units(snapshot, 2)
+	var friendly = AIDM._get_units_for_player(snapshot, 2)
+	var evals = AIDM._evaluate_all_objectives(snapshot, objectives, 2, enemies, friendly, br)
+	for ev in evals:
+		print("  eval %s: %s friendly %d enemy %d projected %d" % [ev.id, ev.state, int(ev.friendly_oc),
+			int(ev.enemy_oc), int(ev.get("projected_enemy_oc", 0))])
+	var movable = {}
+	for uid in movable_ids:
+		movable[uid] = MOVE_ALL
+	var plan = AIDM._assign_units_to_objectives(snapshot, movable, evals, objectives, enemies, friendly, 2, br, [])
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 120)])
+	return plan
+
+func _did(plan: Dictionary, uid: String) -> String:
+	var a: Dictionary = plan.get(uid, {})
+	return "%s %s" % [a.get("action", ""), a.get("objective_id", "")]
+
+# s7475 shape: obj_1 held 20 vs 9; 11 of our OC there cannot move this phase.
+func _held_board(anchor_oc: int) -> Dictionary:
+	return _snapshot({
+		"U_ANCHOR": _unit(2, "Engaged Squad", [OBJ_1], anchor_oc),
+		"U_GUARD": _unit(2, "Custodian Guard", [OBJ_1 + Vector2(-40, -20), OBJ_1 + Vector2(0, -40), OBJ_1 + Vector2(40, -20)], 3),
+		"U_E_CENTRE": _unit(1, "Enemy Squad", [OBJ_1 + Vector2(-40, 100), OBJ_1 + Vector2(0, 90), OBJ_1 + Vector2(40, 100)], 3),
+		"U_E_NML": _unit(1, "Enemy Holder", [OBJ_2], 3),
+	})
+
+func test_surplus_holder_is_freed() -> void:
+	print("\n--- held_threatened, need 0, locked OC 11 vs enemy 9: the movable unit is not pinned ---")
+	var plan = _assign(_held_board(11), ["U_GUARD"])
+	_assert(_did(plan, "U_GUARD") != "hold obj_1", "Custodian Guard does not hold obj_1 (%s)" % _did(plan, "U_GUARD"))
+	_assert(str(plan.get("U_GUARD", {}).get("objective_id", "")) == "obj_2"
+		and str(plan.get("U_GUARD", {}).get("action", "")) in ["move", "advance"],
+		"it goes to flip the enemy-held obj_2 (%s)" % _did(plan, "U_GUARD"))
+
+func test_needed_holder_still_holds() -> void:
+	print("\n--- guard: locked OC 8 does not beat enemy 9 — the unit still holds ---")
+	var plan = _assign(_held_board(8), ["U_GUARD"])
+	_assert(_did(plan, "U_GUARD") == "hold obj_1", "Custodian Guard holds obj_1 (%s)" % _did(plan, "U_GUARD"))
+
+# s7478 shape: obj_1 empty, no enemy near; the Prosecutors (OC 8, M6) score
+# best there, the Guard (OC 9, M10) is farther but arrives the same turn with
+# more spare inches; obj_2 is enemy-held (the Guard's OC can flip it).
+func _swap_board(guard_gap_in: float) -> Dictionary:
+	var pros_pos := OBJ_1 + Vector2(0, (10.0 + 3.79) * PPI)
+	var g := OBJ_1 + Vector2(-(guard_gap_in + 3.79) * PPI * 0.6, (guard_gap_in + 3.79) * PPI * 0.8)
+	return _snapshot({
+		"U_PROS": _unit(2, "Prosecutors", [pros_pos + Vector2(-60, 0), pros_pos + Vector2(-20, 0), pros_pos + Vector2(20, 0), pros_pos + Vector2(60, 0)], 2, 6),
+		"U_GUARD": _unit(2, "Custodian Guard", [g + Vector2(-40, 0), g, g + Vector2(40, 0)], 3, 10),
+		"U_E_NML": _unit(1, "Enemy Holder", [OBJ_2_FAR + Vector2(0, -60)], 3),
+	}, 3, OBJ_2_FAR)
+
+func test_same_turn_swap_skipped_on_uncontested_objective() -> void:
+	print("\n--- same-turn swap onto an empty, uncontested objective ---")
+	var plan = _assign(_swap_board(14.0), ["U_PROS", "U_GUARD"])
+	_assert(str(plan.get("U_PROS", {}).get("objective_id", "")) == "obj_1",
+		"the Prosecutors keep obj_1 (%s)" % _did(plan, "U_PROS"))
+	_assert(str(plan.get("U_GUARD", {}).get("objective_id", "")) != "obj_1",
+		"the Custodian Guard is not swapped onto it (%s)" % _did(plan, "U_GUARD"))
+
+func test_whole_turn_swap_still_happens() -> void:
+	print("\n--- guard: the Guard arrives a whole turn sooner — OBJ-ASSIGN-1 still swaps ---")
+	var plan = _assign(_swap_board(8.0), ["U_PROS", "U_GUARD"])
+	_assert(str(plan.get("U_GUARD", {}).get("objective_id", "")) == "obj_1",
+		"the quicker Custodian Guard takes obj_1 (%s)" % _did(plan, "U_GUARD"))
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_MARGINAL_OC = 0: base behaviour ---")
+	AIDM._config_overrides["FIX_MARGINAL_OC"] = 0.0
+	var p1 = _assign(_held_board(11), ["U_GUARD"])
+	_assert(_did(p1, "U_GUARD") == "hold obj_1", "base: the surplus Custodian Guard holds obj_1 (%s)" % _did(p1, "U_GUARD"))
+	var p2 = _assign(_swap_board(14.0), ["U_PROS", "U_GUARD"])
+	_assert(str(p2.get("U_GUARD", {}).get("objective_id", "")) == "obj_1",
+		"base: OBJ-ASSIGN-1 swaps the Custodian Guard onto obj_1 (%s)" % _did(p2, "U_GUARD"))
+	AIDM._config_overrides["FIX_MARGINAL_OC"] = 1.0
