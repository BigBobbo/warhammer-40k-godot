@@ -1668,6 +1668,22 @@ const FIX_RI_QUARTER: float = 1.0
 # RI-QUARTER: share of the quarter VP counted for each later battle round
 # (the unit usually stays in the quarter it entered, but may move or die).
 const RI_QUARTER_LATER_ROUND_SHARE: float = 0.5
+# Movement plan (FIX_MARGINAL_OC): 1 = a unit's OC goes where it changes who
+# controls an objective, not where it only adds margin. Two gates on existing
+# overrides. (a) Pass 1: a held_threatened objective forced EVERY movable unit
+# on it to hold, even when its need was 0 and the OC of the units that cannot
+# move this phase alone beat the enemy OC there and one move away — the clause
+# came before KEEP-OC, so KEEP-OC's release never ran there. It now runs: such
+# a unit falls through to the keeper / KEEP-OC checks. (b) OBJ-ASSIGN-1 swaps
+# no longer hand an objective nobody can contest (no enemy OC there or one
+# move away) to a higher-OC unit when it only arrives with more spare inches
+# in the same Movement phase and has a candidate where its OC flips or saves
+# control. Custodian Guard Beta held a centre P1 held with OC 20 vs 9 (a Normal
+# move to the enemy-held obj_nml_1 measured +8.00 [3.15, 12.85] n24), and was
+# swapped onto an empty home objective in place of the Prosecutors (a Normal
+# move to the contested centre measured +5.58 [1.41, 9.76] n24) (LLM-critic
+# cluster marginal_oc, round 5). 0 = previous behaviour.
+const FIX_MARGINAL_OC: float = 1.0
 # RI-RACE: a one-move reinforcement is a lost race when the enemy can stand
 # there with at least this multiple of our OC with it. Not 1.0: the enemy has
 # one move, our shooting and charges act on its approach first, and LONE-TRIP
@@ -10119,6 +10135,8 @@ static func _assign_units_to_objectives(
 	var keeper_released := {}  # unit_id -> _keeper_release_check result
 	# LONE-FLIP (FIX_LONE_FLIP): read once, reused by pass 2.5.
 	var lone_flip_on = get_param("FIX_LONE_FLIP", FIX_LONE_FLIP) >= 0.5
+	# MARGINAL-OC (FIX_MARGINAL_OC): read once, reused by OBJ-ASSIGN-1 in pass 2.
+	var marginal_oc_on = get_param("FIX_MARGINAL_OC", FIX_MARGINAL_OC) >= 0.5
 	for cand in candidates:
 		var uid = cand.unit_id
 		var oid = cand.objective_id
@@ -10135,6 +10153,16 @@ static func _assign_units_to_objectives(
 		var should_hold = false
 		if remaining > 0:
 			should_hold = true  # OC still needed at this objective
+		elif obj_state == "held_threatened" and marginal_oc_on and locked_oc_holds.call(oid):
+			# MARGINAL-OC (FIX_MARGINAL_OC): no need left and the units that
+			# cannot move this phase hold it alone — not a forced hold; the
+			# keeper / KEEP-OC checks below decide (base: should_hold = true).
+			print("AIDecisionMaker: [MARGINAL_OC] %s: %s not forced to hold — held_threatened, need 0, locked OC %d beats enemy threat %d (enemy %d, next move %d)" % [
+				oid, uid, int(eval_for_obj.get("friendly_oc", 0)) - int(movable_oc_on_obj.get(oid, 0)),
+				maxi(int(eval_for_obj.get("enemy_oc", 0)), int(eval_for_obj.get("projected_enemy_oc", 0))),
+				int(eval_for_obj.get("enemy_oc", 0)), int(eval_for_obj.get("projected_enemy_oc", 0))])
+			if obj_keeper.get(oid, {}).get("uid", "") == uid and get_param("PLAN_KEEP_OC_ENABLED", 1.0) < 0.5:
+				should_hold = true  # KEEP-OC ablated: the keeper keeps it, as below
 		elif obj_state == "held_threatened":
 			should_hold = true  # Threatened, keep defender
 		elif obj_keeper.get(oid, {}).get("uid", "") == uid and locked_oc_holds.call(oid) \
@@ -10598,6 +10626,27 @@ static func _assign_units_to_objectives(
 						and alt_arrival.spare_in >= cand_arrival.spare_in + closer_min_in)
 			if not quicker:
 				continue
+			# MARGINAL-OC (FIX_MARGINAL_OC): the same phase on an objective no
+			# enemy can contest gains nothing; a higher-OC unit that can flip or
+			# save control elsewhere is not swapped in for spare inches.
+			if marginal_oc_on and alt_arrival.phases == cand_arrival.phases \
+					and int(alt.unit_oc) > int(cand.unit_oc):
+				var mo_eval = _get_obj_eval_by_id(obj_evaluations, oid)
+				if int(mo_eval.get("enemy_oc", 0)) == 0 and int(mo_eval.get("projected_enemy_oc", 0)) == 0:
+					var mo_where := ""
+					for mo_c in candidates:
+						if mo_c.unit_id != alt.unit_id or mo_c.objective_id == oid \
+								or int(obj_oc_remaining.get(mo_c.objective_id, 0)) <= 0:
+							continue
+						var mo_st = str(_get_obj_eval_by_id(obj_evaluations, mo_c.objective_id).get("state", ""))
+						if mo_st in ["contested", "enemy_weak", "held_threatened"]:
+							mo_where = str(mo_c.objective_id)
+							break
+					if mo_where != "":
+						print("AIDecisionMaker: [MARGINAL_OC] %s: not swapping %s (OC %d) in for %s (OC %d) — same phase (%.1f\" vs %.1f\" spare), nobody can contest it, and its OC can change control at %s" % [
+							oid, alt.unit_id, int(alt.unit_oc), uid, int(cand.unit_oc),
+							alt_arrival.spare_in, cand_arrival.spare_in, mo_where])
+						continue
 			if closer.is_empty() or alt_arrival.phases < closer_arrival.phases \
