+# buys nothing, while the swap pulled Custodian Guard Beta (OC 9) off the
+# contested centre for a Prosecutor squad's walk (+5.58 VP [1.4, 9.8]).
+# 0 = previous behaviour.
+const FIX_MARGINAL_OC: float = 1.0
