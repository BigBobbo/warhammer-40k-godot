+# MOC-HOLD: longest trip (turns) a freed holder may take — a holder freed
+# for a 3+ turn walk leaves the fight for most of the remaining game.
+const MARGINAL_OC_MAX_TURNS: int = 2
 # RI-QUARTER: share of the quarter VP counted for each later battle round
