diff --git a/40k/tests/unit/test_ai_fix_ranged_centre.gd b/40k/tests/unit/test_ai_fix_ranged_centre.gd
new file mode 100644
index 00000000..41aa9cc8
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_ranged_centre.gd
@@ -0,0 +1,166 @@
+extends SceneTree
+
+# RANGED-CENTRE (FIX_RANGED_CENTRE): in battle round 1, a ranged unit the
+# capture pass refused its pick (here LONE-TRIP: a fragile squad, the enemy can
+# have 20 OC at the centre next move) and left over joins the plan's push on
+# the CENTRE objective when the plan already sends another unit there, instead
+# of "supporting" a side objective (where a Heavy weapon then held it still) or
+# blocking a corridor. LLM-critic cluster ranged_hold_vs_centre (value-checked,
+# 2026-10-31): Lootas held for Heavy (s7462 r1) / blocked a corridor 26" from
+# the objective it protected (s7463 r1); Advancing to the centre measured
+# +5.6 / +4.8 VP over 24 seeds. Later rounds, melee units, units without a
+# friend going to the centre and FIX_RANGED_CENTRE = 0 keep the base plan.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_ranged_centre.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const OBJ_C := Vector2(880, 1200)    # the centre objective (board centre)
+const OBJ_SIDE := Vector2(200, 1700) # a quiet objective on our side, nobody near it
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Round-1 ranged leftovers join the centre push (RANGED-CENTRE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_RANGED_CENTRE"] = 1.0
+	test_ranged_leftover_joins_the_centre_push()
+	test_no_friend_going_keeps_the_base_plan()
+	test_round_two_keeps_the_base_plan()
+	test_melee_unit_keeps_the_base_plan()
+	test_non_heavy_unit_keeps_the_base_plan()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_RANGED_CENTRE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot(battle_round: int = 1) -> Dictionary:
+	var objs = [{"id": "obj_center", "position": OBJ_C, "zone": "no_mans_land"},
+		{"id": "obj_side", "position": OBJ_SIDE, "zone": "no_mans_land"}]
+	return {"battle_round": battle_round, "meta": {"battle_round": battle_round},
+		"board": {"objectives": objs, "terrain_features": []}, "units": {}}
+
+# `n` models (OC 2 each) whose centroid is at `pos`. weapon: "ranged", "melee" or "".
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		toughness: int, wounds: int, move: int = 6, weapon: String = "") -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	var weapons = []
+	if weapon == "ranged":
+		weapons.append({"name": "Deffgun", "type": "Ranged", "range": "48", "attacks": "2",
+			"ballistic_skill": "5", "strength": "8", "ap": "-1", "damage": "2", "special_rules": "heavy"})
+	elif weapon == "ranged_plain":
+		weapons.append({"name": "Shoota", "type": "Ranged", "range": "18", "attacks": "2",
+			"ballistic_skill": "5", "strength": "4", "ap": "0", "damage": "1", "special_rules": ""})
+	elif weapon == "melee":
+		weapons.append({"name": "Choppa", "type": "Melee", "range": "Melee", "attacks": "4",
+			"weapon_skill": "3", "strength": "5", "ap": "-1", "damage": "1", "special_rules": ""})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": 200, "stats": {"move": move, "toughness": toughness, "save": 3,
+			"wounds": wounds, "leadership": 6, "objective_control": 2}, "keywords": ["INFANTRY"], "weapons": weapons},
+		"models": models, "flags": {}}
+
+# Two 5-model OC 2 enemy squads `enemy_dist` inches above the centre (20 OC).
+func _add_enemies(snap: Dictionary, enemies: Dictionary, enemy_dist: float) -> void:
+	for i in range(2):
+		var eid = "theirs_%d" % i
+		_add_unit(snap, eid, 1, OBJ_C + Vector2((i - 0.5) * 300.0, -enemy_dist * PX), 5, 4, 2)
+		enemies[eid] = snap.units[eid]
+
+# The board of the findings: a fragile ranged squad 8" below the centre that
+# LONE-TRIP refuses (20 enemy OC one move away vs its 8), and — with_friend — a
+# durable squad 16" out that the capture pass sends to the centre first (it
+# arrives later, so LONE-TRIP does not count it). obj_side is held already, so
+# the capture pass has nothing left for the squad: it is a leftover.
+func _board(battle_round: int, with_friend: bool, weapon: String) -> Array:
+	var snap = _snapshot(battle_round)
+	var enemies = {}
+	var movable_ids = ["lootas"]
+	# obj_side is already held by a squad that is not moving: no OC needed there
+	_add_unit(snap, "keeper", 2, OBJ_SIDE, 5, 4, 2)
+	if with_friend:
+		_add_unit(snap, "wagon", 2, OBJ_C + Vector2(300, 16.0 * PX), 5, 7, 6, 6)
+		movable_ids.insert(0, "wagon")
+	_add_unit(snap, "lootas", 2, OBJ_C + Vector2(0, 8.0 * PX), 4, 3, 1, 6, weapon)
+	_add_enemies(snap, enemies, 10.0)
+	return [snap, movable_ids, enemies]
+
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {}
+	AIDecisionMaker._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var br = int(snap.battle_round)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, br)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, br)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	return plan
+
+func _goes_to(plan: Dictionary, uid: String, oid: String) -> bool:
+	var a: Dictionary = plan.get(uid, {})
+	return str(a.get("objective_id", "")) == oid and str(a.get("action", "")) in ["move", "advance"]
+
+func test_ranged_leftover_joins_the_centre_push() -> void:
+	print("\n--- round 1: fragile ranged squad refused the centre (LONE-TRIP), a durable squad sent there ---")
+	var b = _board(1, true, "ranged")
+	var plan = _plan(b[0], b[1], b[2])
+	_assert(_goes_to(plan, "wagon", "obj_center"), "precondition: the durable squad is sent to the centre")
+	_assert(_goes_to(plan, "lootas", "obj_center"), "the ranged leftover joins the centre push (was: support elsewhere)")
+	_assert(str(plan.get("lootas", {}).get("assign_pass", "")) == "ranged_centre", "assigned by the RANGED-CENTRE pass")
+
+func test_no_friend_going_keeps_the_base_plan() -> void:
+	print("\n--- round 1, no other unit sent to the centre ---")
+	var b = _board(1, false, "ranged")
+	var plan = _plan(b[0], b[1], b[2])
+	_assert(not _goes_to(plan, "lootas", "obj_center"), "it is not sent to the centre alone (LONE-TRIP stands)")
+
+func test_round_two_keeps_the_base_plan() -> void:
+	print("\n--- round 2, same board ---")
+	var b = _board(2, true, "ranged")
+	var plan = _plan(b[0], b[1], b[2])
+	_assert(str(plan.get("lootas", {}).get("assign_pass", "")) != "ranged_centre" and not _goes_to(plan, "lootas", "obj_center"),
+		"round 2 keeps the base plan")
+
+func test_melee_unit_keeps_the_base_plan() -> void:
+	print("\n--- round 1, a fragile squad with no ranged weapons ---")
+	var b = _board(1, true, "melee")
+	var plan = _plan(b[0], b[1], b[2])
+	_assert(str(plan.get("lootas", {}).get("assign_pass", "")) != "ranged_centre", "a unit without ranged weapons is not touched")
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_RANGED_CENTRE = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_RANGED_CENTRE"] = 0.0
+	var b = _board(1, true, "ranged")
+	var plan = _plan(b[0], b[1], b[2])
+	AIDecisionMaker._config_overrides["FIX_RANGED_CENTRE"] = 1.0
+	_assert(not _goes_to(plan, "lootas", "obj_center"), "with the fix off the ranged squad is not sent to the centre (base)")
+
+func test_non_heavy_unit_keeps_the_base_plan() -> void:
+	print("\n--- round 1, a fragile ranged squad without Heavy weapons ---")
+	var b = _board(1, true, "ranged_plain")
+	var plan = _plan(b[0], b[1], b[2])
+	_assert(str(plan.get("lootas", {}).get("assign_pass", "")) != "ranged_centre", "a ranged unit without Heavy weapons is not touched")
