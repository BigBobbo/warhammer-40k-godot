diff --git a/40k/tests/unit/test_ai_fix_ranged_centre.gd b/40k/tests/unit/test_ai_fix_ranged_centre.gd
new file mode 100644
index 00000000..56d32e55
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_ranged_centre.gd
@@ -0,0 +1,207 @@
+extends SceneTree
+
+# RANGED-CENTRE (FIX_RANGED_CENTRE): a capture trip's reach is priced the way
+# the unit really gets there — (a) on an 11e terrain objective (14.01: the
+# hosting AREA is the objective) from the nearest model to that area, not the
+# centroid to the marker point; (b) a trip the plan Advances on because the
+# Advance reaches range this turn costs one turn, not ceil(gap / M).
+# LLM-critic cluster ranged_hold_vs_centre (value-checked, 2026-10-30): Lootas
+# 7.3" from the centre's ruin (19.6" centroid -> marker) were priced as a
+# 2-turn lost race into ~30 enemy OC, LONE-TRIP vetoed the centre and the unit
+# held still for its Heavy bonus; one Advance put it on the centre (+5.62 VP
+# over 24 rollouts).
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_ranged_centre.gd
+
+const AIDM_PATH := "res://scripts/AIDecisionMaker.gd"
+const GameStateData = preload("res://autoloads/GameState.gd")
+# s7462 r1 P2 movement (Orks mirror): the finding's saved position
+const F1_SAVE := "res://tests/rollout_cases/r4c11/s7462_r1_p2_movement_1.w40ksave"
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0
+const OBJ_X := Vector2(880, 1200)
+
+var AIDM
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	create_timer(0.2).timeout.connect(_run)
+
+func _run():
+	print("\n=== Reach priced as the unit gets there (RANGED-CENTRE) ===\n")
+	AIDM = load(AIDM_PATH)
+	AIDM._config_overrides["FIX_RANGED_CENTRE"] = 1.0
+	test_advance_now_trip_costs_one_turn()
+	test_already_on_objective_unchanged()
+	test_param_zero_restores_base()
+	test_saved_position_lootas_go_forward()
+	AIDM._config_overrides.erase("FIX_RANGED_CENTRE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+# ---------------------------------------------------------------------------
+# Fabricated board: open-ground marker (no hosting area) — part (b)
+# ---------------------------------------------------------------------------
+
+func _snapshot() -> Dictionary:
+	return {"battle_round": 1, "meta": {"battle_round": 1},
+		"board": {"objectives": [{"id": "obj_x", "position": OBJ_X, "zone": "no_mans_land"}],
+			"terrain_features": []}, "units": {}}
+
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		toughness: int, wounds: int, move: int = 6) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": 120, "stats": {"move": move, "toughness": toughness, "save": 5,
+			"wounds": wounds, "leadership": 7, "objective_control": 2}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+# A fragile 5-model squad (OC 10) 7" from control range of obj_x (M6: one
+# Advance, two Normal moves); two enemy OC 10 squads 16" above obj_x — out of
+# one enemy move (M + 2" + range), inside two.
+func _board(snap: Dictionary, enemies: Dictionary) -> void:
+	_add_unit(snap, "fragile", 2, OBJ_X + Vector2(0, (7.0 + 3.79) * PX), 5, 3, 1)
+	for i in range(2):
+		var eid = "theirs_%d" % i
+		_add_unit(snap, eid, 1, OBJ_X + Vector2((i - 0.5) * 300.0, -16.0 * PX), 5, 4, 2)
+		enemies[eid] = snap.units[eid]
+
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary) -> Dictionary:
+	AIDM._primary_awareness_p2 = {}
+	AIDM._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDM._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 1)
+	var plan = AIDM._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 1)
+	for uid in plan:
+		print("  %s: %s %s [%s] turns %s (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("turns_to_reach", "")),
+			str(plan[uid].get("reason", "")).substr(0, 100)])
+	return plan
+
+func _cand(uid: String, oid: String) -> Dictionary:
+	for c in AIDM._last_movement_candidates.get(uid, []):
+		if str(c.get("objective_id", "")) == oid:
+			return c
+	return {}
+
+func test_advance_now_trip_costs_one_turn() -> void:
+	print("\n--- fragile squad 7\" from range (M6), 20 enemy OC two moves out, none one move out ---")
+	var snap = _snapshot()
+	var enemies = {}
+	_board(snap, enemies)
+	var plan = _plan(snap, ["fragile"], enemies)
+	var c = _cand("fragile", "obj_x")
+	_assert(str(c.get("action", "")) == "advance" and int(c.get("turns_to_reach", 0)) == 1,
+		"the Advance that reaches range this turn is priced as 1 turn (action %s, turns %s)" % [
+			str(c.get("action", "")), str(c.get("turns_to_reach", ""))])
+	_assert(not c.get("race_lost", false), "no 2-turn contest race is charged against it")
+	var a: Dictionary = plan.get("fragile", {})
+	_assert(str(a.get("objective_id", "")) == "obj_x" and str(a.get("action", "")) == "advance",
+		"the squad Advances onto obj_x instead of being kept off it as a lost lone trip (%s %s)" % [
+			str(a.get("action", "")), str(a.get("objective_id", ""))])
+
+func test_already_on_objective_unchanged() -> void:
+	print("\n--- a squad already on obj_x is not repriced ---")
+	var snap = _snapshot()
+	var enemies = {}
+	_add_unit(snap, "holder", 2, OBJ_X + Vector2(0, 1.0 * PX), 5, 3, 1)
+	for i in range(2):
+		var eid = "theirs_%d" % i
+		_add_unit(snap, eid, 1, OBJ_X + Vector2((i - 0.5) * 300.0, -16.0 * PX), 5, 4, 2)
+		enemies[eid] = snap.units[eid]
+	var plan = _plan(snap, ["holder"], enemies)
+	var c = _cand("holder", "obj_x")
+	_assert(not c.has("gap_in") or c.get("already_on_obj", false), "the holder's candidate is the hold")
+	_assert(str(plan.get("holder", {}).get("action", "")) == "hold", "it still holds obj_x")
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_RANGED_CENTRE = 0 ---")
+	AIDM._config_overrides["FIX_RANGED_CENTRE"] = 0.0
+	var snap = _snapshot()
+	var enemies = {}
+	_board(snap, enemies)
+	var plan = _plan(snap, ["fragile"], enemies)
+	var c = _cand("fragile", "obj_x")
+	AIDM._config_overrides["FIX_RANGED_CENTRE"] = 1.0
+	_assert(int(c.get("turns_to_reach", 0)) == 2 and not c.has("gap_in"),
+		"with the fix off the trip is priced at 2 turns as before (turns %s)" % str(c.get("turns_to_reach", "")))
+	_assert(not (str(plan.get("fragile", {}).get("objective_id", "")) == "obj_x" \
+			and str(plan.get("fragile", {}).get("action", "")) in ["move", "advance"]),
+		"…and LONE-TRIP keeps the squad off obj_x as before")
+
+# ---------------------------------------------------------------------------
+# The finding's saved position: terrain-hosted centre — part (a), driven
+# through AIDecisionMaker.decide() for the movement phase
+# ---------------------------------------------------------------------------
+
+func _decide_for(save_path: String, focus: String) -> Dictionary:
+	var root = (Engine.get_main_loop() as SceneTree).root
+	var ser = root.get_node_or_null("StateSerializer")
+	var gs = root.get_node_or_null("GameState")
+	var tm = root.get_node_or_null("TerrainManager")
+	if ser == null or gs == null or tm == null:
+		_assert(false, "StateSerializer / GameState / TerrainManager autoloads are reachable")
+		return {}
+	var f = FileAccess.open(save_path, FileAccess.READ)
+	if f == null:
+		_assert(false, "saved position %s is readable" % save_path)
+		return {}
+	var state: Dictionary = ser.deserialize_game_state(f.get_as_text())
+	f.close()
+	gs.state = state
+	tm.load_terrain_from_save(state.board.get("terrain_features", []))
+	var player = int(state.get("meta", {}).get("active_player", 1))
+	var mp = load("res://phases/MovementPhase.gd").new()
+	root.add_child(mp)
+	mp.enter_phase(state)
+	var act := {}
+	# Units the plan moves before the focus unit stay put (marked as moved),
+	# so the focus unit's own decision is the one returned.
+	for _step in range(30):
+		act = AIDM.decide(7, gs.state, mp.get_available_actions(), player, 3)
+		var uid = str(act.get("actor_unit_id", ""))
+		print("  decide: %s %s — %s" % [act.get("type", ""), uid, str(act.get("_ai_description", "")).substr(0, 110)])
+		if uid == focus or uid == "" or str(act.get("type", "")) == "END_MOVEMENT":
+			break
+		gs.state.units[uid]["flags"]["moved"] = true
+		gs.state.units[uid]["flags"]["remained_stationary"] = true
+		mp.game_state_snapshot = gs.state
+	mp.queue_free()
+	return act
+
+func test_saved_position_lootas_go_forward() -> void:
+	print("\n--- s7462 r1 P2: Lootas Alpha, 19.6\" centroid -> centre marker, 7.3\" from the centre's ruin ---")
+	AIDM._turn_movement_plan.clear()
+	var act = _decide_for(F1_SAVE, "U_LOOTAS_A_P2")
+	if act.is_empty():
+		return
+	var c = _cand("U_LOOTAS_A_P2", "obj_center")
+	print("  obj_center candidate: action %s, turns %s, gap %s\", score %.1f" % [
+		str(c.get("action", "")), str(c.get("turns_to_reach", "")), str(c.get("gap_in", "?")), float(c.get("score", 0.0))])
+	_assert(int(c.get("turns_to_reach", 0)) == 1 and str(c.get("action", "")) == "advance",
+		"the centre is priced as one Advance from the hosting area (not a 2-turn trip)")
+	_assert(str(act.get("actor_unit_id", "")) == "U_LOOTAS_A_P2" and str(act.get("type", "")) == "BEGIN_ADVANCE",
+		"Lootas Alpha Advances forward instead of holding still for its Heavy bonus (%s: %s)" % [
+			str(act.get("type", "")), str(act.get("_ai_description", ""))])
