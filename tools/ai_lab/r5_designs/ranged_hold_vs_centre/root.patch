+## RANGED-CENTRE (FIX_RANGED_CENTRE): inches the unit's nearest alive model
+## still has to cover to be within range of `objective` by MissionManager's
+## measure (model_gap_to_objective_range_px: on an 11e terrain objective the
+## distance to the hosting area, else to 3" of the marker). INF when no model
+## can be measured.
+static func _rc_host_gap_inches(unit: Dictionary, objective: Dictionary, mm) -> float:
+	var best := INF
+	if mm == null or not mm.has_method("model_gap_to_objective_range_px"):
+		return best
+	for model in unit.get("models", []):
+		if not model.get("alive", true) or _get_model_position(model) == Vector2.INF:
+			continue
+		best = minf(best, float(mm.model_gap_to_objective_range_px(model, objective)) / PIXELS_PER_INCH)
+	return best
+
 ## The OC a unit brings once its models stand in range — every alive model's
