+func _decl(snap: Dictionary, uid: String, tids: Array, player: int, fix: float) -> Array:
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = fix
+	AIDecisionMaker._charge_coordination.clear()
+	var d = AIDecisionMaker._decide_charge(snap, _charge_actions(uid, tids), player)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	return [d.get("type", ""), d.get("payload", {}).get("target_unit_ids", [])]
