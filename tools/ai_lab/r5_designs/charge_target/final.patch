+	var on := _decl(snap, "allarus", ["champion", "prosecutors"], 2, 1.0)
+	var off := _decl(snap, "allarus", ["champion", "prosecutors"], 2, 0.0)
+	_assert(on == off, "CT-DEPLETED: the declaration at full-health targets matches FIX_CHARGE_TARGET=0 (%s vs %s)" % [str(on), str(off)])
