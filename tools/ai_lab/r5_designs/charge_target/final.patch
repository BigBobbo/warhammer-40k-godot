+static func _charge_target_overkill_gate(target: Dictionary, melee_damage: float, snapshot: Dictionary, player: int) -> Dictionary:
+	if _ct_suspend or get_param("FIX_CHARGE_TARGET", FIX_CHARGE_TARGET) <= 0.0:
+		return {}
+	var units: Dictionary = snapshot.get("units", {})
+	# CT-ATTACHED: fold the target into its Attached unit, walking both linkage
+	# sides (attached_to on the character, attached_characters on the bodyguard).
+	var members: Array = [target]
+	var tid := str(target.get("id", ""))
