+# ---------------------------------------------------------------------------
+# Real saves (critic .w40ksave: base64 gzip JSON)
+# ---------------------------------------------------------------------------
+
+func _load_state(save_rel: String) -> Dictionary:
+	var txt = FileAccess.get_file_as_string(CASES + save_rel)
+	var raw = Marshalls.base64_to_raw(txt.strip_edges())
+	var js = raw.decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP).get_string_from_utf8()
+	var found = _find_state(JSON.parse_string(js))
+	return found if found != null else {}
+
+func _find_state(o):
+	if typeof(o) == TYPE_DICTIONARY:
+		if o.has("units") and typeof(o.units) == TYPE_DICTIONARY and not o.units.is_empty():
+			return o
+		for v in o.values():
+			var r = _find_state(v)
+			if r != null:
+				return r
+	return null
+
+func _save_actions(state: Dictionary, charger_id: String, player: int) -> Array:
+	var units: Dictionary = state.units
+	var c: Dictionary = units[charger_id]
+	var acts := []
+	for tid in units:
+		var t: Dictionary = units[tid]
+		if int(t.get("owner", 0)) == player or AIDecisionMaker._get_alive_models(t).is_empty():
+			continue
+		if AIDecisionMaker._get_closest_model_distance_inches(c, t) <= 12.0:
+			acts.append({"type": "DECLARE_CHARGE", "actor_unit_id": charger_id, "payload": {"target_unit_ids": [tid]}})
+	acts.append({"type": "SKIP_CHARGE", "actor_unit_id": charger_id})
+	return acts
+
+func _save_decl(save_rel: String, charger_id: String, player: int, fix: float) -> Array:
+	var state = _load_state(save_rel)
+	if state.is_empty() or not state.units.has(charger_id):
+		return ["LOAD_FAILED", []]
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = fix
+	AIDecisionMaker._charge_coordination = {}
+	var d = AIDecisionMaker._decide_charge(state, _save_actions(state, charger_id, player), player)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	return [d.get("type", ""), d.get("payload", {}).get("target_unit_ids", [])]
+
+func _test_real_save_guards() -> void:
+	var f = _save_decl("r5c05/s7480_r3_p2_charge_1.w40ksave", "U_ALLARUS_CUSTODIANS_A_P2", 2, 1.0)
+	_assert(f == ["DECLARE_CHARGE", ["U_BLADE_CHAMPION_A"]], "s7480 r3 P2: the Allarus charge Blade Champion Alpha alone (%s)" % str(f))
+	var g = _save_decl("r2c00/s7431_r3_p1_charge_1.w40ksave", "U_ALLARUS_CUSTODIANS_A", 1, 1.0)
+	_assert(g == ["DECLARE_CHARGE", ["U_BLADE_CHAMPION_A_P2"]], "s7431 r3 P1 (harmful guard): the Allarus keep Blade Champion Alpha (%s)" % str(g))
+	# Guards: the fix leaves these declarations as they were.
+	var guards := [
+		["s1b/s7403_r3_p1_charge_1.w40ksave", "", 1],
+		["r4c15/s7466_r3_p2_charge_1.w40ksave", "U_BATTLEWAGON_A_P2", 2],
+		["r4c14/s7465_r2_p2_charge_1.w40ksave", "U_STORMBOYZ_A_P2", 2],
+		["r4c19/s7470_r2_p2_charge_1.w40ksave", "U_STORMBOYZ_A", 2],
+		["r4c19/s7470_r2_p2_charge_2.w40ksave", "U_STORMBOYZ_A", 2],
+		["r5c05/s7480_r3_p1_charge_1.w40ksave", "U_ALLARUS_CUSTODIANS_A", 1],
+		["r4c16/s7467_r2_p1_charge_1.w40ksave", "U_ALLARUS_CUSTODIANS_A", 1],
+	]
+	for gd in guards:
+		var cid: String = gd[1]
+		if cid == "":
+			cid = _find_charger(gd[0], gd[2])
+		var on = _save_decl(gd[0], cid, gd[2], 1.0)
+		var off = _save_decl(gd[0], cid, gd[2], 0.0)
+		_assert(on[0] != "LOAD_FAILED" and on == off, "%s %s: declaration unchanged (%s vs base %s)" % [gd[0], cid, str(on), str(off)])
+
+# The unit of `player` that charges with the fix off (the logged choice).
+func _find_charger(save_rel: String, player: int) -> String:
+	var state = _load_state(save_rel)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 0.0
+	var acts := []
+	for uid in state.units:
+		var u: Dictionary = state.units[uid]
+		if int(u.get("owner", 0)) != player or AIDecisionMaker._get_alive_models(u).is_empty():
+			continue
+		if bool(u.get("flags", {}).get("cannot_charge", false)) or bool(u.get("flags", {}).get("in_engagement", false)):
+			continue
+		for a in _save_actions(state, uid, player):
+			if a.type == "DECLARE_CHARGE":
+				acts.append(a)
+	AIDecisionMaker._charge_coordination = {}
+	var d = AIDecisionMaker._decide_charge(state, acts, player)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	return str(d.get("actor_unit_id", ""))
