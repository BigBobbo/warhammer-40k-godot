+		var host_id := _attached_unit_target_id(tid, snapshot)
+		var member_ids: Array = [host_id]
+		for cid in units.get(host_id, {}).get("attachment_data", {}).get("attached_characters", []):
+			if not str(cid) in member_ids:
+				member_ids.append(str(cid))
+		for oid in units:
+			if str(units[oid].get("attached_to", "")) == host_id and not str(oid) in member_ids:
+				member_ids.append(str(oid))
+		members = []
+		for mid in member_ids:
+			if units.has(mid):
+				members.append(units[mid])
+	var hp := 0.0
+	var start := 0.0
+	for m in members:
+		hp += _calculate_kill_threshold(m)
+		for model in m.get("models", []):
+			start += float(model.get("wounds", m.get("meta", {}).get("stats", {}).get("wounds", 1)))
+	if hp <= 0.0 or start <= 0.0:
+		return {}
+	# CT-DEPLETED: only a remnant, never a full-health target.
+	if hp > start * get_param("CHARGE_TARGET_DEPLETED_SHARE", CHARGE_TARGET_DEPLETED_SHARE):
+		return {}
+	if melee_damage < hp * get_param("CHARGE_TARGET_OVERKILL_RATIO", CHARGE_TARGET_OVERKILL_RATIO):
+		return {}
