diff --git a/40k/tests/unit/test_ai_fix_charge_target.gd b/40k/tests/unit/test_ai_fix_charge_target.gd
new file mode 100644
index 00000000..cf0e2540
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_charge_target.gd
@@ -0,0 +1,145 @@
+extends SceneTree
+
+# FIX_CHARGE_TARGET (critic cluster "charge_target", round 5): a charge was
+# declared at a poor set of targets when one valuable target scored more.
+#
+# s7480 r3 P2: Allarus Custodians declared at a 2-wound Allarus remnant (3+,
+# 97%) + Allarus #2 (9+) instead of Blade Champion Alpha (5+, 83%). The
+# remnant was credited the charger's full 7.5 expected melee damage against 2
+# wounds left (ch_damage 15) and the x1.56 short-charge multipliers scaled
+# that phantom damage; the second Allarus squad came along as an "extra" that
+# fights back. Charging Blade Champion alone measured +5.75 VP over 24 seeds.
+#
+# CH-OVERKILL: with a choice of targets, damage beyond the target's remaining
+# wounds is not credited. CH-EXTRA: a multi-target declaration whose extra
+# target adds nothing (fights back for at least its lock-down share) is
+# dropped. Guard: a charger with ONE target keeps its old score.
+#
+# Run with: godot --headless --path . -s tests/unit/test_ai_fix_charge_target.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+const AIDifficultyConfig = preload("res://scripts/AIDifficultyConfig.gd")
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== FIX_CHARGE_TARGET: charge the target the damage is for ===\n")
+	AIDecisionMaker._current_difficulty = AIDifficultyConfig.Difficulty.COMPETITIVE  # no score noise (the benches play Competitive)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	test_remnant_vs_character()
+	test_lone_remnant_unchanged()
+	test_extra_target_that_adds_nothing()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_CHARGE_TARGET")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	if _fail_count > 0:
+		print("SOME TESTS FAILED")
+	else:
+		print("ALL TESTS PASSED")
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot() -> Dictionary:
+	return {
+		"battle_round": 3,
+		"meta": {"battle_round": 3},
+		"board": {"objectives": [], "terrain_features": [], "deployment_zones": []},
+		"units": {}
+	}
+
+func _melee(wname: String, ws: int, s: int, ap: int, d: int, a: int) -> Dictionary:
+	return {"name": wname, "type": "Melee", "weapon_skill": str(ws), "strength": str(s),
+		"ap": ("-%d" % ap) if ap > 0 else "0", "damage": str(d), "attacks": str(a)}
+
+func _add(snap: Dictionary, uid: String, owner: int, pos: Vector2, name: String, n: int,
+		kw: Array, weapons: Array, t: int, sv: int, w: int, points: int, wounds_left: Array = []) -> void:
+	var models = []
+	for i in range(n):
+		var cw = w if wounds_left.is_empty() else int(wounds_left[i])
+		models.append({"id": "m%d" % (i + 1), "alive": cw > 0, "base_mm": 40, "base_type": "circular",
+			"base_dimensions": {}, "position": Vector2(pos.x + i * 60, pos.y), "wounds": w, "current_wounds": cw})
+	snap.units[uid] = {"id": uid, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": name, "points": points,
+			"stats": {"move": 6, "toughness": t, "save": sv, "wounds": w, "leadership": 6, "objective_control": 2},
+			"keywords": kw, "weapons": weapons},
+		"models": models, "flags": {}}
+
+func _actions(charger: String, targets: Array) -> Array:
+	var out = []
+	for tid in targets:
+		out.append({"type": "DECLARE_CHARGE", "actor_unit_id": charger, "payload": {"target_unit_ids": [tid]}})
+	out.append({"type": "SKIP_CHARGE", "actor_unit_id": charger})
+	out.append({"type": "END_CHARGE"})
+	return out
+
+# Strong 3-model charger (Allarus-like); a 1-model remnant on 2 wounds ~2"
+# away; a 7-wound CHARACTER ~4.5" away.
+func _scene() -> Dictionary:
+	var snap = _snapshot()
+	_add(snap, "charger", 2, Vector2(880, 1400), "Allarus", 3, ["INFANTRY", "TERMINATOR"],
+		[_melee("Guardian spear", 2, 7, 2, 2, 5)], 7, 2, 3, 165)
+	# remnant: 1 of 3 models alive, 2 wounds left — 2" edge gap (80px + 40mm base)
+	# (its last model still hits back hard, so as an extra target it adds nothing)
+	_add(snap, "remnant", 1, Vector2(880, 1400 - 80 - 63), "Allarus Remnant", 3, ["INFANTRY", "TERMINATOR"],
+		[_melee("Castellan axe", 2, 9, 3, 3, 6)], 7, 2, 3, 120, [2, 0, 0])
+	# character: 7 wounds, ~4.5" edge gap
+	_add(snap, "champ", 1, Vector2(1000, 1400 + 180 + 63), "Blade Champion", 1, ["INFANTRY", "CHARACTER"],
+		[_melee("Vaultswords", 2, 6, 2, 2, 6)], 6, 2, 7, 200)
+	return snap
+
+func _decide(snap: Dictionary, actions: Array, player: int) -> Dictionary:
+	AIDecisionMaker._charge_coordination.clear()  # static per-phase state
+	return AIDecisionMaker._decide_charge(snap, actions, player)
+
+func _targets(decision: Dictionary) -> Array:
+	return decision.get("payload", {}).get("target_unit_ids", []) if decision.get("type") == "DECLARE_CHARGE" else []
+
+func test_remnant_vs_character():
+	var d = _decide(_scene(), _actions("charger", ["remnant", "champ"]), 2)
+	var tg = _targets(d)
+	print("  decision: %s %s — %s" % [d.get("type", ""), str(tg), d.get("_ai_description", "")])
+	_assert(d.get("type") == "DECLARE_CHARGE", "still charges (got %s)" % d.get("type", ""))
+	_assert(tg == ["champ"], "charges the Blade Champion alone, not the 2-wound remnant (got %s)" % str(tg))
+
+func test_lone_remnant_unchanged():
+	# Only the remnant in reach: the overkill cap does not apply, so the
+	# charge / no-charge call and the score match FIX_CHARGE_TARGET=0.
+	var snap = _scene()
+	snap.units.erase("champ")
+	var d_on = _decide(snap, _actions("charger", ["remnant"]), 2)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 0.0
+	var d_off = _decide(snap, _actions("charger", ["remnant"]), 2)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	_assert(d_on.get("type") == "DECLARE_CHARGE" and _targets(d_on) == ["remnant"], "lone remnant still charged (got %s %s)" % [d_on.get("type", ""), str(_targets(d_on))])
+	_assert(str(d_on.get("_ai_description", "")) == str(d_off.get("_ai_description", "")), "same declaration as with the fix off")
+
+func test_extra_target_that_adds_nothing():
+	# A weak-hitting charger (Battlewagon-like) next to a worthless, hard-hitting
+	# target (value floored at 0) and a character: no combo with the worthless one.
+	var snap = _snapshot()
+	_add(snap, "wagon", 2, Vector2(880, 1400), "Battlewagon", 1, ["VEHICLE"],
+		[_melee("Grabbin' klaw", 4, 6, 1, 1, 3)], 10, 3, 16, 160)
+	_add(snap, "boyz", 1, Vector2(860, 1400 - 160 - 63), "Beast Snagga Boyz", 3, ["INFANTRY"],
+		[_melee("Choppa", 3, 8, 2, 2, 4)], 5, 5, 2, 95)
+	_add(snap, "boss", 1, Vector2(1000, 1400 + 190 + 63), "Beastboss", 1, ["INFANTRY", "CHARACTER"],
+		[_melee("Beast-chop", 2, 6, 1, 2, 4)], 5, 4, 6, 80)
+	var d = _decide(snap, _actions("wagon", ["boyz", "boss"]), 2)
+	var tg = _targets(d)
+	print("  decision: %s %s — %s" % [d.get("type", ""), str(tg), d.get("_ai_description", "")])
+	_assert(tg.size() <= 1, "no multi-target declaration with an extra that adds nothing (got %s)" % str(tg))
+
+func test_param_zero_restores_base():
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 0.0
+	var d = _decide(_scene(), _actions("charger", ["remnant", "champ"]), 2)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	print("  fix off: %s %s" % [d.get("type", ""), str(_targets(d))])
+	_assert("remnant" in _targets(d), "FIX_CHARGE_TARGET=0: the old pick includes the remnant (got %s)" % str(_targets(d)))
