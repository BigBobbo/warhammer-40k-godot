diff --git a/40k/tests/unit/test_ai_fix_charge_target.gd b/40k/tests/unit/test_ai_fix_charge_target.gd
new file mode 100644
index 00000000..6b1182fe
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_charge_target.gd
@@ -0,0 +1,199 @@
+extends SceneTree
+
+# FIX_CHARGE_TARGET — charge declarations valued as what the charge can really
+# take (critic cluster "charge_target", round 5).
+#
+# Critic finding s7480_r3_p2_charge_1 (value-checked: +5.75 VP [1.46, 10.04]
+# over 24 paired seeds): Allarus Custodians declared at "Allarus Custodians
+# (a 2-wound remnant, 3+) + Allarus Custodians #2 (9+)" instead of Blade
+# Champion Alpha (7 HP CHARACTER, 5+).
+#
+#   CT-CAP       ch_damage credited all 7.5 expected damage against the
+#                2-wound remnant (15 points for 2 wounds' worth of kill);
+#                the credit is now capped at the target's remaining wounds.
+#   CT-FALLBACK  11e 11.04 picks targets after the roll; when the roll misses
+#                every declared target the post-roll step re-picks the best
+#                enemy in reach. A single-target declaration is now worth that
+#                fallback on the rolls under its target, as the multi-target
+#                combos already were — "Blade Champion, remnant if the roll is
+#                short" is valued like for like against "remnant + far unit".
+#   FIX_CHARGE_TARGET = 0 restores the old behaviour.
+#
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_charge_target.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+const AIDifficultyConfig = preload("res://scripts/AIDifficultyConfig.gd")
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== FIX_CHARGE_TARGET: charge targets valued by what the charge can take ===\n")
+	# Competitive: no score noise (see test_ai_charge_decisions.gd).
+	AIDecisionMaker._current_difficulty = AIDifficultyConfig.Difficulty.COMPETITIVE
+	var prev_edition = GameConstants.edition
+	GameConstants.edition = 11
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	_test_damage_credit_capped_at_remaining_wounds()
+	_test_full_strength_target_not_capped()
+	_test_fallback_ev_counts_lower_rolls()
+	_test_finding_charges_the_valuable_target()
+	_test_lone_remnant_still_charged()
+	_test_param_zero_restores_base()
+	AIDecisionMaker._charge_coordination.clear()
+	AIDecisionMaker._config_overrides.erase("FIX_CHARGE_TARGET")
+	GameConstants.edition = prev_edition
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+# ---------------------------------------------------------------------------
+# Fixtures (40 px per inch, 32 mm bases)
+# ---------------------------------------------------------------------------
+
+func _snapshot() -> Dictionary:
+	return {
+		"battle_round": 3,
+		"meta": {"battle_round": 3},
+		"board": {"objectives": [], "terrain_features": [], "deployment_zones": []},
+		"units": {},
+	}
+
+func _melee(wname: String, ws: int, s: int, ap: int, d: int, a: int) -> Dictionary:
+	return {"name": wname, "type": "Melee", "weapon_skill": str(ws), "strength": str(s),
+		"ap": ("-%d" % ap) if ap > 0 else "0", "damage": str(d), "attacks": str(a)}
+
+# Models at the given positions; `dead` of them (from the end) are removed.
+func _add(snap: Dictionary, uid: String, owner: int, positions: Array, weapons: Array,
+		toughness: int, save_val: int, wounds: int, keywords: Array = ["INFANTRY"],
+		dead: int = 0, last_wounds: int = -1) -> Dictionary:
+	var models := []
+	for i in range(positions.size()):
+		var alive := i < positions.size() - dead
+		var cw := wounds if alive else 0
+		if alive and last_wounds > 0 and i == positions.size() - dead - 1:
+			cw = last_wounds
+		models.append({"id": "m%d" % (i + 1), "alive": alive, "base_mm": 32, "base_type": "circular",
+			"base_dimensions": {}, "position": positions[i], "wounds": wounds, "current_wounds": cw})
+	var u := {"id": uid, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": uid, "keywords": keywords, "weapons": weapons,
+			"stats": {"move": 6, "toughness": toughness, "save": save_val, "wounds": wounds,
+				"leadership": 6, "objective_control": 2}},
+		"models": models, "flags": {}}
+	snap.units[uid] = u
+	return u
+
+# The finding's shape. The charger: 3 elite models in a row (x 1000..1120).
+#   remnant  one 3W model left of a 3-model unit, on 2 wounds, 2" off the
+#            charger's left end (3+);
+#   far      a fresh 3-model 3W unit 8.5" further left, near the remnant (9+);
+#   champ    a 7W CHARACTER 4.3" off the charger's right end (5+), too far
+#            from the remnant for one charge to engage both.
+func _finding_snapshot(with_champ: bool = true, with_far: bool = true) -> Dictionary:
+	var snap := _snapshot()
+	var spear := _melee("Guardian spear", 2, 7, 2, 2, 5)
+	_add(snap, "allarus", 2, [Vector2(1000, 1000), Vector2(1060, 1000), Vector2(1120, 1000)], [spear], 6, 2, 3)
+	_add(snap, "remnant", 1, [Vector2(870, 1000), Vector2(870, 1060), Vector2(870, 1120)], [spear], 6, 2, 3,
+		["INFANTRY"], 2, 2)
+	if with_far:
+		_add(snap, "far", 1, [Vector2(610, 1000), Vector2(610, 1060), Vector2(610, 1120)], [spear], 6, 2, 3)
+	if with_champ:
+		_add(snap, "champ", 1, [Vector2(1342, 1000)], [_melee("Sword", 2, 6, 2, 2, 6)], 5, 3, 7,
+			["INFANTRY", "CHARACTER"])
+	return snap
+
+func _charge_actions(snap: Dictionary, uid: String) -> Array:
+	var acts := []
+	for tid in snap.units:
+		if snap.units[tid].owner != snap.units[uid].owner:
+			acts.append({"type": "DECLARE_CHARGE", "actor_unit_id": uid, "payload": {"target_unit_ids": [tid]}})
+	acts.append({"type": "SKIP_CHARGE", "actor_unit_id": uid})
+	acts.append({"type": "END_CHARGE"})
+	return acts
+
+func _declared(snap: Dictionary) -> Array:
+	AIDecisionMaker._charge_coordination.clear()
+	var d = AIDecisionMaker._decide_charge(snap, _charge_actions(snap, "allarus"), 2)
+	print("  decision: %s — %s" % [d.get("type", ""), d.get("_ai_description", "")])
+	if d.get("type", "") != "DECLARE_CHARGE":
+		return []
+	var ids: Array = d.get("payload", {}).get("target_unit_ids", []).duplicate()
+	ids.sort()
+	return ids
+
+# ---------------------------------------------------------------------------
+# CT-CAP
+# ---------------------------------------------------------------------------
+
+func _test_damage_credit_capped_at_remaining_wounds() -> void:
+	var snap := _finding_snapshot()
+	var dmg := AIDecisionMaker._estimate_melee_damage(snap.units.allarus, snap.units.remnant)
+	var hp := AIDecisionMaker._calculate_kill_threshold(snap.units.remnant)
+	_assert(dmg > hp, "setup: the charger's damage (%.2f) exceeds the remnant's %.0f wounds" % [dmg, hp])
+	var terms := {}
+	AIDecisionMaker._score_charge_target(snap.units.allarus, snap.units.remnant, snap, 2, terms)
+	var w := AIDecisionMaker.CHARGE_MELEE_DAMAGE_WEIGHT
+	_assert(absf(float(terms.get("ch_damage", 0.0)) - hp * w) < 0.01,
+		"ch_damage credits only the remnant's wounds (%.2f, want %.2f)" % [float(terms.get("ch_damage", 0.0)), hp * w])
+
+func _test_full_strength_target_not_capped() -> void:
+	var snap := _finding_snapshot()
+	var dmg := AIDecisionMaker._estimate_melee_damage(snap.units.allarus, snap.units.far)
+	var terms := {}
+	AIDecisionMaker._score_charge_target(snap.units.allarus, snap.units.far, snap, 2, terms)
+	var w := AIDecisionMaker.CHARGE_MELEE_DAMAGE_WEIGHT
+	_assert(dmg < AIDecisionMaker._calculate_kill_threshold(snap.units.far) and absf(float(terms.get("ch_damage", 0.0)) - dmg * w) < 0.01,
+		"a target the charge cannot overkill keeps its full damage credit (%.2f)" % float(terms.get("ch_damage", 0.0)))
+
+# ---------------------------------------------------------------------------
+# CT-FALLBACK
+# ---------------------------------------------------------------------------
+
+func _test_fallback_ev_counts_lower_rolls() -> void:
+	# A 5+ target with a 3+ fallback worth 10 if reached: rolls 3 and 4
+	# (5/36) re-pick the fallback.
+	var pool := [
+		{"target_id": "a", "need": 5.0, "prob": 30.0 / 36.0, "score": 20.0, "target_score": 20.0},
+		{"target_id": "b", "need": 3.0, "prob": 35.0 / 36.0, "score": 10.0 * 35.0 / 36.0, "target_score": 8.0},
+	]
+	var fb = (AIDecisionMaker as Script).call("_charge_post_roll_fallback_ev", ["a"], pool)  # .call: absent on the base code
+	_assert(fb != null and absf(float(fb) - 10.0 * 5.0 / 36.0) < 0.01, "fallback EV = P(roll 3-4) x fallback value (%s, want %.3f)" % [str(fb), 10.0 * 5.0 / 36.0])
+	var none = (AIDecisionMaker as Script).call("_charge_post_roll_fallback_ev", ["b"], pool)
+	_assert(none != null and float(none) == 0.0, "the nearest target has no fallback below it (%s)" % str(none))
+
+# ---------------------------------------------------------------------------
+# Decision (drives _decide_charge)
+# ---------------------------------------------------------------------------
+
+func _test_finding_charges_the_valuable_target() -> void:
+	var snap := _finding_snapshot()
+	var ids := _declared(snap)
+	_assert(ids == ["champ"],
+		"the charger declares at the 7W character (remnant as the post-roll fallback), not remnant + far unit (got %s)" % str(ids))
+
+func _test_lone_remnant_still_charged() -> void:
+	# Guard: with nothing better in reach, the remnant is still charged
+	# (the fix re-ranks targets, it does not stop charges).
+	var snap := _finding_snapshot(false, false)
+	var ids := _declared(snap)
+	_assert(ids == ["remnant"], "a lone remnant in reach is still charged (got %s)" % str(ids))
+
+func _test_param_zero_restores_base() -> void:
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 0.0
+	var snap := _finding_snapshot()
+	var terms := {}
+	AIDecisionMaker._score_charge_target(snap.units.allarus, snap.units.remnant, snap, 2, terms)
+	var dmg := AIDecisionMaker._estimate_melee_damage(snap.units.allarus, snap.units.remnant)
+	var ids := _declared(snap)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_TARGET"] = 1.0
+	_assert(absf(float(terms.get("ch_damage", 0.0)) - dmg * AIDecisionMaker.CHARGE_MELEE_DAMAGE_WEIGHT) < 0.01,
+		"FIX_CHARGE_TARGET = 0: the full damage is credited again (%.2f)" % float(terms.get("ch_damage", 0.0)))
+	_assert(ids != ["champ"], "FIX_CHARGE_TARGET = 0: the old declaration comes back (got %s)" % str(ids))
