@@ -1665,6 +1665,22 @@ const FIX_REINFORCE_INSURANCE: float = 1.0
 const FIX_RI_RACE: float = 1.0
 const FIX_RI_ASSAULT: float = 1.0
 const FIX_RI_QUARTER: float = 1.0
+# Movement plan (FIX_ATTACK_MOVE): 1 = a capture that leaves its objective
+# SHORT is not worth more than a top-up. Pass 2's need ledger gives OC past an
+# objective's need zero marginal value, so a unit whose best objective was
+# "already taken" was redirected to the next objective that still needed OC
+# even when its OC alone could not get there ("needs 3 more OC after this
+# unit") and no unassigned unit could close the gap in time. That capture
+# controls nothing (control needs MORE OC than the enemy) — its marginal value
+# under the same ledger is zero too, so the two are ranked by their candidate
+# scores: the unit tops up the higher-scored contested objective (one the
+# enemy holds, contests or can reach next move) that it reaches within two
+# moves or no later than the short capture. Custodian
+# Guard units walked 2-3 turns to flip an 11-OC side objective with 9 OC while
+# a third guard on the contested centre measured +4.0 / +5.9 / +9.8 VP
+# (rollouts, 24-36 seeds; LLM-critic cluster attack_move). 0 = previous
+# behaviour.
+const FIX_ATTACK_MOVE: float = 1.0
 # RI-QUARTER: share of the quarter VP counted for each later battle round
 # (the unit usually stays in the quarter it entered, but may move or die).
 const RI_QUARTER_LATER_ROUND_SHARE: float = 0.5
@@ -10488,6 +10504,40 @@ static func _assign_units_to_objectives(
 		assignments[c_uid]["assign_pass"] = "capture"
 		print("AIDecisionMaker: Assigned %s to %s %s (score: %.1f, reason: %s)" % [c_uid, cand.action.to_upper(), c_oid, cand.score, assign_reason])
 
+	# ATTACK-MOVE (FIX_ATTACK_MOVE): a capture this unit leaves short of the
+	# need, with no unassigned unit able to close the gap in time, controls
+	# nothing — no more marginal value than a top-up past the need, which the
+	# ledger prices at zero. Between the two, the candidate scores decide.
+	# Returns the top-up candidate ({} = keep cand).
+	var attack_move_on = get_param("FIX_ATTACK_MOVE", FIX_ATTACK_MOVE) >= 0.5
+	var am_covered_best := {}  # unit_id -> its best candidate skipped as covered
+	var attack_move_topup := func(c: Dictionary, c_remaining: int) -> Dictionary:
+		if not attack_move_on or c.get("action", "") not in ["move", "advance"] or c.get("already_on_obj", false):
+			return {}
+		var gap: int = c_remaining - int(c.get("unit_oc", 1))
+		if gap <= 0 or not am_covered_best.has(c.unit_id):
+			return {}
+		var top: Dictionary = am_covered_best[c.unit_id]
+		if top.get("action", "") not in ["move", "advance"] or top.get("already_on_obj", false) \
+				or float(top.score) <= float(c.score) \
+				or int(top.get("turns_to_reach", 1)) > maxi(int(c.get("turns_to_reach", 1)), 2):
+			return {}  # the top-up must arrive in time to matter: by our next move, or no later than c
+		var top_ev = _get_obj_eval_by_id(obj_evaluations, top.objective_id)
+		if top_ev.is_empty() or (int(top_ev.get("enemy_oc", 0)) <= 0 and int(top_ev.get("projected_enemy_oc", 0)) <= 0):
+			return {}  # nothing there to insure against
+		# Could the plan still close the gap? Unassigned units that reach c's
+		# objective no later than this unit.
+		var help := 0
+		for h in candidates:
+			if h.objective_id != c.objective_id or h.unit_id == c.unit_id or assigned_unit_ids.has(h.unit_id) \
+					or h.action not in ["move", "advance"] \
+					or int(h.get("turns_to_reach", 1)) > int(c.get("turns_to_reach", 1)):
+				continue
+			help += int(h.unit_oc)
+		if help >= gap:
+			return {}
+		return {"top": top, "gap": gap, "help": help}
+
 	for cand in candidates:
 		var uid = cand.unit_id
 		var oid = cand.objective_id
@@ -10498,6 +10548,9 @@ static func _assign_units_to_objectives(
 		if remaining <= 0:
 			if incoming_oc.get(oid, 0) > 0 and not blocked_best.has(uid):
 				blocked_best[uid] = {"objective_id": oid, "names": incoming_names.get(oid, [])}
+			# ATTACK-MOVE: the unit's best candidate the ledger called covered
+			if attack_move_on and not am_covered_best.has(uid):
+				am_covered_best[uid] = cand
 			continue  # Skip objectives that don't need more OC
 
 		var price: Dictionary = reprice_capture.call(oid)
@@ -10614,6 +10667,19 @@ static func _assign_units_to_objectives(
 			if obj_oc_remaining.get(oid, 0) <= 0:
 				continue  # covered — this unit falls through to its next option
 
+		var am: Dictionary = attack_move_topup.call(cand, int(obj_oc_remaining.get(oid, 0)))
+		if not am.is_empty():
+			var am_top: Dictionary = am.top
+			apply_capture_assignment.call(am_top)
+			assignments[uid]["reason"] = "reinforcing %s past the need — %s would still need %d more OC after this unit and no other unit can reach it in time" % [
+				am_top.objective_id, oid, int(am.gap)]
+			assignments[uid]["coordination_note"] = "not going for %s alone (it would still need %d more OC after this unit); adding OC on contested %s instead" % [
+				oid, int(am.gap), am_top.objective_id]
+			print("AIDecisionMaker: [ATTACK_MOVE] %s: not sending %s — short by %d OC after it (help in time: %d OC); tops up %s instead (score %.1f vs %.1f, %d vs %d turn(s))" % [
+				oid, uid, int(am.gap), int(am.help), am_top.objective_id, float(am_top.score), float(cand.score),
+				int(am_top.get("turns_to_reach", 1)), int(cand.get("turns_to_reach", 1))])
+			continue
