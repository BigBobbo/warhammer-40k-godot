diff --git a/40k/tests/unit/test_ai_fix_attack_move.gd b/40k/tests/unit/test_ai_fix_attack_move.gd
new file mode 100644
index 00000000..f8d32f93
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_attack_move.gd
@@ -0,0 +1,155 @@
+extends SceneTree
+
+# ATTACK-MOVE (FIX_ATTACK_MOVE): a capture this unit leaves SHORT of the need
+# (control needs more OC than the enemy) with no unassigned unit able to close
+# the gap in time controls nothing — no more marginal value than a top-up past
+# the need, which pass 2's ledger prices at zero. The unit then tops up its
+# higher-scored contested objective instead of walking off to flip a stronger
+# one alone. LLM-critic cluster attack_move (value-checked, 2026-10-30/31):
+# Custodian Guard sent to flip an 11-OC side objective with 9 OC while a third
+# guard on the contested centre measured +4.0 / +5.9 / +9.8 VP (24-36 seeds).
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_attack_move.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const OBJ_X := Vector2(880, 1200)     # contested centre: enemy holds it with 4 OC
+const OBJ_SIDE := Vector2(200, 1700)  # side objective: enemy holds it with 10 OC
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== A short capture is worth no more than a top-up (ATTACK-MOVE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 1.0
+	test_short_flip_redirected_to_contested_topup()
+	test_help_in_time_keeps_the_flip()
+	test_flip_the_unit_completes_is_kept()
+	test_quiet_topup_is_not_taken()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_ATTACK_MOVE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot() -> Dictionary:
+	var objs = [{"id": "obj_x", "position": OBJ_X, "zone": "no_mans_land"},
+		{"id": "obj_side", "position": OBJ_SIDE, "zone": "no_mans_land"}]
+	return {"battle_round": 2, "meta": {"battle_round": 2},
+		"board": {"objectives": objs, "terrain_features": []}, "units": {}}
+
+# Durable models (T6, 3 wounds, OC 2) at the given positions.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, positions: Array, move: int = 6, oc: int = 2) -> void:
+	var models = []
+	for i in range(positions.size()):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {},
+			"position": positions[i], "wounds": 3, "current_wounds": 3})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": 200, "stats": {"move": move, "toughness": 6, "save": 3,
+			"wounds": 3, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+func _row(center: Vector2, n: int) -> Array:
+	var out = []
+	for i in range(n):
+		out.append(Vector2(center.x + (i - (n - 1) / 2.0) * 45.0, center.y))
+	return out
+
+# Enemy: 2 models (4 OC) on obj_x, 5 models (10 OC) on obj_side. Ours (P2):
+# "first" and "second" (4 models, 8 OC each) about 10" below obj_x and 17"
+# from obj_side. One of them covers obj_x's need (5); 8 OC cannot flip
+# obj_side (needs 11).
+func _board(enemies: Dictionary, x_enemy_models: int = 2, side_enemy_models: int = 5) -> Dictionary:
+	var snap = _snapshot()
+	if x_enemy_models > 0:
+		_add_unit(snap, "theirs_x", 1, _row(OBJ_X + Vector2(0, -1.0 * PX), x_enemy_models))
+		enemies["theirs_x"] = snap.units["theirs_x"]
+	_add_unit(snap, "theirs_side", 1, _row(OBJ_SIDE + Vector2(0, -1.0 * PX), side_enemy_models))
+	enemies["theirs_side"] = snap.units["theirs_side"]
+	_add_unit(snap, "first", 2, _row(OBJ_X + Vector2(0, 9.5 * PX), 4))
+	_add_unit(snap, "second", 2, _row(OBJ_X + Vector2(-1.0 * PX, 10.5 * PX), 4))
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {}
+	AIDecisionMaker._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 2)
+	for ev in evals:
+		print("  eval %s: state %s, friendly %d, enemy %d, projected %d" % [ev.id, ev.state, int(ev.friendly_oc),
+			int(ev.enemy_oc), int(ev.get("projected_enemy_oc", 0))])
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 2)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 120)])
+	return plan
+
+func _goes_to(plan: Dictionary, uid: String, oid: String) -> bool:
+	var a: Dictionary = plan.get(uid, {})
+	return str(a.get("objective_id", "")) == oid and str(a.get("action", "")) in ["move", "advance"]
+
+func _count_to(plan: Dictionary, oid: String) -> int:
+	var n := 0
+	for uid in plan:
+		if _goes_to(plan, uid, oid):
+			n += 1
+	return n
+
+func test_short_flip_redirected_to_contested_topup() -> void:
+	print("\n--- obj_x (enemy 4 OC) covered by one 8-OC unit; obj_side needs 11, the other unit has 8 ---")
+	var enemies = {}
+	var snap = _board(enemies)
+	var plan = _plan(snap, ["first", "second"], enemies)
+	_assert(_count_to(plan, "obj_x") == 2, "both units go to the contested obj_x (%d)" % _count_to(plan, "obj_x"))
+	_assert(_count_to(plan, "obj_side") == 0, "nobody walks off alone to flip obj_side (%d)" % _count_to(plan, "obj_side"))
+
+func test_help_in_time_keeps_the_flip() -> void:
+	print("\n--- same, plus a third unassigned unit that reaches obj_side as soon: the flip can be completed ---")
+	var enemies = {}
+	var snap = _board(enemies)
+	_add_unit(snap, "helper", 2, _row(OBJ_SIDE + Vector2(9.0 * PX, 6.0 * PX), 4))
+	var plan = _plan(snap, ["first", "second", "helper"], enemies)
+	_assert(_count_to(plan, "obj_side") >= 1, "with help in time the plan still goes for obj_side (%d)" % _count_to(plan, "obj_side"))
+
+func test_flip_the_unit_completes_is_kept() -> void:
+	print("\n--- obj_side held with only 6 OC: an 8-OC unit flips it alone ---")
+	var enemies = {}
+	var snap = _board(enemies, 2, 3)
+	var plan = _plan(snap, ["first", "second"], enemies)
+	_assert(_count_to(plan, "obj_side") == 1, "the completable flip of obj_side is kept (%d)" % _count_to(plan, "obj_side"))
+
+func test_quiet_topup_is_not_taken() -> void:
+	print("\n--- obj_x uncontrolled with no enemy near it: a top-up there insures nothing ---")
+	var enemies = {}
+	var snap = _board(enemies, 0, 5)
+	var plan = _plan(snap, ["first", "second"], enemies)
+	_assert(_count_to(plan, "obj_x") <= 1, "no second unit stacked on a quiet obj_x (%d)" % _count_to(plan, "obj_x"))
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_ATTACK_MOVE = 0: the short flip is assigned as before ---")
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 0.0
+	var enemies = {}
+	var snap = _board(enemies)
+	var plan = _plan(snap, ["first", "second"], enemies)
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 1.0
+	_assert(_count_to(plan, "obj_side") == 1, "with the fix off one unit is sent to flip obj_side alone (%d)" % _count_to(plan, "obj_side"))
