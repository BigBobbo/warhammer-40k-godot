@@ -1660,6 +1660,17 @@ const FIX_CHARGE_EV: float = 0.0
 # reinforce_insurance; the Advance measured +4.36 VP over 36 rollouts, the
 # gain from the quarter tier). 0 = previous behaviour.
 const FIX_REINFORCE_INSURANCE: float = 1.0
+# ATTACK-MOVE (FIX_ATTACK_MOVE): after the capture passes, a unit sent to
+# flip or capture an objective the plan still leaves short (its OC need stays
+# above 0 once every unit is assigned — the unit cannot take it and nobody
+# joins it) is sent instead to its top-scored objective when that one is
+# enemy-held, already covered by friends moving or holding there, and no
+# slower to reach. A lone 9-OC trip onto an 11-OC objective changes nothing;
+# a third unit on the enemy-held centre keeps the flip (Custodian Guard Alpha
+# s7475 r2: Normal move to obj_center +4.0 VP over 24 rollouts; Beta s7455 r2
+# +5.9 over 36 — the gain is denying the enemy's centre hold). 0 = previous
+# behaviour.
+const FIX_ATTACK_MOVE: float = 1.0
 # Part switches under the master (each read at its own branch; 0 removes only
 # that part, the master at 0 removes all three).
 const FIX_RI_RACE: float = 1.0
@@ -10715,6 +10726,49 @@ static func _assign_units_to_objectives(
 		apply_capture_assignment.call(cand)
 		assignments[cand.unit_id]["reason"] += " — backfilling for a unit that went hunting"
 
+	# ATTACK-MOVE (FIX_ATTACK_MOVE): a capture the plan leaves short goes to the
+	# unit's top-scored enemy-held objective that friends already cover instead.
+	if get_param("FIX_ATTACK_MOVE", FIX_ATTACK_MOVE) >= 0.5:
+		for am_uid in assignments.keys():
+			var am_cur: Dictionary = assignments[am_uid]
+			var am_oid = str(am_cur.get("objective_id", ""))
+			if am_cur.get("assign_pass", "") != "capture" or am_cur.get("action", "") not in ["move", "advance"] \
+					or int(obj_oc_remaining.get(am_oid, 0)) <= 0:
+				continue
+			var am_eval = _get_obj_eval_by_id(obj_evaluations, am_oid)
+			if am_eval.is_empty() or am_eval.get("is_home", false) or am_eval.get("state", "") in ["held_safe", "held_threatened"]:
+				continue
+			var am_top: Dictionary = {}
+			for am_c in candidates:
+				if am_c.unit_id == am_uid and (am_top.is_empty() or float(am_c.score) > float(am_top.score)):
+					am_top = am_c
+			if am_top.is_empty() or am_top.objective_id == am_oid or am_top.action not in ["move", "advance"] \
+					or float(am_top.score) <= float(am_cur.get("score", 0.0)) \
+					or int(obj_oc_remaining.get(am_top.objective_id, 0)) > 0 \
+					or int(am_top.turns_to_reach) > int(am_cur.get("turns_to_reach", 1)) \
+					or too_late.call(am_top) or race_hopeless.call(am_top):
+				continue
+			var am_top_eval = _get_obj_eval_by_id(obj_evaluations, am_top.objective_id)
+			if am_top_eval.get("state", "") not in ["enemy_weak", "enemy_strong", "contested"]:
+				continue
+			var am_friends: Array = []
+			for am_o in assignments:
+				if str(am_o) != str(am_uid) and str(assignments[am_o].get("objective_id", "")) == str(am_top.objective_id) \
+						and assignments[am_o].get("action", "") in ["hold", "move", "advance"]:
+					am_friends.append(_dn(snapshot.get("units", {}).get(am_o, {}), am_o))
+			if am_friends.is_empty():
+				continue
+			var am_short = int(obj_oc_remaining.get(am_oid, 0))
+			obj_oc_remaining[am_oid] = am_short + int(am_cur.get("oc_consumed", 0))
+			assignments.erase(am_uid)
+			assigned_unit_ids.erase(am_uid)
+			apply_capture_assignment.call(am_top)
+			assignments[am_uid]["coordination_note"] = "not going alone to %s — it would still need %d more OC there and no other unit joins it; joining %s on %s instead" % [
+				am_oid, am_short, ", ".join(am_friends), am_top.objective_id]
+			print("AIDecisionMaker: [ATTACK_MOVE] %s: %s -> %s (%s left %d OC short, nobody joins; %s already on %s, score %.1f vs %.1f, %d vs %d turn(s))" % [
+				am_uid, am_oid, am_top.objective_id, am_oid, am_short, ", ".join(am_friends), am_top.objective_id,
+				float(am_top.score), float(am_cur.get("score", 0.0)), int(am_top.turns_to_reach), int(am_cur.get("turns_to_reach", 1))])
+
 	# PASS 3: Assign remaining units — screening / deep strike denial / support
 	# Difficulty gate (use_screening, Hard+): the deep-strike denial,
