diff --git a/40k/tests/unit/test_ai_fix_attack_move.gd b/40k/tests/unit/test_ai_fix_attack_move.gd
new file mode 100644
index 00000000..db3192dc
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_attack_move.gd
@@ -0,0 +1,154 @@
+extends SceneTree
+
+# ATTACK-MOVE (FIX_ATTACK_MOVE): after the capture passes, a unit sent to flip
+# an objective the plan still leaves short (the OC need stays above 0 — the
+# unit cannot take it alone and nobody joins it) goes instead to its
+# top-scored objective when that one is enemy-held, already covered by
+# friends, and no slower to reach. LLM-critic cluster attack_move
+# (value-checked, 2026-10-31): s7475 r2, Custodian Guard Alpha sent to flip an
+# 11-OC objective with 9 OC while two Guard squads took the enemy-held centre;
+# a Normal move to the centre measured +4.0 VP over 24 seeds (s7455 r2 +5.9
+# over 36).
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_attack_move.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const OBJ_C := Vector2(880, 1200)    # enemy-held centre, weakly held
+const OBJ_FAR := Vector2(880, 400)   # enemy-held, strongly held
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== A short lone flip joins the covered enemy-held objective (ATTACK-MOVE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 1.0
+	test_short_flip_joins_covered_centre()
+	test_flip_that_gets_filled_is_kept()
+	test_held_top_objective_not_stacked()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_ATTACK_MOVE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot() -> Dictionary:
+	var objs = [{"id": "obj_c", "position": OBJ_C, "zone": "no_mans_land"},
+		{"id": "obj_far", "position": OBJ_FAR, "zone": "no_mans_land"}]
+	return {"battle_round": 2, "meta": {"battle_round": 2},
+		"board": {"objectives": objs, "terrain_features": []}, "units": {}}
+
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, positions: Array, move: int = 6, oc: int = 2) -> void:
+	var models = []
+	for i in range(positions.size()):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {},
+			"position": positions[i], "wounds": 3, "current_wounds": 3})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": 200, "stats": {"move": move, "toughness": 6, "save": 3,
+			"wounds": 3, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+func _row(center: Vector2, n: int) -> Array:
+	var out = []
+	for i in range(n):
+		out.append(Vector2(center.x + (i - (n - 1) / 2.0) * 45.0, center.y))
+	return out
+
+# Enemy: 5 models (10 OC) on obj_c, 6 models (12 OC) on obj_far. Ours: two
+# 4-model squads (8 OC each) just below obj_c, and "lone" (4 models, 8 OC)
+# between the two objectives, nearer obj_c.
+func _board(enemies: Dictionary, far_models: int = 6, c_models: int = 5) -> Dictionary:
+	var snap = _snapshot()
+	_add_unit(snap, "e_c", 1, _row(OBJ_C + Vector2(0, -1.0 * PX), c_models))
+	_add_unit(snap, "e_far", 1, _row(OBJ_FAR + Vector2(0, -1.0 * PX), far_models))
+	enemies["e_c"] = snap.units["e_c"]
+	enemies["e_far"] = snap.units["e_far"]
+	_add_unit(snap, "f1", 2, _row(OBJ_C + Vector2(-4.0 * PX, 7.0 * PX), 4))
+	_add_unit(snap, "f2", 2, _row(OBJ_C + Vector2(4.0 * PX, 7.0 * PX), 4))
+	_add_unit(snap, "lone", 2, _row(OBJ_C + Vector2(10.0 * PX, -8.0 * PX), 4))
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {}
+	AIDecisionMaker._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 2)
+	for ev in evals:
+		print("  eval %s: state %s, friendly %d, enemy %d" % [ev.id, ev.state, int(ev.friendly_oc), int(ev.enemy_oc)])
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 2)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for c in AIDecisionMaker._last_movement_candidates.get("lone", []):
+		print("    lone cand %s %s score %.1f ttr %d" % [c.action, c.objective_id, float(c.score), int(c.turns_to_reach)])
+	return plan
+
+func _goes_to(plan: Dictionary, uid: String, oid: String) -> bool:
+	var a: Dictionary = plan.get(uid, {})
+	return str(a.get("objective_id", "")) == oid and str(a.get("action", "")) in ["move", "advance"]
+
+func test_short_flip_joins_covered_centre() -> void:
+	print("\n--- obj_c (10 enemy OC) covered by f1+f2 (16 OC); lone (8 OC) would flip obj_far (12 OC) alone ---")
+	var enemies = {}
+	var snap = _board(enemies)
+	var plan = _plan(snap, ["f1", "f2", "lone"], enemies)
+	_assert(_goes_to(plan, "f1", "obj_c") or _goes_to(plan, "f2", "obj_c"), "a friend squad takes obj_c")
+	_assert(_goes_to(plan, "lone", "obj_c"),
+		"lone joins the covered enemy-held obj_c instead of a short flip of obj_far (%s %s)" % [
+			str(plan.get("lone", {}).get("action", "")), str(plan.get("lone", {}).get("objective_id", ""))])
+
+func test_flip_that_gets_filled_is_kept() -> void:
+	print("\n--- obj_far held by 3 enemy models (6 OC): lone's 8 OC flips it alone ---")
+	var enemies = {}
+	var snap = _board(enemies, 3)
+	var plan = _plan(snap, ["f1", "f2", "lone"], enemies)
+	_assert(not _goes_to(plan, "lone", "obj_c") or float(plan.get("lone", {}).get("score", 0.0)) > 0.0,
+		"a flip lone can complete is not redirected by ATTACK-MOVE (%s %s)" % [
+			str(plan.get("lone", {}).get("action", "")), str(plan.get("lone", {}).get("objective_id", ""))])
+	_assert(not str(plan.get("lone", {}).get("coordination_note", "")).begins_with("not going alone to obj_far — it would still need"),
+		"no ATTACK-MOVE note when the flip completes")
+
+func test_held_top_objective_not_stacked() -> void:
+	print("\n--- obj_c already held by us (f1 on it): lone is not stacked there ---")
+	var enemies = {}
+	var snap = _board(enemies)
+	snap.units.erase("e_c")
+	enemies.erase("e_c")
+	snap.units["f1"].models[0].position = OBJ_C
+	snap.units["f1"].models[1].position = OBJ_C + Vector2(45, 0)
+	snap.units["f1"].models[2].position = OBJ_C + Vector2(-45, 0)
+	snap.units["f1"].models[3].position = OBJ_C + Vector2(0, 45)
+	var plan = _plan(snap, ["f1", "f2", "lone"], enemies)
+	_assert(not str(plan.get("lone", {}).get("coordination_note", "")).begins_with("not going alone to"),
+		"ATTACK-MOVE does not stack onto an objective we already hold")
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_ATTACK_MOVE = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 0.0
+	var enemies = {}
+	var snap = _board(enemies)
+	var plan = _plan(snap, ["f1", "f2", "lone"], enemies)
+	AIDecisionMaker._config_overrides["FIX_ATTACK_MOVE"] = 1.0
+	_assert(_goes_to(plan, "lone", "obj_far"),
+		"with the fix off lone goes on the short flip of obj_far (%s %s)" % [
+			str(plan.get("lone", {}).get("action", "")), str(plan.get("lone", {}).get("objective_id", ""))])
