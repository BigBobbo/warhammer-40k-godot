index 0000000..f682199
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_charge_low_odds.gd
@@ -0,0 +1,180 @@
+extends SceneTree
+
+# FIX_CHARGE_LOW_ODDS (critic cluster "charge_low_odds", 2026-10-30): the AI
+# declared low-odds charges whose real value was below what they cost.
+#
+#   s7469 r2 P2: Stormboyz declare a 28% charge at Blade Champion Alpha
+#     ("expected 8.9 melee dmg vs 7 HP") — not charging measured +4.33 VP
+#     [1.37, 7.30] over 36 rollouts.
+#   s7467 r2 P1: Allarus Custodians declare a 17% charge at a 4-wound Mek
+#     ("13.3 melee dmg vs 4 HP, overwatch risk 7.2") — not charging measured
+#     +2.64 [0.40, 4.88].
+#
+# Root cause — the charge estimate valued the options wrongly:
+#   CLO-OVERKILL  13.3 damage was counted against a 4-wound target (the cap is
+#                 the alive models' FULL wounds: a wounded model's kill still
+#                 removes the whole model).
+#   CLO-ATTACHED  the Blade Champion is attached to a 3-model Custodian Guard
+#                 unit: the charge fights 22 wounds and all of them hit back,
+#                 but it was scored as a lone 7-wound character "likely kill"
+#                 with no fight-back.
+#   CLO-CARRIER   the Nob's Kustom Choppa (no wargear entry) was counted for
+#                 all 10 Stormboyz: 8.9 expected damage, 2.2 real.
+#
+# The Mek finding's decision is NOT changed by this design (reported only):
+# its charge stays above the bar once its value is corrected; at 11e the
+# overwatch penalty it pays is a separate model error (15.08: no Charge-phase
+# overwatch), left as it is.
+#
+# Guard: a strong charge with low overwatch (Allarus at an attached Blade
+# Champion, s7431 r3, where charging measured -5.00 for not charging) is still
+# declared. FIX_CHARGE_LOW_ODDS = 0 restores the previous decision.
+#
+# Run with: godot --headless --path . -s tests/unit/test_ai_fix_charge_low_odds.gd
+
+const AI_PATH := "res://scripts/AIDecisionMaker.gd"
+const CASES := "res://tests/rollout_cases/"
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+var _ran := false
+var AIDM = null
+
+func _init():
+	root.connect("ready", Callable(self, "_run_tests"))
+	create_timer(0.1).timeout.connect(_run_tests)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _run_tests():
+	if _ran:
+		return
+	_ran = true
+	await process_frame
+	print("\n=== FIX_CHARGE_LOW_ODDS: low-odds charges valued at what they cost ===\n")
+	var prev_edition = GameConstants.edition
+	GameConstants.edition = 11
+	# Loaded at run time so the AI script compiles after the autoloads exist.
+	AIDM = load(AI_PATH)
+	AIDM._config_overrides["FIX_CHARGE_LOW_ODDS"] = 1.0
+	# Competitive, as in the critic games; no score noise at that level.
+	AIDM._current_difficulty = 3
+
+	test_carrier_counts()
+	test_stormboyz_no_charge_at_attached_champion()
+	test_mek_overkill_not_counted()
+	test_strong_charge_still_declared()
+	test_param_zero_restores_old_decision()
+
+	AIDM._config_overrides.erase("FIX_CHARGE_LOW_ODDS")
+	GameConstants.edition = prev_edition
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+# --- fixtures ---------------------------------------------------------------
+
+## The game state stored in a critic case's .w40ksave (base64 gzip JSON).
+func _load_state(save_rel: String) -> Dictionary:
+	var txt = FileAccess.get_file_as_string(CASES + save_rel)
+	var raw = Marshalls.base64_to_raw(txt.strip_edges())
+	var js = raw.decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP).get_string_from_utf8()
+	var found = _find_state(JSON.parse_string(js))
+	return found if found != null else {}
+
+func _find_state(o):
+	if typeof(o) == TYPE_DICTIONARY:
+		if o.has("units") and typeof(o.units) == TYPE_DICTIONARY and not o.units.is_empty():
+			return o
+		for v in o.values():
+			var r = _find_state(v)
+			if r != null:
+				return r
+	return null
+
+## The charge-phase actions for one charger: a DECLARE_CHARGE per enemy within
+## 12" (11.02) and its SKIP_CHARGE.
+func _actions(state: Dictionary, charger_id: String, player: int) -> Array:
+	var units: Dictionary = state.units
+	var c: Dictionary = units[charger_id]
+	var acts := []
+	for tid in units:
+		var t: Dictionary = units[tid]
+		if int(t.get("owner", 0)) == player or AIDM._get_alive_models(t).is_empty():
+			continue
+		if AIDM._get_closest_model_distance_inches(c, t) <= 12.0:
+			acts.append({"type": "DECLARE_CHARGE", "actor_unit_id": charger_id,
+				"payload": {"target_unit_ids": [tid]}})
+	acts.append({"type": "SKIP_CHARGE", "actor_unit_id": charger_id})
+	return acts
+
+func _decide(save_rel: String, charger_id: String, player: int) -> Dictionary:
+	AIDM._charge_coordination = {}
+	var state = _load_state(save_rel)
+	if state.is_empty():
+		return {"type": "LOAD_FAILED"}
+	return AIDM._decide_charge(state, _actions(state, charger_id, player), player)
+
+func _describe(d: Dictionary) -> String:
+	return "%s %s %s" % [d.get("type", ""), str(d.get("payload", {}).get("target_unit_ids", [])),
+		str(d.get("_ai_description", "")).substr(0, 110)]
+
