+	print("  carriers: %s" % str(counts))
+	_assert(int(counts.get("Kustom Choppa", 0)) == 1, "the Nob's Kustom Choppa (no wargear entry) is one model's weapon (%s)" % str(counts.get("Kustom Choppa")))
+	_assert(int(counts.get("Choppas", 0)) == 10, "Choppas matches 9x + 1x Choppa: all 10 models (%s)" % str(counts.get("Choppas")))
+
