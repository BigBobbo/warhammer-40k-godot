--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_charge_low_odds.gd
@@ -0,0 +1,222 @@
+extends SceneTree
+
+# FIX_CHARGE_LOW_ODDS — a long-odds charge is not declared when what the
+# charger stands to lose for the rest of the game outweighs what it can win.
+#
+# Critic cluster charge_low_odds (value-checked over 36 paired seeds):
+#   s7469 r2 P2  Stormboyz (140 pts) declared a 28% charge at a T7 2+/4++
+#                Blade Champion: "expected 8.9 dmg vs 7 HP", not a confident
+#                kill of a single model — not charging +4.33 VP [1.37, 7.30].
+#   s7467 r2 P1  Allarus Custodians (270 pts) declared a 17% charge at a 4 HP
+#                Mek into 7.2 dmg of expected overwatch — not charging
+#                +2.64 VP [0.40, 4.88].
+# The "don't charge" bar is a near-zero constant, so nothing counted the
+# charger's own later rounds:
+#   CH-OW-TOLL     overwatch is paid on every declaration; a toll of a quarter
+#                  or more of the charger that costs more points than the
+#                  charge can win at its odds -> no charge.
+#   CH-NO-LASTING  a single-model target that is not a confident kill (expected
+#                  damage under 2x its wounds) and fights back -> no charge.
+#   CH-LOSING-TRADE  a multi-model target, no confident kill, whose fight-back
+#                  takes more points off the charger than the charge removes
+#                  -> no charge (guardrail s7441 r3: Logan Grimnar 28% at a
+#                  Blade Champion, not charging +0.94 VP).
+# Kept: a confident kill (guardrail s7431 r3: Allarus 28% at a 1-wound Blade
+# Champion, charging measured better), a multi-model target (removed models
+# last), the last battle round, FIX_CHARGE_LOW_ODDS = 0.
+#
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_charge_low_odds.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+const AIDifficultyConfig = preload("res://scripts/AIDifficultyConfig.gd")
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== FIX_CHARGE_LOW_ODDS: long-odds charges weigh the charger's later rounds ===\n")
+	# Competitive: no score noise.
+	AIDecisionMaker._current_difficulty = AIDifficultyConfig.Difficulty.COMPETITIVE
+	AIDecisionMaker._config_overrides["FIX_CHARGE_LOW_ODDS"] = 1.0
+	AIDecisionMaker._charge_coordination.clear()
+	_test_no_lasting_single_model_skipped()
+	_test_overwatch_toll_skipped()
+	_test_losing_trade_skipped()
+	_test_confident_kill_kept()
+	_test_multi_model_target_kept()
+	_test_short_charge_kept()
+	_test_last_round_kept()
+	_test_param_zero_restores_base()
+	AIDecisionMaker._charge_coordination.clear()
+	AIDecisionMaker._config_overrides.erase("FIX_CHARGE_LOW_ODDS")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+# ---------------------------------------------------------------------------
+# Fixtures (40 px per inch, 32 mm bases)
+# ---------------------------------------------------------------------------
+
+func _snapshot(battle_round: int = 2) -> Dictionary:
+	return {
+		"battle_round": battle_round,
+		"meta": {"battle_round": battle_round},
+		"board": {"objectives": [], "terrain_features": [], "deployment_zones": []},
+		"players": {"1": {"cp": 0}, "2": {"cp": 0}},
+		"units": {},
+	}
+
+func _melee(wname: String, ws: int, s: int, ap: int, d: int, a: int) -> Dictionary:
+	return {"name": wname, "type": "Melee", "weapon_skill": str(ws), "strength": str(s),
+		"ap": ("-%d" % ap) if ap > 0 else "0", "damage": str(d), "attacks": str(a)}
+
+func _ranged(wname: String, bs: int, s: int, ap: int, d: int, a: int) -> Dictionary:
+	return {"name": wname, "type": "Ranged", "range": "36", "ballistic_skill": str(bs), "strength": str(s),
+		"ap": ("-%d" % ap) if ap > 0 else "0", "damage": str(d), "attacks": str(a)}
+
+# `n` models in a row from `pos`, 40 px (1") apart.
+func _add(snap: Dictionary, uid: String, owner: int, pos: Vector2, n: int, weapons: Array,
+		points: int, toughness: int = 4, save_val: int = 3, wounds: int = 1, invuln: int = 0,
+		keywords: Array = ["INFANTRY"]) -> Dictionary:
+	var models := []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32, "base_type": "circular",
+			"base_dimensions": {}, "position": Vector2(pos.x + i * 40, pos.y),
+			"wounds": wounds, "current_wounds": wounds})
+	var stats := {"move": 6, "toughness": toughness, "save": save_val, "wounds": wounds,
+		"leadership": 6, "objective_control": 1}
+	if invuln > 0:
+		stats["invuln"] = invuln
+	var u := {"id": uid, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": uid, "display_name": uid, "keywords": keywords, "weapons": weapons,
+			"points": points, "stats": stats},
+		"models": models, "flags": {}}
+	snap.units[uid] = u
+	return u
+
+func _charge_actions(uid: String, tids: Array) -> Array:
+	var acts := []
+	for tid in tids:
+		acts.append({"type": "DECLARE_CHARGE", "actor_unit_id": uid, "payload": {"target_unit_ids": [tid]}})
+	acts.append({"type": "SKIP_CHARGE", "actor_unit_id": uid})
+	acts.append({"type": "END_CHARGE"})
+	return acts
+
+# The s7469 shape: 10 choppa-armed boyz (140 pts, 1 W each) 8.5" (edge to
+# edge) from a lone T7 2+/4++ champion with 7 wounds (175 pts) that hits hard
+# in melee. 32 mm bases are 1.26" across: centres 8.5 + 1.26 = 9.76" apart.
+func _champion_snapshot(champ_wounds: int = 7, battle_round: int = 2) -> Dictionary:
+	var snap := _snapshot(battle_round)
+	_add(snap, "boyz", 2, Vector2(600, 1200), 10, [_melee("Kustom choppa", 3, 5, 2, 2, 4)], 140, 5, 5, 1)
+	var champ := _add(snap, "champ", 1, Vector2(600, 1200 - 9.76 * 40.0), 1,
+		[_melee("Vaultswords", 2, 6, 2, 1, 10)], 175, 7, 2, 7, 4, ["INFANTRY", "CHARACTER"])
+	champ.models[0].current_wounds = champ_wounds
+	return snap
+
+func _decide(snap: Dictionary, uid: String, tids: Array, player: int) -> Dictionary:
+	AIDecisionMaker._charge_coordination.clear()
+	return AIDecisionMaker._decide_charge(snap, _charge_actions(uid, tids), player)
+
+func _declared(d: Dictionary, tid: String) -> bool:
+	return d.get("type", "") == "DECLARE_CHARGE" and tid in d.get("payload", {}).get("target_unit_ids", [])
+
+# ---------------------------------------------------------------------------
+# Skipped
+# ---------------------------------------------------------------------------
+
+func _test_no_lasting_single_model_skipped() -> void:
+	var snap := _champion_snapshot()
+	var dmg := AIDecisionMaker._estimate_melee_damage(snap.units.boyz, snap.units.champ)
+	var p := AIDecisionMaker._charge_success_probability(AIDecisionMaker._charge_roll_needed(
+		AIDecisionMaker._get_closest_model_distance_inches(snap.units.boyz, snap.units.champ)))
+	_assert(dmg >= 7.0 and dmg < 14.0 and p > 0.2 and p < 0.34,
+		"setup: %.1f dmg vs a 7 W lone champion (not a confident kill) at %.0f%%" % [dmg, p * 100.0])
+	var d := _decide(snap, "boyz", ["champ"], 2)
+	_assert(d.get("type", "") == "SKIP_CHARGE",
+		"CH-NO-LASTING: no long-odds charge at a lone champion it is unlikely to kill (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+# The s7467 shape: 3 elite models (270 pts, 6 W each) 9.9" from a 4 W Mek,
+# with an enemy gun line in overwatch range and CP to fire it.
+func _overwatch_snapshot() -> Dictionary:
+	var snap := _snapshot(2)
+	_add(snap, "allarus", 1, Vector2(600, 1200), 3, [_melee("Guardian spear", 2, 7, 2, 2, 5)], 270, 7, 2, 6, 4)
+	_add(snap, "mek", 2, Vector2(600, 1200 - 11.16 * 40.0), 1, [_melee("Spanner", 4, 5, 1, 1, 2)], 60, 5, 4, 4, 0,
+		["INFANTRY", "CHARACTER"])
+	_add(snap, "lootas", 2, Vector2(200, 600), 20, [_ranged("Deffgun", 5, 8, 2, 2, 3)], 200, 5, 5, 1)
+	snap.players["2"]["cp"] = 2
+	return snap
+
+func _test_overwatch_toll_skipped() -> void:
+	var snap := _overwatch_snapshot()
+	var ow: Dictionary = AIDecisionMaker._estimate_overwatch_risk(snap.units.allarus, snap, 1)
+	_assert(float(ow.expected_damage) >= 4.5,
+		"setup: overwatch toll %.1f of the charger's 18 wounds" % float(ow.expected_damage))
+	var d := _decide(snap, "allarus", ["mek"], 1)
+	_assert(d.get("type", "") == "SKIP_CHARGE",
+		"CH-OW-TOLL: no 17%% charge at a 60 pt Mek through a quarter of a 270 pt unit in overwatch (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+func _test_losing_trade_skipped() -> void:
+	# A lone 6 W hero (150 pts) 8.5" from a 5-model elite squad (3 W each,
+	# 250 pts) whose fight-back costs the hero more points than it removes.
+	var snap := _snapshot(2)
+	_add(snap, "hero", 2, Vector2(600, 1200), 1, [_melee("Axe", 2, 8, 3, 2, 8)], 150, 5, 2, 6, 4,
+		["INFANTRY", "CHARACTER"])
+	_add(snap, "guard", 1, Vector2(600, 1200 - 9.76 * 40.0), 5, [_melee("Guardian spear", 3, 5, 2, 1, 5)], 250, 6, 2, 3, 4)
+	var dmg := AIDecisionMaker._estimate_melee_damage(snap.units.hero, snap.units.guard)
+	var back := AIDecisionMaker._estimate_melee_damage(snap.units.guard, snap.units.hero, snap)
+	_assert(dmg * 250.0 / 15.0 < back * 150.0 / 6.0,
+		"setup: removes %.0f pts, the fight-back takes %.0f pts" % [dmg * 250.0 / 15.0, back * 150.0 / 6.0])
+	AIDecisionMaker._config_overrides["FIX_CHARGE_LOW_ODDS"] = 0.0
+	var d0 := _decide(snap, "hero", ["guard"], 2)
+	AIDecisionMaker._config_overrides["FIX_CHARGE_LOW_ODDS"] = 1.0
+	_assert(_declared(d0, "guard"), "setup: the base AI declares this charge (got %s)" % d0.get("type", ""))
+	var d := _decide(snap, "hero", ["guard"], 2)
+	_assert(d.get("type", "") == "SKIP_CHARGE",
+		"CH-LOSING-TRADE: no long-odds charge into a squad that takes more off the charger than it loses (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+# ---------------------------------------------------------------------------
+# Kept (guardrails)
+# ---------------------------------------------------------------------------
+
+func _test_confident_kill_kept() -> void:
+	# Guardrail s7431 r3: the champion is down to 1 wound — the kill lasts.
+	var snap := _champion_snapshot(1)
+	var d := _decide(snap, "boyz", ["champ"], 2)
+	_assert(_declared(d, "champ"), "a confident kill of a wounded champion is still declared (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+func _test_multi_model_target_kept() -> void:
+	# Removed models last: a 5-model squad in the same spot is still charged.
+	var snap := _snapshot(2)
+	_add(snap, "boyz", 2, Vector2(600, 1200), 10, [_melee("Kustom choppa", 3, 5, 2, 2, 4)], 140, 5, 5, 1)
+	_add(snap, "guard", 1, Vector2(600, 1200 - 9.76 * 40.0), 5, [_melee("Spear", 3, 5, 1, 1, 2)], 175, 5, 3, 2)
+	var d := _decide(snap, "boyz", ["guard"], 2)
+	_assert(_declared(d, "guard"), "a long-odds charge at a multi-model squad is not vetoed (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+func _test_short_charge_kept() -> void:
+	# Above the long-odds band (6" away, ~72%): the fix does not apply.
+	var snap := _champion_snapshot()
+	snap.units.champ.models[0].position = Vector2(600, 1200 - 7.26 * 40.0)
+	var d := _decide(snap, "boyz", ["champ"], 2)
+	_assert(_declared(d, "champ"), "a likely charge at the same champion is still declared (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+func _test_last_round_kept() -> void:
+	# Battle round 5: no later rounds for the charger to lose.
+	var snap := _champion_snapshot(7, 5)
+	var d := _decide(snap, "boyz", ["champ"], 2)
+	_assert(_declared(d, "champ"), "round 5: the long-odds charge at the champion is kept (got %s: %s)" % [d.get("type", ""), d.get("_ai_description", "")])
+
+func _test_param_zero_restores_base() -> void:
+	AIDecisionMaker._config_overrides["FIX_CHARGE_LOW_ODDS"] = 0.0
+	var d1 := _decide(_champion_snapshot(), "boyz", ["champ"], 2)
+	var d2 := _decide(_overwatch_snapshot(), "allarus", ["mek"], 1)
