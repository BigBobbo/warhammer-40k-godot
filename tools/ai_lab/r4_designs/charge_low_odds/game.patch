+++ b/40k/scripts/AIDecisionMaker.gd
@@ -1626,6 +1626,44 @@ const CHARGE_RETALIATION_WEIGHT: float = 0.5
 # target without it. 0 = V6 behaviour (every declared charger counts).
 # Off since the round-1 bundle test (2026-10-30, vs V6, 3 fixtures): with it +0.97 [-1.17, +3.12], without it +1.58 [-0.27, +3.42]. Kept for a later test.
 const FIX_CHARGE_EV: float = 0.0
+# Charge (FIX_CHARGE_LOW_ODDS): 1 = a long-odds charge (under
+# CHARGE_LOW_ODDS_MAX_PROB) is not declared when what the charger stands to
+# lose for the rest of the game outweighs what the charge can still win.
+# Score already weights the target's value by the roll, but the "don't
+# charge" bar is a near-zero constant (0.2-0.5 after the early-round,
+# aggression and tempo cuts), so nothing on that side counts the charger's
+# own future: rounds 3-5 of objective holding and secondary actions.
+#   CH-OW-TOLL   overwatch is paid on every declaration, made or failed, and
+#                the wounds never come back: when the expected toll is a
+#                quarter or more of the charger and costs more points than the
+#                charge could win at its odds (target points x chance), skip.
+#   CH-NO-LASTING  a charge at a single model (a character, a lone beast or
+#                vehicle) that is not a confident kill (expected damage under
+#                CHARGE_LOW_ODDS_KILL_CONF x its wounds) wins nothing that
+#                lasts: a wounded model keeps its full OC, actions and attacks,
+#                and the charger ends locked beside it, fighting back, through
+#                the enemy turn and out of its own next turn's objective and
+#                card play. Removed models (a multi-model target) and a
+#                confident kill (the target gone for the rest of the game,
+#                objective and kill cards with it) do last and are never
+#                vetoed, nor is a cheap charger thrown at a far dearer target
+#                (a deliberate tie-up).
+#   CH-LOSING-TRADE  the same charge at a multi-model target that is not a
+#                confident kill: the survivors fight back, so it is declared
+#                only when the points it removes (expected damage x the
+#                target's points per wound) at least match the points the
+#                fight-back takes off the charger (all its points when the
+#                fight-back would destroy it). This also stops a unit
+#                whose real target was vetoed from falling back onto a
+#                marginal second one.
+# Nothing is vetoed in battle round 5: no later rounds to protect.
+# Critic cluster charge_low_odds: Stormboyz 28% at a Blade Champion (+4.33
+# VP not charging, 36 seeds), Allarus 17% at a Mek into 7.2 dmg of
+# overwatch (+2.64). 0 = previous behaviour.
+const FIX_CHARGE_LOW_ODDS: float = 1.0
+const CHARGE_LOW_ODDS_MAX_PROB: float = 0.34  # 9+ on 2D6 (27.8%) and longer
+const CHARGE_LOW_ODDS_KILL_CONF: float = 2.0  # damage / wounds for a confident kill
+const CHARGE_LOW_ODDS_OW_SHARE: float = 0.25  # overwatch toll that matters (share of charger wounds)
 const CHARGE_SHORT_6IN_MULT: float = 1.2  # charge: needs 6" or less (reliability multiplier)
 const CHARGE_TARGET_ON_OBJ_MULT: float = 1.5  # charge: target is standing on an objective
 const DEPLOY_TERRAIN_CHAR_COVER: float = 2.0  # deployment terrain, character: piece grants cover
@@ -16606,6 +16644,20 @@ static func _evaluate_best_charge(snapshot: Dictionary, available_actions: Array
 			if ow_risk.score_penalty < 1.0:
 				score = _t_mul(ch_terms, "ch_overwatch_risk", score, ow_risk.score_penalty)
 
+			# FIX_CHARGE_LOW_ODDS: a long-odds charge whose cost to the charger's
+			# later rounds outweighs what it can still win is not declared.
+			if get_param("FIX_CHARGE_LOW_ODDS", FIX_CHARGE_LOW_ODDS) > 0.0 and score > 0.0:
+				var lo = _charge_low_odds_stake(unit, target_unit, charge_prob, melee_dmg, ow_risk, snapshot, player)
+				if bool(lo.get("veto", false)):
+					print("AIDecisionMaker: [CHARGE_LOW_ODDS] %s -> %s: not declaring (%.0f%% chance, score %.2f): %s" % [
+						unit_name, target_name, charge_prob * 100.0, score, str(lo.get("reason", ""))])
+					_t_add(ch_terms, "ch_low_odds_stake", -score)
+					score = 0.0
+				elif lo.has("kill_ratio"):
+					print("AIDecisionMaker: [CHARGE_LOW_ODDS-EVAL] %s -> %s: kept (%.0f%% chance, kill ratio %.2f, overwatch %.0f pts vs %.0f pts to win, fight-back %.1f vs %.0f wounds)" % [
+						unit_name, target_name, charge_prob * 100.0, float(lo.kill_ratio), float(lo.get("ow_pts", 0.0)),
+						float(lo.get("win_pts", 0.0)), float(lo.get("back", -1.0)), _calculate_kill_threshold(unit)])
+
 			# T7-11: Deadly Demise leverage — doomed vehicles with Deadly Demise
 			# should be strongly encouraged to charge into enemies, since they'll
 			# deal mortal wounds to nearby units when destroyed
@@ -16805,6 +16857,69 @@ static func _evaluate_best_charge(snapshot: Dictionary, available_actions: Array
 
 	return result
 
+## FIX_CHARGE_LOW_ODDS: what a long-odds charge costs the charger for the
+## rest of the game against what it can still win. Returns {veto, reason,
+## ...terms}; veto is false (and nothing is computed) for a charge at
+## CHARGE_LOW_ODDS_MAX_PROB or better. See the FIX_CHARGE_LOW_ODDS const.
+static func _charge_low_odds_stake(charger: Dictionary, target: Dictionary, prob: float,
+		melee_dmg: float, ow_risk: Dictionary, snapshot: Dictionary, player: int) -> Dictionary:
+	var out := {"veto": false, "reason": ""}
+	if prob >= get_param("CHARGE_LOW_ODDS_MAX_PROB", CHARGE_LOW_ODDS_MAX_PROB):
+		return out
+	# The last battle round has no later rounds for the charger to lose.
+	var battle_round = int(snapshot.get("meta", {}).get("battle_round", snapshot.get("battle_round", 1)))
+	if battle_round >= 5:
+		return out
+	var c_hp = _calculate_kill_threshold(charger)
+	var t_hp = _calculate_kill_threshold(target)
+	if c_hp <= 0.0 or t_hp <= 0.0:
+		return out
+	var c_pts = float(charger.get("meta", {}).get("points", 0))
+	var t_pts = float(target.get("meta", {}).get("points", 0))
+	var c_ppw = _get_points_per_wound(charger)
+	var kill_ratio = melee_dmg / t_hp
+	out["kill_ratio"] = kill_ratio
+	# CH-OW-TOLL: paid on the declaration whether the roll makes it or not.
+	var ow_dmg = float(ow_risk.get("expected_damage", 0.0))
+	var ow_pts = minf(ow_dmg, c_hp) * c_ppw
+	var win_pts = prob * t_pts
+	out["ow_pts"] = ow_pts
+	out["win_pts"] = win_pts
+	if ow_dmg >= get_param("CHARGE_LOW_ODDS_OW_SHARE", CHARGE_LOW_ODDS_OW_SHARE) * c_hp and ow_pts > win_pts:
+		out["veto"] = true
+		out["reason"] = "CH-OW-TOLL overwatch %.1f of %.0f wounds (%.0f pts, lost made or failed) > %.0f%% x %.0f pts target" % [
+			ow_dmg, c_hp, ow_pts, prob * 100.0, t_pts]
+		return out
+	# A confident kill lasts (the target is gone for the rest of the game).
+	if kill_ratio >= get_param("CHARGE_LOW_ODDS_KILL_CONF", CHARGE_LOW_ODDS_KILL_CONF):
+		return out
+	# A cheap charger thrown at a far dearer target is a fair gamble (tie-up).
+	if c_pts < 0.5 * t_pts:
+		return out
+	var back = _estimate_melee_damage(target, charger, snapshot)
+	out["back"] = back
+	if back < 1.0:
+		return out
+	if _get_alive_models(target).size() != 1:
+		# CH-LOSING-TRADE: removed models last; so does what the survivors
+		# take off the charger.
+		var removed_pts = minf(melee_dmg, t_hp) * _get_points_per_wound(target)
+		# A charger the fight-back destroys loses all its later rounds (and
+		# hands the enemy its kill): its full points.
+		var lost_pts = c_pts if back >= c_hp else back * c_ppw
+		out["removed_pts"] = removed_pts
+		out["lost_pts"] = lost_pts
+		if lost_pts > removed_pts:
+			out["veto"] = true
+			out["reason"] = "CH-LOSING-TRADE no confident kill (%.1f dmg vs %.0f wounds) removes %.0f pts, the fight-back (%.1f dmg) takes %.0f pts off the charger" % [
+				melee_dmg, t_hp, removed_pts, back, lost_pts]
+		return out
+	# CH-NO-LASTING: a single model that survives and fights back.
+	out["veto"] = true
+	out["reason"] = "CH-NO-LASTING single-model target, no confident kill (%.1f dmg vs %.0f wounds, x%.2f) and it fights back for %.1f — nothing lasting for a locked charger" % [
+		melee_dmg, t_hp, kill_ratio, back]
+	return out
+
 # The 2D6 result a charge against a target `edge_in` inches away (base to base)
 # needs, with `terrain_pen` inches of terrain penalty on the approach.
 #   11e: max(edge_in, move) — Core 11.04 BEFORE MOVING: a charge target must be
