diff --git a/40k/tests/unit/test_ai_fix_keeper_reach.gd b/40k/tests/unit/test_ai_fix_keeper_reach.gd
new file mode 100644
index 0000000..f94b5c8
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_keeper_reach.gd
@@ -0,0 +1,159 @@
+extends SceneTree
+
+# KEEPER-REACH (FIX_KEEPER_REACH): the sole keeper of an objective is valued by
+# what its move actually costs. When a Normal move toward its best objective
+# elsewhere still ends with OC in range of the objective it holds, "leaving
+# would drop control" is false: it moves and keeps the objective. LLM-critic
+# cluster keeper_reach (value-checked, 2026-10-30, Custodes mirror round 1): a
+# Custodian Guard unit stood on home although a move toward the centre kept it
+# on home's terrain area (+6.17 VP [3.42, 8.91], 36 rollouts). Guardrails: a
+# move that leaves the objective, or a threatened objective, keep it holding.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_keeper_reach.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const HOME := Vector2(510, 340)      # our home objective (player 1 zone)
+const NML := Vector2(890, 860)       # a no man's land objective ~16" away
+const ENEMY_HOME := Vector2(1250, 2060)
+
+# Determined Acquisition: per_objective counts home.
+const ACQ_RULES := [
+	{"type": "per_new_objective", "vp_per": 2, "when": "eot"},
+	{"type": "per_objective", "exclude_home": false, "vp_per": 3, "when": "command", "rounds": [2, 5]},
+]
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Sole keeper valued by what its move costs (KEEPER-REACH) ===\n")
+	AIDecisionMaker._config_overrides["FIX_KEEPER_REACH"] = 1.0
+	test_keeper_moves_when_the_move_keeps_home()
+	test_keeper_holds_when_the_move_leaves_home()
+	test_keeper_holds_when_the_enemy_is_on_its_way()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_KEEPER_REACH")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot(nml_pos: Vector2 = NML) -> Dictionary:
+	return {"battle_round": 1, "meta": {"battle_round": 1, "first_turn_player": 1},
+		"board": {"objectives": [
+			{"id": "obj_home_1", "position": HOME, "zone": "player1"},
+			{"id": "obj_nml_1", "position": nml_pos, "zone": "no_mans_land"},
+			{"id": "obj_home_2", "position": ENEMY_HOME, "zone": "player2"},
+		], "terrain_features": []}, "units": {}}
+
+# Models (OC `oc` each) at `positions`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, positions: Array,
+		toughness: int, wounds: int, oc: int, move: int, points: int) -> void:
+	var models = []
+	for i in range(positions.size()):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 40,
+			"base_type": "circular", "base_dimensions": {},
+			"position": positions[i], "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": points, "stats": {"move": move, "toughness": toughness, "save": 2,
+			"wounds": wounds, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+# A line of 3 models along home -> obj_nml_1, centred `back_px` behind home
+# (on the far side from obj_nml_1).
+func _line(back_px: float) -> Array:
+	var dir := (NML - HOME).normalized()
+	var c := HOME - dir * back_px
+	return [c - dir * 45.0, c, c + dir * 45.0]
+
+# A line of 3 models across home -> obj_nml_1, centred on home.
+func _across() -> Array:
+	var perp := (NML - HOME).normalized().orthogonal()
+	return [HOME - perp * 45.0, HOME, HOME + perp * 45.0]
+
+# keeper: a 240 pt Custodian Guard unit (M6); backup: a squad that can step
+# onto home in one move; the enemy far away unless `enemy_pos` says otherwise.
+func _board(keeper_positions: Array, enemy_pos: Vector2 = ENEMY_HOME, enemy_move: int = 6,
+		nml_pos: Vector2 = NML) -> Dictionary:
+	var snap = _snapshot(nml_pos)
+	_add_unit(snap, "keeper", 1, keeper_positions, 7, 5, 3, 6, 240)
+	var b := HOME + Vector2(-300, -250)
+	_add_unit(snap, "backup", 1, [b, b + Vector2(45, 0), b + Vector2(90, 0), b + Vector2(135, 0)], 3, 1, 2, 7, 45)
+	_add_unit(snap, "enemy", 2, [enemy_pos], 7, 5, 2, enemy_move, 80)
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, rules: Array) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p1 = {"card_name": "test", "active_rules": rules.size(), "vp_rules": rules.duplicate(true),
+		"objective_pressure": 0.0, "enemy_home_bonus": 0.0, "central_bonus": 0.0, "hold_home_required": false,
+		"kill_pressure": false, "quarters": false}
+	AIDecisionMaker._secondary_awareness_p1 = {}
+	var friendlies = {}
+	var enemies = {}
+	var movable = {}
+	for uid in snap.units:
+		var u = snap.units[uid]
+		if int(u.owner) == 1:
+			friendlies[uid] = u
+		else:
+			enemies[uid] = u
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 1, enemies, friendlies, 1)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 1, 1)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for c in AIDecisionMaker._last_movement_candidates.get("keeper", []):
+		print("    keeper candidate %s %s score %.1f" % [c.get("action", ""), c.get("objective_id", ""), float(c.get("score", 0.0))])
+	AIDecisionMaker._primary_awareness_p1 = {}
+	return plan
+
+func _holds_home(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("keeper", {})
+	return str(a.get("objective_id", "")) == "obj_home_1" and str(a.get("action", "")) == "hold"
+
+func _goes_forward(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("keeper", {})
+	return str(a.get("objective_id", "")) == "obj_nml_1" and str(a.get("action", "")) in ["move", "advance"]
+
+func test_keeper_moves_when_the_move_keeps_home() -> void:
+	print("\n--- home counts for the card; the keeper stands on home's far side: a 6\" move still ends in range ---")
+	var plan = _plan(_board(_line(130.0)), ["keeper"], ACQ_RULES)
+	_assert(_goes_forward(plan), "the keeper moves toward obj_nml_1 (%s %s)" % [
+		plan.get("keeper", {}).get("action", ""), plan.get("keeper", {}).get("objective_id", "")])
+	_assert(str(plan.get("keeper", {}).get("action", "")) == "move", "with a Normal move (an Advance would leave home)")
+	_assert(str(plan.get("keeper", {}).get("assign_pass", "")) == "keeper_reach", "the plan says why (%s)" % str(plan.get("keeper", {}).get("assign_pass", "")))
+	_assert(str(plan.get("keeper", {}).get("keeper_reach_home", "")) == "obj_home_1", "the executor is told to keep obj_home_1")
+
+func test_keeper_holds_when_the_move_leaves_home() -> void:
+	print("\n--- same, but the keeper stands across home's centre: a 6\" move leaves home ---")
+	var plan = _plan(_board(_across()), ["keeper"], ACQ_RULES)
+	_assert(_holds_home(plan), "the keeper holds (a move would drop home) (%s %s)" % [
+		plan.get("keeper", {}).get("action", ""), plan.get("keeper", {}).get("objective_id", "")])
+
+func test_keeper_holds_when_the_enemy_is_on_its_way() -> void:
+	print("\n--- keeper on home's far side, but an enemy unit stands next to home (it is threatened) ---")
+	var plan = _plan(_board(_line(130.0), HOME + Vector2(0, 8.0 * PX)), ["keeper"], ACQ_RULES)
+	_assert(not (str(plan.get("keeper", {}).get("assign_pass", "")) == "keeper_reach"),
+		"a threatened home is not left to a move that keeps only part of the OC (%s %s)" % [
+		plan.get("keeper", {}).get("action", ""), plan.get("keeper", {}).get("objective_id", "")])
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_KEEPER_REACH = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_KEEPER_REACH"] = 0.0
+	var plan = _plan(_board(_line(130.0)), ["keeper"], ACQ_RULES)
+	AIDecisionMaker._config_overrides["FIX_KEEPER_REACH"] = 1.0
+	_assert(_holds_home(plan), "the keeper on home's far side holds as before")
