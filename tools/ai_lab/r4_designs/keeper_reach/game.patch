+			{"id": "obj_nml_2", "position": FAR_NML, "zone": "no_mans_land"},
+			{"id": "obj_home_2", "position": ENEMY_HOME, "zone": "player2"},
+		], "terrain_features": []}, "units": {}}
+
+# `n` models (OC `oc` each) whose centroid is at `pos`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		toughness: int, wounds: int, oc: int, move: int, points: int,
+		status: int = GameStateData.UnitStatus.DEPLOYED) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 40,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": status,
+		"meta": {"name": unit_id, "points": points, "stats": {"move": move, "toughness": toughness, "save": 2,
+			"wounds": wounds, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+# The s7453/s7454 shape: a 240 pt Custodian Guard unit alone on home, nobody
+# within one move of it, a unit of ours in reserves, an enemy M6 unit 24"+
+# from home (inside the max-roll 6+12+6" reach, outside Move + 12").
+func _board(enemy_inches: float = 24.5, battle_round: int = 1, with_reserve: bool = true,
+		first_turn_player: int = 1) -> Dictionary:
+	var snap = _snapshot(battle_round, first_turn_player)
+	_add_unit(snap, "keeper", 1, HOME, 3, 7, 5, 3, 8, 240)
+	if with_reserve:
+		_add_unit(snap, "allarus", 1, Vector2.ZERO, 3, 7, 4, 2, 7, 195, GameStateData.UnitStatus.IN_RESERVES)
+	# nearest model ~`enemy_inches` from home's centre
+	_add_unit(snap, "guard_p2", 2, HOME + ENEMY_DIR.normalized() * (enemy_inches * PX) + Vector2(45, 0), 3, 7, 5, 3, 6, 240)
+	return snap
+
+func _plan(snap: Dictionary, rules: Array, secondary_hints: Array = []) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p1 = {"card_name": "test", "active_rules": rules.size(), "vp_rules": rules.duplicate(true),
+		"objective_pressure": 0.0, "enemy_home_bonus": 0.0, "central_bonus": 0.0, "hold_home_required": false,
+		"kill_pressure": false, "quarters": false}
+	AIDecisionMaker._secondary_awareness_p1 = {} if secondary_hints.is_empty() else {"vp_objective_hints": secondary_hints.duplicate(true)}
+	var friendlies = {}
+	var enemies = {}
+	var movable = {}
+	for uid in snap.units:
+		var u = snap.units[uid]
+		if int(u.owner) == 1:
+			friendlies[uid] = u
+		elif int(u.status) != GameStateData.UnitStatus.IN_RESERVES:
+			enemies[uid] = u
+	movable["keeper"] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var br := int(snap.meta.battle_round)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 1, enemies, friendlies, br)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 1, br)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for c in AIDecisionMaker._last_movement_candidates.get("keeper", []):
+		print("    keeper candidate %s %s score %.1f" % [c.get("action", ""), c.get("objective_id", ""), float(c.get("score", 0.0))])
+	AIDecisionMaker._primary_awareness_p1 = {}
+	AIDecisionMaker._secondary_awareness_p1 = {}
+	return plan
+
+func _holds_home(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("keeper", {})
+	return str(a.get("objective_id", "")) == "obj_home_1" and str(a.get("action", "")) == "hold"
+
+func _normal_move_forward(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("keeper", {})
+	return str(a.get("objective_id", "")) == "obj_nml_1" and str(a.get("action", "")) == "move" \
+		and str(a.get("assign_pass", "")) == "keeper_release"
+
+func test_keeper_leaves_when_only_the_max_roll_reach_holds_it() -> void:
+	print("\n--- round 1, Immovable Object, enemy M6 24.5\" away, a unit of ours in reserves ---")
+	var plan = _plan(_board(), IMMOVABLE_RULES)
+	_assert(_normal_move_forward(plan), "the keeper leaves home for obj_nml_1 by Normal move (%s %s [%s])" % [
+		plan.get("keeper", {}).get("action", ""), plan.get("keeper", {}).get("objective_id", ""), plan.get("keeper", {}).get("assign_pass", "")])
+	_assert(str(plan.get("keeper", {}).get("coordination_note", "")).find("from reserves") >= 0,
+		"its card names the reserve unit that re-takes home (%s)" % str(plan.get("keeper", {}).get("coordination_note", "")))
+
+func test_keeper_holds_when_the_enemy_can_walk_onto_home() -> void:
+	print("\n--- same, enemy M6 18\" away (Move + 12\" reaches home's range) ---")
+	var plan = _plan(_board(18.0), IMMOVABLE_RULES)
+	_assert(_holds_home(plan), "an enemy that can move onto home next turn keeps the keeper")
+
+func test_keeper_holds_when_a_unit_left_near_home_can_be_charged() -> void:
+	print("\n--- same as the first, but a unit of ours stands 6\" from home toward the enemy (it can be charged) ---")
+	var snap = _board()
+	_add_unit(snap, "servitors", 1, HOME + ENEMY_DIR.normalized() * (6.0 * PX), 1, 4, 3, 1, 5, 30)
+	var plan = _plan(snap, IMMOVABLE_RULES)
+	_assert(_holds_home(plan), "an enemy that can charge a unit of ours near home and consolidate onto it keeps the keeper")
+
+func test_keeper_holds_without_reserves_or_a_backup() -> void:
+	print("\n--- same as the first, no unit in reserves ---")
+	var plan = _plan(_board(24.5, 1, false), IMMOVABLE_RULES)
+	_assert(_holds_home(plan), "with nobody to re-take home, the keeper holds")
+
+func test_round_two_enemy_strategic_reserves_cannot_reach_home() -> void:
+	print("\n--- going second (enemy's next turn is round 2), enemy unit in Strategic Reserves ---")
+	var snap = _board(24.5, 1, true, 2)
+	_add_unit(snap, "bikes_p2", 2, Vector2.ZERO, 3, 5, 2, 2, 12, 120, GameStateData.UnitStatus.IN_RESERVES)
+	snap.units["bikes_p2"]["reserve_type"] = "strategic_reserves"
+	var plan = _plan(snap, IMMOVABLE_RULES)
+	_assert(_normal_move_forward(plan), "Strategic Reserves cannot be set up in our zone in round 2: the keeper leaves (%s %s)" % [
+		plan.get("keeper", {}).get("action", ""), plan.get("keeper", {}).get("objective_id", "")])
+
+func test_round_two_enemy_deep_strike_keeps_the_keeper() -> void:
+	print("\n--- going second, enemy unit in reserves that can Deep Strike ---")
+	var snap = _board(24.5, 1, true, 2)
+	_add_unit(snap, "allarus_p2", 2, Vector2.ZERO, 3, 7, 4, 2, 7, 195, GameStateData.UnitStatus.IN_RESERVES)
+	snap.units["allarus_p2"]["reserve_type"] = "deep_strike"
+	snap.units["allarus_p2"].meta["abilities"] = ["Deep Strike"]
+	var plan = _plan(snap, IMMOVABLE_RULES)
+	_assert(_holds_home(plan), "a Deep Strike unit can land on our empty home next turn: the keeper holds")
+
+func test_priced_home_primary_releases_a_big_gain() -> void:
+	print("\n--- Determined Acquisition (home pays 3 VP a scoring), enemy far away ---")
+	var plan = _plan(_board(40.0), DETERMINED_RULES)
+	var a: Dictionary = plan.get("keeper", {})
+	var cands: Array = AIDecisionMaker._last_movement_candidates.get("keeper", [])
+	var hold_score := -INF
+	var best := -INF
+	for c in cands:
+		if str(c.get("action", "")) == "hold":
+			hold_score = float(c.score)
+		elif str(c.get("objective_id", "")) != "obj_home_1":
+			best = maxf(best, float(c.score))
+	var min_gain := float(AIDecisionMaker.KEEPER_RELEASE_MIN_GAIN)
+	print("  hold %.1f, best elsewhere %.1f" % [hold_score, best])
+	if best >= hold_score + min_gain + 3.0:
+		_assert(_normal_move_forward(plan), "gain %.1f >= %.1f + 3 VP: the keeper leaves by Normal move" % [best - hold_score, min_gain])
+	else:
+		_assert(_holds_home(plan), "gain %.1f < %.1f + 3 VP: the keeper holds" % [best - hold_score, min_gain])
+
