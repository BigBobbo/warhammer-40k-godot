+extends SceneTree
+
+# KEEPER-REACH (FIX_KEEPER_REACH): in battle round 1 KEEPER-RELEASE also frees
+# the sole keeper of our home objective when only its worst cases hold it
+# back — the max-roll threat reach (Move + 12" + 6"), a backup that must step
+# onto home in one move (a unit in reserves re-takes it too), or a primary
+# card that pays for home (priced: the target must beat holding by the margin
+# plus home's VP for one scoring). Released this way the keeper makes a Normal
+# move to the objective it reaches soonest among those that beat holding.
+# LLM-critic cluster keeper_reach (value-checked, 2026-10-30): in the Custodes
+# mirror a Custodian Guard unit held home in round 1 with the enemy 23-30"
+# away; moving it to the centre measured +6.17 VP [3.42, 8.91] (s7453) and
+# +4.83 [3.08, 6.59] (s7454), 36 rollouts each.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_keeper_reach.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const HOME := Vector2(510, 340)      # our home objective (player 1 zone)
+const NML := Vector2(890, 560)       # a no man's land objective ~11" away
+const FAR_NML := Vector2(1370, 660)  # a no man's land objective ~23" away
+const ENEMY_HOME := Vector2(1250, 2060)
+const ENEMY_DIR := Vector2(-400, 900)  # from home, away from the no man's land objectives
+
+# Immovable Object: centre + per_objective that excludes home.
+const IMMOVABLE_RULES := [
+	{"type": "hold_central", "vp": 3, "when": "eot"},
+	{"type": "per_objective", "exclude_home": true, "vp_per": 5, "when": "command", "rounds": [2, 5]},
+]
+# Determined Acquisition: per_objective counts home (3 VP a scoring).
+const DETERMINED_RULES := [
+	{"type": "per_new_objective", "vp_per": 2, "when": "eot"},
+	{"type": "per_objective", "exclude_home": false, "vp_per": 3, "when": "command", "rounds": [2, 5]},
+	{"type": "per_objective", "vp_per": 3, "zone": "enemy_territory", "when": "command", "rounds": [2, 5]},
+]
+# A per-objective rule that only pays while home is held.
+const HOME_REQUIRED_RULES := [
+	{"type": "per_objective", "exclude_home": true, "require_hold_home": true, "vp_per": 3, "when": "command", "rounds": [2, 5]},
+]
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Sole keeper held back only by worst cases (KEEPER-REACH) ===\n")
+	AIDecisionMaker._config_overrides["FIX_KEEPER_REACH"] = 1.0
+	test_keeper_leaves_when_only_the_max_roll_reach_holds_it()
+	test_keeper_holds_when_the_enemy_can_walk_onto_home()
+	test_keeper_holds_when_a_unit_left_near_home_can_be_charged()
+	test_keeper_holds_without_reserves_or_a_backup()
+	test_round_two_enemy_strategic_reserves_cannot_reach_home()
+	test_round_two_enemy_deep_strike_keeps_the_keeper()
+	test_priced_home_primary_releases_a_big_gain()
+	test_home_required_primary_keeps_the_keeper()
+	test_secondary_that_pays_for_home_keeps_the_keeper()
+	test_round_two_is_the_base_rule()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_KEEPER_REACH")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
