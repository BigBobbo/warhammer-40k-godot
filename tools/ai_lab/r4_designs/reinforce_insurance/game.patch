+func _board(beta_gun: Dictionary = ASSAULT_GUN) -> Dictionary:
+	var snap = {"battle_round": 2, "meta": {"battle_round": 2},
+		"board": {"objectives": [{"id": "obj_x", "position": OBJ_X, "zone": "no_mans_land"},
+			{"id": "obj_side", "position": OBJ_SIDE, "zone": "no_mans_land"}], "terrain_features": []},
+		"units": {}}
+	_add_unit(snap, "holder", 2, OBJ_X, 3, 2)
+	_add_unit(snap, "q0", 2, Vector2(300, 300), 3, 1)
+	_add_unit(snap, "q1", 2, Vector2(1450, 300), 3, 1)
+	_add_unit(snap, "beta", 2, BETA_POS, 3, 3, 8, ["INFANTRY"], [beta_gun])
+	_add_unit(snap, "wagon", 1, Vector2(1350, 1560), 1, 5, 10, ["VEHICLE"])
+	_add_unit(snap, "mek", 1, Vector2(1160, 1500), 1, 1, 6, ["INFANTRY", "CHARACTER"])
+	_add_unit(snap, "boss", 1, Vector2(1250, 1440), 1, 1, 6, ["INFANTRY", "CHARACTER"])
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, recon: bool = true) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {"card_name": "Reconnaissance Sweep", "objective_pressure": 0.0,
+		"enemy_home_bonus": 0.0, "central_bonus": 0.0, "hold_home_required": false, "kill_pressure": false,
+		"quarters": true, "active_rules": 2, "vp_rules": RECON_RULES.duplicate(true)} if recon else {}
+	AIDecisionMaker._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var enemies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+		else:
+			enemies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 2)
+	for ev in evals:
+		print("  %s: %s, ours %d, theirs %d, ~%d enemy OC one move away" % [ev.id, ev.state,
+			int(ev.friendly_oc), int(ev.enemy_oc), int(ev.get("projected_enemy_oc", 0))])
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 2)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for uid in movable_ids:
+		for c in AIDecisionMaker._last_movement_candidates.get(uid, []):
+			print("    %s -> %s: %s score %.1f (quarter_vp %.1f, secondary_spread %.1f), %d turn(s)" % [uid, c.objective_id,
+				c.action, float(c.score), float(c.get("score_terms", {}).get("quarter_vp", 0.0)),
+				float(c.get("score_terms", {}).get("secondary_spread", 0.0)), int(c.turns_to_reach)])
+	return plan
+
+func _does(plan: Dictionary, uid: String) -> String:
+	var a: Dictionary = plan.get(uid, {})
+	return "%s %s" % [str(a.get("action", "")), str(a.get("objective_id", ""))]
+
+func _with_fix(value: float, snap: Dictionary, movable_ids: Array, recon: bool = true) -> Dictionary:
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = value
+	var plan = _plan(snap, movable_ids, recon)
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0
+	return plan
+
+func test_advances_into_uncovered_quarter_instead_of_reinforcing() -> void:
+	print("\n--- Recon Sweep, 2 quarters covered; beta can reinforce the centre or Advance into quarter 2 ---")
+	var plan = _plan(_board(), ["beta"])
+	_assert(_does(plan, "beta") == "advance obj_side",
+		"beta Advances toward obj_side into the uncovered quarter (3rd quarter = 3 VP every turn): %s" % _does(plan, "beta"))
+	var term := 0.0
+	for c in AIDecisionMaker._last_movement_candidates.get("beta", []):
+		if c.objective_id == "obj_side":
+			term = float(c.get("score_terms", {}).get("quarter_vp", 0.0))
+	_assert(term > 20.0, "its obj_side candidate carries the quarter's card value (quarter_vp %.1f)" % term)
+
+func test_no_quarter_card_no_change() -> void:
+	print("\n--- no quarter card: the fix changes nothing ---")
+	var on = _plan(_board(), ["beta"], false)
+	var off = _with_fix(0.0, _board(), ["beta"], false)
+	_assert(_does(on, "beta") == _does(off, "beta"), "same plan with and without the fix (%s / %s)" % [_does(on, "beta"), _does(off, "beta")])
+
+func test_quarter_already_covered_no_change() -> void:
+	print("\n--- quarter 2 already covered by another unit of ours ---")
