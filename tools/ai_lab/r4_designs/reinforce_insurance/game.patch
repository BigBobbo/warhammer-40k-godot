+	for c in AIDecisionMaker._last_movement_candidates.get("beta", []):
+		term = maxf(term, float(c.get("score_terms", {}).get("quarter_vp", 0.0)))
+	_assert(term == 0.0, "no candidate gets quarter_vp (max %.1f)" % term)
