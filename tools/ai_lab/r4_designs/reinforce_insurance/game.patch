+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_REINFORCE_INSURANCE = 0 ---")
+	var off = _with_fix(0.0, _board(), ["beta"])
+	_assert(not _does(off, "beta").begins_with("advance"), "with the fix off beta does not Advance into the quarter: %s" % _does(off, "beta"))
+	var spread := 0.0
+	var qv := 0.0
+	for c in AIDecisionMaker._last_movement_candidates.get("beta", []):
+		spread = maxf(spread, float(c.get("score_terms", {}).get("secondary_spread", 0.0)))
+		qv = maxf(qv, float(c.get("score_terms", {}).get("quarter_vp", 0.0)))
