+extends SceneTree
+
+# REINFORCE_INSURANCE / QUARTER-VP (FIX_REINFORCE_INSURANCE): a table quarter is
+# priced at the VP the player's cards pay for it, at the pace the unit would
+# travel. LLM-critic cluster reinforce_insurance (value-checked, 2026-10-30,
+# s7437 r2): under Reconnaissance Sweep (3 quarters 3 VP, 4 quarters 6 VP at the
+# end of every turn) Custodian Guard Beta reinforced a centre held with OC 6
+# instead of Advancing into the uncovered bottom-left quarter toward obj_nml_2.
+# The Advance measured +4.36 VP over 36 seeds, every gain from the 3-quarter
+# tier; walking there stopped on the quarter line (-4.0). The flat 4.2
+# secondary_spread bonus was the only quarter term, and its Guardian Spear
+# ([ASSAULT]) made RACE-1 refuse the free Advance.
+# Checks: the unit Advances into the uncovered quarter when its gun is
+# [ASSAULT]; nothing changes without a quarter card, when another unit already
+# covers the quarter, or when the Advance would give up shooting; a holder that
+# gives the 3rd quarter gets the quarter's value for staying; 0 = base.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_reinforce_insurance.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const OBJ_X := Vector2(880, 1200)      # the centre: held by a locked unit
+const OBJ_SIDE := Vector2(390, 1740)   # bottom-left quarter (2), ~21" from beta
+const BETA_POS := Vector2(520, 900)    # top-left quarter (0), 11.7" from obj_x: in reach this turn
+const RECON_RULES := [
+	{"when": "eot", "type": "quarters", "min": 3, "vp": 3, "exclusive_group": "quarters_tier"},
+	{"when": "eot", "type": "quarters", "min": 4, "vp": 6, "exclusive_group": "quarters_tier"},
+]
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Table quarters priced at their card VP (REINFORCE_INSURANCE / QUARTER-VP) ===\n")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0  # pin the fix on, whatever the default
+	test_advances_into_uncovered_quarter_instead_of_reinforcing()
+	test_no_quarter_card_no_change()
+	test_quarter_already_covered_no_change()
+	test_no_free_advance_no_change()
+	test_holder_giving_third_quarter_keeps_value()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_REINFORCE_INSURANCE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+const ASSAULT_GUN := {"name": "spear", "type": "Ranged", "range": "24", "attacks": "2",
+	"ballistic_skill": "2", "strength": "4", "ap": "-1", "damage": "2", "special_rules": "assault, rapid fire 2"}
+
+# `n` models (OC `oc` each) in a row centred on `pos`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int, oc: int,
+		move: int = 8, keywords: Array = ["INFANTRY"], weapons: Array = []) -> void:
+	var models = []
