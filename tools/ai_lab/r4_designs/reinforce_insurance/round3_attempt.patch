+	if not _should_unit_advance_long_trip(unit, gives_up_shooting, _get_max_weapon_range(unit),
+			enemies, _get_unit_centroid(unit)):
+		return alt
+	var paced := alt.duplicate()
+	paced["action"] = "advance"
+	paced["reason"] = "advancing to arrive a turn sooner"
+	paced["turns_to_reach"] = maxf(1.0, ceilf(gap_in / (move_in + get_param("ADVANCE_EXPECTED_EXTRA_INCHES", ADVANCE_EXPECTED_EXTRA_INCHES))))
+	return paced
