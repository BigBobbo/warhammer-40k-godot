diff --git a/40k/tests/unit/test_ai_fix_reinforce_cap.gd b/40k/tests/unit/test_ai_fix_reinforce_cap.gd
new file mode 100644
index 0000000..da2ce1c
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_reinforce_cap.gd
@@ -0,0 +1,216 @@
+extends SceneTree
+
+# REINFORCE-CAP (FIX_REINFORCE_CAP): a unit that would arrive THIS turn to
+# reinforce an objective we already hold is priced as insurance, not as the
+# objective's full value. LLM-critic cluster reinforce_cap (value-checked,
+# 2026-10-30, s7437 r2): Allarus Custodians held the centre with OC 6; a
+# Battlewagon (OC 5) and two characters (OC 1 each) were one move away (~7 OC),
+# so COORD-5 asked for 2 more OC and pass 2 sent Custodian Guard Beta — scored
+# with the centre's full hold value — instead of Advancing on obj_nml_2
+# (+7.75 VP [1.97, 13.53] over 12 seeds, +4.36 over 36). No single enemy unit
+# could contest the centre alone and the enemy needed all ~7 OC there to flip
+# it. The freed unit Advances on a long trip when that costs it nothing —
+# [ASSAULT] ranged weapons count as no cost (Beta walking there instead
+# measured -4.0 VP over 4 seeds: it stopped on the table-quarter line).
+# The reinforcement still happens when one enemy unit can contest the
+# objective alone, when the enemy needs only part of its projected OC, and
+# when the unit has nothing better to do; a unit with less to gain elsewhere
+# still takes the insurance.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_reinforce_cap.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const OBJ_X := Vector2(880, 1200)     # the objective our locked holder keeps
+const OBJ_SIDE := Vector2(300, 1900)  # an open objective two moves from beta
+const BETA_POS := Vector2(880, 1640)  # 11" below obj_x: reaches it this turn (M8)
+const GAMMA_POS := Vector2(1260, 1440)  # 11" from obj_x, 25" from obj_side
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Reinforcing a held objective against a weak threat (REINFORCE-CAP) ===\n")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_CAP"] = 1.0  # pin the fix on, whatever the default
+	test_reinforcer_takes_open_objective_when_threat_is_weak()
+	test_one_unit_that_can_contest_alone_is_still_covered()
+	test_threat_needing_part_of_the_projection_is_still_covered()
+	test_reinforces_when_nothing_better_needs_it()
+	test_insurance_left_to_unit_with_less_to_gain()
+	test_freed_unit_advances_when_its_guns_are_assault()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_REINFORCE_CAP")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot(with_side: bool = true) -> Dictionary:
+	var objs = [{"id": "obj_x", "position": OBJ_X, "zone": "no_mans_land"}]
+	if with_side:
+		objs.append({"id": "obj_side", "position": OBJ_SIDE, "zone": "no_mans_land"})
+	return {"battle_round": 2, "meta": {"battle_round": 2},
+		"board": {"objectives": objs, "terrain_features": []}, "units": {}}
+
+# `n` durable models (T6, 3 wounds, OC `oc` each) whose centroid is at `pos`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int, oc: int,
+		move: int = 8, keywords: Array = ["INFANTRY"], weapons: Array = []) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 40,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 50.0, pos.y), "wounds": 3, "current_wounds": 3})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": 200, "stats": {"move": move, "toughness": 6, "save": 2,
+			"wounds": 3, "leadership": 6, "objective_control": oc}, "keywords": keywords, "weapons": weapons},
+		"models": models, "flags": {}}
+
+# Our side (player 2): a 3-model OC 2 holder on obj_x that is NOT moving this
+# phase (6 OC), and beta, a 3-model OC 3 squad (9 OC) 11" below obj_x.
+# The enemy (player 1), none in control range of obj_x yet:
+#   "weak"   — the s7437 threat: a vehicle (OC 5) 13.6" away and two
+#              characters (OC 1) 9" and 11" away: 7 OC, largest unit 5.
+#   "single" — one 4-model OC 2 squad (8 OC) 9" away: it contests alone.
+#   "heavy"  — three 1-model OC 5 vehicles 9-13.6" away (15 OC, largest 5).
+func _board(enemies: Dictionary, threat: String, with_side: bool = true) -> Dictionary:
+	var snap = _snapshot(with_side)
+	_add_unit(snap, "holder", 2, OBJ_X, 3, 2)
+	_add_unit(snap, "beta", 2, BETA_POS, 3, 3)
+	var placed: Array = []
+	match threat:
+		"weak":
+			placed = [["wagon", Vector2(1200, 760), 1, 5, 10, ["VEHICLE"]],
+				["mek", Vector2(880, 840), 1, 1, 6, ["INFANTRY", "CHARACTER"]],
+				["boss", Vector2(720, 790), 1, 1, 6, ["INFANTRY", "CHARACTER"]]]
+		"single":
+			placed = [["squad", Vector2(880, 840), 4, 2, 6, ["INFANTRY"]]]
+		"heavy":
+			placed = [["wagon_a", Vector2(1200, 760), 1, 5, 10, ["VEHICLE"]],
+				["wagon_b", Vector2(880, 840), 1, 5, 10, ["VEHICLE"]],
+				["wagon_c", Vector2(560, 760), 1, 5, 10, ["VEHICLE"]]]
+	for p in placed:
+		_add_unit(snap, p[0], 1, p[1], p[2], p[3], p[4], p[5])
+		enemies[p[0]] = snap.units[p[0]]
+	return snap
+
+# sec: the player's secondary-mission awareness ({} = no secondary cards).
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary, sec: Dictionary = {}) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {}
+	AIDecisionMaker._secondary_awareness_p2 = sec
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 2)
+	for ev in evals:
+		print("  %s: %s, ours %d, theirs %d, ~%d enemy OC one move away (largest unit %d)" % [ev.id, ev.state,
+			int(ev.friendly_oc), int(ev.enemy_oc), int(ev.get("projected_enemy_oc", 0)), int(ev.get("projected_max_oc", -1))])
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 2)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for uid in movable_ids:
+		for c in AIDecisionMaker._last_movement_candidates.get(uid, []):
+			print("    %s -> %s: %s score %.1f (objective_priority %.1f), %d turn(s)" % [uid, c.objective_id,
+				c.action, float(c.score), float(c.get("score_terms", {}).get("objective_priority", 0.0)), int(c.turns_to_reach)])
+	return plan
+
+func _goes_to(plan: Dictionary, uid: String, oid: String) -> bool:
+	var a: Dictionary = plan.get(uid, {})
+	return str(a.get("objective_id", "")) == oid and str(a.get("action", "")) in ["move", "advance"]
+
+# Sent there by the objective passes (not as a leftover "support" unit).
+func _captures(plan: Dictionary, uid: String, oid: String) -> bool:
+	return _goes_to(plan, uid, oid) and str(plan.get(uid, {}).get("assign_pass", "")) == "capture"
+
+func test_reinforcer_takes_open_objective_when_threat_is_weak() -> void:
+	print("\n--- obj_x held with OC 6; ~7 enemy OC one move away, no unit of it can contest alone ---")
+	var enemies = {}
+	var snap = _board(enemies, "weak")
+	var plan = _plan(snap, ["beta"], enemies)
+	_assert(not _goes_to(plan, "beta", "obj_x"), "beta is not sent to reinforce obj_x (the enemy needs all ~7 OC there to flip it)")
+	_assert(_goes_to(plan, "beta", "obj_side"), "beta takes the open objective obj_side instead")
+	_assert(str(plan.get("beta", {}).get("coordination_note", "")).begins_with("not reinforcing obj_x"),
+		"its card says why (%s)" % str(plan.get("beta", {}).get("coordination_note", "")))
+
+func test_one_unit_that_can_contest_alone_is_still_covered() -> void:
+	print("\n--- one enemy squad with 8 OC one move away: it out-OCs the holder alone ---")
+	var enemies = {}
+	var snap = _board(enemies, "single")
+	var plan = _plan(snap, ["beta"], enemies)
+	_assert(_goes_to(plan, "beta", "obj_x"), "beta still reinforces obj_x against a unit that can take it alone")
+
+func test_threat_needing_part_of_the_projection_is_still_covered() -> void:
