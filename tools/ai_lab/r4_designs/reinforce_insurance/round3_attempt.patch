+## REINFORCE-CAP: `alt` at the pace a unit freed from insurance would travel.
+## On a trip of 2+ turns it Advances when that saves a whole turn (ADV-PROB)
+## and costs it nothing — RACE-1's long-trip test, except that [ASSAULT]
+## ranged weapons (11e: they can be shot after Advancing) are not shooting
+## given up; that test counts any ranged weapon with a target in range as a
+## cost. The freed Custodian Guard (Guardian Spear – Ranged is [ASSAULT])
+## walked and stopped on the table-quarter line, while the measured
+## alternative Advanced into the quarter. Returns `alt` itself or a paced copy.
+## The copy keeps the walking trip's race_* fields: a longer race window, so
+## RACE-SKIP / LONE-TRIP judge the paced trip conservatively, and its card
+## quotes that window's enemy OC.
+static func _reinforce_cap_paced(alt: Dictionary, unit: Dictionary, move_types: Array,
+		enemies: Dictionary) -> Dictionary:
+	if unit.is_empty() or alt.get("action", "") != "move" or int(alt.get("turns_to_reach", 1)) < 2 \
+			or not ("BEGIN_ADVANCE" in move_types) or get_param("MOVE_LONG_ADVANCE", MOVE_LONG_ADVANCE) <= 0.0:
+		return alt
+	var move_in := float(alt.get("move_inches", 6.0))
+	var gap_in := maxf(0.0, (float(alt.get("distance", 0.0)) - OBJECTIVE_CONTROL_RANGE_PX) / PIXELS_PER_INCH)
+	if move_in <= 0.0 or not _long_trip_advance_saves_turn(gap_in, move_in):
+		return alt
+	var gives_up_shooting := false  # a ranged weapon without [ASSAULT]
+	for w in unit.get("meta", {}).get("weapons", []):
+		if str(w.get("type", "")).to_lower() == "ranged" \
+				and not ("assault" in str(w.get("special_rules", "")).to_lower()):
