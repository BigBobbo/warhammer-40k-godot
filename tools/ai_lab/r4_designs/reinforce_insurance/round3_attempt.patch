+func test_insurance_left_to_unit_with_less_to_gain() -> void:
+	print("\n--- weak threat; gamma can also reach obj_x this turn but obj_side is three moves away for it ---")
+	var enemies = {}
+	var snap = _board(enemies, "weak")
+	_add_unit(snap, "gamma", 2, GAMMA_POS, 3, 3)
+	var plan = _plan(snap, ["beta", "gamma"], enemies)
+	_assert(_goes_to(plan, "beta", "obj_side"), "beta takes obj_side")
+	_assert(_goes_to(plan, "gamma", "obj_x"), "gamma, with nothing that needs it elsewhere, reinforces obj_x — the need stays covered")
+
+# The freed unit Advances on its 2-turn trip when Advancing saves a turn and
+# costs it nothing: [ASSAULT] ranged weapons can be shot after Advancing
+# (11e), so a target in range is not a reason to walk. At the finding Beta
+# (Guardian Spear – Ranged [ASSAULT], the Mek 20.5" away) walked toward
+# obj_nml_2 and stopped on the table-quarter line; the measured alternative
+# Advanced. Here beta is 11.5" below obj_x, the nearest enemy 20.5" away (out
+# of charge reach, in its 24" weapon range), obj_side two walking moves away.
+func test_freed_unit_advances_when_its_guns_are_assault() -> void:
+	print("\n--- REINFORCE-CAP pace: beta's 24\" gun is [ASSAULT] / is not ---")
+	var beta_pos := Vector2(880, 1660)
+	var assault_gun := {"name": "spear", "type": "Ranged", "range": "24", "attacks": "2",
+		"ballistic_skill": "2", "strength": "4", "ap": "-1", "damage": "2", "special_rules": "assault"}
+	var plain_gun := assault_gun.duplicate()
+	plain_gun["special_rules"] = "rapid fire 1"
+	var actions := {}
+	for gun in [assault_gun, plain_gun]:
+		var enemies = {}
+		var snap = _board(enemies, "weak")
+		_add_unit(snap, "beta", 2, beta_pos, 3, 3, 8, ["INFANTRY"], [gun])
+		var plan = _plan(snap, ["beta"], enemies)
+		_assert(_captures(plan, "beta", "obj_side"),
+			"beta (%s gun) is not sent to reinforce obj_x — it takes obj_side" % gun.special_rules)
+		actions[gun.special_rules] = str(plan.get("beta", {}).get("action", ""))
+	_assert(actions.get("assault", "") == "advance",
+		"with an [ASSAULT] gun it Advances (saves a turn, keeps its shooting): %s" % actions.get("assault", ""))
+	_assert(actions.get("rapid fire 1", "") == "move",
+		"with a gun that cannot fire after Advancing and a target in range it walks: %s" % actions.get("rapid fire 1", ""))
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_REINFORCE_CAP = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_CAP"] = 0.0
+	var enemies = {}
+	var snap = _board(enemies, "weak")
+	var plan = _plan(snap, ["beta"], enemies)
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_CAP"] = 1.0
+	_assert(_goes_to(plan, "beta", "obj_x"), "with the fix off beta reinforces obj_x as before")
