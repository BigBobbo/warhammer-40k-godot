 		var oc_futile: Dictionary = overcommit_futile.call(cand)
@@ -21961,6 +22005,75 @@ static func _get_secondary_awareness(player: int = 0) -> Dictionary:
 		return _secondary_awareness_p1
 	return _secondary_awareness_p2
 
+## REINFORCE-INSURANCE: does moving `unit` toward cand's objective THIS turn
+## leave it wholly inside a table quarter (every model; base edge >6" from the
+## centre, no base across a halfway line) that none of our OTHER units covers, and
+## does that raise our primary card's table-quarter tier? Tries a Normal move
+## first, then an Advance (expected roll). {} = no; else {mode, quarter,
+## count, vp_gain}. Straight-line estimate toward the objective, stopping at it.
+static func _ri_quarter_tier_move(unit: Dictionary, unit_id: String, cand: Dictionary,
+		snapshot: Dictionary, player: int) -> Dictionary:
+	var tiers: Array = []  # [min, vp] of the card's quarters rules active now
+	for rule in _get_primary_awareness(player).get("vp_rules", []):
+		if str(rule.get("type", "")) == "quarters" and str(rule.get("when", "eot")) == "eot":
+			tiers.append([int(rule.get("min", 3)), int(rule.get("vp", 0))])
+	if tiers.is_empty() or unit.is_empty():
+		return {}
+	var tier_vp := func(n: int) -> int:
+		var best := 0
+		for t in tiers:
+			if n >= int(t[0]):
+				best = maxi(best, int(t[1]))
+		return best
+	var all_units: Dictionary = snapshot.get("units", {})
+	var now_count := 0
+	for q in _get_covered_quarters(all_units, player):
+		if q:
+			now_count += 1
+	var others: Dictionary = all_units.duplicate()
+	others.erase(unit_id)
+	var covered_others: Array = _get_covered_quarters(others, player)
+	var models: Array = _get_alive_models(unit)
+	var centroid := _get_unit_centroid(unit)
+	if models.is_empty() or centroid == Vector2.INF:
+		return {}
+	var to_obj: Vector2 = cand.objective_pos - centroid
+	if to_obj.length() <= 1.0:
+		return {}
+	var move_in := float(unit.get("meta", {}).get("stats", {}).get("move", 6))
+	var board_center = Vector2(BOARD_WIDTH_PX / 2.0, BOARD_HEIGHT_PX / 2.0)
+	var min_edge_px = 6.0 * PIXELS_PER_INCH
+	var stop_px := maxf(0.0, to_obj.length() - OBJECTIVE_CONTROL_RANGE_PX)
+	for mode in ["move", "advance"]:
+		var step_in: float = move_in + (get_param("ADVANCE_EXPECTED_EXTRA_INCHES", ADVANCE_EXPECTED_EXTRA_INCHES) if mode == "advance" else 0.0)
+		var shift: Vector2 = to_obj.normalized() * minf(step_in * PIXELS_PER_INCH, stop_px)
+		var quarter := -1
+		var inside := true
+		for model in models:
+			var pos = _get_model_position(model)
+			if pos == Vector2.INF:
+				inside = false
+				break
+			pos += shift
+			var q = _get_table_quarter(pos)
+			var base_radius_px = (float(model.get("base_mm", 32)) / 2.0) * (PIXELS_PER_INCH / 25.4)
+			# wholly within: the base must not cross a halfway line either
+			if (quarter != -1 and q != quarter) or pos.distance_to(board_center) - base_radius_px <= min_edge_px \
+					or absf(pos.x - board_center.x) <= base_radius_px or absf(pos.y - board_center.y) <= base_radius_px:
+				inside = false
+				break
+			quarter = q
+		if not inside or quarter < 0 or covered_others[quarter]:
+			continue
+		var new_count := 1
+		for q2 in covered_others:
+			if q2:
+				new_count += 1
+		var gain: int = int(tier_vp.call(new_count)) - int(tier_vp.call(now_count))
+		if gain > 0:
+			return {"mode": mode, "quarter": quarter, "count": new_count, "vp_gain": gain}
+	return {}
+
 static func _get_table_quarter(pos: Vector2) -> int:
 	"""Returns the table quarter (0-3) for a given position.
 	0=top-left, 1=top-right, 2=bottom-left, 3=bottom-right."""
diff --git a/40k/tests/unit/test_ai_fix_reinforce_insurance.gd b/40k/tests/unit/test_ai_fix_reinforce_insurance.gd
new file mode 100644
index 0000000..7f748c2
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_reinforce_insurance.gd
@@ -0,0 +1,186 @@
+extends SceneTree
+
+# REINFORCE-INSURANCE (FIX_REINFORCE_INSURANCE): a unit pass 2 would send to
+# reinforce an objective we already hold goes instead to another objective that
+# still needs OC when that move ends with it wholly inside a table quarter none
+# of our other units covers and that quarter completes a tier of our primary
+# card's table-quarter rule (Reconnaissance Sweep: 3 quarters 3 VP, 4 quarters
+# 6 VP, every end of turn). Normal move when that already lands it inside, else
+# Advance. LLM-critic cluster reinforce_insurance (s7437 r2): Custodian Guard
+# Beta reinforced a centre held with OC 6 instead of Advancing on obj_nml_2 into
+# the third quarter — measured +7.75 VP over 12 rollouts, +19.0 over 12 full
+# games; walking there (stopping on the quarter line) measured -4.0.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_reinforce_insurance.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const CENTER := Vector2(880, 1200)
+const NML_2 := Vector2(390, 1740)    # bottom-left quarter
+const HOME_1 := Vector2(510, 340)
+const HOME_2 := Vector2(1250, 2060)
+
+# Reconnaissance Sweep (round 2): quarters tiers, kills, hold_min excl. home.
+const RECON_RULES := [
+	{"type": "quarters", "min": 3, "vp": 3, "when": "eot", "exclusive_group": "quarters_tier"},
+	{"type": "quarters", "min": 4, "vp": 6, "when": "eot", "exclusive_group": "quarters_tier"},
+	{"type": "destroyed_per_unit", "vp_per": 1, "when": "eot"},
+	{"type": "hold_min", "exclude_home": true, "min": 1, "vp": 3, "when": "command", "rounds": [2, 5]},
+]
+# Purge and Secure: no quarter rule.
+const PURGE_RULES := [
+	{"type": "destroyed_started_on_objective", "vp": 3, "when": "eot"},
+	{"type": "per_objective", "exclude_home": true, "vp_per": 4, "when": "command", "rounds": [2, 5]},
+	{"type": "hold_new", "exclude_home": true, "vp": 3, "when": "eot", "rounds": [2, 5]},
+]
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Reinforcing a held objective vs completing a table-quarter tier (REINFORCE-INSURANCE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0
+	test_advances_into_third_quarter_instead_of_reinforcing()
+	test_walks_when_a_normal_move_lands_inside()
+	test_reinforces_without_a_quarter_rule()
+	test_reinforces_when_the_quarter_completes_no_tier()
+	test_reinforces_when_the_quarter_is_already_covered()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_REINFORCE_INSURANCE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		toughness: int, wounds: int, oc: int, move: int, points: int) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 40,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": GameStateData.UnitStatus.DEPLOYED,
+		"meta": {"name": unit_id, "points": points, "stats": {"move": move, "toughness": toughness, "save": 2,
+			"wounds": wounds, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+# The s7437 shape: our units cover the two top quarters, a 3-model OC 2 unit
+# holds the centre (OC 6), enemy squads one move from the centre (projected
+# ~7 OC), and Beta (M8, OC 2 x3) ~8" above the halfway line in the top-left.
+func _board(beta_pos: Vector2 = Vector2(525, 880), cover_q1: bool = true) -> Dictionary:
+	var snap = {"battle_round": 2, "meta": {"battle_round": 2, "first_turn_player": 1},
+		"board": {"objectives": [
+			{"id": "obj_home_1", "position": HOME_1, "zone": "player1"},
+			{"id": "obj_center", "position": CENTER, "zone": "no_mans_land"},
+			{"id": "obj_nml_2", "position": NML_2, "zone": "no_mans_land"},
+			{"id": "obj_home_2", "position": HOME_2, "zone": "player2"},
+		], "terrain_features": []}, "units": {}}
+	_add_unit(snap, "cover_q0", 1, HOME_1, 3, 4, 3, 1, 6, 100)
+	if cover_q1:
+		_add_unit(snap, "cover_q1", 1, Vector2(1400, 400), 3, 4, 3, 1, 6, 100)
+	_add_unit(snap, "holder", 1, CENTER, 3, 7, 3, 2, 7, 250)
+	_add_unit(snap, "beta", 1, beta_pos, 3, 7, 3, 2, 8, 160)
+	_add_unit(snap, "mek", 2, Vector2(1134, 1465), 1, 5, 4, 3, 6, 60)
+	_add_unit(snap, "wagon", 2, Vector2(1263, 1560), 1, 10, 16, 4, 10, 160)
+	_add_unit(snap, "orks_far", 2, HOME_2, 10, 5, 1, 2, 6, 80)
+	_add_unit(snap, "lootas", 2, Vector2(696, 1991), 10, 5, 1, 1, 6, 80)
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, rules: Array) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p1 = {"card_name": "test", "active_rules": rules.size(), "vp_rules": rules.duplicate(true),
+		"objective_pressure": 0.0, "enemy_home_bonus": 0.0, "central_bonus": 0.0, "hold_home_required": false,
+		"kill_pressure": false, "quarters": false}
+	AIDecisionMaker._secondary_awareness_p1 = {}
+	var friendlies = {}
+	var enemies = {}
+	var movable = {}
+	for uid in snap.units:
+		var u = snap.units[uid]
+		if int(u.owner) == 1:
+			friendlies[uid] = u
+		else:
+			enemies[uid] = u
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 1, enemies, friendlies, 2)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 1, 2)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for c in AIDecisionMaker._last_movement_candidates.get("beta", []):
+		print("    beta candidate %s %s score %.1f" % [c.get("action", ""), c.get("objective_id", ""), float(c.get("score", 0.0))])
+	AIDecisionMaker._primary_awareness_p1 = {}
+	return plan
+
+func _beta(plan: Dictionary) -> Dictionary:
+	return plan.get("beta", {})
+
+func _reinforces(plan: Dictionary) -> bool:
+	return str(_beta(plan).get("objective_id", "")) == "obj_center" and str(_beta(plan).get("action", "")) in ["move", "advance"]
+
+func test_advances_into_third_quarter_instead_of_reinforcing() -> void:
+	print("\n--- s7437 shape: centre held OC 6 vs ~7 projected, two quarters covered, a walk stops on the halfway line ---")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 0.0
+	var base_plan = _plan(_board(), ["beta"], RECON_RULES)
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0
+	_assert(_reinforces(base_plan), "precondition: without the fix Beta reinforces the held centre (%s %s)" % [_beta(base_plan).get("action", ""), _beta(base_plan).get("objective_id", "")])
+	var plan = _plan(_board(), ["beta"], RECON_RULES)
+	_assert(str(_beta(plan).get("objective_id", "")) == "obj_nml_2", "Beta goes to obj_nml_2 (%s)" % str(_beta(plan).get("objective_id", "")))
+	_assert(str(_beta(plan).get("action", "")) == "advance", "it Advances: a Normal move stops on the halfway line (%s)" % str(_beta(plan).get("action", "")))
+	_assert(str(_beta(plan).get("assign_pass", "")) == "reinforce_insurance", "the plan says why (%s)" % str(_beta(plan).get("assign_pass", "")))
+	_assert(str(_beta(plan).get("coordination_note", "")).begins_with("not reinforcing obj_center"),
+		"its card names the objective it did not reinforce (%s)" % str(_beta(plan).get("coordination_note", "")))
+
+func test_walks_when_a_normal_move_lands_inside() -> void:
+	print("\n--- Beta 2\" above the halfway line: a Normal move already lands it wholly inside the quarter ---")
+	var plan = _plan(_board(Vector2(525, 1120)), ["beta"], RECON_RULES)
+	if _reinforces(plan) or str(_beta(plan).get("assign_pass", "")) != "reinforce_insurance":
+		_assert(str(_beta(plan).get("objective_id", "")) == "obj_nml_2", "Beta goes to obj_nml_2 (%s %s)" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", "")])
+		return
+	_assert(str(_beta(plan).get("objective_id", "")) == "obj_nml_2" and str(_beta(plan).get("action", "")) == "move",
+		"it makes a Normal move to obj_nml_2 — Advancing would give up shooting and charging for nothing (%s %s)" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", "")])
+
+func test_reinforces_without_a_quarter_rule() -> void:
+	print("\n--- same board, Purge and Secure (no table-quarter rule) ---")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 0.0
+	var base_plan = _plan(_board(), ["beta"], PURGE_RULES)
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0
+	var plan = _plan(_board(), ["beta"], PURGE_RULES)
+	_assert(str(_beta(plan).get("objective_id", "")) == str(_beta(base_plan).get("objective_id", "")) \
+			and str(_beta(plan).get("action", "")) == str(_beta(base_plan).get("action", "")) \
+			and str(_beta(plan).get("assign_pass", "")) != "reinforce_insurance",
+		"the plan is unchanged (%s %s, base %s %s)" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", ""),
+			_beta(base_plan).get("action", ""), _beta(base_plan).get("objective_id", "")])
+
+func test_reinforces_when_the_quarter_completes_no_tier() -> void:
+	print("\n--- only one quarter covered: a second quarter scores nothing on the card ---")
+	var plan = _plan(_board(Vector2(525, 880), false), ["beta"], RECON_RULES)
+	_assert(str(_beta(plan).get("assign_pass", "")) != "reinforce_insurance" and _reinforces(plan),
+		"Beta reinforces the centre (%s %s [%s])" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", ""), _beta(plan).get("assign_pass", "")])
+
+func test_reinforces_when_the_quarter_is_already_covered() -> void:
+	print("\n--- another of our units already stands in the bottom-left quarter ---")
+	var snap = _board()
+	_add_unit(snap, "cover_q2", 1, Vector2(250, 2000), 3, 4, 3, 1, 6, 100)
+	var plan = _plan(snap, ["beta"], RECON_RULES)
+	_assert(str(_beta(plan).get("assign_pass", "")) != "reinforce_insurance",
+		"no redirect: the quarter adds no tier (%s %s [%s])" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", ""), _beta(plan).get("assign_pass", "")])
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_REINFORCE_INSURANCE = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 0.0
+	var plan = _plan(_board(), ["beta"], RECON_RULES)
+	AIDecisionMaker._config_overrides["FIX_REINFORCE_INSURANCE"] = 1.0
+	_assert(_reinforces(plan) and str(_beta(plan).get("assign_pass", "")) != "reinforce_insurance",
+		"Beta reinforces the centre as before (%s %s)" % [_beta(plan).get("action", ""), _beta(plan).get("objective_id", "")])
