+		print("AIDecisionMaker: [REINFORCE_INSURANCE] RI-ASSAULT %s: every ranged weapon is [ASSAULT] — a long-trip Advance costs no shooting" % _dn(unit, str(unit.get("id", ""))))
+		return true
