+				if get_param("FIX_SCREEN_VS_OBJECTIVE", FIX_SCREEN_VS_OBJECTIVE) >= 0.5 \
+						and not svo_switched and bool(denial.get("gap", false)) \
+						and not extra_obj_skipped.has(unit_id) and not lone_skipped.has(unit_id) \
+						and not far_skipped.has(unit_id):
+					var svo_best: Dictionary = {}
