 # spots aim only at objectives that still need OC. 0 = the centre-distance
 # approximation everywhere, spots near any objective.
 const FIX_HELD_DUP: float = 1.0
+# Movement plan (FIX_SCREEN_VS_OBJECTIVE): 1 = a backfield-gap screen (a
+# deep-strike denial spot in our deployment zone that covers no objective)
+# is priced against what the unit adds to a capture the plan is already
+# making — its own planner score at that objective less the support ledger's
+# diminishing returns (SUPPORT_STACK_PENALTY per unit already committed) —
+# and the higher one wins. The objective passes skip a capture whose OC need
+# is met, so the gap screen used to take every spare cheap unit on pass order
+# alone (flat 8 + 3), even when the capture is uncontested and the unit's
+# score there (no-man's-land / zone secondaries, backup OC) is twice that.
+# Only captures the enemy cannot win the race for (no contest_race, not
+# LONE-/FAR-TRIP / RACE-SKIP / TOO-LATE), that are the unit's top-scored
+# option, with at most SCREEN_VS_OBJECTIVE_MAX_COMMITTED units already
+# committed. 0 = the gap screen always wins.
+const FIX_SCREEN_VS_OBJECTIVE: float = 1.0
+# SCREEN_VS_OBJECTIVE: the capture must be the unit's own top-scored option,
+# and the unit is at most the (N+1)th committed there: the per-unit terms
+# (no-man's-land / zone secondaries, a backup holder) are paid once per
+# objective, so a 4th, 5th unit adds nothing the screen does not.
+const SCREEN_VS_OBJECTIVE_MAX_COMMITTED: int = 2
 # Charge (RETALIATION): share of the surviving target's melee damage on the
 # charger counted against the charge (x CHARGE_MELEE_DAMAGE_WEIGHT).
 const CHARGE_RETALIATION_WEIGHT: float = 0.5
@@ -10634,6 +10653,55 @@ static func _assign_units_to_objectives(
 				score += _t_add(screen_terms, "denial_priority", float(denial.priority))
 				# Closer units score higher for screening
 				score += _t_add(screen_terms, "screen_distance", -((dist_to_denial / PIXELS_PER_INCH) * 0.3))
+				# SCREEN_VS_OBJECTIVE: a backfield gap covers no objective, so it
