+				if denial.get("backfield_gap", false) \
+						and get_param("FIX_SCREEN_VS_OBJECTIVE", FIX_SCREEN_VS_OBJECTIVE) >= 0.5:
+					var svo_stack = get_param("SUPPORT_STACK_PENALTY", SUPPORT_STACK_PENALTY)
+					var svo_max_k = get_param_int("SCREEN_VS_OBJECTIVE_MAX_COMMITTED", SCREEN_VS_OBJECTIVE_MAX_COMMITTED)
+					var svo_best: Dictionary = {}
+					var svo_best_val := -INF
+					# Only the unit's own top-scored objective: the screen would
+					# throw away the option the planner valued highest for it.
+					var svo_top: Dictionary = {}
+					for svo_cand in candidates:
+						if svo_cand.unit_id == unit_id and (svo_top.is_empty() or float(svo_cand.score) > float(svo_top.score)):
