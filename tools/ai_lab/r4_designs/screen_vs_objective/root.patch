+							continue
+						var svo_oid = str(svo_cand.objective_id)
+						if svo_top.is_empty() or str(svo_top.objective_id) != svo_oid:
+							continue
+						if not planned_new_objs.has(svo_oid) or svo_cand.get("race_lost", false):
+							continue
+						if int(support_counts.get(svo_oid, 0)) > svo_max_k:
+							continue  # the capture already has its holder and backup
+						if lone_skipped.get(unit_id, {}).has(svo_oid) or far_skipped.get(unit_id, {}).has(svo_oid) \
+								or too_late.call(svo_cand) or race_hopeless.call(svo_cand):
+							continue
+						var svo_val = float(svo_cand.score) - svo_stack * float(support_counts.get(svo_oid, 0))
+						if svo_val > svo_best_val:
