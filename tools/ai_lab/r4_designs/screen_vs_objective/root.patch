diff --git a/40k/tests/unit/test_ai_fix_screen_vs_objective.gd b/40k/tests/unit/test_ai_fix_screen_vs_objective.gd
new file mode 100644
index 0000000..523bb67
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_screen_vs_objective.gd
@@ -0,0 +1,168 @@
+extends SceneTree
+
+# SCREEN_VS_OBJECTIVE (FIX_SCREEN_VS_OBJECTIVE): a backfield-gap screen (a
+# deep-strike denial spot in our deployment zone that covers no objective) is
+# priced against what the unit adds to a capture the plan already makes, and
+# the higher one wins. LLM-critic cluster screen_vs_objective (value-checked,
+# 2026-10-30): s7467 r1 P2 sent Gretchin to a backfield gap while the plan was
+# capturing the uncontested obj_nml_2; Advancing them onto it measured
+# +3.64 [1.82, 5.46] VP over 36 seeds (Cleanse / Forward Position actions).
+# The objective passes skip a capture whose OC need is met, so the gap screen
+# (flat 8 + 3) took every spare cheap unit on pass order alone.
+# Guards: a capture the enemy wins the race for, or one already stacked with
+# committed units, still loses to the screen; home deep-strike denial is not
+# touched.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_screen_vs_objective.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const PX := 40.0  # pixels per inch
+const OBJ_N := Vector2(440, 1500)    # uncontrolled no-man's-land objective on our side
+const ENEMY_POS := Vector2(1320, 300)  # the enemy's deployed squad, in its own zone
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Backfield-gap screen vs an uncontested capture (SCREEN_VS_OBJECTIVE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_SCREEN_VS_OBJECTIVE"] = 1.0
+	test_spare_cheap_unit_supports_uncontested_capture()
+	test_screen_kept_when_capture_is_stacked()
+	test_screen_kept_when_enemy_wins_the_race()
+	test_screen_kept_past_commit_cap()
+	AIDecisionMaker._config_overrides.erase("FIX_SCREEN_VS_OBJECTIVE")
+	test_param_zero_restores_base()
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+# P2 deploys along the bottom 12" (y 1920-2400 px); the enemy has a unit in
+# reserves, so the deep-strike denial pass runs.
+func _snapshot() -> Dictionary:
+	var objs = [{"id": "obj_n", "position": OBJ_N, "zone": "no_mans_land"}]
+	var dz2 = [Vector2(0, 1920), Vector2(1760, 1920), Vector2(1760, 2400), Vector2(0, 2400)]
+	var dz1 = [Vector2(0, 0), Vector2(1760, 0), Vector2(1760, 480), Vector2(0, 480)]
+	return {"battle_round": 1, "meta": {"battle_round": 1},
+		"board": {"objectives": objs, "terrain_features": [],
+			"deployment_zones": [{"player": 1, "vertices": dz1}, {"player": 2, "vertices": dz2}]},
+		"units": {}}
+
+# `n` models whose centroid is at `pos`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		oc: int, points: int, move: int = 6, toughness: int = 4, wounds: int = 1,
+		status: int = GameStateData.UnitStatus.DEPLOYED) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": status,
+		"meta": {"name": unit_id, "points": points, "stats": {"move": move, "toughness": toughness, "save": 5,
+			"wounds": wounds, "leadership": 7, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+func _plan(snap: Dictionary, movable_ids: Array, enemies: Dictionary) -> Dictionary:
+	AIDecisionMaker._primary_awareness_p2 = {}
+	AIDecisionMaker._secondary_awareness_p2 = {}
+	var friendlies = {}
+	var movable = {}
+	for uid in snap.units:
+		if int(snap.units[uid].owner) == 2:
+			friendlies[uid] = snap.units[uid]
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 2, enemies, friendlies, 1)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 2, 1)
+	for uid in plan:
+		print("  %s: %s %s [%s] score %.1f (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), float(plan[uid].get("score", 0.0)), str(plan[uid].get("reason", "")).substr(0, 110)])
+	return plan
+
+# A capturer 6" from obj_n (it alone meets the OC need), the cheap Gretchin-
+# like unit in the bottom-right of our zone, an enemy squad in its zone and one
+# in reserves. `enemy_near`: an enemy wave that reaches obj_n before the
+# Gretchin can.
+func _setup(enemy_near: bool = false) -> Array:
+	var snap = _snapshot()
+	var enemies = {}
+	_add_unit(snap, "capper", 2, OBJ_N + Vector2(0, 6.0 * PX), 5, 2, 200, 6, 4, 2)
+	_add_unit(snap, "grots", 2, Vector2(1300, 2100), 10, 1, 40, 5, 2, 1)
+	var movable = ["capper", "grots"]
+	_add_unit(snap, "theirs", 1, ENEMY_POS, 5, 2, 200, 6, 4, 2)
+	enemies["theirs"] = snap.units["theirs"]
+	if enemy_near:
+		for i in range(3):
+			var eid = "rush_%d" % i
+			_add_unit(snap, eid, 1, OBJ_N + Vector2((i - 1) * 200.0, -12.0 * PX), 10, 2, 200, 8, 4, 2)
+			enemies[eid] = snap.units[eid]
+	_add_unit(snap, "deep", 1, Vector2(-1000, -1000), 5, 2, 250, 6, 4, 2, GameStateData.UnitStatus.IN_RESERVES)
+	return [snap, movable, enemies]
+
+func test_spare_cheap_unit_supports_uncontested_capture() -> void:
+	print("\n--- obj_n uncontrolled, nobody else near; capper covers it; grots spare ---")
+	var s = _setup()
+	var plan = _plan(s[0], s[1], s[2])
+	var g: Dictionary = plan.get("grots", {})
+	_assert(str(g.get("objective_id", "")) == "obj_n" and str(g.get("action", "")) in ["move", "advance"],
+		"grots support the uncontested capture of obj_n instead of a backfield-gap screen (got %s %s)" % [
+			g.get("action", ""), g.get("objective_id", "")])
+	_assert(str(g.get("assign_pass", "")) == "support", "assigned in the support role")
+	_assert(str(plan.get("capper", {}).get("objective_id", "")) == "obj_n", "the capper still captures obj_n")
+
+func test_screen_kept_when_capture_is_stacked() -> void:
+	# The support ledger's diminishing returns are charged: with a steeper
+	# per-committed-unit penalty the one unit already going to obj_n is
+	# enough to make the extra unit worth less than the screen.
+	print("\n--- obj_n's support is priced down by the units already committed ---")
+	AIDecisionMaker._config_overrides["SUPPORT_STACK_PENALTY"] = 6.0
+	var s = _setup()
+	var plan = _plan(s[0], s[1], s[2])
+	AIDecisionMaker._config_overrides.erase("SUPPORT_STACK_PENALTY")
+	var g: Dictionary = plan.get("grots", {})
+	_assert(str(g.get("action", "")) == "screen",
+		"support worth less than the screen after stacking: the screen is kept (got %s %s)" % [
+			g.get("action", ""), g.get("objective_id", "")])
+
+func test_screen_kept_when_enemy_wins_the_race() -> void:
+	print("\n--- an enemy wave reaches obj_n before the grots ---")
+	var s = _setup(true)
+	var plan = _plan(s[0], s[1], s[2])
+	var g: Dictionary = plan.get("grots", {})
+	_assert(not (str(g.get("objective_id", "")) == "obj_n" and str(g.get("assign_pass", "")) == "support"
+			and str(g.get("reason", "")).contains("backfield-gap")),
+		"no SCREEN_VS_OBJECTIVE support into a lost race (got %s %s [%s])" % [
+			g.get("action", ""), g.get("objective_id", ""), g.get("assign_pass", "")])
+
+func test_screen_kept_past_commit_cap() -> void:
+	# The per-unit terms are paid once per objective: past the cap of units
+	# already committed, the extra unit takes the screen.
+	print("\n--- obj_n already has more committed units than the cap ---")
+	AIDecisionMaker._config_overrides["SCREEN_VS_OBJECTIVE_MAX_COMMITTED"] = 0.0
+	var s = _setup()
+	var plan = _plan(s[0], s[1], s[2])
+	AIDecisionMaker._config_overrides.erase("SCREEN_VS_OBJECTIVE_MAX_COMMITTED")
+	_assert(str(plan.get("grots", {}).get("action", "")) == "screen",
+		"past the commitment cap the screen is kept (got %s %s)" % [
+			plan.get("grots", {}).get("action", ""), plan.get("grots", {}).get("objective_id", "")])
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_SCREEN_VS_OBJECTIVE = 0 ---")
+	AIDecisionMaker._config_overrides["FIX_SCREEN_VS_OBJECTIVE"] = 0.0
+	var s = _setup()
+	var plan = _plan(s[0], s[1], s[2])
+	AIDecisionMaker._config_overrides.erase("FIX_SCREEN_VS_OBJECTIVE")
+	_assert(str(plan.get("grots", {}).get("action", "")) == "screen",
+		"with the fix off the grots take the backfield-gap screen as before")
