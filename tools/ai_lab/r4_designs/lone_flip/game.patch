+	# RACE-SKIP / LONE-TRIP, that outscores c by LONE_FLIP_MIN_GAIN. {} = keep c.
+	var lone_flip_on = get_param("FIX_LONE_FLIP", FIX_LONE_FLIP) >= 0.5
+	var lone_flip_gain = get_param("LONE_FLIP_MIN_GAIN", LONE_FLIP_MIN_GAIN)
+	var lone_flip_redirect := func(c: Dictionary) -> Dictionary:
+		if not lone_flip_on or c.get("action", "") not in ["move", "advance"] or c.get("already_on_obj", false):
+			return {}
+		var ev = _get_obj_eval_by_id(obj_evaluations, c.objective_id)
+		if ev.is_empty() or ev.get("state", "") not in ["enemy_weak", "enemy_strong"]:
