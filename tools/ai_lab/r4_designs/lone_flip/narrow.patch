+			# oc_needed already counts it; staying adds nothing, so it consumes
+			# none of the need. It used to subtract its whole unit OC again: a
+			# Custodian Guard unit with 1 model on a 5 vs 8 centre "covered" it,
+			# and the next unit walked alone into a 9 vs 14 flip elsewhere.
+			if lone_flip_on and obj_state in ["enemy_weak", "enemy_strong", "contested"]:
+				assignments[uid]["oc_consumed"] = 0
+				print("AIDecisionMaker: [LONE_FLIP] %s: %s holds but adds no OC (already counted: friendly %d vs enemy %d) — need stays %d" % [
