 				hold_reason = "holding objective (OC: %d)" % cand.unit_oc
 			assignments[uid]["reason"] = hold_reason
 			assigned_unit_ids[uid] = true
-			assignments[uid]["oc_consumed"] = min(cand.unit_oc, max(0, remaining))
