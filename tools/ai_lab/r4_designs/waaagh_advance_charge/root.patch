diff --git a/40k/tests/unit/test_ai_fix_waaagh_advance_charge.gd b/40k/tests/unit/test_ai_fix_waaagh_advance_charge.gd
new file mode 100644
index 0000000..8ad03c8
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_waaagh_advance_charge.gd
@@ -0,0 +1,155 @@
+extends SceneTree
+
+# FIX-WAAAGH-ADVANCE-CHARGE (critic cluster "waaagh_advance_charge", 2026-10-30):
+# Ork melee units Advanced "to attack" when a Normal move already reached
+# charge range, then could not declare the charge.
+#
+# Root cause — the AI estimated "can this unit charge after it Advances?" with
+# a text match: any ability whose name or text contains "advance" and
+# "charge". Every Ork unit carries Waaagh!, whose text describes the riled-up
+# effect ("that advance move does not prevent that unit from being eligible to
+# declare a charge") — but a unit is riled up only for one turn after the
+# once-per-battle War Cry. Custodes' Swift Onslaught ("re-roll advance rolls,
+# re-roll charge rolls") matched too. ChargePhase allows a charge after an
+# Advance only through EffectPrimitivesData.has_effect_advance_and_charge; the
+# AI now asks the same predicate.
+#
+# Measured (36 / 12 rollouts): Stormboyz Normal move +6.1 VP [3.1, 9.2],
+# Beast Snagga Boyz Normal move +11.3 VP [5.1, 17.4].
+#
+# Run with: godot --headless --path . -s tests/unit/test_ai_fix_waaagh_advance_charge.gd
+
+const AI_PATH := "res://scripts/AIDecisionMaker.gd"
+const PX := 40.0
+const WAAAGH := {"name": "Waaagh!", "type": "Faction", "description": "Friendly ORKS units with this ability can:\n• Re-roll advance rolls.\n• Become riled up, as stated in other rules.\nWhile a unit is riled up:\n• That unit has 5+ InSv.\n• That unit's ranged attacks have [ASSAULT].\n• When that unit is selected to make an advance move, that advance move does not prevent that unit from being eligible to declare a charge.\nWar Cry (Once per battle, per army): At the start of the Command phase, you can use this ability. If you do, friendly ORKS units with the Waaagh! ability are riled up until the end of the next turn."}
+const SWIFT := {"name": "Swift Onslaught", "type": "Datasheet", "description": "This unit can:\n• Re-roll advance rolls.\n• Re-roll charge rolls."}
+const OBJ := Vector2(880, 1200)
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+var _ran := false
+var AIDM = null
+
+func _init():
+	root.connect("ready", Callable(self, "_run_tests"))
+	create_timer(0.1).timeout.connect(_run_tests)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _run_tests():
+	if _ran:
+		return
+	_ran = true
+	await process_frame
+	print("\n=== FIX-WAAAGH-ADVANCE-CHARGE: Advance only when the charge survives it ===\n")
+	var prev_edition = GameConstants.edition
+	GameConstants.edition = 11
+	AIDM = load(AI_PATH)
+	AIDM._config_overrides["FIX_WAAAGH_ADVANCE_CHARGE"] = 1.0
+
+	test_plan_normal_moves_when_waaagh_not_called()
+	test_riled_up_unit_still_advances()
+	test_swift_onslaught_is_not_advance_and_charge()
+	test_far_enemy_still_advances()
+	test_long_trip_keeps_charge()
+	test_param_zero_restores_old_estimate()
+
+	AIDM._config_overrides.erase("FIX_WAAAGH_ADVANCE_CHARGE")
+	GameConstants.edition = prev_edition
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+# --- fixtures ---------------------------------------------------------------
+
+func _snapshot(battle_round: int = 3) -> Dictionary:
+	var objs = [{"id": "obj_center", "position": OBJ, "zone": "no_mans_land"}]
+	return {"battle_round": battle_round, "meta": {"battle_round": battle_round},
+		"board": {"objectives": objs, "terrain_features": []}, "units": {},
+		"factions": {"1": "Orks", "2": "Adeptus Custodes"}}
+
+func _add_unit(snap: Dictionary, uid: String, owner: int, at: Vector2, n: int,
+		abilities: Array, melee: bool, flags: Dictionary = {}) -> Dictionary:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 32,
+			"base_type": "circular", "base_dimensions": {}, "position": at + Vector2(40 * i, 0),
+			"wounds": 2, "current_wounds": 2})
+	var weapons = []
+	if melee:
+		weapons.append({"name": "Choppa", "type": "Melee", "range": "Melee", "attacks": "3",
+			"weapon_skill": "3", "strength": "5", "ap": "-1", "damage": "1", "special_rules": ""})
+	else:
+		weapons.append({"name": "Spear", "type": "Melee", "range": "Melee", "attacks": "5",
+			"weapon_skill": "2", "strength": "7", "ap": "-2", "damage": "2", "special_rules": ""})
+		weapons.append({"name": "Bolter", "type": "Ranged", "range": "24", "attacks": "2",
+			"ballistic_skill": "2", "strength": "5", "ap": "-1", "damage": "2", "special_rules": ""})
+	var u = {"id": uid, "owner": owner, "status": 2,
+		"meta": {"name": uid, "points": 150, "faction": "Orks" if owner == 1 else "Adeptus Custodes",
+			"stats": {"move": 6, "toughness": 5, "save": 5, "wounds": 2, "leadership": 7, "objective_control": 2},
+			"keywords": ["INFANTRY", "ORKS"] if owner == 1 else ["INFANTRY"], "weapons": weapons,
+			"abilities": abilities},
+		"models": models, "flags": flags.duplicate()}
+	snap.units[uid] = u
+	return u
+
+## An Ork melee unit 9.5" from an enemy: a Normal move (M6) ends 3.5" away,
+## inside charge range, so Advancing only throws the charge away.
+func _gate(abilities: Array, flags: Dictionary = {}, enemy_gap_in: float = 9.5) -> Dictionary:
+	var snap = _snapshot()
+	var u = _add_unit(snap, "BOYZ", 1, OBJ + Vector2(-80, 0), 5, abilities, true, flags)
+	var c = AIDM._get_unit_centroid(u)
+	_add_unit(snap, "ENEMY", 2, c + Vector2(-20, enemy_gap_in * PX), 1, [], false)
+	var enemies = AIDM._get_enemy_units(snap, 1)
+	var friendly = AIDM._get_units_for_player(snap, 1)
+	var assignment = {"action": "move", "objective_id": "obj_center", "objective_pos": OBJ + Vector2(0, -600)}
+	return AIDM._melee_chase_gate(u, "BOYZ", assignment, enemies, friendly, snap, 1)
+
+# --- tests --------------------------------------------------------------------
+
+func test_plan_normal_moves_when_waaagh_not_called() -> void:
+	print("\n--- Waaagh! not called: Ork melee unit, enemy 9.5\" away ---")
+	var g = _gate([WAAAGH])
+	print("  gate: %s" % str(g))
+	_assert(not g.is_empty(), "the unit still goes to attack the enemy")
+	_assert(g.get("advance", true) == false, "it Normal-moves into charge range instead of Advancing (advance=%s)" % str(g.get("advance")))
+
+func test_riled_up_unit_still_advances() -> void:
+	print("\n--- Waaagh! called this turn (effect_advance_and_charge set) ---")
+	var g = _gate([WAAAGH], {"effect_advance_and_charge": true})
+	_assert(g.get("advance", false) == true, "a riled-up unit may Advance and still charge, so it Advances (advance=%s)" % str(g.get("advance")))
+
+func test_swift_onslaught_is_not_advance_and_charge() -> void:
+	print("\n--- Swift Onslaught (re-roll advance / re-roll charge) is not advance-and-charge ---")
+	var g = _gate([SWIFT])
+	_assert(g.get("advance", true) == false, "re-roll text does not make the AI Advance into a lost charge (advance=%s)" % str(g.get("advance")))
+
+func test_far_enemy_still_advances() -> void:
+	print("\n--- enemy 19\" away: a Normal move cannot reach charge range ---")
+	var g = _gate([WAAAGH], {}, 19.0)
+	_assert(g.get("advance", false) == true, "it still Advances to close the distance (advance=%s)" % str(g.get("advance")))
+
+func test_long_trip_keeps_charge() -> void:
+	print("\n--- long trip: enemy within M+12\" of an Ork melee unit without Waaagh! ---")
+	var snap = _snapshot()
+	var u = _add_unit(snap, "BOYZ", 1, OBJ, 5, [WAAAGH], true)
+	var c = AIDM._get_unit_centroid(u)
+	_add_unit(snap, "ENEMY", 2, c + Vector2(0, 15 * PX), 1, [], false)
+	var enemies = AIDM._get_enemy_units(snap, 1)
+	var adv = AIDM._should_unit_advance_long_trip(u, false, 0.0, enemies, c)
+	_assert(adv == false, "no long-trip Advance that would lose a charge (advance=%s)" % str(adv))
+	u.flags["effect_advance_and_charge"] = true
+	adv = AIDM._should_unit_advance_long_trip(u, false, 0.0, enemies, c)
+	_assert(adv == true, "riled up: the long-trip Advance is free (advance=%s)" % str(adv))
+
+func test_param_zero_restores_old_estimate() -> void:
+	print("\n--- FIX_WAAAGH_ADVANCE_CHARGE = 0: the text match is back ---")
+	AIDM._config_overrides["FIX_WAAAGH_ADVANCE_CHARGE"] = 0.0
+	var g = _gate([WAAAGH])
+	AIDM._config_overrides["FIX_WAAAGH_ADVANCE_CHARGE"] = 1.0
+	_assert(g.get("advance", false) == true, "off: the Ork unit Advances (old behaviour, advance=%s)" % str(g.get("advance")))
