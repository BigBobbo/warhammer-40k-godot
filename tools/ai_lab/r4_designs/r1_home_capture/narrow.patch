diff --git a/40k/tests/unit/test_ai_fix_r1_home_capture.gd b/40k/tests/unit/test_ai_fix_r1_home_capture.gd
new file mode 100644
index 0000000..0f9e10e
--- /dev/null
+++ b/40k/tests/unit/test_ai_fix_r1_home_capture.gd
@@ -0,0 +1,167 @@
+extends SceneTree
+
+# R1-HOME-CAPTURE (FIX_R1_HOME_CAPTURE): in battle round 1 no unit is SENT to
+# capture our own uncontrolled home objective when holding it pays nothing yet
+# (our primary card counts home in none of its rules; a Decoy never lands on a
+# home objective) and no enemy unit can be in range of it by the end of the
+# enemy's next turn. The unit takes its next objective instead. LLM-critic
+# cluster r1_home_capture (value-checked, 2026-10-30): s7468 r1 P1 (Custodes vs
+# Orks, Smoke and Mirrors) a Custodian Guard unit 9" from an empty home
+# objective went there while the Orks were 30" away; Advancing it to the centre
+# measured +6.86 VP [4.45, 9.27] over 36 rollouts. Guardrails: a card that pays
+# for home, an enemy that can reach home, round 2, and a unit already on home
+# keep the base plan.
+# Run with: godot --headless --path 40k -s tests/unit/test_ai_fix_r1_home_capture.gd
+
+const GameStateData = preload("res://autoloads/GameState.gd")
+const AIDecisionMaker = preload("res://scripts/AIDecisionMaker.gd")
+
+const MOVABLE := ["BEGIN_NORMAL_MOVE", "BEGIN_ADVANCE", "REMAIN_STATIONARY"]
+const HOME := Vector2(510, 340)      # our home objective (player 1 zone)
+const NML := Vector2(1200, 700)      # a no man's land objective ~19" from the unit (2 turns)
+const ENEMY_HOME := Vector2(1250, 2060)
+
+# Smoke and Mirrors: Decoys (never on home), hold_min that excludes home.
+const SMOKE_RULES := [
+	{"when": "eot", "type": "decoyed_score", "vp_per": 2, "enemy_territory_bonus": 2},
+	{"when": "command", "type": "hold_min", "min": 1, "exclude_home": true, "vp": 4, "rounds": [2, 5]},
+	{"when": "eog", "type": "decoyed_total_eog", "min": 4, "vp": 10},
+]
+# Destroyer's Wrath: hold_more counts every objective, home included.
+const WRATH_RULES := [
+	{"type": "destroyed_min", "min": 1, "vp": 3, "when": "eot"},
+	{"type": "hold_min", "exclude_home": true, "min": 1, "vp": 4, "when": "command", "rounds": [2, 5]},
+	{"type": "hold_more", "vp": 6, "when": "command", "rounds": [2, 5]},
+]
+
+var _pass_count: int = 0
+var _fail_count: int = 0
+
+func _init():
+	print("\n=== Round-1 capture of a home objective that pays nothing (R1-HOME-CAPTURE) ===\n")
+	AIDecisionMaker._config_overrides["FIX_R1_HOME_CAPTURE"] = 1.0
+	test_unit_goes_forward_when_home_pays_nothing()
+	test_unit_captures_home_when_primary_pays_for_it()
+	test_unit_captures_home_when_enemy_can_reach_it()
+	test_unit_captures_home_in_round_two()
+	test_keeper_on_home_is_untouched()
+	test_param_zero_restores_base()
+	AIDecisionMaker._config_overrides.erase("FIX_R1_HOME_CAPTURE")
+	print("\n=== Results: %d passed, %d failed ===" % [_pass_count, _fail_count])
+	quit(1 if _fail_count > 0 else 0)
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_pass_count += 1
+		print("PASS: %s" % message)
+	else:
+		_fail_count += 1
+		print("FAIL: %s" % message)
+
+func _snapshot(battle_round: int = 1) -> Dictionary:
+	return {"battle_round": battle_round, "meta": {"battle_round": battle_round, "first_turn_player": 1},
+		"board": {"objectives": [
+			{"id": "obj_home_1", "position": HOME, "zone": "player1"},
+			{"id": "obj_nml_1", "position": NML, "zone": "no_mans_land"},
+			{"id": "obj_home_2", "position": ENEMY_HOME, "zone": "player2"},
+		], "terrain_features": []}, "units": {}}
+
+# `n` models (OC `oc` each) whose centroid is at `pos`.
+func _add_unit(snapshot: Dictionary, unit_id: String, owner: int, pos: Vector2, n: int,
+		toughness: int, wounds: int, oc: int, move: int, points: int,
+		status: int = GameStateData.UnitStatus.DEPLOYED) -> void:
+	var models = []
+	for i in range(n):
+		models.append({"id": "m%d" % (i + 1), "alive": true, "base_mm": 40,
+			"base_type": "circular", "base_dimensions": {},
+			"position": Vector2(pos.x + (i - (n - 1) / 2.0) * 45.0, pos.y), "wounds": wounds, "current_wounds": wounds})
+	snapshot.units[unit_id] = {
+		"id": unit_id, "owner": owner, "status": status,
+		"meta": {"name": unit_id, "points": points, "stats": {"move": move, "toughness": toughness, "save": 2,
+			"wounds": wounds, "leadership": 6, "objective_control": oc}, "keywords": ["INFANTRY"], "weapons": []},
+		"models": models, "flags": {}}
+
+# The s7468 shape: a 240 pt Custodian Guard unit (M6) ~9" from an empty home
+# objective and ~19" from a no man's land objective, the enemy army 40"+ away.
+func _board(battle_round: int = 1, enemy_pos: Vector2 = ENEMY_HOME, capper_pos: Vector2 = HOME + Vector2(330, 160)) -> Dictionary:
+	var snap = _snapshot(battle_round)
+	_add_unit(snap, "capper", 1, capper_pos, 3, 7, 3, 2, 6, 240)
+	_add_unit(snap, "orks", 2, enemy_pos, 10, 5, 1, 2, 6, 80)
+	return snap
+
+func _plan(snap: Dictionary, movable_ids: Array, rules: Array) -> Dictionary:
+	var br := int(snap.meta.battle_round)
+	AIDecisionMaker._primary_awareness_p1 = {"card_name": "test", "active_rules": rules.size(), "vp_rules": rules.duplicate(true),
+		"objective_pressure": 0.0, "enemy_home_bonus": 0.0, "central_bonus": 0.0, "hold_home_required": false,
+		"kill_pressure": false, "quarters": false}
+	AIDecisionMaker._secondary_awareness_p1 = {}
+	var friendlies = {}
+	var enemies = {}
+	var movable = {}
+	for uid in snap.units:
+		var u = snap.units[uid]
+		if int(u.owner) == 1:
+			friendlies[uid] = u
+		elif int(u.status) != GameStateData.UnitStatus.IN_RESERVES:
+			enemies[uid] = u
+	for uid in movable_ids:
+		movable[uid] = MOVABLE
+	var objectives = []
+	for o in snap.board.objectives:
+		objectives.append(o.position)
+	var evals = AIDecisionMaker._evaluate_all_objectives(snap, objectives, 1, enemies, friendlies, br)
+	var plan = AIDecisionMaker._assign_units_to_objectives(snap, movable, evals, objectives, enemies, friendlies, 1, br)
+	for uid in plan:
+		print("  %s: %s %s [%s] (%s)" % [uid, plan[uid].get("action", ""), plan[uid].get("objective_id", ""),
+			plan[uid].get("assign_pass", ""), str(plan[uid].get("reason", "")).substr(0, 110)])
+	for c in AIDecisionMaker._last_movement_candidates.get("capper", []):
+		print("    capper candidate %s %s score %.1f" % [c.get("action", ""), c.get("objective_id", ""), float(c.get("score", 0.0))])
+	AIDecisionMaker._primary_awareness_p1 = {}
+	return plan
+
+func _target(plan: Dictionary, uid: String = "capper") -> String:
+	var a: Dictionary = plan.get(uid, {})
+	return "%s %s" % [str(a.get("action", "")), str(a.get("objective_id", ""))]
+
+func _goes_home(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("capper", {})
+	return str(a.get("objective_id", "")) == "obj_home_1" and str(a.get("action", "")) in ["move", "advance"]
+
+func _goes_forward(plan: Dictionary) -> bool:
+	var a: Dictionary = plan.get("capper", {})
+	return str(a.get("objective_id", "")) == "obj_nml_1" and str(a.get("action", "")) in ["move", "advance"]
+
+func test_unit_goes_forward_when_home_pays_nothing() -> void:
+	print("\n--- round 1, Smoke and Mirrors (home pays nothing), enemy 40\"+ away ---")
+	var plan = _plan(_board(), ["capper"], SMOKE_RULES)
+	_assert(_goes_forward(plan), "the unit goes to obj_nml_1, not the empty home objective (%s)" % _target(plan))
+
+func test_unit_captures_home_when_primary_pays_for_it() -> void:
+	print("\n--- same board, Destroyer's Wrath: hold_more counts home ---")
+	var plan = _plan(_board(), ["capper"], WRATH_RULES)
+	_assert(_goes_home(plan), "a home objective the card pays for is captured (%s)" % _target(plan))
+
+func test_unit_captures_home_when_enemy_can_reach_it() -> void:
+	print("\n--- same board, an enemy unit ~25\" from home (Move 6 + charge + pile-in reaches it) ---")
+	var plan = _plan(_board(1, HOME + Vector2(-100, 1000)), ["capper"], SMOKE_RULES)
+	_assert(_goes_home(plan), "a home objective the enemy can reach next turn is captured (%s)" % _target(plan))
+
+func test_unit_captures_home_in_round_two() -> void:
+	print("\n--- round 2, Smoke and Mirrors ---")
+	var plan = _plan(_board(2), ["capper"], SMOKE_RULES)
+	_assert(_goes_home(plan), "after round 1 the base plan stands (%s)" % _target(plan))
+
+func test_keeper_on_home_is_untouched() -> void:
+	print("\n--- the unit already stands on home (a keeper): not this fix's business ---")
+	AIDecisionMaker._config_overrides["FIX_R1_HOME_CAPTURE"] = 0.0
+	var off_plan = _plan(_board(1, ENEMY_HOME, HOME), ["capper"], SMOKE_RULES)
+	AIDecisionMaker._config_overrides["FIX_R1_HOME_CAPTURE"] = 1.0
+	var on_plan = _plan(_board(1, ENEMY_HOME, HOME), ["capper"], SMOKE_RULES)
+	_assert(_target(on_plan) == _target(off_plan), "keeper: %s with the fix, %s without" % [_target(on_plan), _target(off_plan)])
+
+func test_param_zero_restores_base() -> void:
+	print("\n--- FIX_R1_HOME_CAPTURE = 0: the base sends the unit home ---")
+	AIDecisionMaker._config_overrides["FIX_R1_HOME_CAPTURE"] = 0.0
+	var plan = _plan(_board(), ["capper"], SMOKE_RULES)
+	AIDecisionMaker._config_overrides["FIX_R1_HOME_CAPTURE"] = 1.0
+	_assert(_goes_home(plan), "with the fix off the unit captures home (%s)" % _target(plan))
