		"U_CUSTODIAN_GUARD_B": {
			"attachment_data": {
				"attached_characters": []
			},
			"disembarked_this_phase": false,
			"flags": {

			},
			"id": "U_CUSTODIAN_GUARD_B",
			"meta": {
				"abilities": [
					{
						"description": "At the start of your Command phase, friendly Adeptus Custodes units with this ability are readied. While a friendly unit is readied, you can select one of the ka'tah abilities presented below for that unit to use. If you do, that unit is no longer readied.\nEach ka'tah ability will tell you when that ka'tah ability can be used, and the effects that ka'tah ability has on the unit using it.\nWe recommend placing a token next to each readied unit, removing it when that unit is no longer readied.\nFavoured Ka'tah\nMany of the most prominent shield hosts favour a specific martial ka'tah above all others.\nAll detachments tagged 'Unique: Shield Host' state a Favoured Ka'tah. If you selected one of these detachments, the ka'tah ability that is the Favoured Ka'tah of that detachment grants the additional effect listed in that detachment.\nExample: If you selected the Solar Watch detachment, when you select the Calistus ka'tah ability for a readied unit, that unit has +2\" M in addition to the normal effect of Calistus.",
						"name": "Martial Ka'tah",
						"type": "Faction"
					},
					{
						"description": "The unit has the Deep Strike ability.",
						"name": "Deep Strike",
						"type": "Core"
					},
					{
						"description": "Friendly Adeptus Custodes units with this ability have Feel No Pain 5+ against mortal wounds.",
						"name": "Aegis of the Emperor",
						"type": "Faction"
					},
					{
						"description": "This unit's attacks have [sustained Hits 1: non-Monster/Vehicle] if any of the following apply:\n• This unit is within range of an objective.\n• The target of those attacks is within range of an objective.",
						"name": "Impenetrable Defence",
						"type": "Datasheet"
					}
				],
				"display_name": "Custodian Guard Sodality",
				"enhancements": [],
				"is_warlord": false,
				"keywords": [
					"ADEPTUS CUSTODES",
					"BATTLELINE",
					"CUSTODIAN GUARD SODALITY",
