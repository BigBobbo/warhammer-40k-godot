		"U_CHIEF_LIBRARIAN_TIGURIUS_A": {
			"attachment_data": {
				"attached_characters": []
			},
			"disembarked_this_phase": false,
			"flags": {

			},
			"id": "U_CHIEF_LIBRARIAN_TIGURIUS_A",
			"meta": {
				"abilities": [
					{
						"description": "At the start of your Command phase, you can select one combat doctrine listed below. If you do, that combat doctrine is active for friendly ADEPTUS ASTARTES units with this ability until the start of your next Command phase.\nASSAULT DOCTRINEWhen this unit is selected to make an advance move, that advance move does not prevent this unit from being eligible to declare a charge.\nDEVASTATOR DOCTRINEThis unit's ranged attacks have [ASSAULT].\nTACTICAL DOCTRINEWhen this unit is selected to make a fall-back move, that fall-back move does not prevent this unit from being eligible to shoot and eligible to declare a charge.\nUnless otherwise stated:\n• You can only select each combat doctrine once per battle.\n• Only one combat doctrine can be active for each unit. If a rule makes a combat doctrine active for a unit, any combat doctrine previously active for that unit is no longer active for that unit.",
						"name": "Combat Doctrines",
						"type": "Faction"
					},
					{
						"description": "The unit gains the Leader ability.",
						"name": "Leader",
						"type": "Core"
					},
					{
						"description": "ADEPTUS ASTARTES PSYKER units with this ability have a psyker level of 1 or higher, specified in that unit's abilities. Each psychic ability has a psychic level of 1 or higher, specified in that ability's name.\nIn a battle round, a friendly ADEPTUS ASTARTES PSYKER unit can use a number of psychic abilities whose total psychic level does not exceed that PSYKER unit's psyker level.\nExample: In a battle round, a psyker level 3 PSYKER unit could use three psychic level 1 abilities, or one psychic level 1 ability and one psychic level 2 ability, or one psychic level 3 ability.",
						"name": "Librarius",
						"type": "Faction"
					},
					{
						"description": "At the start of the battle round, if a model with this ability is your WARLORD, gain 1CP.",
						"name": "Transhuman Strategist",
						"type": "Faction"
					},
					{
						"description": "This model has the psychic abilities listed in the Psychic Abilities section.",
						"name": "Chief Librarian",
						"type": "Datasheet"
					},
					{
						"description": "This unit has Feel No Pain 4+ against psychic attacks and mortal wounds.",
						"name": "Hood of Hellfire",
						"type": "Datasheet"
					},
					{
						"description": "In your Movement phase, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:\n• On a 1, this unit is battle-shocked.\n• This unit has +1 Sv until the start of your next turn.",
						"name": "Prescience",
						"type": "Datasheet"
					},
					{
						"description": "In your Shooting phase, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:\n• On a 1, this unit is battle-shocked.\n• Select one visible enemy unit within 24\" of this unit. That enemy unit suffers 2D3 mortal wounds.",
						"name": "Telepathic Assault",
						"type": "Datasheet"
					}
				],
				"display_name": "Chief Librarian Tigurius",
				"enhancements": [],
				"is_warlord": true,
				"keywords": [
					"ADEPTUS ASTARTES",
					"CHARACTER",
					"CHIEF LIBRARIAN TIGURIUS",
					"EPIC HERO",
					"EXPLOSIVES",
					"INFANTRY",
					"PSYKER",
					"TACTICUS",
					"ULTRAMARINES"
				],
				"leader_data": {
					"can_lead": [
						"ASSAULT INTERCESSOR SQUAD",
						"BLADEGUARD VETERAN SQUAD",
						"DESOLATION SQUAD",
						"DEVASTATOR SQUAD",
						"INFERNUS SQUAD",
						"INTERCESSOR SQUAD",
						"STERNGUARD VETERAN SQUAD",
						"TACTICAL SQUAD"
					]
				},
