			"disembarked_this_phase": false,
			"flags": {

			},
			"id": "U_BOYZ_C",
			"meta": {
				"abilities": [
					{
						"description": "Friendly ORKS units with this ability can:\n• Re-roll advance rolls.\n• Become riled up, as stated in other rules.\nWhile a unit is riled up:\n• That unit has 5+ InSv.\n• That unit's ranged attacks have [ASSAULT].\n• When that unit is selected to make an advance move, that advance move does not prevent that unit from being eligible to declare a charge.\nWar Cry (Once per battle, per army): At the start of the Command phase, you can use this ability. If you do, friendly ORKS units with the Waaagh! ability are riled up until the end of the next turn.",
						"name": "Waaagh!",
						"type": "Faction"
					},
					{
						"description": "In your Shooting phase, when this unit is selected to shoot, you can use this ability. If you do, this unit's ranged attacks have +1 to hit rolls.\nPlace any number of Ammo Runt tokens next to the unit, removing them when this ability is used.",
						"name": "Ammo Runts",
						"type": "Datasheet"
					},
					{
						"description": "In the Fight phase, if this unit made a charge move this turn, this unit's melee attacks have [Lethal Hits].",
						"name": "Tide of Muscle",
						"type": "Datasheet"
					},
					{
						"description": "Being engaged does not prevent this unit from being eligible to start an action.",
						"name": "Never Too Busy to Fight",
						"type": "Datasheet"
					}
				],
				"display_name": "Boyz Alpha",
				"enhancements": [],
				"is_warlord": false,
