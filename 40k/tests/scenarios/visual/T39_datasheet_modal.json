{
  "id": "T39_datasheet_modal",
  "covers": ["design_guidelines.T39", "hud.datasheet_modal", "ui.datasheet.layout"],
  "fixture": "co_pretrigger",
  "transition_to_phase": 7,
  "description": "Datasheet modal on 'i' key. Read-only view of M/T/Sv/W/Ld/OC + weapon TABLES (ranged/melee, 7 columns) + abilities + keywords for the selected unit. Hidden by default; opens via open_for(unit_id); ESC dismisses. Also asserts the 2026-07 layout contract: the card never exceeds the viewport height and is centred vertically (it used to be a fixed 600px box that taller content overflowed off-screen). Asserts it does NOT auto-open during normal phase load (would be a regression).",

  "steps": [
    { "act": "wait_seconds", "seconds": 0.5 },

    { "act": "execute_script",
      "script": "get_node_or_null(\"/root/Main/DatasheetModal\") != null",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").visible",
      "equals": false },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").current_unit_id",
      "equals": "" },

    { "act": "screenshot", "label": "T39_closed" },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").open_for(\"U_WARBOSS_B\")",
      "equals": true },
    { "act": "wait_frames", "frames": 5 },
    { "act": "screenshot", "label": "T39_open" },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").visible",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").current_unit_id",
      "equals": "U_WARBOSS_B" },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"M \")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"T \")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"Sv \")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"W \")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"Ld \")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").stats_text.contains(\"OC \")",
      "equals": true },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").weapons_text.begins_with(\"WEAPONS\")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").keywords_text.begins_with(\"KEYWORDS\")",
      "equals": true },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").abilities_text.begins_with(\"ABILITIES\")",
      "equals": true },

    { "act": "execute_script",
      "script": "var t = tree.root.get_node_or_null(\"Main/DatasheetModal/Body/Scroll/Sections/RangedWeapons/Table\")\nreturn t != null and t.columns == 7",
      "multiline": true,
      "equals": true },
    { "act": "execute_script",
      "script": "var t = tree.root.get_node_or_null(\"Main/DatasheetModal/Body/Scroll/Sections/MeleeWeapons/Table\")\nreturn t != null and t.columns == 7",
      "multiline": true,
      "equals": true },
    { "act": "execute_script",
      "script": "var t = tree.root.get_node_or_null(\"Main/DatasheetModal/Body/Scroll/Sections/RangedWeapons/Table\")\nvar heads = []\nfor i in range(7):\n\theads.append(t.get_child(i).get_child(0).text)\nreturn heads",
      "multiline": true,
      "equals": ["RANGED WEAPONS", "RANGE", "A", "BS", "S", "AP", "D"] },
    { "act": "execute_script",
      "script": "var t = tree.root.get_node_or_null(\"Main/DatasheetModal/Body/Scroll/Sections/MeleeWeapons/Table\")\nreturn t.get_child(3).get_child(0).text",
      "multiline": true,
      "equals": "WS" },

    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nvar vp = d.get_viewport().get_visible_rect().size\nreturn d.size.y <= vp.y - 40.0",
      "multiline": true,
      "equals": true },
    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nvar vp = d.get_viewport().get_visible_rect().size\nreturn abs((d.position.y + d.size.y * 0.5) - vp.y * 0.5) <= 2.0",
      "multiline": true,
      "equals": true },
    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nvar vp = d.get_viewport().get_visible_rect().size\nreturn abs((d.position.x + d.size.x * 0.5) - vp.x * 0.5) <= 2.0",
      "multiline": true,
      "equals": true },

    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nd.max_panel_height = 320.0\nd.close()\nreturn d.open_for(\"U_WARBOSS_B\")",
      "multiline": true,
      "equals": true },
    { "act": "wait_frames", "frames": 6 },
    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nreturn int(d.size.y)",
      "multiline": true,
      "equals": 320 },
    { "act": "execute_script",
      "script": "var sb = tree.root.get_node(\"Main/DatasheetModal/Body/Scroll\").get_v_scroll_bar()\nreturn sb.max_value > sb.page",
      "multiline": true,
      "equals": true },
    { "act": "hover_node", "node": "/root/Main/DatasheetModal/Body/Scroll" },
    { "act": "simulate_wheel", "direction": "down", "count": 3 },
    { "act": "wait_frames", "frames": 3 },
    { "act": "execute_script",
      "script": "var s = tree.root.get_node(\"Main/DatasheetModal/Body/Scroll\")\nreturn s.scroll_vertical > 0",
      "multiline": true,
      "equals": true },
    { "act": "screenshot", "label": "T39_scrolled" },
    { "act": "execute_script",
      "script": "var d = tree.root.get_node(\"Main/DatasheetModal\")\nd.max_panel_height = d.DEFAULT_MAX_PANEL_HEIGHT\nreturn d.max_panel_height",
      "multiline": true,
      "equals": 760.0 },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").t39_synthesize_escape()",
      "equals": false },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").visible",
      "equals": false },

    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").open_for(\"\")",
      "equals": false },
    { "act": "execute_script",
      "script": "get_node(\"/root/Main/DatasheetModal\").open_for(\"NOPE_NOT_A_UNIT\")",
      "equals": false },

    { "act": "pixel_diff",
      "before": "T39_closed",
      "after":  "T39_open",
      "expect_min_pct": 1.0 },

    { "act": "expect_baseline_unchanged" }
  ]
}
