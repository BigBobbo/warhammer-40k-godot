{
  "id": "charge_hover_stats_dwell",
  "covers": [
    "ui.token_hover_card.dwell_delay",
    "ui.token_hover_card.suppressed_while_dragging",
    "charge.model_placement.visibility"
  ],
  "fixture": "audit_372_charge_modifier",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 9,
  "disable_ai": true,
  "description": "Charge-phase readability: the board model-stats card used to pop the instant the pointer crossed a base, so sweeping the mouse over the mob to pick a model up — and then dragging it — buried the board under a stats card. The card now waits out Main.HOVER_DWELL_SEC of a PARKED cursor, and is suppressed outright while a mouse button is held. Drives the real player path in the Charge phase with WARBOSS_B mid-charge-move: (1) a fresh hover shows nothing right away but arms the dwell; (2) parking the cursor pops the card with the unit's real stats; (3) hopping the cursor across three models faster than the dwell (0.2s per hop, 0.8s total on models) never shows it; (4) a real paused drag_board of the charging model shows nothing even parked for longer than the dwell, because LMB is down; (5) after the drop, a parked hover gets the card back.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 2 },

    { "act": "execute_script",
      "script": "GameState.state.units[\"U_WARBOSS_B\"].models[0].merge({\"position\": {\"x\": 300.0, \"y\": 1880.0}, \"rotation\": 0.0}, true)" },
    { "act": "execute_script",
      "script": "GameState.state.units[\"U_WARBOSS_IN_MEGA_ARMOUR_D\"].models[0].merge({\"position\": {\"x\": 300.0, \"y\": 2020.0}, \"rotation\": 0.0}, true)" },
    { "act": "execute_script",
      "script": "GameState.state.units[\"U_BLADE_CHAMPION_A\"].models[0].merge({\"position\": {\"x\": 300.0, \"y\": 2160.0}, \"rotation\": 0.0}, true)" },
    { "act": "execute_script",
      "script": "GameState.state.units[\"U_WARBOSS_B\"].merge({\"flags\": {}}, true)" },
    { "act": "execute_script", "script": "main.update_unit_visuals(\"U_WARBOSS_B\")" },
    { "act": "execute_script", "script": "main.update_unit_visuals(\"U_WARBOSS_IN_MEGA_ARMOUR_D\")" },
    { "act": "execute_script", "script": "main.update_unit_visuals(\"U_BLADE_CHAMPION_A\")" },
    { "act": "wait_for_tweens" },
    { "act": "wait_frames", "frames": 8 },

    { "act": "dispatch_action", "action": {
      "type": "DECLARE_CHARGE",
      "actor_unit_id": "U_WARBOSS_B",
      "payload": { "target_unit_ids": ["U_BLADE_CHAMPION_A"] }
    }},
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": {
      "type": "CHARGE_ROLL",
      "actor_unit_id": "U_WARBOSS_B",
      "payload": { "rng_seed": 23 }
    }},
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "execute_script",
      "script": "get_tree().root.find_children(\"KeepRollButton\", \"\", true, false)[0].emit_signal(\"pressed\")" },
    { "act": "wait_frames", "frames": 6 },
    { "act": "execute_script",
      "script": "main.charge_controller.set(\"active_unit_id\", \"U_WARBOSS_B\")" },
    { "act": "execute_script",
      "script": "main.charge_controller.set(\"selected_targets\", [\"U_BLADE_CHAMPION_A\"])" },
    { "act": "execute_script", "script": "main.charge_controller.awaiting_movement", "equals": true },

    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "comment": "Zoom onto the three models so the screenshots read as evidence rather than a wall of 20px tokens. view_offset is solved from screen = z*(world - view_offset): world (330,2020) lands mid board-area at z=1.2.",
      "script": "node.view_rotation = 0.0\nnode.view_zoom = 1.2\nnode.view_offset = Vector2(-445.0, 1553.0)\nnode.update_view_transform()\nvar s = node.world_to_screen_position(Vector2(300.0, 1880.0))\nreturn s.x > 400.0 and s.x < 1500.0 and s.y > 100.0 and s.y < 1000.0",
      "equals": true },
    { "act": "wait_frames", "frames": 5 },
    { "act": "screenshot", "label": "01_charge_move_enabled" },

    { "act": "hover_unit", "unit_id": "U_WARBOSS_B",
      "comment": "STEP 1 — the fix: crossing a base no longer flashes the card" },
    { "act": "wait_frames", "frames": 3 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "execute_script", "script": "main._token_hover_unit_id", "equals": "" },
    { "act": "execute_script", "script": "main._token_hover_pending_unit_id", "equals": "U_WARBOSS_B",
      "comment": "the dwell IS armed — the card is waiting, not broken" },
    { "act": "screenshot", "label": "02_hover_no_instant_card" },

    { "act": "wait_seconds", "seconds": 0.9,
      "comment": "STEP 2 — park the cursor past HOVER_DWELL_SEC and the stats arrive" },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": true },
    { "act": "execute_script", "script": "main._token_hover_unit_id", "equals": "U_WARBOSS_B" },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"Warboss\")", "equals": true },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"M:6\\\"\")", "equals": true },
    { "act": "screenshot", "label": "03_dwell_elapsed_card_shown" },

    { "act": "hover_board_at", "x": 300.0, "y": 2020.0,
      "comment": "STEP 3 — a moving cursor: each hop re-arms the dwell, so nothing ever shows. Hops are wall-clock (wait_seconds), NOT wait_frames: llvmpipe renders single-digit FPS in this container, where 12 frames is several seconds and would clear the dwell." },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "hover_board_at", "x": 300.0, "y": 2160.0 },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "hover_board_at", "x": 300.0, "y": 2020.0 },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "hover_board_at", "x": 300.0, "y": 1880.0 },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "screenshot", "label": "04_sweep_across_models_no_card" },

    { "act": "hover_unit", "unit_id": "U_WARBOSS_B" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip", "timeout_s": 2.0,
      "comment": "park again so the card IS up when the drag starts — proves the drag TAKES IT DOWN, not merely that it never came up" },

    { "act": "drag_board", "from_x": 300, "from_y": 1880, "to_x": 420, "to_y": 2020, "steps": 10, "release": false,
      "comment": "STEP 4 — the reported case: a real charge-move drag with LMB still down" },
    { "act": "execute_script", "script": "Input.get_mouse_button_mask()", "equals": 1,
      "comment": "LMB really is held — the suppression below is the button check firing, not an accident" },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "execute_script", "script": "main._token_hover_pending_unit_id", "equals": "",
      "comment": "the held button cancels the dwell outright — parking mid-drag must not pop it either" },
    { "act": "wait_seconds", "seconds": 0.9 },
    { "act": "execute_script", "script": "main._token_hover_tooltip.visible", "equals": false },
    { "act": "screenshot", "label": "05_mid_drag_parked_still_no_card" },

    { "act": "mouse_up_board", "x": 420, "y": 2020 },
    { "act": "wait_frames", "frames": 6 },
    { "act": "execute_script", "script": "main.charge_controller.moved_models.has(\"m1\")", "equals": true,
      "comment": "the drag really moved the charging model — this was the player path, not a stub" },

    { "act": "hover_unit", "unit_id": "U_WARBOSS_B",
      "comment": "STEP 5 — button released: parking gets the stats back" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip", "timeout_s": 2.0 },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"Warboss\")", "equals": true },
    { "act": "screenshot", "label": "06_after_drop_dwell_card_returns" }
  ]
}
