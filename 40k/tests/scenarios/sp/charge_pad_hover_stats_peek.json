{
  "id": "charge_pad_hover_stats_peek",
  "covers": [
    "ui.token_hover_card.pad_suppressed",
    "ui.token_hover_card.r4_l4_peek",
    "controller.settings.pad_hover_stats_card",
    "charge.model_placement.visibility"
  ],
  "fixture": "audit_372_charge_modifier",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 9,
  "disable_ai": true,
  "description": "Steam Deck charge-phase readability: the board model-stats card that pops up on hover used to sit on top of the very spot the virtual cursor was dragging a model to, hiding the charge destination. It is now suppressed while the controller is the active device, and the R4 / L4 back paddles peek at it on demand (hold to show, release to hide). This scenario drives the real hover path in the Charge phase: mouse & keyboard still get the card unchanged; on the pad the same hover shows nothing; holding R4 (JOY_BUTTON_PADDLE1 = 16) brings up the hovered model's card and releasing removes it; L4 (PADDLE2 = 17) does the same; and Settings > Controller > 'Always show model stats card on hover' restores the old always-on behaviour.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 },

    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "script": "SettingsService.set_pad_hover_stats_card(false)\nSettingsService.set_input_mode_policy(\"kbm\")\nreturn node._token_hover_allowed()",
      "equals": true },
    { "act": "hover_unit", "unit_id": "U_BATTLEWAGON_G" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip" },
    { "act": "screenshot", "label": "01_kbm_hover_card_shown" },

    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "script": "SettingsService.set_input_mode_policy(\"pad\")\nreturn [InputDeviceManager.is_pad_active(), node._token_hover_allowed()]",
      "equals": [true, false] },
    { "act": "hover_unit", "unit_id": "U_BATTLEWAGON_G" },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },
    { "act": "screenshot", "label": "02_pad_hover_card_suppressed" },

    { "act": "simulate_joy_button", "button_index": 16, "state": "press" },
    { "act": "wait_seconds", "seconds": 0.45, "comment": "a HOLD, not a tap — a tap keeps the paddle's model-hop meaning" },
    { "act": "execute_script", "multiline": true, "node": "/root/PadRouter", "script": "return node.stats_peek_active", "equals": true },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip" },
    { "act": "execute_script", "multiline": true, "node": "/root/Main", "script": "return node._token_hover_unit_id", "equals": "U_BATTLEWAGON_G" },
    { "act": "screenshot", "label": "03_pad_r4_held_card_shown" },

    { "act": "simulate_joy_button", "button_index": 16, "state": "release" },
    { "act": "execute_script", "multiline": true, "node": "/root/PadRouter", "script": "return node.stats_peek_active", "equals": false },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },
    { "act": "screenshot", "label": "04_pad_r4_released_card_hidden" },

    { "act": "simulate_joy_button", "button_index": 17, "state": "press" },
    { "act": "wait_seconds", "seconds": 0.45 },
    { "act": "execute_script", "multiline": true, "node": "/root/PadRouter", "script": "return node.stats_peek_active", "equals": true },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip" },
    { "act": "screenshot", "label": "05_pad_l4_held_card_shown" },
    { "act": "simulate_joy_button", "button_index": 17, "state": "release" },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },

    { "act": "execute_script",
      "script": "GameState.state.units[\"U_BATTLEWAGON_G\"].models[0].merge({\"position\": {\"x\": 700.0, \"y\": 2150.0}, \"rotation\": 0.0}, true)" },
    { "act": "execute_script",
      "script": "GameState.state.units[\"U_BLADE_CHAMPION_A\"].models[0].merge({\"position\": {\"x\": 973.0, \"y\": 2150.0}}, true)" },
    { "act": "execute_script", "script": "GameState.state.players[\"1\"].merge({\"cp\": 0}, true)" },
    { "act": "execute_script", "script": "GameState.state.players[\"2\"].merge({\"cp\": 0}, true)" },
    { "act": "execute_script", "script": "main.charge_controller._refresh_ui()" },
    { "act": "execute_script", "multiline": true,
      "script": "var cc = tree.current_scene.charge_controller\nfor i in range(cc.unit_selector.item_count):\n\tif str(cc.unit_selector.get_item_metadata(i)) == \"U_BATTLEWAGON_G\":\n\t\tcc.unit_selector.select(i)\n\t\tcc.unit_selector.item_selected.emit(i)\n\t\tbreak\nreturn str(cc.active_unit_id)",
      "equals": "U_BATTLEWAGON_G" },
    { "act": "simulate_joy_button", "button_index": 0, "comment": "A toggles the first eligible target into the declaration" },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "simulate_joy_button", "button_index": 6, "comment": "Start = Declare Charge" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "simulate_joy_button", "button_index": 6, "comment": "Start = Roll 2D6" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "script": "return node.charge_controller.awaiting_movement", "equals": true },

    { "act": "hover_unit", "unit_id": "U_BATTLEWAGON_G" },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },
    { "act": "screenshot", "label": "06_charge_move_destination_unobstructed" },
    { "act": "simulate_joy_button", "button_index": 16, "state": "press" },
    { "act": "wait_seconds", "seconds": 0.45, "comment": "a HOLD, not a tap — a tap keeps the paddle's model-hop meaning" },
    { "act": "execute_script", "multiline": true, "node": "/root/PadHintBar",
      "script": "return node.label_for(\"r4\")", "equals": "Hold: Model Stats" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip" },
    { "act": "screenshot", "label": "07_charge_move_r4_hint_and_card" },
    { "act": "simulate_joy_button", "button_index": 16, "state": "release" },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },

    { "act": "simulate_joy_button", "button_index": 16, "comment": "a TAP is still the model hop it always was — no card, so the paddle keeps both jobs" },
    { "act": "wait_seconds", "seconds": 0.45 },
    { "act": "execute_script", "multiline": true, "node": "/root/PadRouter", "script": "return node.stats_peek_active", "equals": false },
    { "act": "expect_node_property", "node": "/root/Main/TokenHoverTooltip", "property": "visible", "equals": false },

    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "script": "SettingsService.set_pad_hover_stats_card(true)\nreturn node._token_hover_allowed()",
      "equals": true },
    { "act": "hover_unit", "unit_id": "U_BLADE_CHAMPION_A" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip" },
    { "act": "execute_script", "multiline": true, "node": "/root/PadHintBar",
      "script": "return node.label_for(\"r4\")", "equals": "" },
    { "act": "screenshot", "label": "08_pad_setting_on_card_always_shown" },

    { "act": "execute_script", "multiline": true, "node": "/root/Main",
      "script": "SettingsService.set_pad_hover_stats_card(false)\nSettingsService.set_input_mode_policy(\"auto\")\nreturn SettingsService.pad_hover_stats_card",
      "equals": false }
  ]
}
