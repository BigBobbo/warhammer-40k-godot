    { "act": "execute_script", "multiline": true,
      "script": "var n := 0\nfor b in PhaseManager.get_current_phase_instance().dice_log:\n\tif str(b.get(\"context\", \"\")) == \"grot_shields\" and str(b.get(\"target_unit_id\", \"\")) == \"U_FLASH_GITZ_A\":\n\t\tn += int(b.get(\"intercepted\", 0))\nreturn n",
