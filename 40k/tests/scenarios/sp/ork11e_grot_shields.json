      "equals": false },
    { "act": "execute_script", "multiline": true, "script": "var n := 0\nfor m in GameState.get_unit(\"U_GRETCHIN_C\").models:\n\tif m.get(\"alive\", true):\n\t\tn += 1\nreturn n", "equals": 10 },

