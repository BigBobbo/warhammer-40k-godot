    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(2)" },
    { "act": "execute_script", "script": "StratagemManager.get_stratagem(\"faction_ork_da_big_hunt_instinctive_hunters\").get(\"implemented\", false)", "equals": true },
    { "act": "execute_script", "multiline": true, "script": "var bs = GameState.get_unit(\"U_BEAST_SNAGGA_BOYZ_A\")\nfor i in range(bs.models.size()):\n\tvar col = i % 5\n\tvar row = int(i / 5)\n\tbs.models[i][\"position\"] = {\"x\": (1.0 + col * 1.3) * 40.0, \"y\": (57.6 + row * 1.3) * 40.0}\nreturn not RulesEngine.is_unit_engaged(\"U_BEAST_SNAGGA_BOYZ_A\", GameState.state)", "equals": true, "comment": "setup privilege: Beast Snagga Boyz unengaged in the Orks' corner (within 6\" of a battlefield edge)" },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_phase_property", "property": "pile_in_step_11e", "equals": 2 },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/EndFightConfirmationDialog/Content/Actions/ConfirmEndFight", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "click_node", "node": "/root/Main/PhaseActionButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/EndFightConfirmationDialog/Content/Actions/ConfirmEndFight", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "multiline": true, "script": "var d = tree.current_scene._phase_end_confirm\nif d != null and d.visible:\n\td.get_ok_button().pressed.emit()\nreturn true", "equals": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_phase_property", "property": "consolidation_step_11e", "equals": 1 },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel/EndConsolidationButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel/EndConsolidationButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().get(\"window_id\", \"\")", "equals": "fight_phase_end" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 2 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog\").defending_player", "equals": 2 },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_da_big_hunt_instinctive_hunters/Buttons/Use_faction_ork_da_big_hunt_instinctive_hunters_U_BEAST_SNAGGA_BOYZ_A", "timeout_s": 2.0 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_da_big_hunt_instinctive_hunters/Buttons/Use_faction_ork_da_big_hunt_instinctive_hunters_U_BEAST_SNAGGA_BOYZ_A", "property": "disabled", "equals": false },
    { "act": "execute_script", "script": "main._reactive_stratagem_overlay_label.text.contains(\"Player 2\")", "equals": true },
    { "act": "execute_script", "script": "GameState.get_current_phase()", "equals": 10, "comment": "the phase waits for the decision before it ends" },
    { "act": "expect_token_visible", "unit_id": "U_BEAST_SNAGGA_BOYZ_A", "timeout_s": 2.0, "comment": "on the board before the stratagem" },
    { "act": "screenshot", "label": "01_instinctive_hunters_window" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_da_big_hunt_instinctive_hunters/Buttons/Use_faction_ork_da_big_hunt_instinctive_hunters_U_BEAST_SNAGGA_BOYZ_A" },
    { "act": "wait_seconds", "seconds": 0.6 },

    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "expect_cp", "player": 1, "delta_from_start": 0 },
    { "act": "execute_script", "script": "int(GameState.get_unit(\"U_BEAST_SNAGGA_BOYZ_A\").get(\"status\", -1)) == int(GameState.UnitStatus.IN_RESERVES)", "equals": true },
    { "act": "expect_state", "path": "units.U_BEAST_SNAGGA_BOYZ_A.reserve_type", "equals": "strategic_reserves" },
    { "act": "expect_state", "path": "units.U_BEAST_SNAGGA_BOYZ_A.flags.repositioned_to_reserves", "equals": true },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"INSTINCTIVE HUNTERS: Beast Snagga Boyz is placed in strategic reserves\")", "expect_min": 1 },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "multiline": true, "script": "var t = ScenarioRunner._find_unit_token(\"U_BEAST_SNAGGA_BOYZ_A\")\nreturn t == null or not t.is_visible_in_tree()", "equals": true, "comment": "its tokens have left the board" },
    { "act": "screenshot", "label": "02_beast_snagga_in_strategic_reserves" }
  ]
