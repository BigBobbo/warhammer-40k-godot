    { "act": "expect_cp", "player": 1, "equals": 8 },
    { "act": "expect_cp", "player": 2, "equals": 7 },
    { "act": "execute_script", "script": "main._p1_cp_label.text", "equals": "CP:8" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"Aquila Commander\")", "equals": 1 },
    { "act": "execute_script", "script": "GameState.get_bonus_cp_gained_this_round(1)", "equals": 1 },
    { "act": "screenshot", "label": "01_round2_aquila_commander_cp8" },
    { "act": "click_if_visible", "node": "/root/SecondaryMissionReviewDialog/OuterScroll/MainContainer/ButtonRow/DoneButton" },
    { "act": "wait_seconds", "seconds": 0.6 },

    { "act": "execute_script", "multiline": true, "comment": "setup privilege: skip to the end of the Orks' turn of battle round 2", "script": "GameState.set_active_player(2)\nPhaseManager.transition_to_phase(11)\nreturn true", "equals": true },
