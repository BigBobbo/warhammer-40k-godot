{
  "id": "ork11e_reactive_core_then_codex",
  "covers": [
    "shooting.reactive.multiple_per_targeting",
    "stratagem.ork11e.grot_shields",
    "dialogs.StratagemDialog.legacy_fold_in"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 8,
  "disable_ai": true,
  "description": "Several reactive stratagems on ONE targeting, core card first: the reverse order of ork11e_grot_shields. Fixture ork11e_orks_reactive: P1 Custodes ACTIVE, P2 Orks. Setup-only privileges: P2's detachment is flipped to Runt Swarm and its stratagems reloaded; the Kommandos (SMOKE) are moved into Custodian Guard C's range. Custodian Guard C (selected by clicking its token) splits its guardian spears between the Flash Gitz, the Tankbustas and the Kommandos. After the Kommandos' Distraction Grot prompt is declined, the defender's dialog offers SMOKESCREEN (a legacy core card) and GROT SHIELDS. A real click on SMOKESCREEN's Use button spends 1 CP and the dialog RE-OPENS at the same stable path with GROT SHIELDS still on offer (SMOKESCREEN gone, once per phase); Use on Gretchin C -> the unit picker -> Tankbustas spends 1 CP more and the attack resumes.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 8 },
    { "act": "execute_script", "script": "SettingsService.set(\"auto_allocate_wounds\", true)" },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"2\"].merge({\"detachment\": \"Runt Swarm\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(2)" },
    { "act": "execute_script", "multiline": true, "comment": "setup privilege: the Kommandos (SMOKE) move into Custodian Guard C's range, clear of every enemy",
      "script": "var xs = [37.0, 38.5, 40.0, 41.5, 43.0]\nvar ys = [39.5, 41.0]\nvar ms = GameState.get_unit(\"U_KOMMANDOS_A\").models\nfor i in range(ms.size()):\n\tms[i][\"position\"] = {\"x\": xs[i % 5] * 40.0, \"y\": ys[i / 5] * 40.0}\nvar ph = PhaseManager.get_current_phase_instance()\nph.game_state_snapshot = GameState.create_snapshot()\nph._compute_engagement_flags()\ntree.root.get_node(\"Main\")._recreate_unit_visuals()\nreturn RulesEngine.is_unit_engaged(\"U_KOMMANDOS_A\", GameState.state)",
      "equals": false },

    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_D", "comment": "the panel auto-highlights a shooter on phase entry; picking another unit first makes the Custodian Guard C token click a real selection" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_C" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_shooter_id", "equals": "U_CUSTODIAN_GUARD_C" },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_CUSTODIAN_GUARD_C",
      "payload": { "weapon_id": "guardian_spear___ranged_ranged", "target_unit_id": "U_FLASH_GITZ_A", "model_ids": ["m1", "m2"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_CUSTODIAN_GUARD_C",
      "payload": { "weapon_id": "guardian_spear___ranged_ranged", "target_unit_id": "U_TANKBUSTAS_A", "model_ids": ["m3"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_CUSTODIAN_GUARD_C",
      "payload": { "weapon_id": "guardian_spear___ranged_ranged", "target_unit_id": "U_KOMMANDOS_A", "model_ids": ["m4", "m5"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "CONFIRM_TARGETS" } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "expect_node_visible", "node": "/root/DistractionGrotDialog", "timeout_s": 3.0, "comment": "the Kommandos' own Distraction Grot prompt comes first — not under test, declined" },
    { "act": "click_node", "button_text": "Decline" },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_smokescreen_11e/Buttons/Use_smokescreen_11e_U_KOMMANDOS_A", "property": "disabled", "equals": false },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_runt_swarm_grot_shields/Buttons/Use_faction_ork_runt_swarm_grot_shields_U_GRETCHIN_C", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "01_core_and_codex_offered" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_smokescreen_11e/Buttons/Use_smokescreen_11e_U_KOMMANDOS_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_KOMMANDOS_A.flags.stratagem_cover", "equals": true },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().awaiting_reactive_stratagem", "equals": true },
    { "act": "execute_script", "script": "main.get_tree().root.get_node_or_null(\"StratagemDialog/Content/StratScroll/StratList/Card_smokescreen_11e\") == null", "equals": true },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_runt_swarm_grot_shields/Buttons/Use_faction_ork_runt_swarm_grot_shields_U_GRETCHIN_C", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "02_reopened_grot_shields_left" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_runt_swarm_grot_shields/Buttons/Use_faction_ork_runt_swarm_grot_shields_U_GRETCHIN_C" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_visible", "node": "/root/StratagemTargetDialog", "timeout_s": 3.0 },
    { "act": "click_node", "node": "/root/StratagemTargetDialog/Content/Pick_U_TANKBUSTAS_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -2 },
    { "act": "expect_state", "path": "units.U_TANKBUSTAS_A.flags.ork11e_grot_shields.gretchin_unit_id", "equals": "U_GRETCHIN_C" },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_FLASH_GITZ_A\").flags.has(\"ork11e_grot_shields\")", "equals": false },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().awaiting_reactive_stratagem", "equals": false },
    { "act": "execute_script", "multiline": true,
      "script": "var d = tree.root.get_node_or_null(\"StratagemDialog\")\nreturn d == null or not d.visible",
      "equals": true },
    { "act": "execute_script", "script": "main.get_node(\"ShootingController\").resolution_dock.is_active()", "equals": true },
    { "act": "screenshot", "label": "03_both_used_attack_resumes" }
  ]
}
