    { "act": "expect_state", "path": "units.U_BLADE_CHAMPION_A.flags.cus11e_readied", "equals": true },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_BLADE_CHAMPION_A", "timeout_s": 6.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_BLADE_CHAMPION_A", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 5.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id", "equals": "unit_selected_to_fight" },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_BLADE_CHAMPION_A", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "02_rendax_card_offered_at_0cp" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_BLADE_CHAMPION_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "re-opened window (no paid stratagem at 0 CP) — normally closed already" },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "expect_cp", "player": 1, "equals": 0 },
    { "act": "expect_state", "path": "units.U_BLADE_CHAMPION_A.flags.cus11e_katah_rendax", "equals": true },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_BLADE_CHAMPION_A\").flags.get(\"cus11e_readied\", false)", "equals": false },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"uses RENDAX\")", "expect_min": 1 },

    { "act": "expect_node_visible", "node": "/root/AttackAssignmentDialog", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/AllToTargetButton", "emit_pressed": true },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/ConfirmButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(12)" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "multiline": true, "comment": "the Blade Champion's melee hit roll vs the Deff Dread carried [LETHAL HITS] (none of its Vaultswords profiles has it natively)", "script": "var ph = PhaseManager.get_current_phase_instance()\nvar found := false\nfor d in ph.dice_log:\n\tif str(d.get(\"context\", \"\")) == \"hit_roll_melee\":\n\t\tprint(\"[cus11e rendax] hit_roll_melee: weapon=\", d.get(\"weapon\", \"\"), \" lethal=\", d.get(\"lethal_hits_weapon\", false), \" crits=\", d.get(\"critical_hits\", 0))\n\t\tif bool(d.get(\"lethal_hits_weapon\", false)):\n\t\t\tfound = true\nreturn found", "equals": true },
    { "act": "screenshot", "label": "03_rendax_lethal_hits_resolved" },
    { "act": "execute_script", "script": "main.get_node(\"FightController\").dice_log_display.get_parsed_text().contains(\"[LETHAL HITS]\")", "equals": true },
    { "act": "execute_script", "multiline": true, "comment": "show the Dice Log tab ([LETHAL HITS] critical hits auto-wound)", "script": "var panel = tree.root.get_node(\"Main\").get_node_or_null(\"HUD_Left/GameLogPanel\")\nif panel == null:\n\tfor n in tree.root.get_node(\"Main\").find_children(\"*\", \"\", true, false):\n\t\tif n.get(\"_tab_dice_button\") != null:\n\t\t\tpanel = n\n\t\t\tbreak\nif panel == null:\n\treturn \"panel not found\"\npanel._tab_dice_button.emit_signal(\"pressed\")\nreturn true", "equals": true },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "screenshot", "label": "04_dice_log_lethal_hits" }
  ]
}
