      "act": "execute_script",
      "multiline": true,
      "script": "var p = PhaseManager.get_current_phase_instance()\nfor d in p.dice_log:\n\tif typeof(d) == TYPE_DICTIONARY and (str(d.get(\"context\", \"\")) == \"to_hit\" and int(d.get(\"sustained_hits_value\", 0)) == 1 and int(d.get(\"sustained_bonus_hits\", -1)) == int(d.get(\"critical_hits\", -2))):\n\t\treturn true\nreturn false",
