      "script": "var c = tree.root.get_node(\"Main\").shooting_controller\nvar w = RulesEngine.get_unit_weapons(\"U_DEFFKOPTAS_A\", GameState.state)\nfor mid in w:\n\tfor wid in w[mid]:\n\t\tif \"SH 1\" in c._calc_weapon_expected_damage(str(wid), \"U_CUSTODIAN_GUARD_C\").get(\"active_tags\", []):\n\t\t\treturn true\nreturn false",
