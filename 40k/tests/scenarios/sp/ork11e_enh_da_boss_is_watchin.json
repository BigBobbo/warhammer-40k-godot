  { "act": "execute_script", "script": "tree.root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_ork11e_ab_enh_da_boss_is_watchin\").find_child(\"Cost\", true, false).text", "equals": "Enhancement", "comment": "an enhancement card: no CP cost" },
  { "act": "screenshot", "label": "01_da_boss_is_watchin_card" },
