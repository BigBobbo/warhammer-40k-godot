  { "act": "execute_script", "script": "GameState.get_unit(\"U_WARBOSS_A\").flags.get(\"ork11e_riled_up\", false)", "equals": true, "comment": "the Warboss (part of the Attached unit) too" },
  { "act": "execute_script", "multiline": true, "script": "return load(\"res://autoloads/EffectPrimitives.gd\").get_effect_invuln(GameState.get_unit(\"U_BOYZ_C\"))", "equals": 5, "comment": "riled up: 5+ invulnerable save" },
  { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"Da Boss is Watchin'\")", "expect_min": 1 },
