{
  "id": "ork11e_crazed_rampage",
  "covers": [
    "stratagem.window.enemy_targets_unit_fight",
    "stratagem.ork11e.crazed_rampage",
    "phases.FightPhase.enemy_targets_unit_fight",
    "phases.FightPhase.fight_on_death_11e",
    "dialogs.StratagemDialog.window_mode",
    "stratagems.dread_mob.loading"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 9,
  "disable_ai": true,
  "description": "Codex: Orks (11e) CRAZED RAMPAGE (Dread Mob) in the ENEMY's Fight phase through the real enemy_targets_unit_fight window. Fixture ork11e_orks_reactive (P1 Custodes active, P2 Orks), detachment switched to Dread Mob (setup privilege, stratagems reloaded). Setup-only privileges in the Custodes' Charge phase: Custodian Guard C is placed beside the Deff Dread (engaged with it only) with Fights First and inflated wounds; the Deff Dread starts on 2 wounds so the swing can destroy it; auto wound allocation. The Custodes player picks Custodian Guard C, a Ka'tah stance, assigns all attacks to the Deff Dread and confirms: the window opens for PLAYER 2 with CRAZED RAMPAGE (enabled Use). A real click spends P2's CP; when the Deff Dread is destroyed it rolls a D6 +3 (DEFF DREAD) — always 4+ — so it is NOT removed: it stays on the battlefield with 0 wounds, the Ork player then fights with it, and it is removed once it has fought.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 9 },
    { "act": "execute_script", "multiline": true, "comment": "Codex: Adeptus Custodes 11e (WP-C3): loading this Command-phase fixture readied the Custodes (Martial Ka'tah), which would open ka'tah windows (fight_phase_start / unit_selected_to_fight). Not under test here (the cus11e_* scenarios cover them): un-ready the Custodes - replaces the old 'click the Dacatarai stance' step.", "script": "for uid in GameState.state.units:\n\tvar u = GameState.state.units[uid]\n\tif u.get(\"flags\", null) is Dictionary:\n\t\tu.flags.erase(\"cus11e_readied\")\nreturn true", "equals": true },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"2\"].merge({\"detachment\": \"Dread Mob\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(2)" },
    { "act": "execute_script", "script": "StratagemManager.get_stratagem(\"faction_ork_dread_mob_crazed_rampage\").get(\"implemented\", false)", "equals": true },
    { "act": "execute_script", "script": "SettingsService.set(\"auto_allocate_wounds\", true)" },
    { "act": "execute_script", "multiline": true, "script": "var dd = GameState.get_unit(\"U_DEFF_DREAD_A\")\nvar c = dd.models[0].position\nvar offs = [Vector2(-2.4, -0.9), Vector2(-4.0, -0.9), Vector2(2.4, -0.9), Vector2(4.0, -0.9), Vector2(-4.0, -2.5)]\nvar cg = GameState.get_unit(\"U_CUSTODIAN_GUARD_C\")\nfor i in range(cg.models.size()):\n\tcg.models[i][\"position\"] = {\"x\": float(c.x) + offs[i].x * 40.0, \"y\": float(c.y) + offs[i].y * 40.0}\n\tcg.models[i][\"wounds\"] = 99\n\tcg.models[i][\"current_wounds\"] = 99\ncg[\"flags\"].merge({\"fights_first\": true, \"charged_this_turn\": true}, true)\ndd.models[0][\"current_wounds\"] = 2\nvar t = PhaseManager.get_current_phase_instance()\nreturn RulesEngine.is_unit_engaged(\"U_CUSTODIAN_GUARD_C\", GameState.state)", "equals": true, "comment": "setup privilege: Custodian Guard C beside the Deff Dread, Fights First; the Deff Dread on 2 wounds" },
    { "act": "dispatch_action", "action": { "type": "END_CHARGE", "player": 1 } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/HeroicInterventionDialog/Content/Buttons/DeclineButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "expect_phase", "equals": 10 },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_CUSTODIAN_GUARD_C", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_CUSTODIAN_GUARD_C" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_node_visible", "node": "/root/AttackAssignmentDialog", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/AllToTargetButton", "emit_pressed": true },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/ConfirmButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().get(\"window_id\", \"\")", "equals": "enemy_targets_unit_fight" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 2 },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_dread_mob_crazed_rampage/Buttons/Use_faction_ork_dread_mob_crazed_rampage_U_DEFF_DREAD_A", "timeout_s": 2.0 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_dread_mob_crazed_rampage/Buttons/Use_faction_ork_dread_mob_crazed_rampage_U_DEFF_DREAD_A", "property": "disabled", "equals": false },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll\").ensure_control_visible(main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_dread_mob_crazed_rampage/Buttons/Use_faction_ork_dread_mob_crazed_rampage_U_DEFF_DREAD_A\"))" },
    { "act": "wait_frames", "frames": 3 },
    { "act": "screenshot", "label": "01_crazed_rampage_window" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_dread_mob_crazed_rampage/Buttons/Use_faction_ork_dread_mob_crazed_rampage_U_DEFF_DREAD_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.ork11e_fod_mode", "equals": "deff_dread" },

    { "act": "execute_script", "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(12)" },
    { "act": "wait_frames", "frames": 4 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightResolutionDock/DockPrimaryButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "script": "\"U_CUSTODIAN_GUARD_C\" in PhaseManager.get_current_phase_instance().units_that_fought", "equals": true },
    { "act": "execute_script", "multiline": true, "script": "var p = PhaseManager.get_current_phase_instance()\nvar roll = {}\nfor d in p.dice_log:\n\tif typeof(d) == TYPE_DICTIONARY and str(d.get(\"context\", \"\")) == \"ork11e_fight_on_death\":\n\t\troll = d\nvar m = GameState.get_unit(\"U_DEFF_DREAD_A\").models[0]\nprint(\"CR scenario: roll=%s alive=%s wounds=%s pending=%s\" % [str(roll.get(\"rolls_raw\", [])), str(m.get(\"alive\", true)), str(m.get(\"current_wounds\", \"\")), str(GameState.get_unit(\"U_DEFF_DREAD_A\").flags.get(\"ork11e_fod_pending\", []))])\nreturn not roll.is_empty() and int(roll.modifier) == 3 and roll.kept and m.get(\"alive\", false) and int(m.current_wounds) == 0 and GameState.get_unit(\"U_DEFF_DREAD_A\").flags.get(\"ork11e_fod_pending\", []).size() == 1", "equals": true, "comment": "the destroyed Deff Dread rolled D6+3 and stays on the battlefield (0 wounds, pending)" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"CRAZED RAMPAGE:\")", "expect_min": 1 },
    { "act": "click_if_visible", "node": "/root/CounterOffensiveDialog/Content/Buttons/DeclineButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "screenshot", "label": "02_deff_dread_destroyed_but_not_removed" },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_DEFF_DREAD_A", "timeout_s": 8.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_DEFF_DREAD_A" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_node_visible", "node": "/root/AttackAssignmentDialog", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/AllToTargetButton", "emit_pressed": true },
    { "act": "click_node", "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/ConfirmButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(12)" },
    { "act": "wait_frames", "frames": 4 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightResolutionDock/DockPrimaryButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "script": "\"U_DEFF_DREAD_A\" in PhaseManager.get_current_phase_instance().units_that_fought", "equals": true },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_DEFF_DREAD_A\").models[0].get(\"alive\", true)", "equals": false, "comment": "it has fought: now it is removed" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"removed from the battlefield (has fought)\")", "expect_min": 1 },
    { "act": "screenshot", "label": "03_deff_dread_removed_after_fighting" }
  ]
}
