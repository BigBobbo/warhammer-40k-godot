{
  "id": "ai_suggestion_unit_order_deployment",
  "covers": [
    "ai.suggestion.breakdown_panel",
    "ai.suggestion.unit_order",
    "ai.suggestion.unit_order_refresh"
  ],
  "fixture": "asym_2000_predeploy",
  "disable_ai": true,
  "edition": 11,
  "rng_seed": 7,
  "description": "UNIT-ORDER (deployment): K card says 'Deploying next: <unit> — <reason>', lists the units still to deploy, Unit ▶ / ◀ Unit cycle, and once the suggested unit is deployed the card refreshes without it.",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"HUMAN\"})"
    },
    {
      "act": "execute_script",
      "script": "main.refresh_ai_suggestion_button()"
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.clear_action_log()"
    },
    {
      "act": "simulate_key",
      "keycode": "K"
    },
    {
      "act": "wait_frames",
      "frames": 6
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel != null and main._ai_suggestion_panel.is_visible_in_tree()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"Deploying next: \")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._cycle_order.size()",
      "expect_min": 2
    },
    {
      "act": "execute_script",
      "script": "str(main._ai_suggestion_panel._decision.get(\"actor_unit_id\", main._ai_suggestion_panel._decision.get(\"unit_id\", \"\"))) == str(main._ai_suggestion_panel._cycle_order[0])",
      "equals": true,
      "comment": "the AI's pick is first in its order"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._next_unit_btn.visible",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.set_meta(\"probe_n\", main._ai_suggestion_panel._cycle_order.size())"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.set_meta(\"probe_first\", str(main._ai_suggestion_panel._cycle_order[0]))"
    },
    {
      "act": "screenshot",
      "label": "01_deployment_order"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._next_unit_btn.pressed.emit()",
      "comment": "press the card's Unit ▶ button via its own pressed signal — the card is created on the first K press, so the loop's selector dry-run cannot resolve a click_node into it"
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
      "act": "execute_script",
      "script": "str(main._ai_suggestion_panel._decision.get(\"actor_unit_id\", main._ai_suggestion_panel._decision.get(\"unit_id\", \"\"))) == str(main._ai_suggestion_panel._cycle_order[1])",
      "equals": true,
      "comment": "Unit ▶ shows the 2nd unit"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"2nd in the order\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"would deploy\")",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "02_deployment_second_unit"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._prev_unit_btn.pressed.emit()",
      "comment": "press the card's ◀ Unit button via its own pressed signal — the card is created on the first K press, so the loop's selector dry-run cannot resolve a click_node into it"
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
      "act": "execute_script",
      "script": "str(main._ai_suggestion_panel._decision.get(\"actor_unit_id\", main._ai_suggestion_panel._decision.get(\"unit_id\", \"\"))) == main._ai_suggestion_panel.get_meta(\"probe_first\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.current_phase_instance.execute_action(main._ai_suggestion_panel._decision).get(\"success\", false)",
      "comment": "the player deploys the suggested unit where the AI suggested; the open card re-asks the AI"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.visible",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._cycle_order.has(main._ai_suggestion_panel.get_meta(\"probe_first\"))",
      "equals": false,
      "comment": "the unit that acted has left the order"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._subtitle.text.contains(\"updated after\")",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "03_deployment_after_refresh"
    }
  ]
}
