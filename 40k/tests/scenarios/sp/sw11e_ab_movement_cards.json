{
  "id": "sw11e_ab_movement_cards",
  "covers": [
    "codex.space_wolves.datasheet_abilities.murderous_hurricane",
    "codex.space_wolves.datasheet_abilities.high_king_of_fenris",
    "codex.space_wolves.datasheet_abilities.gift_of_the_iron_wolf",
    "codex.space_wolves.librarius",
    "scripts.codex.space_wolves.SWAbilities11e",
    "stratagem.window.phase_start",
    "stratagem.window.unit_selected_to_move",
    "dialogs.StratagemTargetDialog"
  ],
  "description": "WP-S4 Space Wolves Movement-phase abilities through the real windows. Fixture sw11e_s4_move (P1 Space Wolves, round 2): Njal Stormcaller leads Grey Hunters 10\" from Ork Boyz; Logan Grimnar on the table with Blood Claws in strategic reserves; an Iron Priest next to a damaged (3 W) Venerable Dreadnought. Entering the Movement phase opens P1's phase_start window: MURDEROUS HURRICANE (psychic level 1, Librarius) — a real click and a real pick of the Boyz: psychic roll logged, the Boyz cannot make snap-shooting attacks (FIRE OVERWATCH refuses them), 1 of Njal's 3 psyker levels spent, the power not re-offered; HIGH KING OF FENRIS — real click + pick of the Blood Claws: their ingress this phase counts as battle round 3. Then a real click on the Iron Priest token selects it to move: the unit_selected_to_move window offers GIFT OF THE IRON WOLF; a real click + pick heals the Dreadnought D3 and gives it the ignore-modifiers flag. No CP is spent.",
  "fixture": "sw11e_s4_move",
  "edition": 11,
  "rng_seed": 11,
  "transition_to_phase": 7,
  "disable_ai": true,
  "sw_abilities": true,
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_phase",
      "equals": 7
    },
    {
      "act": "expect_state",
      "path": "meta.active_player",
      "equals": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 6.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "phase_start"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()",
      "equals": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_murderous_hurricane",
      "timeout_s": 2.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_high_king_of_fenris",
      "timeout_s": 2.0
    },
    {
      "act": "execute_script",
      "script": "tree.root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_murderous_hurricane\").find_child(\"Cost\", true, false).text",
      "comment": "a datasheet ability card: no CP cost",
      "equals": "Ability"
    },
    {
      "act": "screenshot",
      "label": "01_movement_phase_start_cards"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_murderous_hurricane/Buttons/Use_sw11e_ab_murderous_hurricane_U_GREY_HUNTERS_A",
      "comment": "real click: Murderous Hurricane (Njal leads the Grey Hunters)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog",
      "timeout_s": 3.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BOYZ_B",
      "timeout_s": 2.0
    },
    {
      "act": "screenshot",
      "label": "02_hurricane_picker_enemy_within_12"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BOYZ_B",
      "comment": "real click: the Boyz (10\" away, visible)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0
    },
    {
      "act": "execute_script",
      "script": "GameState.get_unit(\"U_BOYZ_B\").flags.has(\"sw11e_ab_no_snap\")",
      "comment": "the Boyz cannot make snap-shooting attacks this turn",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "StratagemManager.fire_overwatch_shooter_reason_11e(2, \"U_BOYZ_B\").contains(\"Murderous Hurricane\")",
      "comment": "FIRE OVERWATCH refuses the Boyz",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "return load(\"res://scripts/codex/space_wolves/SWAbilities11e.gd\").psychic_levels_used(GameState.get_unit(\"U_NJAL_STORMCALLER_A\"))\n",
      "multiline": true,
      "comment": "Librarius: 1 of Njal's 3 psychic levels used this battle round",
      "equals": 1
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Murderous Hurricane (Njal Stormcaller): psychic roll\")",
      "expect_min": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_high_king_of_fenris",
      "timeout_s": 3.0,
      "comment": "the window re-offers what is left"
    },
    {
      "act": "execute_script",
      "script": "tree.root.get_node_or_null(\"StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_murderous_hurricane\") == null",
      "comment": "the same power is not offered twice in a phase",
      "equals": true
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_high_king_of_fenris/Buttons/Use_sw11e_ab_high_king_of_fenris_U_LOGAN_GRIMNAR_A",
      "comment": "real click: High King of Fenris"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BLOOD_CLAWS_A",
      "timeout_s": 3.0
    },
    {
      "act": "screenshot",
      "label": "03_high_king_reserves_picker"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BLOOD_CLAWS_A",
      "comment": "real click: the Blood Claws in strategic reserves"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "return load(\"res://scripts/codex/space_wolves/SWAbilities11e.gd\").ingress_battle_round(GameState.get_unit(\"U_BLOOD_CLAWS_A\"), 2)\n",
      "multiline": true,
      "comment": "their ingress this phase treats battle round 2 as 3 (the opponent-DZ ban is lifted)",
      "equals": 3
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"High King of Fenris: when\")",
      "expect_min": 1
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()",
      "equals": false
    },
    {
      "act": "click_unit",
      "unit_id": "U_IRON_PRIEST_A"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 4.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "unit_selected_to_move"
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_gift_of_the_iron_wolf",
      "timeout_s": 2.0
    },
    {
      "act": "screenshot",
      "label": "04_gift_of_the_iron_wolf_card"
    },
    {
      "act": "execute_script",
      "script": "GameState.get_unit(\"U_VENERABLE_DREADNOUGHT_A\").models[0].current_wounds",
      "comment": "the Venerable Dreadnought starts on 3 wounds",
      "equals": 3
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sw11e_ab_gift_of_the_iron_wolf/Buttons/Use_sw11e_ab_gift_of_the_iron_wolf_U_IRON_PRIEST_A",
      "comment": "real click: Gift of the Iron Wolf"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_VENERABLE_DREADNOUGHT_A",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_VENERABLE_DREADNOUGHT_A",
      "comment": "real click: the Venerable Dreadnought within 3\""
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "var cw := int(GameState.get_unit(\"U_VENERABLE_DREADNOUGHT_A\").models[0].current_wounds)\nprint(\"[sw11e-s4] gift: dreadnought wounds now \", cw)\nreturn cw >= 4 and cw <= 6",
      "multiline": true,
      "comment": "healed D3",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "GameState.get_unit(\"U_VENERABLE_DREADNOUGHT_A\").flags.has(\"sw11e_ab_gifted\")",
      "comment": "its attacks ignore hit/wound modifiers until your next Movement phase",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Gift of the Iron Wolf (Iron Priest)\")",
      "expect_min": 1
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "screenshot",
      "label": "05_gift_resolved_log"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "clean debug log: no ERROR line was written during the scenario",
      "script": "DebugLogger._flush_buffer()\nvar f = FileAccess.open(DebugLogger.get_real_log_file_path(), FileAccess.READ)\nvar n := 0\nwhile f != null and not f.eof_reached():\n\tvar l := f.get_line()\n\tif l.contains(\"[ERROR\"):\n\t\tn += 1\n\t\tprint(\"[sw11e-s4] debug-log ERROR: \", l)\nreturn n",
      "equals": 0
    }
  ]
}
