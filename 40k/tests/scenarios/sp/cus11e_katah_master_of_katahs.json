{
  "id": "cus11e_katah_master_of_katahs",
  "covers": [
    "codex.custodes.master_of_katahs",
    "codex.custodes.martial_katah.kaptaris",
    "codex.custodes.martial_katah.rendax",
    "stratagem.window.fight_phase_start",
    "stratagem.window.unit_selected_to_fight",
    "dialogs.StratagemDialog.katah_variant"
  ],
  "description": "Codex: Adeptus Custodes (11e) MASTER OF KA'TAHS (Shield-Captain: 'Once per battle round, per unit: if this unit is not readied, it is readied') through the real windows (WP-C3). Fixture cus11e_c3_custodes_active (P1 Custodes, round 2), Fight phase of the Custodes' turn; setup privilege: CP 0 for both players (no paid stratagem / Epic Challenge prompt competes with the 0-CP ka'tah cards). (1) Start of the Fight phase: a real click uses KAPTARIS on the Shield-Captain — it is no longer readied. (2) Pile-ins end. (3) A real click selects the Shield-Captain to fight: the RENDAX card is offered again, but only through its 'Master of Ka'tahs: ready Shield-Captain, then use RENDAX' button (the plain Use button is absent because the unit is not readied). (4) A real click on it: the Shield-Captain is readied by Master of Ka'tahs and uses Rendax at once — Rendax active, the once-per-round marker is set, no CP spent. (5) Pinned: the same window then offers no Master of Ka'tahs for it again this round.",
  "fixture": "cus11e_c3_custodes_active",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 10,
  "disable_ai": true,
  "martial_katah": true,
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 10 },
    { "act": "execute_script", "multiline": true, "comment": "setup privilege (see description)", "script": "GameState.state.players[\"1\"][\"cp\"] = 0\nGameState.state.players[\"2\"][\"cp\"] = 0\nSettingsService.set(\"auto_allocate_wounds\", true)\nreturn true", "equals": true },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 5.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id", "equals": "fight_phase_start" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_kaptaris/Buttons/Use_cus11e_katah_kaptaris_U_SHIELD_CAPTAIN_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_state", "path": "units.U_SHIELD_CAPTAIN_A.flags.cus11e_katah_kaptaris", "equals": true },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_SHIELD_CAPTAIN_A\").flags.get(\"cus11e_readied\", false)", "equals": false },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "re-opened window for the other readied units" },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_SHIELD_CAPTAIN_A", "timeout_s": 6.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_SHIELD_CAPTAIN_A", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 5.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id", "equals": "unit_selected_to_fight" },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_SHIELD_CAPTAIN_A_master_of_katahs", "timeout_s": 2.0 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node_or_null(\"StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_SHIELD_CAPTAIN_A\") == null", "equals": true, "comment": "no plain Use: the Shield-Captain is not readied" },
    { "act": "execute_script", "script": "str(main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_SHIELD_CAPTAIN_A_master_of_katahs\").text).begins_with(\"Master of Ka'tahs\")", "equals": true },
    { "act": "screenshot", "label": "01_rendax_via_master_of_katahs_offered" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_katah_rendax/Buttons/Use_cus11e_katah_rendax_U_SHIELD_CAPTAIN_A_master_of_katahs" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "re-opened window (nothing left for the Shield-Captain) — normally closed" },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "expect_state", "path": "units.U_SHIELD_CAPTAIN_A.flags.cus11e_katah_rendax", "equals": true },
    { "act": "expect_state", "path": "units.U_SHIELD_CAPTAIN_A.flags.cus11e_master_of_katahs_round", "equals": 2 },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_SHIELD_CAPTAIN_A\").flags.get(\"cus11e_readied\", false)", "equals": false },
    { "act": "expect_cp", "player": 1, "equals": 0 },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"Master of Ka'tahs\")", "expect_min": 1 },
    { "act": "execute_script", "multiline": true, "comment": "once per battle round: no Master of Ka'tahs offer for the Shield-Captain any more", "script": "var K = load(\"res://scripts/codex/custodes/CustodesKatah.gd\")\nreturn K.master_available(\"U_SHIELD_CAPTAIN_A\")", "equals": false },
    { "act": "expect_node_visible", "node": "/root/AttackAssignmentDialog", "timeout_s": 5.0 },
    { "act": "screenshot", "label": "02_master_of_katahs_used_attack_assignment" }
  ]
}
