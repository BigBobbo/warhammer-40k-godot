{
  "id": "sw11e_det_master_of_wolves",
  "covers": [
    "codex.space_wolves.detachment.saga_of_the_great_wolf.master_of_wolves",
    "codex.space_wolves.detachment.saga_of_the_great_wolf.howling_onslaught",
    "codex.space_wolves.SWDetachments11e",
    "ui.CommandController.sw11e_doctrines",
    "rules.melee.sustained_hits.ferocious_strike",
    "debug_log.no_errors"
  ],
  "description": "Codex: Space Marines (11e) Saga of the Great Wolf — MASTER OF WOLVES (WP-S2). Fixture sw11e_s2_wolves_active (P1 Space Wolves, Command phase of round 2; Logan Grimnar on the battlefield). (1) Command panel: a REAL click on TACTICAL DOCTRINE, then a REAL click on HOWLING ONSLAUGHT (Logan Grimnar, once per battle): the block reads 'HOWLING ONSLAUGHT active', the Game Log names it, the button is gone, and the Venerable Dreadnought (a VEHICLE) now benefits from Master of Wolves. (2) Setup privilege: straight to the Fight phase; CP 0 for both, auto wound allocation. Both players end their pile-in; a real click selects the Blood Claws (engaged with the Boyz, within 9\") to fight; their attacks go at the Boyz: the melee hit rolls carry [SUSTAINED HITS 1] from FEROCIOUS STRIKE (tactical doctrine; no Blood Claws weapon has it natively).",
  "fixture": "sw11e_s2_wolves_active",
  "edition": 11,
  "rng_seed": 42,
  "disable_ai": true,
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 1.0
    },
    {
      "act": "click_if_visible",
      "node": "/root/SecondaryMissionReviewDialog/OuterScroll/MainContainer/ButtonRow/DoneButton"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_phase",
      "equals": 6
    },
    {
      "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eDoctrinesBox/SW11eDoctrine_tactical",
      "comment": "REAL click on TACTICAL DOCTRINE"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_state",
      "path": "factions.1.sw11e_doctrine",
      "equals": "tactical"
    },
    {
      "act": "expect_node_visible",
      "node": "/root/Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eHowlingOnslaughtButton",
      "timeout_s": 3.0
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "return load(\"res://scripts/codex/space_wolves/SWDetachments11e.gd\").has_master_of_wolves(GameState.state.units[\"U_VENERABLE_DREADNOUGHT_A\"])",
      "equals": false
    },
    {
      "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eHowlingOnslaughtButton",
      "comment": "REAL click on HOWLING ONSLAUGHT"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_state",
      "path": "factions.1.sw11e_howling_onslaught_used",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main.get_tree().root.get_node_or_null(\"Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eHowlingOnslaughtButton\") == null",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main.get_tree().root.get_node(\"Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eHowlingStatus\").text.begins_with(\"HOWLING ONSLAUGHT active\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Howling Onslaught\")",
      "expect_min": 1
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "return load(\"res://scripts/codex/space_wolves/SWDetachments11e.gd\").has_master_of_wolves(GameState.state.units[\"U_VENERABLE_DREADNOUGHT_A\"])",
      "equals": true
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "var b = tree.root.get_node(\"Main/HUD_Right/VBoxContainer/CommandScrollContainer/CommandPanel/FactionAbilitiesSection/SW11eHowlingStatus\")\ntree.root.get_node(\"Main/HUD_Right/VBoxContainer/CommandScrollContainer\").ensure_control_visible(b)\nreturn true",
      "equals": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.4
    },
    {
      "act": "screenshot",
      "label": "01_tactical_doctrine_and_howling_onslaught"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "setup privileges: CP 0, auto wound allocation, straight to the Fight phase",
      "script": "GameState.state.players[\"1\"][\"cp\"] = 0\nGameState.state.players[\"2\"][\"cp\"] = 0\nSettingsService.set(\"auto_allocate_wounds\", true)\nPhaseManager.transition_to_phase(10)\nreturn int(GameState.get_current_phase())",
      "equals": 10
    },
    {
      "act": "wait_seconds",
      "seconds": 1.0
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "fight_phase_start (Howlmaw) — not under test"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.4
    },
    {
      "act": "expect_node_visible",
      "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton",
      "timeout_s": 5.0
    },
    {
      "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton",
      "emit_pressed": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "click_if_visible",
      "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton",
      "emit_pressed": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_BLOOD_CLAWS_A",
      "timeout_s": 6.0
    },
    {
      "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/FightSelectionPanel/UnitList/Fight_U_BLOOD_CLAWS_A",
      "emit_pressed": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "unit_selected_to_fight (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/AttackAssignmentDialog",
      "timeout_s": 5.0
    },
    {
      "act": "click_node",
      "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/AllToTargetButton",
      "emit_pressed": true
    },
    {
      "act": "click_node",
      "node": "/root/AttackAssignmentDialog/Content/ButtonContainer/ConfirmButton",
      "emit_pressed": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "execute_script",
      "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(16)"
    },
    {
      "act": "wait_seconds",
      "seconds": 1.0
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "the Blood Claws' melee hit rolls carry [SUSTAINED HITS 1] (Ferocious Strike)",
      "script": "var ph = PhaseManager.get_current_phase_instance()\nvar found := false\nfor d in ph.dice_log:\n\tif typeof(d) == TYPE_DICTIONARY and str(d.get(\"context\", \"\")) == \"hit_roll_melee\":\n\t\tprint(\"[sw11e ferocious] hit_roll_melee: weapon=\", d.get(\"weapon\", \"\"), \" sustained=\", d.get(\"sustained_hits_value\", 0))\n\t\tif int(d.get(\"sustained_hits_value\", 0)) >= 1:\n\t\t\tfound = true\nreturn found",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "02_ferocious_strike_sustained_hits"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "show the Dice Log tab",
      "script": "var panel = tree.root.get_node(\"Main\").get_node_or_null(\"HUD_Left/GameLogPanel\")\nif panel == null:\n\tfor n in tree.root.get_node(\"Main\").find_children(\"*\", \"\", true, false):\n\t\tif n.get(\"_tab_dice_button\") != null:\n\t\t\tpanel = n\n\t\t\tbreak\nif panel == null:\n\treturn \"panel not found\"\npanel._tab_dice_button.emit_signal(\"pressed\")\nreturn true",
      "equals": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.4
    },
    {
      "act": "screenshot",
      "label": "03_dice_log_sustained_hits"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "clean log: no ERROR line in this session's debug log",
      "script": "DebugLogger._flush_buffer()\nvar f = FileAccess.open(DebugLogger.get_log_file_path(), FileAccess.READ)\nif f == null:\n\treturn -1\nvar n = 0\nvar bad = []\nwhile not f.eof_reached():\n\tvar l = f.get_line()\n\tif l.contains(\"[ERROR\"):\n\t\tn += 1\n\t\tbad.append(l)\nprint(\"[sw11e log] \", DebugLogger.get_real_log_file_path(), \" ERROR lines = \", n, \" \", bad.slice(0, 3))\nreturn n",
      "equals": 0
    }
  ]
}
