{
  "id": "shooting_single_weapon_staged_rolls",
  "covers": [
    "shooting.staged.single_weapon_hit_pause",
    "scripts.ShootingResolutionDock.auto_start"
  ],
  "fixture": "shooting_phase",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 8,
  "disable_ai": true,
  "description": "Single-weapon shooting steps through the roll via the B2 resolution dock. Confirming ONE weapon type auto-starts staged resolution in the dock: it rolls to hit and PAUSES (primary button 'Roll to Wound') so the attacker can read the result and use Command Re-roll before the wound roll. Drives Battlewagon Alpha firing only its Lobba at the Blade Champion and asserts the dock reaches the hit pause, then continues to the wound roll.",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "expect_phase",
      "equals": 8
    },
    {
      "act": "dispatch_action",
      "action": {
        "type": "SELECT_SHOOTER",
        "actor_unit_id": "U_BATTLEWAGON_A"
      }
    },
    {
      "act": "expect_action_result",
      "path": "success",
      "equals": true
    },
    {
      "act": "dispatch_action",
      "action": {
        "type": "ASSIGN_TARGET",
        "actor_unit_id": "U_BATTLEWAGON_A",
        "payload": {
          "weapon_id": "lobba_ranged",
          "target_unit_id": "U_BLADE_CHAMPION_A",
          "model_ids": [
            "m1"
          ]
        }
      }
    },
    {
      "act": "expect_action_result",
      "path": "success",
      "equals": true
    },
    {
      "act": "dispatch_action",
      "action": {
        "type": "CONFIRM_TARGETS"
      }
    },
    {
      "act": "expect_action_result",
      "path": "success",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().awaiting_reactive_stratagem",
      "equals": false,
      "comment": "11e: no reactive window opens for the Blade Champion — the 10e Go to Ground offer (INFANTRY target) is gone: 11e core stratagems are 15.02 Command Re-roll through 15.12 Counteroffensive with no Go to Ground, and 15.10 Smokescreen is 'WHEN: Start of your opponent's Shooting phase', so there is nothing to decline and the dock starts directly"
    },
    {
      "act": "wait_seconds",
      "seconds": 1.2
    },
    {
      "act": "execute_script",
      "script": "main.get_node(\"ShootingController\").resolution_dock.is_active()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main.get_node(\"ShootingController\").resolution_dock.state",
      "equals": "staged_hits"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().resolution_state.get(\"mode\", \"?\")",
      "equals": "sequential_staged"
    },
    {
      "act": "execute_script",
      "script": "main.get_node(\"ShootingController\").resolution_dock.primary_button.text",
      "equals": "Roll to Wound ▶"
    },
    {
      "act": "screenshot",
      "label": "01_single_weapon_hit_pause"
    },
    {
      "act": "dispatch_action",
      "action": {
        "type": "CONTINUE_TO_WOUNDS"
      }
    },
    {
      "act": "expect_action_result",
      "path": "success",
      "equals": true
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "screenshot",
      "label": "02_after_wound_roll"
    }
  ]
}