{
  "id": "ai_suggestion_scout_objective",
  "covers": [
    "ai.suggestion.breakdown_panel",
    "scripts.AIDecisionMaker.scout_record"
  ],
  "fixture": "audit_baseline_postdeploy",
  "disable_ai": true,
  "edition": 11,
  "rng_seed": 7,
  "description": "K in the Scout phase: the scout's objective choice is an itemised ledger (who holds it, no man's land, home/enemy-home penalties, distance), every objective recorded.",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"HUMAN\"})"
    },
    {
      "act": "execute_script",
      "script": "main.refresh_ai_suggestion_button()"
    },
    {
      "act": "execute_script",
      "script": "GameState.state.units.U_WITCHSEEKERS_C.meta.abilities.append({'name': 'Scouts 6\"', 'type': 'Core', 'parameter': '6\"'})"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.transition_to_phase(4)"
    },
    {
      "act": "wait_frames",
      "frames": 4
    },
    {
      "act": "execute_script",
      "script": "GameState.set_active_player(int(GameState.state.units.U_WITCHSEEKERS_C.owner))"
    },
    {
      "act": "wait_frames",
      "frames": 2
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "Setup: decline any pending stratagem window so the phase's own decision is next",
      "script": "var pi = PhaseManager.get_current_phase_instance()\nvar n = 0\nwhile pi.has_method(\"get_pending_stratagem_window\") and not pi.get_pending_stratagem_window().is_empty() and n < 6:\n\tvar w = pi.get_pending_stratagem_window()\n\tpi.execute_action({\"type\": \"DECLINE_WINDOW_STRATAGEM\", \"player\": int(pi.get_pending_stratagem_window_decider()), \"window_id\": w.get(\"window_id\", \"\")})\n\tn += 1\nreturn n"
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.clear_action_log()"
    },
    {
      "act": "simulate_key",
      "keycode": "K"
    },
    {
      "act": "wait_frames",
      "frames": 6
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel != null and main._ai_suggestion_panel.is_visible_in_tree()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"== SCOUT\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.full_text.contains(\"Who holds it\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.full_text.contains(\"read as: ledger\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "screenshot",
      "label": "01_scout_card"
    }
  ]
}