{
  "id": "ork11e_while_their_backs_are_turned",
  "covers": [
    "stratagem.window.movement_phase_end.opponent_turn",
    "stratagem.ork11e.while_their_backs_are_turned",
    "stratagem.followup.reactive_normal_move",
    "phases.MovementPhase.complete_movement_phase"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 7,
  "disable_ai": true,
  "description": "Codex: Orks (11e) WHILE THEIR BACKS ARE TURNED (Taktikal Brigade, 1 CP) at the end of the ENEMY's Movement phase through the real movement_phase_end window. Fixture ork11e_orks_reactive: P1 Custodes active; Custodian Guard A is engaged with the Boyz (+ attached Warboss) at the start of the phase. The Custodes player clicks Custodian Guard A, picks Fall Back, drags the unit 4\" away and locks it in, then ends the Movement phase: before the phase ends the window opens for PLAYER 2 with an enabled 'Use on Boyz + Warboss' button (engaged at the start of the phase, unengaged now). A real click on Use spends P2's CP and gives the Boyz a normal move of up to 6\": the Ork player drags the mob 1\" (Ctrl+A grabs the Boyz and the Warboss) and locks it in; only then does the Movement phase end (Shooting). Setup-only privilege: P2's detachment flipped to Taktikal Brigade (stratagems reloaded).",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 7 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "execute_script", "multiline": true, "script": "GameState.state[\"factions\"][\"2\"].merge({\"detachment\": \"Taktikal Brigade\"}, true)\nStratagemManager.load_faction_stratagems_for_player(2)\nreturn PhaseManager.get_current_phase_instance()._engagement_at_phase_start.has(\"U_BOYZ_B\")", "equals": true, "comment": "setup privilege: Taktikal Brigade for P2; the Boyz were engaged when the phase began" },
    { "act": "expect_node_property", "node": "/root/Main/HUD_Bottom/HBoxContainer/AutoDeclineOverwatch", "property": "button_pressed", "equals": true, "comment": "Skip Overwatch is on (harness default) — Fire Overwatch is not under test" },

    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_A" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "main.movement_controller.active_unit_id", "equals": "U_CUSTODIAN_GUARD_A" },
    { "act": "click_node", "button_text": "Fall Back" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_moves.get(\"U_CUSTODIAN_GUARD_A\", {}).get(\"mode\", \"\")", "equals": "FALL_BACK" },
    { "act": "simulate_key", "keycode": "A", "ctrl": true },
    { "act": "wait_frames", "frames": 3 },
    { "act": "drag_board", "from_x": 952.99, "from_y": 1148.5, "to_x": 952.99, "to_y": 988.5 },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "click_node", "button_text": "End This Unit's Move" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "expect_state", "path": "units.U_CUSTODIAN_GUARD_A.flags.fell_back", "equals": true },
    { "act": "execute_script", "multiline": true, "script": "var M = load(\"res://scripts/stratagems/ork_codex/OrkCodexMovement.gd\")\nreturn M.is_attached_unit_engaged(\"U_BOYZ_B\")", "equals": false, "comment": "the Boyz are unengaged now" },
    { "act": "screenshot", "label": "01_custodes_fell_back" },

    { "act": "dispatch_action", "action": { "type": "END_MOVEMENT", "player": 1 } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 7, "comment": "the phase waits for the window" },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id", "equals": "movement_phase_end" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 2 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_taktikal_brigade_while_their_backs_are_turned/Buttons/Use_faction_ork_taktikal_brigade_while_their_backs_are_turned_U_BOYZ_B", "property": "disabled", "equals": false },
    { "act": "execute_script", "script": "main.get_tree().root.get_node_or_null(\"StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_taktikal_brigade_while_their_backs_are_turned/Buttons/Use_faction_ork_taktikal_brigade_while_their_backs_are_turned_U_KOMMANDOS_A\") == null", "equals": true, "comment": "the Kommandos were not engaged at the start of the phase" },
    { "act": "execute_script", "script": "main._reactive_stratagem_pending", "equals": true },
    { "act": "screenshot", "label": "02_phase_end_window_for_ork_player" },

    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_taktikal_brigade_while_their_backs_are_turned/Buttons/Use_faction_ork_taktikal_brigade_while_their_backs_are_turned_U_BOYZ_B" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "expect_cp", "player": 1, "delta_from_start": 0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_moves.get(\"U_BOYZ_B\", {}).get(\"move_cap_inches\", 0.0)", "equals": 6.0 },
    { "act": "execute_script", "script": "main.movement_controller.active_unit_id", "equals": "U_BOYZ_B" },
    { "act": "expect_phase", "equals": 7 },
    { "act": "screenshot", "label": "03_boyz_6in_move" },

    { "act": "simulate_key", "keycode": "A", "ctrl": true },
    { "act": "wait_frames", "frames": 3 },
    { "act": "drag_board", "from_x": 1000.79, "from_y": 1245.2, "to_x": 1000.79, "to_y": 1285.2 },
    { "act": "wait_seconds", "seconds": 2.5 },
    { "act": "click_node", "button_text": "End This Unit's Move" },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "execute_script", "script": "float(GameState.get_unit(\"U_BOYZ_B\").models[0].position.y) > 1280.0", "equals": true },
    { "act": "execute_script", "script": "float(GameState.get_unit(\"U_WARBOSS_A\").models[0].position.y) > 1400.0", "equals": true, "comment": "the attached Warboss moved with the Boyz" },
    { "act": "expect_phase", "equals": 8, "comment": "the Movement phase ends once the reactive move is done" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"WHILE THEIR BACKS ARE TURNED\")", "expect_min": 1 },
    { "act": "screenshot", "label": "04_moved_then_shooting_phase" }
  ]
}
