    { "act": "execute_script", "script": "main.get_node(\"StratagemPanel/Scroll/List/Strat_faction_ork_war_horde_hit_em_harder/Row\").get_child(1).text", "equals": "Offered automatically when one of your units is selected to fight" },
    { "act": "execute_script", "script": "main.get_node(\"StratagemPanel/Scroll\").ensure_control_visible(main.get_node(\"StratagemPanel/Scroll/List/Strat_faction_ork_war_horde_hit_em_harder\"))" },
