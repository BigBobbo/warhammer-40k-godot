    { "act": "execute_script", "multiline": true, "script": "var s = StratagemManager.get_stratagem(\"faction_ork_war_horde_hit_em_harder\")\nreturn s.get(\"implemented\", false) and s.get(\"csv_id\", \"\") == \"hit-em-harder-war-horde\"", "equals": true },
    { "act": "execute_script", "script": "StratagemManager.can_use_stratagem(1, \"faction_ork_war_horde_hit_em_harder\", \"U_BOYZ_B\").reason", "equals": "Offered automatically when one of your units is selected to fight" },

    { "act": "click_node", "node": "/root/Main/HUD_Bottom/HBoxContainer/StratagemPanelButton" },
