    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_war_horde_hit_em_harder/Buttons/Use_faction_ork_war_horde_hit_em_harder_U_BOYZ_B", "property": "disabled", "equals": false },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/DeclineButton" },
