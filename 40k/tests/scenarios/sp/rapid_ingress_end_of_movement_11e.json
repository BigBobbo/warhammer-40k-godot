      "timeout_s": 3.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/RapidIngressDialog/Content/UnitScroll/UnitList/Row_U_CALADIUS_GRAV-TANK_E/Use_U_CALADIUS_GRAV-TANK_E"
    },
    {
      "act": "screenshot",
      "label": "01_rapid_ingress_offer_for_non_active_player"
    },
    {
      "act": "execute_script",
      "script": "StratagemManager.get_fire_overwatch_offer_targets_11e(1).size()",
      "equals": 0,
      "comment": "P1 has no FIRE OVERWATCH row here (no unit within 24\" of an enemy) \u2014 so no FO prompt can follow"
    },
    {
      "act": "click_node",
      "node": "/root/RapidIngressDialog/Content/Buttons/DeclineButton"
    },
    {
      "act": "wait_seconds",
      "seconds": 1.5
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0,
      "comment": "declined: no CP"
    },
    {
      "act": "expect_phase",
      "equals": 8,
      "comment": "the movement_phase_end window had nothing to offer P1 \u2014 the Movement phase ended"
    },
    {
      "act": "execute_script",
      "script": "main.get_tree().root.get_node_or_null(\"StratagemDialog\") == null",
      "equals": true,
      "comment": "no stratagem dialog was shown"
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\">>> FIRE OVERWATCH <<<\")",
      "equals": 0
