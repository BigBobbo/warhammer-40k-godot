    {
      "act": "expect_state",
      "path": "units.U_CALADIUS_GRAV-TANK_E.status",
      "equals": 7,
      "comment": "the Caladius stays in reserves"
    },
    {
      "act": "screenshot",
      "label": "02_declined_shooting_phase"
    }
  ]
}
