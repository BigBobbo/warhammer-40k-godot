{
  "id": "ai_suggestion_board_overlay",
  "covers": [
    "ai.suggestion.board_overlay",
    "ai.suggestion.breakdown_panel",
    "ui.HUD.ai_suggestion_button"
  ],
  "fixture": "audit_382_cp_grant",
  "disable_ai": true,
  "edition": 11,
  "rng_seed": 7,
  "description": "The AI suggestion is drawn on the board, not just described. Clicking Suggest in P1's Movement phase opens the breakdown card AND AISuggestionBoardOverlay under BoardRoot: the suggested unit is ringed (cyan, 'SUGGESTED' tag) and, for a move, every model gets a dashed path to a ghost base at its planned destination, and the objective it is heading for is marked GOAL. Hovering an option row in the card previews that option on the board (amber). Esc clears the overlay. In the Shooting phase the suggested shooter and its target are both ringed and linked. Pure preview \u2014 nothing executes.",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"HUMAN\"})"
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.clear_action_log()"
    },
    {
      "act": "execute_script",
      "script": "GameState.set_active_player(1)"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.transition_to_phase(7)"
    },
    {
      "act": "execute_script",
      "script": "main.refresh_ai_suggestion_button()"
    },
    {
      "act": "wait_frames",
      "frames": 3
    },
    {
      "act": "expect_node_visible",
      "node": "/root/Main/HUD_Right/VBoxContainer/AIControlsRow/AISuggestionButton",
      "timeout_s": 2.0
    },
    {
      "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/AIControlsRow/AISuggestionButton"
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.visible",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.get_path() == NodePath(\"/root/Main/BoardRoot/AISuggestionBoardOverlay\")",
      "equals": true,
      "comment": "the overlay lives on the board, in board coordinates"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary()"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel._decision.get(\"type\", \"\")"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().actors.size()",
      "expect_min": 1,
      "comment": "the suggested unit is ringed"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().actors.has(main._ai_suggestion_panel._decision.get(\"actor_unit_id\", main._ai_suggestion_panel._decision.get(\"unit_id\", \"\")))",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().moves == main._ai_suggestion_panel._decision.get(\"_ai_model_destinations\", {}).size()",
      "equals": true,
      "comment": "one dashed path + ghost per model with a planned destination"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().moves",
      "expect_min": 1
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().goal.begins_with(\"Move obj_\")",
      "equals": true,
      "comment": "the objective the move heads for is marked GOAL"
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "screenshot",
      "label": "01_movement_suggestion_on_board"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.get_node(\"Body/Content/BreakdownText\").meta_hover_started.emit(\"opt:0:\" + str((int(main._ai_suggestion_panel._decision.get(\"_ai_decision_records\", [{}])[0].get(\"chosen_index\", 0)) + 1) % max(1, main._ai_suggestion_panel._decision.get(\"_ai_decision_records\", [{}])[0].get(\"candidates\", []).size())))",
      "comment": "pointer over a runner-up option row"
    },
    {
      "act": "wait_frames",
      "frames": 3
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().preview != \"\"",
      "equals": true,
      "comment": "the hovered option is drawn on the board"
    },
    {
      "act": "screenshot",
      "label": "02_hovered_option_preview"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.get_node(\"Body/Content/BreakdownText\").meta_hover_ended.emit(\"\")"
    },
    {
      "act": "wait_frames",
      "frames": 2
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().preview",
      "equals": ""
    },
    {
      "act": "simulate_key",
      "keycode": "Escape"
    },
    {
      "act": "wait_frames",
      "frames": 3
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.visible",
      "equals": false
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().actors.size() + main._ai_suggestion_overlay.summary().moves",
      "equals": 0,
      "comment": "closing the card clears the board"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.transition_to_phase(8)"
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
      "act": "simulate_key",
      "keycode": "K"
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.visible",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary()"
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_overlay.summary().targets.size()",
      "expect_min": 1,
      "comment": "the shooting target is ringed and linked to the shooter"
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "expect_phase",
      "equals": 8
    },
    {
      "act": "screenshot",
      "label": "03_shooting_suggestion_target"
    }
  ]
}