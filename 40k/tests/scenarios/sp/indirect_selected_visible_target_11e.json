      "script": "var u = GameState.state.units[\"U_BOYZ_E\"]\nvar alive = []\nfor i in range(u.models.size()):\n\tif u.models[i].get(\"alive\", true):\n\t\talive.append(i)\nfor dy in range(6, 24, 2):\n\tfor dx in range(-12, 13, 3):\n\t\tvar c = Vector2(823.4 + dx * 40.0, 407.4 + dy * 40.0)\n\t\tfor k in range(alive.size()):\n\t\t\tu.models[alive[k]].position = {\"x\": c.x + (k % 5) * 40.0, \"y\": c.y + (k / 5) * 40.0}\n\t\tif RulesEngine._has_los_to_target_unit(\"U_WITCHSEEKERS_D\", \"U_BOYZ_E\", GameState.state):\n\t\t\ttree.current_scene._sync_all_token_positions()\n\t\t\treturn true\nreturn false",
