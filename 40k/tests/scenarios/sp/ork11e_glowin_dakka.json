    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "expect_state",
      "path": "meta.active_player",
      "equals": 1
    },
    {
      "act": "execute_script",
      "script": "SettingsService.set(\"auto_allocate_wounds\", true)"
    },
    {
      "act": "execute_script",
