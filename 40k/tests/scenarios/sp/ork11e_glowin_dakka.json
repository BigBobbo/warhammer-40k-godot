    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "var p = PhaseManager.get_current_phase_instance()\nfor sd in p.pending_save_data:\n\tif int(sd.get(\"ap\", 0)) == -1:\n\t\treturn true\nreturn false",
