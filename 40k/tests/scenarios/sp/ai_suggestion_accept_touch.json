{
  "id": "ai_suggestion_accept_touch",
  "covers": ["ai.suggestion.accept", "touch.mvp"],
  "fixture": "audit_382_cp_grant",
  "edition": 11,
  "rng_seed": 7,
  "description": "Android: accept the AI suggestion with a finger. Touch mode on and the mobile 1.25x UI scale. Tapping 'Suggest (K)' opens the card; '✔ Accept' is the FIRST control in the footer (left end, never pushed into a clipped right edge) and lies fully on screen. Tapping it carries out the suggested move: the suggested unit is flagged moved and the card shows '✔ Done'.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "script": "TouchInputAdapter.set_enabled(true)\nreturn TouchInputAdapter.enabled", "multiline": true, "equals": true },
    { "act": "execute_script", "script": "SettingsService.set_ui_scale(1.25)" },
    { "act": "execute_script", "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"AI\"})" },
    { "act": "execute_script", "script": "AIPlayer.set_ai_speed_preset(1)" },
    { "act": "execute_script", "script": "GameState.set_active_player(1)" },
    { "act": "execute_script", "script": "PhaseManager.transition_to_phase(7)" },
    { "act": "execute_script", "script": "main.refresh_ai_suggestion_button()" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "script": "return TouchInputAdapter.inject_tap_text('Suggest (K)')", "multiline": true, "equals": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "main._ai_suggestion_panel != null and main._ai_suggestion_panel.visible", "equals": true },
    { "act": "execute_script", "script": "main.set_meta(\"acc_uid\", str(main._ai_suggestion_panel._decision.get(\"actor_unit_id\", \"\")))" },
    { "act": "execute_script", "script": "main._ai_suggestion_panel._accept_btn.get_index()", "equals": 0,
      "comment": "Accept leads the footer row" },
    { "act": "execute_script", "multiline": true,
      "script": "var vis: Rect2 = tree.root.get_visible_rect()\nvar main = tree.root.get_node(\"Main\")\nvar r: Rect2 = main._ai_suggestion_panel._accept_btn.get_global_rect()\nvar card: Rect2 = main._ai_suggestion_panel.get_global_rect()\nprint(\"ACCEPT-TOUCH vis=\", vis, \" card=\", card, \" accept=\", r)\nreturn vis.encloses(r) and vis.encloses(card) and r.position.x < card.position.x + card.size.x * 0.4",
      "equals": true, "comment": "card and Accept fully on screen; Accept on the card's left side" },
    { "act": "screenshot", "label": "01_touch_card_accept_left" },
    { "act": "execute_script", "script": "return TouchInputAdapter.inject_tap_text('✔ Accept')", "multiline": true, "equals": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "script": "GameState.get_unit(main.get_meta(\"acc_uid\")).get(\"flags\", {}).get(\"moved\", false)", "equals": true },
    { "act": "execute_script", "script": "main._ai_suggestion_panel.visible", "equals": true },
    { "act": "screenshot", "label": "02_touch_accepted" }
  ]
}
