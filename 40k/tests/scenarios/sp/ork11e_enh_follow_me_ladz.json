 "description": "WP-O5 Codex: Orks (11e) FOLLOW ME LADZ (War Horde enhancement, ORKS model: add 2\" to the Move characteristic of models in this model's unit) — passive. Fixture ork11e_enh_war_horde_move: the Big Mek carries it and leads Boyz D (M6\"). The Da Boss is Watchin' card at the phase start is declined. A real click on the Boyz D token selects the Attached unit for a normal move (any unit_selected_to_move card is declined): the move cap is 8\" (6 + 2) in the phase and in the movement panel ('Move: 8.0\"'). The whole unit (ctrl+A) is dragged 7.5\" — more than its printed 6\" — and 'End This Unit's Move' is accepted. Boyz C (no Follow Me Ladz) keep +0\".",
 "fixture": "ork11e_enh_war_horde_move",
 "edition": 11,
 "rng_seed": 42,
 "transition_to_phase": 7,
 "disable_ai": true,
 "steps": [
  { "act": "wait_seconds", "seconds": 0.8 },
  { "act": "expect_phase", "equals": 7 },
  { "act": "expect_state", "path": "factions.1.detachment", "equals": "War Horde" },
  { "act": "expect_state", "path": "units.U_BIG_MEK_A.attached_to", "equals": "U_BOYZ_D" },
  { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton" },
  { "act": "wait_seconds", "seconds": 0.6 },
  { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
  { "act": "execute_script", "multiline": true, "script": "var oa = load(\"res://scripts/codex/orks/OrkAbilities11e.gd\")\nreturn [oa.move_modifier(GameState.get_unit(\"U_BOYZ_D\")), oa.move_modifier(GameState.get_unit(\"U_BOYZ_C\"))]", "equals": [2.0, 0.0], "comment": "Boyz D (led by the Follow Me Ladz Big Mek) +2\"; Boyz C +0\"" },
  { "act": "click_unit", "unit_id": "U_BOYZ_D" },
  { "act": "wait_seconds", "seconds": 0.8 },
  { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton" },
  { "act": "wait_seconds", "seconds": 0.8 },
  { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
  { "act": "execute_script", "script": "main.movement_controller.active_unit_id", "equals": "U_BOYZ_D" },
  { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_moves[\"U_BOYZ_D\"][\"move_cap_inches\"]", "equals": 8.0, "comment": "M6\" + 2\" Follow Me Ladz" },
  { "act": "execute_script", "script": "main.movement_controller.move_cap_inches", "equals": 8.0 },
  { "act": "execute_script", "script": "main.movement_controller.move_cap_label.text.begins_with(\"Move: 8.0\")", "equals": true, "comment": "the movement panel shows the 8\" cap" },
  { "act": "screenshot", "label": "01_follow_me_ladz_cap_8" },
  { "act": "simulate_key", "keycode": "A", "ctrl": true },
  { "act": "wait_frames", "frames": 3 },
  { "act": "drag_board", "from_x": 1040.0, "from_y": 775.0, "to_x": 1040.0, "to_y": 1075.0 },
  { "act": "wait_seconds", "seconds": 1.5 },
  { "act": "execute_script", "multiline": true, "script": "var md = PhaseManager.get_current_phase_instance().get_active_move_data(\"U_BOYZ_D\")\nvar d = md.get(\"model_distances\", {})\nvar mx := 0.0\nfor k in d:\n\tmx = maxf(mx, float(d[k]))\nreturn [float(d.size()), mx > 7.0 and mx <= 8.0]", "equals": [11, true], "comment": "every model of the Attached unit (10 Boyz + the Big Mek) dragged ~7.5\" (screen-projection rounding gives 7.4) — beyond the printed 6\"" },
  { "act": "screenshot", "label": "02_follow_me_ladz_dragged_7_5" },
  { "act": "click_node", "button_text": "End This Unit's Move" },
  { "act": "wait_seconds", "seconds": 0.8 },
  { "act": "expect_state", "path": "units.U_BOYZ_D.flags.moved", "equals": true },
  { "act": "execute_script", "script": "float(GameState.get_unit(\"U_BOYZ_D\").models[2].position.y) > 775.0 + 7.0 * 40.0", "equals": true, "comment": "the move of more than 7\" was accepted" },
  { "act": "screenshot", "label": "03_follow_me_ladz_moved" }
 ]
