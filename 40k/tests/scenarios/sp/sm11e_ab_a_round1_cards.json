{
  "id": "sm11e_ab_a_round1_cards",
  "covers": [
    "codex.space_marines.datasheet_abilities.teleport_homer",
    "codex.space_marines.datasheet_abilities.forward_assault_warsuit",
    "scripts.codex.space_marines.SMAbilitiesA",
    "stratagem.window.phase_start",
    "dialogs.StratagemChoiceDialog"
  ],
  "description": "WP-M4a start-of-battle datasheet abilities through the real phase_start window (battle round 1, P1 Command phase). Fixture sm11e_m4a_round1: an Invictor Tactical Warsuit, Intercessors, a Terminator Assault Squad in strategic reserves; Boyz and a Warboss. TELEPORT HOMER (once per battle): real click, real pick of the spot next to the Intercessors - the token is set up (usable for a -1 CP Rapid Ingress). FORWARD ASSAULT WARSUIT: real click + pick of the Warboss - the Invictor's attacks vs its mark re-roll wound rolls of 1.",
  "fixture": "sm11e_m4a_round1",
  "edition": 11,
  "rng_seed": 11,
  "disable_ai": true,
  "sm_abilities_a": true,
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "click_if_visible",
      "node": "/root/SecondaryMissionReviewDialog/OuterScroll/MainContainer/ButtonRow/DoneButton",
      "comment": "the secondary-mission review (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.4
    },
    {
      "act": "expect_phase",
      "equals": 6
    },
    {
      "act": "expect_state",
      "path": "meta.battle_round",
      "equals": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 6.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "phase_start"
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_a_teleport_homer",
      "timeout_s": 2.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_a_forward_assault_warsuit",
      "timeout_s": 1.0
    },
    {
      "act": "screenshot",
      "label": "01_start_of_battle_cards"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_a_teleport_homer/Buttons/Use_sm11e_ab_a_teleport_homer_U_TERMINATOR_ASSAULT_SQUAD_A",
      "comment": "REAL click: Teleport Homer (the squad is in strategic reserves)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemChoiceDialog/Content/Choice_unit_U_INTERCESSOR_SQUAD_A",
      "timeout_s": 3.0
    },
    {
      "act": "screenshot",
      "label": "02_teleport_homer_spot_picker"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemChoiceDialog/Content/Choice_unit_U_INTERCESSOR_SQUAD_A",
      "comment": "REAL click: set the token up next to the Intercessors"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "var S = load(\"res://scripts/codex/space_marines/SMAbilitiesA.gd\")\nreturn S.homer_position_px(\"U_TERMINATOR_ASSAULT_SQUAD_A\") != Vector2.INF",
      "comment": "the token is on the battlefield",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "UnitAbilityManager.is_once_per_battle_used(\"U_TERMINATOR_ASSAULT_SQUAD_A\", \"Teleport Homer\")",
      "comment": "once per battle",
      "equals": true
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "var S = load(\"res://scripts/codex/space_marines/SMAbilitiesA.gd\")\nreturn S.homer_usable(\"U_TERMINATOR_ASSAULT_SQUAD_A\")",
      "comment": "far from every enemy: Rapid Ingress can use it (-1 CP) from round 2",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Teleport Homer: Terminator Assault Squad's token is set up\")",
      "expect_min": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_a_forward_assault_warsuit",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_a_forward_assault_warsuit/Buttons/Use_sm11e_ab_a_forward_assault_warsuit_U_INVICTOR_TACTICAL_WARSUIT_A",
      "comment": "REAL click: Forward Assault Warsuit"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_WARBOSS_A",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_WARBOSS_A",
      "comment": "REAL click: the Warboss is the mark"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "GameState.get_unit(\"U_INVICTOR_TACTICAL_WARSUIT_A\").flags.get(\"sm11e_aba_mark\", \"\")",
      "equals": "U_WARBOSS_A"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "script": "var m = RulesEngine.ork11e_ab_mods(GameState.get_unit(\"U_INVICTOR_TACTICAL_WARSUIT_A\"), GameState.get_unit(\"U_WARBOSS_A\"), {\"name\": \"x\", \"type\": \"Ranged\"}, false, GameState.state)\nreturn str(m.get(\"wound_reroll\", \"\"))",
      "comment": "attacks vs the mark re-roll wound rolls of 1",
      "equals": "ones"
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "screenshot",
      "label": "03_round1_cards_resolved_log"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "clean debug log: no ERROR line was written during the scenario",
      "script": "DebugLogger._flush_buffer()\nvar f = FileAccess.open(DebugLogger.get_real_log_file_path(), FileAccess.READ)\nvar n := 0\nwhile f != null and not f.eof_reached():\n\tvar l := f.get_line()\n\tif l.contains(\"[ERROR\"):\n\t\tn += 1\n\t\tprint(\"[sm11e-m4a] debug-log ERROR: \", l)\nreturn n",
      "equals": 0
    }
  ]
}
