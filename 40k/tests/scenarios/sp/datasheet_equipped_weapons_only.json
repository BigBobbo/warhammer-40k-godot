{
  "id": "datasheet_equipped_weapons_only",
  "covers": [
    "ui.datasheet.equipped_weapons_only",
    "scripts.UnitLoadoutResolver.get_equipped_weapons",
    "scripts.DatasheetModal.render_weapons"
  ],
  "fixture": "fullauto_pretrigger",
  "transition_to_phase": 7,
  "rng_seed": 42,
  "disable_ai": true,
  "description": "Pressing Y (pad) on a selected Battlewagon opens the datasheet showing ONLY the weapons it is equipped with. Its roster wargear is Kannon / Lobba / Deff rolla / Grabbin' klaw / Wreckin' ball, so the datasheet must list those (plus the base-kit Tracks and wheels) and must NOT list the killkannon, zzap gun or big shoota the datasheet menu also contains.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_token_visible", "unit_id": "U_BATTLEWAGON_G" },
    { "act": "click_unit", "unit_id": "U_BATTLEWAGON_G" },
    { "act": "wait_seconds", "seconds": 0.4 },

    { "act": "simulate_joy_button", "button_index": 3 },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "expect_node_visible", "node": "/root/Main/DatasheetModal", "timeout_s": 2.0 },
    { "act": "execute_script", "script": "var m=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn m.current_unit_id", "multiline": true, "equals": "U_BATTLEWAGON_G" },

    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn d.weapons_text.contains(\"Kannon\") and d.weapons_text.contains(\"Lobba\") and d.weapons_text.contains(\"Deff rolla\") and d.weapons_text.contains(\"Grabbin\") and d.weapons_text.contains(\"Wreckin\")", "multiline": true, "equals": true },
    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn d.weapons_text.contains(\"Tracks and wheels\")", "multiline": true, "equals": true },
    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn d.weapons_text.contains(\"Killkannon\")", "multiline": true, "equals": false },
    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn d.weapons_text.contains(\"Zzap gun\")", "multiline": true, "equals": false },
    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nreturn d.weapons_text.contains(\"Big shoota\")", "multiline": true, "equals": false },

    { "act": "execute_script", "script": "var t=tree.root.get_node_or_null(\"Main/TokenHoverTooltip\")\nreturn t == null or not t.visible", "multiline": true, "equals": true },
    { "act": "execute_script", "script": "var d=tree.root.get_node_or_null(\"Main/DatasheetModal\")\nvar vp=d.get_viewport().get_visible_rect().size\nreturn d.size.y <= vp.y - 40.0 and abs((d.position.y + d.size.y * 0.5) - vp.y * 0.5) <= 2.0", "multiline": true, "equals": true },

    { "act": "screenshot", "label": "01_battlewagon_datasheet_equipped_only" },

    { "act": "simulate_joy_button", "button_index": 3 },
    { "act": "wait_seconds", "seconds": 0.3 },
    { "act": "expect_node_property", "node": "/root/Main/DatasheetModal", "property": "visible", "equals": false }
  ]
}
