    {
      "act": "wait_seconds",
      "seconds": 1.5
    },
    {
      "act": "simulate_joy_button",
      "button_index": 9,
      "comment": "LB claims pad mode"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.3
    },
    {
      "act": "execute_script",
      "script": "InputDeviceManager.is_pad_active()",
      "equals": true
    },
    {
      "act": "simulate_joy_button",
      "button_index": 12
    },
    {
