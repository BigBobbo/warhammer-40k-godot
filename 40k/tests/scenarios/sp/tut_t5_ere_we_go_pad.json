      "act": "simulate_joy_button",
      "button_index": 6,
      "comment": "Start = Roll 2D6 (HINTS_CHARGE_ROLL)"
    },
    {
      "act": "wait_seconds",
      "seconds": 2.5
    },
    {
      "act": "execute_script",
      "script": "TutorialManager.current_step_id()",
      "equals": "keep_da_roll"
    },
    {
      "act": "screenshot",
      "label": "03_rolled_pad"
    },
    {
      "act": "execute_script",
      "script": "var q = [tree.root]\nwhile not q.is_empty():\n\tvar nd = q.pop_back()\n\tif nd is Button and nd.is_visible_in_tree() and str(nd.text).strip_edges() == \"Keep Roll\":\n\t\tnd.pressed.emit()\n\t\treturn true\n\tfor c in nd.get_children():\n\t\tq.append(c)\nreturn false",
      "multiline": true,
      "equals": true,
      "comment": "the Command Re-roll offer is an embedded modal Window - native focus drives it for a real player, emit here"
    },
    {
      "act": "wait_seconds",
      "seconds": 2.0
    },
    {
      "act": "execute_script",
