    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "simulate_joy_button",
      "button_index": 14,
      "comment": "D-pad right parks the virtual cursor and steps the ring off index 0. _pad_charge_toggle() refuses while the cursor is ACTIVE, so a D-pad press is what hands the pad back to the board after a cursor glide."
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "simulate_joy_button",
      "button_index": 13,
      "comment": "D-pad left steps back to the nearest target the ring started on"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "execute_script",
      "script": "var cc = tree.root.get_node(\"/root/Main/ChargeController\")\nreturn str(cc.target_list.get_item_text(cc.pad_target_cursor))",
      "multiline": true,
      "equals": "Custodian Guard (2.9\")",
      "comment": "pin WHICH row the ring armed on (pad_step_target sets index 0 from unset)"
    },
    {
      "act": "simulate_joy_button",
      "button_index": 0,
      "comment": "A toggles the ring-highlighted target into the declaration"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "screenshot",
      "label": "02_target_toggled_pad"
    },
    {
      "act": "execute_script",
      "script": "var cc = tree.root.get_node(\"/root/Main/ChargeController\")\nreturn \"U_CUSTODIAN_GUARD_T\" in cc.selected_targets",
      "multiline": true,
      "equals": true,
      "comment": "assert WHICH target the pad toggled - charging the far Witchseekers instead would still 'declare' but could never reach contact"
    },
    {
      "act": "simulate_joy_button",
      "button_index": 6,
      "comment": "Start = Declare Charge (HINTS_CHARGE_READY)"
