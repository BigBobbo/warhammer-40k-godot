      "timeout_s": 3.0
    },
    {
      "act": "pad_cursor_glide",
      "node": "/root/MainMenu/TutorialPicker/Margin/VBox/LessonRows/Row_t5_ere_we_go/Play_t5_ere_we_go"
    },
    {
      "act": "simulate_joy_button",
      "button_index": 0
    },
    {
      "act": "wait_seconds",
      "seconds": 8.0
    },
    {
      "act": "execute_script",
