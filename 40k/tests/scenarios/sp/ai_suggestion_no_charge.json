{
  "id": "ai_suggestion_no_charge",
  "covers": [
    "ai.suggestion.breakdown_panel",
    "scripts.AIDecisionMaker.charge_declined_record"
  ],
  "fixture": "audit_372_charge_modifier",
  "edition": 11,
  "rng_seed": 7,
  "description": "K breakdown when the AI declines to charge. Every charger\u2192target pair it weighed is recorded against a 'Don't charge' option at the charge threshold (pairs under 3% are listed as not considered, with the roll they need), so a skipped charge is explainable instead of showing the 'not instrumented' gap.",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"HUMAN\"})"
    },
    {
      "act": "execute_script",
      "script": "main.refresh_ai_suggestion_button()"
    },
    {
      "act": "expect_phase",
      "equals": 9
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.clear_action_log()"
    },
    {
      "act": "simulate_key",
      "keycode": "K"
    },
    {
      "act": "wait_frames",
      "frames": 6
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel != null and main._ai_suggestion_panel.is_visible_in_tree()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"== CHARGE \u00b7 no charge declared ==\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"Picked: Don't charge\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"not considered\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"not instrumented\")",
      "equals": false
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "expect_phase",
      "equals": 9
    },
    {
      "act": "screenshot",
      "label": "01_no_charge_card"
    }
  ]
}