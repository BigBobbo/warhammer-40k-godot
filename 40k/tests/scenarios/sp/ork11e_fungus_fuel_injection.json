{
  "id": "ork11e_fungus_fuel_injection",
  "covers": [
    "stratagem.window.unit_selected_to_move",
    "stratagem.ork11e.fungus_fuel_injection",
    "phases.MovementPhase.unit_selected_to_move_window",
    "dialogs.StratagemDialog.window_mode"
  ],
  "fixture": "ork11e_orks_active",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 7,
  "disable_ai": true,
  "description": "Codex: Orks (11e) FUNGUS-FUEL INJECTION (War Horde, 1 CP) through the real unit_selected_to_move window. Fixture ork11e_orks_active: P1 Orks (War Horde) active in the Movement phase. The S panel shows the row disabled with the window reason. The player clicks the Warbikers token: selecting the unit opens the window BEFORE the move is set up (no move cap yet); the StratagemDialog shows the card with an enabled 'Use on Warbikers' button. A real click on Use spends 1 CP, flags +2\" Move, and resumes the normal move with a 14\" cap (M12 + 2). The whole unit is then dragged 13\" (Ctrl+A group drag) — more than the datasheet 12\" — and the move is locked in with 'End This Unit's Move'. Setup-only privilege: the Allarus Custodians are moved off the Warbikers' lane so the 13\" drop is outside engagement range.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 7 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "expect_state", "path": "factions.1.detachment", "equals": "War Horde" },
    { "act": "execute_script", "script": "StratagemManager.can_use_stratagem(1, \"faction_ork_war_horde_fungus_fuel_injection\", \"U_WARBIKERS_A\").reason", "equals": "Offered automatically when one of your units is selected to move" },
    { "act": "execute_script", "multiline": true, "script": "var i := 0\nfor m in GameState.state.units[\"U_ALLARUS_CUSTODIANS_A\"].models:\n\tm[\"position\"] = {\"x\": 80.0 + i * 72.0, \"y\": 1840.0}\n\ti += 1\ntree.current_scene._recreate_unit_visuals()\nreturn true", "equals": true, "comment": "setup privilege: Allarus moved off the Warbikers' lane (x 34-44, y 11-26)" },
    { "act": "wait_frames", "frames": 3 },

    { "act": "click_unit", "unit_id": "U_WARBIKERS_A" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 1 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id", "equals": "unit_selected_to_move" },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/Header\").text", "equals": "Warbikers has been selected to move" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_moves.has(\"U_WARBIKERS_A\")", "equals": false, "comment": "the move is not set up while the window waits" },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_war_horde_fungus_fuel_injection/Buttons/Use_faction_ork_war_horde_fungus_fuel_injection_U_WARBIKERS_A", "timeout_s": 2.0 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_war_horde_fungus_fuel_injection/Buttons/Use_faction_ork_war_horde_fungus_fuel_injection_U_WARBIKERS_A", "property": "disabled", "equals": false },
    { "act": "dispatch_action", "action": { "type": "END_MOVEMENT", "player": 1 } },
    { "act": "expect_action_result", "path": "success", "equals": false },
    { "act": "screenshot", "label": "01_window_on_select" },

    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_war_horde_fungus_fuel_injection/Buttons/Use_faction_ork_war_horde_fungus_fuel_injection_U_WARBIKERS_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 1, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_WARBIKERS_A.flags.ork11e_plus_move", "equals": 2 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_moves[\"U_WARBIKERS_A\"][\"move_cap_inches\"]", "equals": 14.0 },
    { "act": "execute_script", "script": "main.movement_controller.active_unit_id", "equals": "U_WARBIKERS_A" },
    { "act": "execute_script", "script": "main.movement_controller.move_cap_inches", "equals": 14.0 },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"FUNGUS-FUEL INJECTION\")", "expect_min": 1 },
    { "act": "screenshot", "label": "02_used_cap_14" },

    { "act": "simulate_key", "keycode": "A", "ctrl": true },
    { "act": "wait_frames", "frames": 3 },
    { "act": "drag_board", "from_x": 1432.0, "from_y": 440.0, "to_x": 1432.0, "to_y": 960.0 },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "execute_script", "multiline": true, "script": "var md = PhaseManager.get_current_phase_instance().get_active_move_data(\"U_WARBIKERS_A\")\nvar d = md.get(\"model_distances\", {})\nvar out := []\nfor k in d:\n\tout.append(snappedf(float(d[k]), 0.1))\nreturn out", "equals": [13.0, 13.0, 13.0], "comment": "every Warbiker staged 13\" — beyond the datasheet M12" },
    { "act": "screenshot", "label": "03_13in_group_drag" },
    { "act": "click_node", "button_text": "End This Unit's Move" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_state", "path": "units.U_WARBIKERS_A.flags.moved", "equals": true },
    { "act": "execute_script", "script": "abs(float(GameState.get_unit(\"U_WARBIKERS_A\").models[0].position.y) - 960.0) < 4.0", "equals": true, "comment": "landed 13\" south of y 440 (screen-projection rounding of the real drag is ~1px)" },
    { "act": "screenshot", "label": "04_moved_13in" }
  ]
}
