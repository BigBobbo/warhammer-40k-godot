{
  "id": "ork11e_gun_crazy_show_offs",
  "covers": [
    "stratagem.window.enemy_has_shot",
    "stratagem.ork11e.gun_crazy_show_offs",
    "stratagem.followup.shoot",
    "dialogs.StratagemDialog.window_mode",
    "ui.Main.stratagem_window_waiting_overlay"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 8,
  "disable_ai": true,
  "description": "Codex: Orks (11e) GUN-CRAZY SHOW-OFFS (Wreckas, 1 CP, opponent's Shooting phase) through the real enemy_has_shot window. Fixture ork11e_orks_reactive: P1 Custodes ACTIVE, P2 Orks. Setup-only privilege: P2's detachment is flipped to Wreckas and its stratagems reloaded. The Custodes player selects Custodian Guard C by clicking its token and declares its guardian spears at the Tankbustas (phase actions the shooting panel sends), then resolves with the dock's Fast Roll button (with this seed the activation auto-completes after the saves). Once that unit has fully shot, the enemy_has_shot window opens for PLAYER 2 (the non-active Ork player, hot-seat overlay naming them): the StratagemDialog shows GUN-CRAZY SHOW-OFFS on the hit Tankbustas with an enabled Use button. A real click spends 1 CP and the Tankbustas shoot the Custodian Guard — AUTO-RESOLVED (every ranged weapon that can target that unit fires at it, best profile per weapon, saves rolled automatically; there is no weapon-assignment UI for the non-active player's out-of-turn shooting). Asserts dice rolled against Custodian Guard C and only against it, the CP delta, the Tankbustas NOT marked as having shot, and the phase free again.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 8 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "execute_script", "script": "SettingsService.set(\"auto_allocate_wounds\", true)" },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"2\"].merge({\"detachment\": \"Wreckas\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(2)" },
    { "act": "execute_script", "script": "StratagemManager.find_faction_stratagem_by_name(2, \"GUN-CRAZY SHOW-OFFS\")", "equals": "faction_ork_wreckas_gun_crazy_show_offs" },

    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_D", "comment": "the panel auto-highlights a shooter on phase entry; picking another unit first makes the Custodian Guard C token click a real selection" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_C" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_shooter_id", "equals": "U_CUSTODIAN_GUARD_C" },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_CUSTODIAN_GUARD_C",
      "payload": { "weapon_id": "guardian_spear___ranged_ranged", "target_unit_id": "U_TANKBUSTAS_A", "model_ids": ["m1", "m2", "m3", "m4", "m5"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "CONFIRM_TARGETS" } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "no enemy_targets_unit_shooting offer is expected for Wreckas; decline defensively if a core one appears" },
    { "act": "wait_seconds", "seconds": 0.5 },

    { "act": "click_node", "button_text": "Fast Roll ⏩" },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ConfirmButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton" },
    { "act": "wait_seconds", "seconds": 1.2 },
    { "act": "expect_state", "path": "units.U_CUSTODIAN_GUARD_C.flags.has_shot", "equals": true, "comment": "with this seed the saves leave the Tankbustas at half strength and the phase's existing 'all remaining targets destroyed' check auto-completes the activation (no Complete Shooting / Sentinel Storm step)" },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 4.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().get(\"window_id\", \"\")", "equals": "enemy_has_shot" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 2 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/Header\").text.contains(\"has shot at your units\")", "equals": true },
    { "act": "execute_script", "script": "main._reactive_stratagem_overlay_label.text.contains(\"Player 2\")", "equals": true },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_wreckas_gun_crazy_show_offs/Buttons/Use_faction_ork_wreckas_gun_crazy_show_offs_U_TANKBUSTAS_A", "property": "disabled", "equals": false },
    { "act": "dispatch_action", "action": { "type": "SELECT_SHOOTER", "actor_unit_id": "U_CUSTODIAN_GUARD_D" } },
    { "act": "expect_action_result", "path": "success", "equals": false },
    { "act": "execute_script", "multiline": true, "script": "Engine.set_meta(\"ork11e_gc_dice_before\", PhaseManager.get_current_phase_instance().dice_log.size())\nreturn true", "equals": true },
    { "act": "screenshot", "label": "01_gun_crazy_window_for_player_2" },

    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_wreckas_gun_crazy_show_offs/Buttons/Use_faction_ork_wreckas_gun_crazy_show_offs_U_TANKBUSTAS_A" },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "expect_cp", "player": 1, "delta_from_start": 0 },
    { "act": "execute_script", "multiline": true, "comment": "dice were rolled against Custodian Guard C (the unit that shot) and against no other unit",
      "script": "var log = PhaseManager.get_current_phase_instance().dice_log\nvar at_attacker := 0\nvar elsewhere := 0\nfor i in range(int(Engine.get_meta(\"ork11e_gc_dice_before\", 0)), log.size()):\n\tvar tid := str(log[i].get(\"target_unit_id\", \"\"))\n\tif tid == \"U_CUSTODIAN_GUARD_C\":\n\t\tat_attacker += 1\n\telif tid != \"\":\n\t\telsewhere += 1\nreturn at_attacker > 0 and elsewhere == 0",
      "equals": true },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"GUN-CRAZY SHOW-OFFS\")", "expect_min": 1 },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_TANKBUSTAS_A\").flags.get(\"has_shot\", false)", "equals": false },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance()._ork11e_followup.is_empty()", "equals": true },
    { "act": "execute_script", "script": "main._reactive_stratagem_pending", "equals": false },
    { "act": "screenshot", "label": "02_tankbustas_shot_back" },
    { "act": "dispatch_action", "action": { "type": "SELECT_SHOOTER", "actor_unit_id": "U_CUSTODIAN_GUARD_D" } },
    { "act": "expect_action_result", "path": "success", "equals": true }
  ]
}
