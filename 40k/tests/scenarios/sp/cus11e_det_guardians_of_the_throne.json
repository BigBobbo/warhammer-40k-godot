    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_rule_martial_mastery/Buttons/Use_cus11e_rule_martial_mastery_U_BLADE_CHAMPION_A_lethal" },
    { "act": "wait_seconds", "seconds": 0.8 },
