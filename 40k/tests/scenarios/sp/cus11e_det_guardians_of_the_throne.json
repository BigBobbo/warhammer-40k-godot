    { "act": "execute_script", "multiline": true, "comment": "show the Dice Log tab", "script": "var panel = tree.root.get_node(\"Main\").get_node_or_null(\"HUD_Left/GameLogPanel\")\nif panel == null:\n\tfor n in tree.root.get_node(\"Main\").find_children(\"*\", \"\", true, false):\n\t\tif n.get(\"_tab_dice_button\") != null:\n\t\t\tpanel = n\n\t\t\tbreak\nif panel == null:\n\treturn \"panel not found\"\npanel._tab_dice_button.emit_signal(\"pressed\")\nreturn true", "equals": true },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "screenshot", "label": "03_dice_log_lethal_hits" }
