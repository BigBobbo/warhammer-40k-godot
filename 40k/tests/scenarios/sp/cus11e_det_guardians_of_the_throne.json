    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton" },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "execute_script", "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(12)" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "multiline": true, "comment": "the Blade Champion's melee hit roll carried [LETHAL HITS]", "script": "var ph = PhaseManager.get_current_phase_instance()\nfor d in ph.dice_log:\n\tif str(d.get(\"context\", \"\")) == \"hit_roll_melee\" and bool(d.get(\"lethal_hits_weapon\", false)):\n\t\treturn true\nreturn false", "equals": true },
