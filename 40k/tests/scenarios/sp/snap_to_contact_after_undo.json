{
  "id": "snap_to_contact_after_undo",
  "covers": ["charge.ux.snap_to_contact_button", "charge.ux.snap_button_lifecycle", "charge.per_model_undo", "charge.ux.undo_last_model_button"],
  "fixture": "test_charge_congestion",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 9,
  "disable_ai": true,
  "description": "Snap to Contact must come BACK after an undo. Reported: 'if I move models then revert them with B, it no longer gives me the option to snap to closest'. Repro driven as a player: select the 3-model Boyz unit, declare, roll (seeded 12), CLICK Snap to Contact (every model placed -> models_to_move empty -> the Snap button correctly greys itself out), then CLICK Undo Last Model. That undo puts the model back in models_to_move and returns it to its origin, but _on_undo_last_charge_model never re-evaluated auto_path_charge_button.disabled, so the Snap button stayed greyed FOREVER — and ChargeController.pad_snap_available() reads that same disabled flag, so the pad's '[X] Snap to Contact' chip vanished too. The reverted model could then only be dragged by hand. After the fix the button (and pad_snap_available) are live again the moment a model returns to models_to_move, and the second Snap press is a REAL mouse click (no emit_pressed) precisely because a disabled button ignores one — it only lands if the affordance genuinely came back. The confirm row is also an HFlowContainer now: as a plain HBox its three buttons overflowed the right panel at 1080p and 'Snap to Contact' was sliced in half by the screen edge (see the 02b/03b crops), so the button the player is told to use was only half there.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 2 },

    { "act": "execute_script",
      "script": "GameState.state.players[\"1\"].merge({\"cp\": 0}, true)" },
    { "act": "execute_script",
      "script": "GameState.state.players[\"2\"].merge({\"cp\": 0}, true)" },

    { "act": "execute_script",
      "script": "main.charge_controller.unit_selector.select(0)" },
    { "act": "execute_script",
      "script": "main.charge_controller._on_unit_selected(0)" },
    { "act": "execute_script",
      "script": "main.charge_controller.active_unit_id", "equals": "U_CHARGER_0" },
    { "act": "execute_script",
      "script": "main.charge_controller.target_list.select(0)" },
    { "act": "execute_script",
      "script": "main.charge_controller._on_target_selected(0)" },
    { "act": "execute_script",
      "script": "main.charge_controller._on_declare_charge_pressed()" },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script",
      "script": "main.charge_controller._on_roll_charge_pressed()" },
    { "act": "wait_seconds", "seconds": 0.3 },

    { "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().has_pending_charge(\"U_CHARGER_0\")",
      "equals": true },
    { "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().pending_charges[\"U_CHARGER_0\"].merge({\"distance\": 12}, true)" },
    { "act": "execute_script",
      "script": "main.charge_controller.set(\"charge_distance\", 12)" },
    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.size()", "equals": 3 },

    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "01_snap_live_before_any_move" },

    { "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.3 },

    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.is_empty()", "equals": true },
    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "property": "disabled", "equals": true },
    { "act": "execute_script",
      "script": "main.charge_controller.pad_snap_available()", "equals": false },
    { "act": "execute_script",
      "script": "PadRouter.is_charge_snap_active()", "equals": false },
    { "act": "screenshot", "label": "02_all_snapped_snap_greyed_out" },
    { "act": "screenshot", "label": "02b_confirm_row_snap_greyed_out", "region": [1512, 688, 400, 132] },

    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/UndoLastModelButton",
      "property": "disabled", "equals": false },
    { "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/UndoLastModelButton" },
    { "act": "wait_seconds", "seconds": 0.3 },

    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.size()", "equals": 1 },
    { "act": "execute_script",
      "script": "main.charge_controller._moved_model_order.size()", "equals": 2 },

    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "property": "disabled", "equals": false },
    { "act": "execute_script",
      "script": "main.charge_controller.pad_snap_available()", "equals": true },
    { "act": "execute_script",
      "script": "PadRouter.is_charge_snap_active()", "equals": true },
    { "act": "screenshot", "label": "03_after_undo_snap_live_again" },
    { "act": "screenshot", "label": "03b_confirm_row_snap_live_again", "region": [1512, 688, 400, 132] },

    { "act": "execute_script",
      "script": "main.charge_controller.pad_undo_model()", "equals": true },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.size()", "equals": 2 },
    { "act": "execute_script",
      "script": "main.charge_controller._moved_model_order.size()", "equals": 1 },
    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "property": "disabled", "equals": false },
    { "act": "execute_script",
      "script": "PadRouter.is_charge_snap_active()", "equals": true },
    { "act": "screenshot", "label": "03c_after_pad_b_undo_snap_still_live" },

    { "act": "execute_script",
      "script": "main.charge_controller.pad_undo_model()", "equals": true },
    { "act": "wait_seconds", "seconds": 0.2 },
    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.size()", "equals": 3 },
    { "act": "execute_script",
      "script": "main.charge_controller._moved_model_order.size()", "equals": 0 },
    { "act": "execute_script",
      "script": "main.charge_controller.moved_models.is_empty()", "equals": true },
    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/UndoLastModelButton",
      "property": "disabled", "equals": true },
    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/ConfirmChargeButton",
      "property": "disabled", "equals": true },
    { "act": "expect_node_property",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton",
      "property": "disabled", "equals": false },
    { "act": "execute_script",
      "script": "PadRouter.is_charge_snap_active()", "equals": true },
    { "act": "screenshot", "label": "03d_every_model_reverted_snap_still_live" },
    { "act": "screenshot", "label": "03e_confirm_row_all_reverted", "region": [1512, 688, 400, 132] },

    { "act": "click_node",
      "node": "/root/Main/HUD_Right/VBoxContainer/ChargeScrollContainer/ChargePanel/ChargeActionButtons/ConfirmRow/SnapToContactButton" },
    { "act": "wait_seconds", "seconds": 0.3 },

    { "act": "execute_script",
      "script": "main.charge_controller.models_to_move.is_empty()", "equals": true },
    { "act": "execute_script",
      "script": "Measurement.model_to_model_distance_inches(GameState.get_unit(\"U_CHARGER_0\").models[0], GameState.get_unit(\"U_TARGET_SC\").models[0])",
      "expect_max": 0.05 },
    { "act": "execute_script",
      "script": "Measurement.model_to_model_distance_inches(GameState.get_unit(\"U_CHARGER_0\").models[1], GameState.get_unit(\"U_TARGET_SC\").models[0])",
      "expect_max": 0.05 },
    { "act": "execute_script",
      "script": "Measurement.model_to_model_distance_inches(GameState.get_unit(\"U_CHARGER_0\").models[2], GameState.get_unit(\"U_TARGET_SC\").models[0])",
      "expect_max": 0.05 },
    { "act": "screenshot", "label": "04_reverted_model_resnapped_to_contact" },
    { "act": "screenshot", "label": "04b_resnap_cluster_closeup", "region": [760, 260, 460, 340] }
  ]
}
