    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().validate_action({\"type\": \"END_MOVEMENT\", \"player\": 1}).get(\"valid\", false)",
      "comment": "the Movement phase can now end",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "03_allarus_arrived_by_ingress"
    }
