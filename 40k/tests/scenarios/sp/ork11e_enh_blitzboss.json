 ],
 "description": "WP-O5 Codex: Orks (11e) BLITZBOSS (Brute Bosses enhancement, Warboss model; while this model is embarked within a TRANSPORT, add 2\" to that TRANSPORT's Move characteristic and it has a 5+ invulnerable save) — passive. Fixture ork11e_enh_brute_move: the Warboss is embarked in the Battlewagon (M10\"). The Battlewagon has a 5+ invulnerable save; a real click selects it for a normal move: the cap is 12\" in the phase and in the movement panel; a real drag of ~11\" and 'End This Unit's Move' are accepted.",
 "fixture": "ork11e_enh_brute_move",
 "edition": 11,
 "rng_seed": 42,
 "transition_to_phase": 7,
 "disable_ai": true,
 "steps": [
  {
   "act": "wait_seconds",
   "seconds": 0.8
  },
  {
   "act": "expect_phase",
   "equals": 7
  },
  {
   "act": "expect_state",
   "path": "factions.1.detachment",
   "equals": "Brute Bosses"
  },
  {
   "act": "expect_state",
   "path": "units.U_WARBOSS_A.embarked_in",
   "equals": "U_BATTLEWAGON_A"
  },
  {
   "act": "execute_script",
   "script": "return load(\"res://autoloads/EffectPrimitives.gd\").get_effect_invuln(GameState.get_unit(\"U_BATTLEWAGON_A\"))",
   "multiline": true,
   "equals": 5,
   "comment": "Blitzboss: the TRANSPORT carrying the Warboss has a 5+ invulnerable save"
  },
  {
   "act": "click_if_visible",
   "node": "/root/StratagemDialog/Content/DeclineButton"
  },
  {
   "act": "wait_seconds",
   "seconds": 0.6
  },
  {
   "act": "click_unit",
   "unit_id": "U_BATTLEWAGON_A"
  },
  {
   "act": "wait_seconds",
   "seconds": 0.8
  },
  {
   "act": "click_if_visible",
   "node": "/root/StratagemDialog/Content/DeclineButton"
  },
  {
   "act": "wait_seconds",
   "seconds": 0.8
  },
  {
   "act": "execute_script",
   "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()",
   "equals": false
  },
  {
   "act": "execute_script",
   "script": "main.movement_controller.active_unit_id",
   "equals": "U_BATTLEWAGON_A"
  },
  {
   "act": "execute_script",
   "script": "PhaseManager.get_current_phase_instance().active_moves[\"U_BATTLEWAGON_A\"][\"move_cap_inches\"]",
   "equals": 12.0,
   "comment": "M10\" + 2\" Blitzboss"
  },
  {
   "act": "execute_script",
   "script": "main.movement_controller.move_cap_label.text.begins_with(\"Move: 12.0\")",
   "equals": true,
   "comment": "the movement panel shows the 12\" cap"
  },
  {
   "act": "screenshot",
   "label": "01_blitzboss_cap_12"
  },
  {
   "act": "drag_board",
   "from_x": 560.0,
   "from_y": 775.0,
   "to_x": 560.0,
   "to_y": 1215.0
  },
  {
   "act": "wait_seconds",
   "seconds": 1.5
  },
  {
   "act": "execute_script",
   "script": "var md = PhaseManager.get_current_phase_instance().get_active_move_data(\"U_BATTLEWAGON_A\")\nvar mx := 0.0\nfor k in md.get(\"model_distances\", {}):\n\tmx = maxf(mx, float(md.model_distances[k]))\nreturn mx > 10.5 and mx <= 12.0",
   "multiline": true,
   "equals": true,
   "comment": "dragged ~11\" — beyond its printed 10\""
  },
  {
   "act": "click_node",
   "button_text": "End This Unit's Move"
  },
  {
   "act": "wait_seconds",
   "seconds": 0.8
  },
  {
   "act": "expect_state",
   "path": "units.U_BATTLEWAGON_A.flags.moved",
   "equals": true
  },
  {
   "act": "execute_script",
   "script": "float(GameState.get_unit(\"U_BATTLEWAGON_A\").models[0].position.y) > 775.0 + 10.5 * 40.0",
   "equals": true,
   "comment": "the 11\" move was accepted"
  },
  {
