{
  "id": "ork11e_dread_power",
  "covers": [
    "stratagem.ork11e.dread_power",
    "ui.StratagemPanel.codex_row",
    "ui.Main.stratagem_target_picker",
    "ui.StratagemPanel.friendly_target_picker",
    "autoloads.StratagemManager.target_condition_enforcement"
  ],
  "fixture": "ork11e_orks_active",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 7,
  "disable_ai": true,
  "description": "Codex: Orks (11e) DREAD POWER (Dread Mob, 1 CP) from the S panel in the Orks' Movement phase. The player opens the Stratagem panel: the DREAD POWER row's Use button is enabled. A real click on Use opens the friendly-target picker listing only ORKS WALKER units (Deff Dread, Killa Kans — not the Battlewagon). A real click on the Deff Dread spends 1 CP and makes it riled up until the start of the Orks' next Command phase: Waaagh! state, a 5+ invulnerable save, eligible to charge after advancing, and its ranged weapons gain [ASSAULT]. Setup-only privilege: the fixture's Ork detachment is flipped to Dread Mob (stratagems reloaded).",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 7 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "execute_script", "multiline": true, "script": "GameState.state[\"factions\"][\"1\"].merge({\"detachment\": \"Dread Mob\"}, true)\nStratagemManager.load_faction_stratagems_for_player(1)\nreturn StratagemManager.get_stratagem(\"faction_ork_dread_mob_dread_power\").get(\"implemented\", false)", "equals": true, "comment": "setup privilege: Dread Mob" },
    { "act": "click_node", "node": "/root/Main/HUD_Bottom/HBoxContainer/StratagemPanelButton" },
    { "act": "expect_node_visible", "node": "/root/Main/StratagemPanel", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "main.get_node(\"StratagemPanel/Scroll\").ensure_control_visible(main.get_node(\"StratagemPanel/Scroll/List/Strat_faction_ork_dread_mob_dread_power\"))" },
    { "act": "wait_frames", "frames": 3 },
    { "act": "expect_node_property", "node": "/root/Main/StratagemPanel/Scroll/List/Strat_faction_ork_dread_mob_dread_power/Row/Use_faction_ork_dread_mob_dread_power", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "01_s_panel_dread_power" },
    { "act": "click_node", "node": "/root/Main/StratagemPanel/Scroll/List/Strat_faction_ork_dread_mob_dread_power/Row/Use_faction_ork_dread_mob_dread_power" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_node_visible", "node": "/root/StratagemTargetDialog", "timeout_s": 3.0 },
    { "act": "expect_node_visible", "node": "/root/StratagemTargetDialog/Content/Pick_U_DEFF_DREAD_A" },
    { "act": "expect_node_visible", "node": "/root/StratagemTargetDialog/Content/Pick_U_KILLA_KANS_A" },
    { "act": "execute_script", "script": "main.get_tree().root.get_node_or_null(\"StratagemTargetDialog/Content/Pick_U_BATTLEWAGON_A\") == null", "equals": true, "comment": "only ORKS WALKER units" },
    { "act": "expect_cp", "player": 1, "delta_from_start": 0 },
    { "act": "screenshot", "label": "02_walker_picker" },
    { "act": "click_node", "node": "/root/StratagemTargetDialog/Content/Pick_U_DEFF_DREAD_A" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_cp", "player": 1, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.ork11e_riled_up", "equals": true },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.waaagh_active", "equals": true },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.effect_invuln", "equals": 5 },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.effect_advance_and_charge", "equals": true },
    { "act": "expect_state", "path": "units.U_DEFF_DREAD_A.flags.effect_advance_and_shoot", "equals": true },
    { "act": "expect_state", "path": "units.U_KILLA_KANS_A.flags.ork11e_riled_up", "equals": null, "comment": "only the picked walker" },
    { "act": "execute_script", "multiline": true, "script": "for e in StratagemManager.active_effects:\n\tif str(e.get(\"stratagem_id\", \"\")) == \"faction_ork_dread_mob_dread_power\":\n\t\treturn str(e.get(\"expires\", \"\"))\nreturn \"none\"", "equals": "next_own_command_phase", "comment": "until the start of your next Command phase" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"DREAD POWER\")", "expect_min": 1 },
    { "act": "screenshot", "label": "03_deff_dread_riled_up" },
    { "act": "execute_script", "script": "main.get_node(\"StratagemPanel\").hide()", "comment": "close the S panel so the board can be hovered" },
    { "act": "wait_frames", "frames": 3 },
    { "act": "hover_unit", "unit_id": "U_DEFF_DREAD_A", "comment": "LV-3: hover the riled-up Deff Dread" },
    { "act": "expect_node_visible", "node": "/root/Main/TokenHoverTooltip", "timeout_s": 2.0 },
    { "act": "execute_script", "script": "main._token_hover_unit_id", "equals": "U_DEFF_DREAD_A" },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"Inv:5++ (Dread Power)\") and not main._token_hover_label.get_parsed_text().contains(\"Inv:6++\")", "equals": true, "comment": "LV-3: the card shows the EFFECTIVE 5+ invulnerable save (better of datasheet 6++ and DREAD POWER's 5+), not the datasheet's" },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"Riled up\")", "equals": true, "comment": "LV-3: the card says the walker is riled up" },
    { "act": "execute_script", "script": "main._token_hover_label.get_parsed_text().contains(\"Riled up — 5+ invuln, ranged [ASSAULT], advance and charge\") and not main._token_hover_label.get_parsed_text().to_lower().contains(\"riled up — riled up\")", "equals": true, "comment": "LV2-E1: 'Riled up — <effects>', not 'Riled up — riled up: <effects>'" },
    { "act": "screenshot", "label": "04_hover_card_effective_invuln_riled_up" }
  ]
}
