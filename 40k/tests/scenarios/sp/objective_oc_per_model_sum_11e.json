{
  "id": "objective_oc_per_model_sum_11e",
  "covers": [
    "scoring.objective_control.per_model_sum_14_02"
  ],
  "fixture": "audit_383_battleshock_shoot",
  "edition": 11,
  "description": "14.02 LEVEL OF CONTROL is a per-model sum: 'add together the OC characteristics of all the models in that player's army that are within range of that objective'. Pre-fix, MissionManager added each UNIT's OC once (unit_counted break), so 2 Kommandos (OC1 each) counted 1 and the Shield-Captain (OC2) held the centre ('Adeptus Custodes'). The 11e layout disruption_vs_purge_the_foe_1 is loaded and objectives re-derived so obj_center is the linked Center trapezoid pair (rectangle x680-1080, y970-1430). The Telemon and Caladius, whose big bases graze the area, are parked far away; the Contemptor-Achillus on it is battle-shocked (OC '-'). Stage A: the Shield-Captain (OC2, trapezoid-2) faces Kommandos H models m2 + m3 (OC1 + OC1 = 2): level of control 2 vs 2 -> genuine tie -> board label 'CONTESTED'. Stage B: a third Kommandos model (m6) steps onto the area at (1013,1340): 2 vs 3 -> the Orks control obj_center and the label reads 'Orks' (pre-fix it stayed 'Adeptus Custodes', 2 vs 1).",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "meta.phase", "equals": 8 },
    { "act": "screenshot", "label": "00_fixture_loaded" },

    { "act": "execute_script",
      "script": "TerrainManager.load_terrain_layout(\"disruption_vs_purge_the_foe_1\")" },
    { "act": "wait_frames", "frames": 8 },
    { "act": "execute_script",
      "script": "MissionManager._setup_objectives_for_deployment(\"search_and_destroy\")" },
    { "act": "execute_script",
      "script": "MissionManager._get_objective_by_id(\"obj_center\").get(\"source_pieces\", []).size()",
      "equals": 2 },

    { "act": "execute_script",
      "script": "GameState.state[\"units\"][\"U_TELEMON_HEAVY_DREADNOUGHT_I\"][\"models\"][0].merge({\"position\": Vector2(80.0, 1200.0)}, true)" },
    { "act": "execute_script",
      "script": "GameState.state[\"units\"][\"U_CALADIUS_GRAV-TANK_E\"][\"models\"][0].merge({\"position\": Vector2(1680.0, 1200.0)}, true)" },
    { "act": "execute_script",
      "script": "main._sync_all_token_positions()" },
    { "act": "execute_script",
      "script": "MissionManager.check_all_objectives()" },
    { "act": "wait_frames", "frames": 2 },

    { "act": "execute_script",
      "script": "GameState.state[\"units\"][\"U_CONTEMPTOR-ACHILLUS_DREADNOUGHT_H\"][\"flags\"].get(\"battle_shocked\", false)",
      "equals": true },
    { "act": "execute_script",
      "script": "MissionManager.get_level_of_control(MissionManager._get_objective_by_id(\"obj_center\")).get(1)",
      "equals": 2 },
    { "act": "execute_script",
      "script": "MissionManager.get_level_of_control(MissionManager._get_objective_by_id(\"obj_center\")).get(2)",
      "equals": 2 },
    { "act": "execute_script",
      "script": "MissionManager.objective_control_state.get(\"obj_center\", -1)",
      "equals": 0 },
    { "act": "execute_script",
      "script": "MissionManager.is_objective_contested(\"obj_center\")",
      "equals": true },
    { "act": "execute_script",
      "script": "MissionManager.objectives_visual_refs[\"obj_center\"].control_indicator.text",
      "equals": "CONTESTED" },
    { "act": "execute_script",
      "script": "main.fit_view_to_selection(\"U_SHIELD_CAPTAIN_A\")" },
    { "act": "wait_for_tweens", "timeout_s": 6.0 },
    { "act": "wait_frames", "frames": 2 },
    { "act": "screenshot", "label": "01_two_oc1_models_tie_captain_contested" },

    { "act": "execute_script",
      "script": "GameState.state[\"units\"][\"U_KOMMANDOS_H\"][\"models\"][5].merge({\"position\": Vector2(1013.0, 1340.0)}, true)" },
    { "act": "execute_script",
      "script": "main._sync_all_token_positions()" },
    { "act": "execute_script",
      "script": "MissionManager.check_all_objectives()" },
    { "act": "wait_frames", "frames": 2 },

    { "act": "execute_script",
      "script": "MissionManager.get_level_of_control(MissionManager._get_objective_by_id(\"obj_center\")).get(2)",
      "equals": 3 },
    { "act": "execute_script",
      "script": "MissionManager.objective_control_state.get(\"obj_center\", -1)",
      "equals": 2 },
    { "act": "execute_script",
      "script": "MissionManager.is_objective_contested(\"obj_center\")",
      "equals": false },
    { "act": "execute_script",
      "script": "MissionManager.objectives_visual_refs[\"obj_center\"].control_indicator.text",
      "equals": "Orks" },
    { "act": "execute_script",
      "script": "main.fit_view_to_selection(\"U_SHIELD_CAPTAIN_A\")" },
    { "act": "wait_for_tweens", "timeout_s": 6.0 },
    { "act": "wait_frames", "frames": 2 },
    { "act": "screenshot", "label": "02_third_kommando_orks_control" }
  ]
}
