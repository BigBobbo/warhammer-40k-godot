      "script": "var b = tree.root.get_node_or_null(\"/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton\")\nif b != null and b.is_visible_in_tree():\n\tb.pressed.emit()\nreturn true",
      "multiline": true,
      "equals": true,
