    {
      "act": "execute_script",
      "script": "var pi = tree.root.get_node(\"/root/PhaseManager\").current_phase_instance\nreturn str(pi.active_shooter_id)",
      "multiline": true,
      "equals": "U_BOYZ_T"
    },
    {
      "act": "wait_seconds",
      "seconds": 2.0
