    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_wreckas_grab_it/Buttons/Use_faction_ork_wreckas_grab_it_U_FLASH_GITZ_A", "property": "disabled", "equals": false },
    { "act": "dispatch_action", "action": { "type": "END_SHOOTING", "player": 1 } },
    { "act": "expect_action_result", "path": "success", "equals": false },
    { "act": "screenshot", "label": "01_grab_it_window_after_shooting" },

    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_wreckas_grab_it/Buttons/Use_faction_ork_wreckas_grab_it_U_FLASH_GITZ_A" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 1, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_FLASH_GITZ_A.flags.ork11e_grab_it_no_charge", "equals": true },
    { "act": "expect_node_visible", "node": "/root/Ork11eReactiveMovePanel", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"Ork11eReactiveMovePanel/Content/Header\").text", "equals": "GRAB IT — Flash Gitz" },
    { "act": "expect_node_property", "node": "/root/Ork11eReactiveMovePanel/Content/Buttons/ConfirmButton", "property": "disabled", "equals": true },
    { "act": "dispatch_action", "action": { "type": "SELECT_SHOOTER", "actor_unit_id": "U_TANKBUSTAS_A" } },
    { "act": "expect_action_result", "path": "success", "equals": false },
    { "act": "screenshot", "label": "02_move_panel_before_drag" },

    { "act": "drag_board", "from_x": 160.0, "from_y": 628.4, "to_x": 240.0, "to_y": 808.4, "steps": 10 },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().ork11e_reactive_move_info().get(\"valid\", false)", "equals": true },
    { "act": "expect_node_property", "node": "/root/Ork11eReactiveMovePanel/Content/Buttons/ConfirmButton", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "03_unit_dragged_toward_objective" },
    { "act": "click_node", "node": "/root/Ork11eReactiveMovePanel/Content/Buttons/ConfirmButton" },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance()._ork11e_followup.is_empty()", "equals": true },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
    { "act": "execute_script", "script": "main.get_tree().root.get_node_or_null(\"Ork11eReactiveMovePanel\") == null", "equals": true },
    { "act": "execute_script", "script": "ResourceLoader.load(\"res://scripts/rules/ReactiveMove11e.gd\").group_within_objective_range(GameState.state, \"U_FLASH_GITZ_A\")", "equals": true },
    { "act": "execute_script", "script": "RulesEngine.is_unit_engaged(\"U_FLASH_GITZ_A\", GameState.state)", "equals": false },
    { "act": "execute_script", "script": "RulesEngine.eligible_to_charge(\"U_FLASH_GITZ_A\", GameState.state)", "equals": false },
    { "act": "execute_script", "multiline": true, "script": "return MoveTypes.get_type(\"charge\").eligible(\"U_FLASH_GITZ_A\", GameState.state).get(\"eligible\", true)", "equals": false },
    { "act": "execute_script", "multiline": true,
      "script": "var m = GameState.get_unit(\"U_FLASH_GITZ_A\").models[1]\nreturn absf(float(m.position.y) / 40.0 - 15.71 - 4.5) < 0.3 and absf(float(m.position.x) / 40.0 - 4.0 - 2.0) < 0.3",
      "equals": true },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"GRAB IT\")", "expect_min": 1 },
    { "act": "expect_cp", "player": 1, "delta_from_start": -1 },
    { "act": "screenshot", "label": "04_flash_gitz_on_objective_after_grab_it" }
  ]
