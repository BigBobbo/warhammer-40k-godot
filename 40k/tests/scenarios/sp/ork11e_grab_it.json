    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 0, "comment": "LV-2: the phase-entry auto-selection is not a player choice, so it opens NO unit_selected_to_shoot window (it opens before the player's first action with that shooter instead) - nothing to decline before the scenario picks its own shooter" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "execute_script", "script": "SettingsService.set(\"auto_allocate_wounds\", true)" },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"1\"].merge({\"detachment\": \"Wreckas\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(1)" },
    { "act": "execute_script", "script": "StratagemManager.find_faction_stratagem_by_name(1, \"GRAB IT\")", "equals": "faction_ork_wreckas_grab_it" },
    { "act": "execute_script", "script": "ResourceLoader.load(\"res://scripts/rules/ReactiveMove11e.gd\").group_within_objective_range(GameState.state, \"U_FLASH_GITZ_A\")", "equals": false },

    { "act": "click_unit", "unit_id": "U_FLASH_GITZ_A" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_shooter_id", "equals": "U_FLASH_GITZ_A" },
    { "act": "execute_script", "script": "main.get_node(\"ShootingController\").active_shooter_id", "equals": "U_FLASH_GITZ_A" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 0, "comment": "WP-O6: the 10e Ammo Runt prompt (DECLINE_AMMO_RUNT) is gone — the codex Ammo Runts is a once-per-battle unit_selected_to_shoot ability offer (OrkAbilities11e), and this fixture's Flash Gitz carry no ammo runt, so nothing waits here" },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_FLASH_GITZ_A",
      "payload": { "weapon_id": "snazzgun___kill_shot_ranged", "target_unit_id": "U_CUSTODIAN_GUARD_C", "model_ids": ["m1", "m2", "m3", "m4", "m5"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "CONFIRM_TARGETS" } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "click_node", "button_text": "Fast Roll ⏩" },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ConfirmButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/RerollPanel/KeepRollsButton" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/PickPanel/PickVBox/PickButtons/AutoPickButton" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/PickPanel/PickVBox/PickButtons/ConfirmRemovalButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton" },
    { "act": "wait_seconds", "seconds": 1.2 },
    { "act": "click_node", "button_text": "Complete Shooting" },
    { "act": "wait_seconds", "seconds": 1.0 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 4.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().get(\"window_id\", \"\")", "equals": "unit_has_shot" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 1 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/Header\").text", "equals": "Flash Gitz has shot" },
