{
  "id": "cus11e_ab_neutronium_cascade_mine",
  "covers": [
    "codex.custodes.datasheet_abilities.neutronium_cascade_mine",
    "scripts.codex.custodes.CustodesAbilities",
    "stratagem.window.phase_start",
    "dialogs.StratagemTargetDialog"
  ],
  "description": "WP-C7 Codex: Adeptus Custodes (11e) NEUTRONIUM CASCADE MINE (Venatari Custodians, once per battle) through the real start-of-phase window. Fixture cus11e_c7_fight (P1 Custodes, round 2): the Kinetic-destroyer Venatari are 2.5\" from Gretchin C. Entering the Fight phase opens the phase_start window for P1; a real click on the mine card opens the enemy picker (units within 3\"); a real click picks Gretchin C. No CP; the mine rolls D6 (2+) then D3 mortal wounds — Gretchin models are removed (game log line), the UnitAbilityManager once-per-battle ledger is marked, the window re-offers only Moment Shackle (declined by a real click) and the mine is never offered again. Setup privileges: auto wound allocation; the Orks (P2) have 0 CP.",
  "fixture": "cus11e_c7_fight",
  "edition": 11,
  "rng_seed": 11,
  "transition_to_phase": 10,
  "disable_ai": true,
  "custodes_abilities": true,
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_phase",
      "equals": 10
    },
    {
      "act": "expect_state",
      "path": "meta.active_player",
      "equals": 1
    },
    {
      "act": "execute_script",
      "script": "SettingsService.set(\"auto_allocate_wounds\", true)\nGameState.state.players[\"2\"][\"cp\"] = 0\nreturn true",
      "multiline": true,
      "comment": "setup privilege: auto wound allocation; player(s) 2 CP 0 (no paid stratagem competes with the abilities under test) (see description)",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "var n := 0\nfor m in GameState.get_unit(\"U_GRETCHIN_C\").models:\n\tif m.get(\"alive\", true):\n\t\tn += 1\nprint(\"[wp-c7] NCM: Gretchin C alive before = \", n)\nreturn n",
      "multiline": true,
      "comment": "Gretchin C starts at full strength (10 models)",
      "equals": 10
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 6.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "phase_start"
    },
    {
      "act": "execute_script",
