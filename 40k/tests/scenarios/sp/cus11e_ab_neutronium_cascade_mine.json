      "equals": "Ability"
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_ab_neutronium_cascade_mine/Buttons/Use_cus11e_ab_neutronium_cascade_mine_U_VENATARI_KD_A",
      "timeout_s": 2.0
    },
    {
      "act": "screenshot",
      "label": "01_phase_start_mine_card"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_ab_neutronium_cascade_mine/Buttons/Use_cus11e_ab_neutronium_cascade_mine_U_VENATARI_KD_A",
      "comment": "real click: use the mine"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog",
      "timeout_s": 3.0
    },
    {
      "act": "expect_node_property",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_GRETCHIN_C",
      "property": "disabled",
      "equals": false
    },
    {
      "act": "screenshot",
      "label": "02_mine_target_picker"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_GRETCHIN_C",
      "comment": "real click: the enemy unit within 3\""
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Neutronium Cascade Mine:\")",
