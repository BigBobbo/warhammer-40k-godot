      "timeout_s": 2.0
    },
    {
      "act": "execute_script",
      "script": "tree.root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_cus11e_ab_neutronium_cascade_mine\").find_child(\"Cost\", true, false).text",
