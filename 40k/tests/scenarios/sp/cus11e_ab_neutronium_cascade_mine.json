      "equals": true
    },
    {
      "act": "execute_script",
      "script": "var n := 0\nfor m in GameState.get_unit(\"U_GRETCHIN_C\").models:\n\tif m.get(\"alive\", true):\n\t\tn += 1\nprint(\"[wp-c7] NCM: Gretchin C alive after = \", n)\nreturn n < 10",
      "multiline": true,
      "comment": "the D3 mortal wounds removed Gretchin (W1) models",
      "equals": true
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 3.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "phase_start"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()",
      "equals": 1
    },
    {
      "act": "execute_script",
      "script": "tree.root.get_node_or_null(\"StratagemDialog/Content/StratScroll/StratList/Card_cus11e_ab_neutronium_cascade_mine\") == null",
      "equals": true
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_cus11e_ab_moment_shackle",
