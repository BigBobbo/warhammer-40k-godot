    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "execute_script",
      "script": "var offers = load(\"res://scripts/codex/custodes/CustodesAbilities.gd\").window_offers(1, \"phase_start\", {})\nfor o in offers:\n\tif str(o.get(\"stratagem_id\", \"\")) == \"cus11e_ab_neutronium_cascade_mine\":\n\t\treturn false\nreturn true",
      "multiline": true,
      "comment": "the mine is no longer offered at the start of a later phase this battle",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "03_mine_resolved_log"
    }
  ]
