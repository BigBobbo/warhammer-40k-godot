  "fixture": "ork11e_orks_active",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 10,
  "disable_ai": true,
  "description": "Codex: Orks (11e) KEEP IT RUNNIN' (Blitz Brigade) through the real fight_phase_end window and the embark follow-up. Fixture ork11e_orks_active (P1 Orks active), detachment switched to Blitz Brigade (setup privilege, stratagems reloaded). The Boyz (+ attached Warboss) start the Fight phase engaged with Custodian Guard A, so they are stamped 'eligible to fight this phase'; setup privilege: they are then repositioned in front of the Trukk (unengaged, every model wholly within 6\"), standing in for a fight that left them unengaged. The players end the Fight phase with the real End Fight Phase button / confirmation dialogs and pass both halves of the Consolidate step; at the end of the phase the window opens for the ACTIVE player first with KEEP IT RUNNIN' on the Boyz (enabled Use, label 'Boyz → Trukk'). A real click spends 1 CP; the embark follow-up puts the Boyz AND the Warboss inside the Trukk (embarked_in, positions cleared, Trukk lists both) and the phase then completes.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 10 },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"1\"].merge({\"detachment\": \"Blitz Brigade\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(1)" },
    { "act": "execute_script", "script": "StratagemManager.get_stratagem(\"faction_ork_blitz_brigade_keep_it_runnin\").get(\"implemented\", false)", "equals": true },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_BOYZ_B\").flags.get(\"was_eligible_to_fight\", false)", "equals": true, "comment": "engaged at the start of the phase" },
    { "act": "execute_script", "multiline": true, "script": "var t = GameState.get_unit(\"U_TRUKK_A\").models[0].position\nvar boyz = GameState.get_unit(\"U_BOYZ_B\")\nfor i in range(boyz.models.size()):\n\tvar col = i % 5\n\tvar row = int(i / 5)\n\tboyz.models[i][\"position\"] = {\"x\": float(t.x) + (col - 2) * 1.3 * 40.0, \"y\": float(t.y) + (4.25 + row * 1.3) * 40.0}\nGameState.get_unit(\"U_WARBOSS_A\").models[0][\"position\"] = {\"x\": float(t.x) - 3.9 * 40.0, \"y\": float(t.y) + 4.35 * 40.0}\nreturn not RulesEngine.is_unit_engaged(\"U_BOYZ_B\", GameState.state) and not RulesEngine.is_unit_engaged(\"U_WARBOSS_A\", GameState.state)", "equals": true, "comment": "setup privilege: Boyz + Warboss repositioned (unengaged) in front of the Trukk" },
    { "act": "execute_script", "multiline": true, "script": "var o = StratagemManager.get_window_offers(1, \"fight_phase_end\", {\"phase\": \"fight\"})\nreturn o.size() == 1 and o[0].targets.size() == 1 and o[0].targets[0].unit_id == \"U_BOYZ_B\"", "equals": true },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_phase_property", "property": "pile_in_step_11e", "equals": 2 },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/EndFightConfirmationDialog/Content/Actions/ConfirmEndFight", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "click_node", "node": "/root/Main/PhaseActionButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/EndFightConfirmationDialog/Content/Actions/ConfirmEndFight", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "multiline": true, "script": "var d = tree.current_scene._phase_end_confirm\nif d != null and d.visible:\n\td.get_ok_button().pressed.emit()\nreturn true", "equals": true },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_phase_property", "property": "consolidation_step_11e", "equals": 1 },

    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel/EndConsolidationButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/ConsolidationStepPanel/EndConsolidationButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().get(\"window_id\", \"\")", "equals": "fight_phase_end" },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 1 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/Header\").text", "equals": "Stratagem opportunity: the Fight phase ends" },
    { "act": "expect_node_visible", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_blitz_brigade_keep_it_runnin/Buttons/Use_faction_ork_blitz_brigade_keep_it_runnin_U_BOYZ_B", "timeout_s": 2.0 },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_blitz_brigade_keep_it_runnin/Buttons/Use_faction_ork_blitz_brigade_keep_it_runnin_U_BOYZ_B", "property": "disabled", "equals": false },
    { "act": "execute_script", "script": "GameState.get_current_phase()", "equals": 10, "comment": "the phase waits for the decision before it ends" },
    { "act": "expect_token_visible", "unit_id": "U_BOYZ_B", "timeout_s": 2.0, "comment": "on the board before the stratagem" },
    { "act": "screenshot", "label": "01_keep_it_runnin_window" },
    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_blitz_brigade_keep_it_runnin/Buttons/Use_faction_ork_blitz_brigade_keep_it_runnin_U_BOYZ_B" },
    { "act": "wait_seconds", "seconds": 0.6 },

    { "act": "expect_cp", "player": 1, "delta_from_start": -1 },
    { "act": "expect_state", "path": "units.U_BOYZ_B.embarked_in", "equals": "U_TRUKK_A" },
    { "act": "expect_state", "path": "units.U_WARBOSS_A.embarked_in", "equals": "U_TRUKK_A" },
    { "act": "execute_script", "script": "\"U_BOYZ_B\" in GameState.get_unit(\"U_TRUKK_A\").transport_data.embarked_units and \"U_WARBOSS_A\" in GameState.get_unit(\"U_TRUKK_A\").transport_data.embarked_units", "equals": true },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_BOYZ_B\").models[0].get(\"position\", 1) == null", "equals": true },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"KEEP IT RUNNIN': Boyz embarks within\")", "expect_min": 1 },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "multiline": true, "script": "var t = ScenarioRunner._find_unit_token(\"U_BOYZ_B\")\nvar w = ScenarioRunner._find_unit_token(\"U_WARBOSS_A\")\nreturn (t == null or not t.is_visible_in_tree()) and (w == null or not w.is_visible_in_tree())", "equals": true, "comment": "its tokens have left the board" },
    { "act": "screenshot", "label": "02_boyz_embarked_in_trukk" }
  ]
}
