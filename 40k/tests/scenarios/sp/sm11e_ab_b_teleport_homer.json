    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "str(GameState.get_unit(\"U_TERMINATOR_SQUAD_A\").flags.get(\"sm11e_ab_homer\", {}).get(\"label\", \"\")).contains(\"CENTER\")",
      "comment": "the token is set up on the centre objective",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Teleport Homer: Terminator Squad's token is set up\")",
