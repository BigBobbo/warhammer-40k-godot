      "script": "var md = PhaseManager.current_phase_instance.get_active_move_data(\"U_GRETCHIN_T\")\nvar dists = md.get(\"model_distances\", {})\nvar mx = 0.0\nfor k in dists:\n\tmx = max(mx, float(dists[k]))\nreturn mx > 1.0",
