{
  "id": "sm11e_ab_b_shooting_cards",
  "covers": [
    "scripts.codex.space_marines.SMAbilitiesB",
    "stratagem.window.phase_start",
    "dialogs.StratagemDialog",
    "codex.space_marines.datasheet_abilities.telepathic_assault",
    "codex.space_marines.datasheet_abilities.haywire_mine",
    "codex.space_marines.datasheet_abilities.signum_array"
  ],
  "description": "WP-M4b Shooting-phase abilities through the real phase_start window. Fixture sm11e_m4b_shoot (P1 Space Marines, round 2). TELEPATHIC ASSAULT (Tigurius, psychic level 1): real click + pick of the Boyz \u2014 2D3 mortal wounds. HAYWIRE MINE (Incursors, once per battle): the picker lists only enemies within 6\" (the Deff Dread, not the Boyz); a real pick rolls the D6 (2+: 2D3 mortal wounds vs a VEHICLE). SIGNUM ARRAY (Tor Garadon): real pick of the Boyz \u2014 they cannot have the benefit of cover. No CP spent.",
  "fixture": "sm11e_m4b_shoot",
  "edition": 11,
  "rng_seed": 11,
  "transition_to_phase": 8,
  "disable_ai": true,
  "sm_abilities_b": true,
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "expect_phase",
      "equals": 8
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog",
      "timeout_s": 6.0
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window().window_id",
      "equals": "phase_start"
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()",
      "equals": 1
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_telepathic_assault",
      "timeout_s": 2.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_haywire_mine",
      "timeout_s": 2.0
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_signum_array",
      "timeout_s": 2.0
    },
    {
      "act": "screenshot",
      "label": "01_shooting_phase_start_cards"
    },
    {
      "act": "execute_script",
      "script": "var w := 0\nfor m in GameState.get_unit(\"U_BOYZ_B\").models:\n\tif m.get(\"alive\", true):\n\t\tw += int(m.get(\"current_wounds\", 1))\nGameState.state.meta[\"m4b_boyz_w0\"] = w\nreturn w",
      "multiline": true,
      "expect_min": 1
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_telepathic_assault/Buttons/Use_sm11e_ab_b_telepathic_assault_U_CHIEF_LIBRARIAN_TIGURIUS_A",
      "comment": "real click: Telepathic Assault"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BOYZ_B",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BOYZ_B",
      "comment": "real click: the Boyz within 24\""
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "var w := 0\nfor m in GameState.get_unit(\"U_BOYZ_B\").models:\n\tif m.get(\"alive\", true):\n\t\tw += int(m.get(\"current_wounds\", 1))\nreturn int(GameState.state.meta[\"m4b_boyz_w0\"]) - w",
      "multiline": true,
      "comment": "2D3 mortal wounds",
      "expect_min": 2
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_haywire_mine",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_haywire_mine/Buttons/Use_sm11e_ab_b_haywire_mine_U_INCURSOR_SQUAD_A",
      "comment": "real click: Haywire Mine"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_DEFF_DREAD_A",
      "timeout_s": 3.0
    },
    {
      "act": "execute_script",
      "script": "tree.root.get_node_or_null(\"StratagemTargetDialog/Content/Pick_U_BOYZ_B\") == null",
      "comment": "only enemy units within 6\"",
      "equals": true
    },
    {
      "act": "screenshot",
      "label": "02_haywire_mine_picker"
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_DEFF_DREAD_A",
      "comment": "real click: the Deff Dread 4\" away"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "UnitAbilityManager.is_once_per_battle_used(\"U_INCURSOR_SQUAD_A\", \"Haywire Mine\")",
      "comment": "once per battle: ledger marked",
      "equals": true
    },
    {
      "act": "expect_node_visible",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_signum_array",
      "timeout_s": 3.0
    },
    {
      "act": "click_node",
      "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_sm11e_ab_b_signum_array/Buttons/Use_sm11e_ab_b_signum_array_U_TOR_GARADON_A",
      "comment": "real click: Signum Array"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "click_node",
      "node": "/root/StratagemTargetDialog/Content/Pick_U_BOYZ_B",
      "comment": "real click: the Boyz"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "GameState.get_unit(\"U_BOYZ_B\").flags.has(\"sm11e_ab_signum\")",
      "comment": "the Boyz cannot have the benefit of cover",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Telepathic Assault (Chief Librarian Tigurius): psychic roll\")",
      "expect_min": 1
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Haywire Mine: \")",
      "expect_min": 1
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "decline any other open window (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "screenshot",
      "label": "03_shooting_cards_resolved_log"
    },
    {
      "act": "execute_script",
      "script": "DebugLogger._flush_buffer()\nvar f = FileAccess.open(DebugLogger.get_real_log_file_path(), FileAccess.READ)\nvar n := 0\nwhile f != null and not f.eof_reached():\n\tvar l := f.get_line()\n\tif l.contains(\"[ERROR\"):\n\t\tn += 1\n\t\tprint(\"[sm11e-m4b] debug-log ERROR: \", l)\nreturn n",
      "multiline": true,
      "comment": "clean debug log: no ERROR line was written during the scenario",
      "equals": 0
    }
  ]
}
