    {"act": "execute_script", "multiline": true, "comment": "LIVE-2 / WH-8 / WS-9: every Use / option button is inside the visible part of the card list without scrolling, and the whole dialog is on screen", "script": "var dl = tree.root.get_node(\"StratagemDialog\")\nvar sc = dl.get_node(\"Content/StratScroll\")\nvar view = sc.get_global_rect()\nvar n = 0\nvar shown = 0\nfor card in sc.get_node(\"StratList\").get_children():\n\tvar b = card.get_node_or_null(\"Buttons\")\n\tif b == null:\n\t\tcontinue\n\tfor btn in b.get_children():\n\t\tif btn is Button and btn.visible:\n\t\t\tn += 1\n\t\t\tvar r = btn.get_global_rect()\n\t\t\tif r.position.y >= view.position.y - 0.5 and r.end.y <= view.end.y + 0.5:\n\t\t\t\tshown += 1\nvar vp = tree.root.get_visible_rect().size\nvar on_screen = dl.position.y >= 0 and dl.position.y + dl.size.y <= vp.y\nreturn \"%d/%d on_screen=%s\" % [shown, n, str(on_screen)]", "equals": "3/3 on_screen=true"},
