      "seconds": 1.5
    },
    {
      "act": "execute_script",
      "script": "var labels = tree.current_scene.game_log_panel.last_combat_card_dice_labels()\nfor l in labels:\n\tif l.begins_with(\"Save\") or l.begins_with(\"Inv Save\"):\n\t\treturn true\nreturn false",
      "multiline": true,
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "var kinds = []\nfor l in tree.current_scene.game_log_panel.last_combat_card_dice_labels():\n\tkinds.append(l.split(\" \")[0])\nreturn \"Hit\" in kinds and \"Wound\" in kinds and (\"Save\" in kinds or \"Inv\" in kinds)",
      "multiline": true,
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "for line in tree.current_scene.game_log_panel.last_combat_card_detail_lines():\n\tif \"Saves vs\" in line and (\"Armour Save\" in line or \"Invulnerable Save\" in line):\n\t\treturn true\nreturn false",
      "multiline": true,
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "var last = \"\"\nfor e in GameEventLog.get_all_entries():\n\tif e.get(\"type\", \"\") == \"combat_result\":\n\t\tlast = str(e.get(\"text\", \"\"))\nreturn \"saves passed\" in last",
      "multiline": true,
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "var n = 0\nfor e in GameEventLog.get_all_entries():\n\tif e.get(\"type\", \"\") == \"combat_detail\" and \"Saves vs\" in str(e.get(\"text\", \"\")):\n\t\tn += 1\nreturn n",
      "multiline": true,
      "expect_min": 1
    },
    {
      "act": "execute_script",
      "script": "for e in GameEventLog.get_all_entries():\n\tif e.get(\"type\", \"\") == \"combat_detail\" and \"AP --\" in str(e.get(\"text\", \"\")):\n\t\treturn false\nreturn true",
      "multiline": true,
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main.game_log_panel.expand_last_combat_card()",
      "equals": true
    },
    {
      "act": "wait_frames",
      "frames": 5
    },
    {
