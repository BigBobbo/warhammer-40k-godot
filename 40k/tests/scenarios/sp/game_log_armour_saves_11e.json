    },
    {
      "act": "execute_script",
      "script": "(\"U_BOYZ_E\" in RulesEngine.get_eligible_targets(\"U_CUSTODIAN_GUARD_A\", PhaseManager.get_current_phase_instance().game_state_snapshot))",
      "equals": true
    },
    {
