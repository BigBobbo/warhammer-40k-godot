      "path": "meta.phase",
      "equals": 8
    },
    {
      "act": "expect_state",
      "path": "meta.active_player",
      "equals": 1
    },
    {
      "act": "execute_script",
      "script": "GameState.state[\"units\"][\"U_BOYZ_E\"][\"models\"][0].merge({\"position\": {\"x\": 900.0, \"y\": 500.0}}, true)"
    },
    {
