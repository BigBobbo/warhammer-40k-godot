      "script": "var m = RulesEngine.ork11e_ab_mods(GameState.get_unit(\"U_ELIMINATOR_SQUAD_A\"), GameState.get_unit(\"U_DEFF_DREAD_A\"), {\"name\": \"x\", \"type\": \"Ranged\"}, false, GameState.state)\nreturn str(m.get(\"hit_reroll\", \"\"))",
