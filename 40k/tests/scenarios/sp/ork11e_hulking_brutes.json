{
  "id": "ork11e_hulking_brutes",
  "covers": [
    "stratagem.window.enemy_targets_unit_shooting",
    "stratagem.ork11e.hulking_brutes",
    "stratagem.variant.upgrade_cp",
    "dialogs.StratagemDialog.legacy_fold_in",
    "shooting.reactive.no_reopen_when_nothing_left"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 8,
  "disable_ai": true,
  "description": "Codex: Orks (11e) HULKING BRUTES (Bully Boyz, 1 CP; +1 CP upgrade: every ranged attack, not only S > T) through the real enemy_targets_unit_shooting fold-in of the defender's reactive StratagemDialog. Fixture ork11e_orks_reactive: P1 Custodes ACTIVE, P2 Orks. Setup-only privileges: P2's detachment is flipped to Bully Boyz and its stratagems reloaded; the Nobz (engaged with Custodian Guard B in the fixture, so not a legal target) are moved 4\" clear and the engagement flags recomputed. The Custodes player selects Custodian Guard C by clicking its token and declares its guardian spears at the Nobz (phase actions the shooting panel sends). The Ork player's dialog shows HULKING BRUTES with an enabled base button and an enabled '+1 CP: all ranged attacks' upgrade button; a real click on the upgrade spends 2 CP and marks the Nobz. No other reactive offer remains for the Nobz, so the dialog does not re-open (the re-open path is covered by ork11e_grot_shields) and the attack resumes; the Custodian Guard Sentinel Storm prompt that follows is declined. The Custodes resolve with the dock's Fast Roll / Complete Shooting buttons and the wound roll against the Nobz carries the -1 to wound.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_phase", "equals": 8 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },
    { "act": "execute_script", "script": "SettingsService.set(\"auto_allocate_wounds\", true)" },
    { "act": "execute_script", "script": "GameState.state[\"factions\"][\"2\"].merge({\"detachment\": \"Bully Boyz\"}, true)" },
    { "act": "execute_script", "script": "StratagemManager.load_faction_stratagems_for_player(2)" },
    { "act": "execute_script", "script": "StratagemManager.find_faction_stratagem_by_name(2, \"HULKING BRUTES\")", "equals": "faction_ork_bully_boyz_hulking_brutes" },
    { "act": "execute_script", "multiline": true, "comment": "setup privilege: the Nobz step 4\" clear of Custodian Guard B so they are a legal target",
      "script": "var pts = [Vector2(41.0, 35.0), Vector2(42.6, 35.0), Vector2(41.0, 36.6), Vector2(42.6, 36.6), Vector2(41.8, 38.2)]\nvar ms = GameState.get_unit(\"U_NOBZ_A\").models\nfor i in range(ms.size()):\n\tms[i][\"position\"] = {\"x\": pts[i].x * 40.0, \"y\": pts[i].y * 40.0}\nvar ph = PhaseManager.get_current_phase_instance()\nph.game_state_snapshot = GameState.create_snapshot()\nph._compute_engagement_flags()\ntree.root.get_node(\"Main\")._recreate_unit_visuals()\nreturn RulesEngine.is_unit_engaged(\"U_NOBZ_A\", GameState.state)",
      "equals": false },
    { "act": "execute_script", "script": "RulesEngine.get_eligible_targets(\"U_CUSTODIAN_GUARD_C\", GameState.state).has(\"U_NOBZ_A\")", "equals": true },

    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_D", "comment": "the panel auto-highlights a shooter on phase entry; picking another unit first makes the Custodian Guard C token click a real selection" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_C" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_shooter_id", "equals": "U_CUSTODIAN_GUARD_C" },
    { "act": "execute_script", "script": "main.get_node(\"ShootingController\").active_shooter_id", "equals": "U_CUSTODIAN_GUARD_C" },
    { "act": "dispatch_action", "action": { "type": "ASSIGN_TARGET", "actor_unit_id": "U_CUSTODIAN_GUARD_C",
      "payload": { "weapon_id": "guardian_spear___ranged_ranged", "target_unit_id": "U_NOBZ_A", "model_ids": ["m1", "m2", "m3", "m4", "m5"] } } },
    { "act": "expect_action_result", "path": "success", "equals": true },
    { "act": "dispatch_action", "action": { "type": "CONFIRM_TARGETS" } },
    { "act": "expect_action_result", "path": "success", "equals": true },

    { "act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 3.0 },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/Header\").text.contains(\"being targeted by \")", "equals": true },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().awaiting_reactive_stratagem", "equals": true },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_bully_boyz_hulking_brutes/Buttons/Use_faction_ork_bully_boyz_hulking_brutes_U_NOBZ_A", "property": "disabled", "equals": false },
    { "act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_bully_boyz_hulking_brutes/Buttons/Use_faction_ork_bully_boyz_hulking_brutes_U_NOBZ_A_all_ranged", "property": "disabled", "equals": false },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_bully_boyz_hulking_brutes/Buttons/Use_faction_ork_bully_boyz_hulking_brutes_U_NOBZ_A_all_ranged\").text.contains(\"(2 CP)\")", "equals": true },
    { "act": "execute_script", "script": "main._reactive_stratagem_pending", "equals": true },
    { "act": "execute_script", "script": "main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll\").ensure_control_visible(main.get_tree().root.get_node(\"StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_bully_boyz_hulking_brutes/Buttons/Use_faction_ork_bully_boyz_hulking_brutes_U_NOBZ_A_all_ranged\"))", "comment": "scroll the card's button row into view for the screenshot" },
    { "act": "wait_frames", "frames": 3 },
    { "act": "screenshot", "label": "01_hulking_brutes_offer_with_upgrade" },

    { "act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_bully_boyz_hulking_brutes/Buttons/Use_faction_ork_bully_boyz_hulking_brutes_U_NOBZ_A_all_ranged" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -2 },
    { "act": "expect_cp", "player": 1, "delta_from_start": 0 },
    { "act": "expect_state", "path": "units.U_NOBZ_A.flags.ork11e_hulking_brutes", "equals": "all" },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"HULKING BRUTES\")", "expect_min": 1 },

    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().awaiting_reactive_stratagem", "equals": false, "comment": "no other reactive offer remains for the Nobz, so the dialog does not re-open and the attack resumes" },
    { "act": "execute_script", "multiline": true, "script": "var d = tree.root.get_node_or_null(\"StratagemDialog\")\nreturn d == null or not d.visible", "equals": true },
    { "act": "screenshot", "label": "02_hulking_brutes_used_attack_resumes" },

    { "act": "click_node", "button_text": "Fast Roll ⏩" },
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ConfirmButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/RerollPanel/KeepRollsButton" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/PickPanel/PickVBox/PickButtons/AutoPickButton" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/PickPanel/PickVBox/PickButtons/ConfirmRemovalButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton" },
    { "act": "wait_seconds", "seconds": 1.2 },
    { "act": "execute_script", "multiline": true,
      "script": "var log = PhaseManager.get_current_phase_instance().dice_log\nfor i in range(log.size() - 1, -1, -1):\n\tif str(log[i].get(\"context\", \"\")) == \"to_wound\":\n\t\treturn int(log[i].get(\"wound_modifier_net\", 0))\nreturn 99",
      "equals": -1 },
    { "act": "screenshot", "label": "03_wound_roll_minus_one_vs_nobz" },
    { "act": "click_node", "button_text": "Complete Shooting" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "click_node", "button_text": "Decline", "comment": "Custodian Guard's Sentinel Storm shoot-again prompt — not under test" },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_state", "path": "units.U_CUSTODIAN_GUARD_C.flags.has_shot", "equals": true },
    { "act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false },
    { "act": "expect_cp", "player": 2, "delta_from_start": -2 },
    { "act": "screenshot", "label": "04_shooting_complete" }
  ]
}
