{
  "id": "ai_suggestion_stratagem_window",
  "covers": [
    "ai.suggestion.reactive_window",
    "scripts.AIDecisionMaker.window_stratagem_record"
  ],
  "fixture": "cus11e_c7_fight",
  "disable_ai": true,
  "edition": 11,
  "rng_seed": 7,
  "transition_to_phase": 10,
  "description": "K while a fight_phase_start stratagem window is waiting: the suggestion answers the window (not the phase's next action), with every stratagem/target weighed against 'Decline (save the CP)' and each one's value vs the bar to use it. The free Ka'tah pick is applied first in setup (it is recorded as a take-it-or-skip-it window rule).",
  "steps": [
    {
      "act": "wait_seconds",
      "seconds": 0.8
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.configure({1: \"HUMAN\", 2: \"HUMAN\"})"
    },
    {
      "act": "execute_script",
      "script": "main.refresh_ai_suggestion_button()"
    },
    {
      "act": "execute_script",
      "script": "str(PhaseManager.get_current_phase_instance().execute_action(AIPlayer.request_suggestion()))",
      "comment": "Setup: apply the AI's free Ka'tah pick so the window re-offers its paid stratagems"
    },
    {
      "act": "wait_frames",
      "frames": 4
    },
    {
      "act": "wait_frames",
      "frames": 6
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.clear_action_log()"
    },
    {
      "act": "simulate_key",
      "keycode": "K"
    },
    {
      "act": "wait_frames",
      "frames": 6
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel != null and main._ai_suggestion_panel.is_visible_in_tree()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.breakdown_text.contains(\"STRATAGEM WINDOW \u00b7 fight phase start\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "main._ai_suggestion_panel.full_text.contains(\"Bar to use it\")",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()",
      "equals": true
    },
    {
      "act": "execute_script",
      "script": "AIPlayer.get_action_log().size()",
      "equals": 0
    },
    {
      "act": "screenshot",
      "label": "01_window_card"
    }
  ]
}