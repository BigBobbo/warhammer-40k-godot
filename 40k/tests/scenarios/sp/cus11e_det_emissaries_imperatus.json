    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "execute_script", "multiline": true, "comment": "setup privileges (see description)", "script": "GameState.state[\"factions\"][\"1\"][\"detachment\"] = \"Emissaries Imperatus\"\nGameState.state.players[\"1\"][\"cp\"] = 0\nGameState.state.players[\"2\"][\"cp\"] = 0\nSettingsService.set(\"auto_allocate_wounds\", true)\nPhaseManager.transition_to_phase(10)\nreturn true", "equals": true },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "start-of-Fight window — not under test" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_BLADE_CHAMPION_A\").flags.get(\"charged_this_turn\", false)", "equals": false },
    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "timeout_s": 5.0 },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/FightScrollContainer/FightPanel/PileInStepPanel/EndPileInButton", "emit_pressed": true },
