      "act": "wait_seconds",
      "seconds": 0.5
    },
    {
      "act": "execute_script",
      "script": "main.get_node(\"FightController\").fight_resolution_dock.debug_click_through(12)",
      "comment": "resolve the attacks through the resolution dock"
    },
    {
      "act": "wait_seconds",
      "seconds": 1.2
    },
    {
      "act": "click_if_visible",
      "node": "/root/StratagemDialog/Content/DeclineButton",
      "comment": "post-fight windows (not under test)"
    },
    {
      "act": "wait_seconds",
      "seconds": 0.6
    },
    {
      "act": "wait_for_script",
      "script": "return int(GameState.get_unit(\"U_CAPTAIN_TITUS_A\").models[0].current_wounds) > 3",
      "equals": true,
      "timeout_s": 6.0,
      "comment": "when the unit has fought: Titus heals D3 (2D3 if he destroyed an enemy model)"
    },
    {
      "act": "execute_script",
      "script": "ScenarioRunner.event_log_count_containing(\"Righteous Fury: Captain Titus has fought\")",
      "expect_min": 1
    },
    {
      "act": "expect_cp",
      "player": 1,
      "delta_from_start": 0
    },
    {
      "act": "wait_seconds",
      "seconds": 0.4
    },
    {
      "act": "screenshot",
      "label": "03_titus_healed_log"
    },
    {
      "act": "execute_script",
      "multiline": true,
      "comment": "clean debug log: no ERROR line was written during the scenario",
      "script": "DebugLogger._flush_buffer()\nvar f = FileAccess.open(DebugLogger.get_real_log_file_path(), FileAccess.READ)\nvar n := 0\nwhile f != null and not f.eof_reached():\n\tvar l := f.get_line()\n\tif l.contains(\"[ERROR\"):\n\t\tn += 1\n\t\tprint(\"[sm11e-m4c] debug-log ERROR: \", l)\nreturn n",
      "equals": 0
    }
  ]
