{
  "id": "hi_examine_board_no_autodecline_11e",
  "covers": [
    "dialogs.HeroicInterventionDialog.no_auto_decline",
    "dialogs.HeroicInterventionDialog.examine_board_toggle",
    "scripts.ReactiveDecisionUI.board_examine",
    "scripts.Main.reactive_overlay_camera_passthrough"
  ],
  "fixture": "audit_370_bgnt_shoot",
  "edition": 11,
  "transition_to_phase": 9,
  "disable_ai": true,
  "description": "PLAYER REPORT (2026-08-04): the end-of-charge-phase Heroic Intervention window covered the board, and trying to zoom out made it 'go away' — the 5s auto-decline fired while the player reached for the camera, so the stratagem could no longer be selected. This scenario drives the fixed player path end-to-end: (1) the HI window opens and is STILL open 8 real seconds later — longer than the old 5s auto-decline — so a camera fiddle can never cost the stratagem; (2) the 'Examine Board' toggle hides the dialog, un-dims the blocking overlay and raises the 'Back to the decision' bar; (3) the mouse wheel actually zooms the board while the decision is held open (it used to die on the overlay); (4) the return bar restores the dialog exactly as it was; (5) the stratagem is still fully selectable afterwards — 'Into the Fray' spends the CP and applies.",
  "steps": [
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 },
    { "act": "expect_state", "path": "meta.active_player", "equals": 1 },

    { "act": "execute_script", "script": "CharacterAttachmentManager.detach_character(\"U_WARBOSS_C\")",
      "comment": "he leads Boyz Beta in this fixture; this scenario is about the window's camera/decline behaviour with a lone CHARACTER, and 19.01 would otherwise pull the whole 22-model squad along with the teleport below (see iss15_heroic_intervention_fray_11e)" },
    { "act": "execute_script", "script": "GameState.get_unit(\"U_WARBOSS_C\")[\"models\"][0].merge({\"position\": {\"x\": 933.24, \"y\": 1343.63}}, true)" },
    { "act": "execute_script", "script": "main._sync_all_token_positions()" },
    { "act": "wait_seconds", "seconds": 1.0 },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton", "emit_pressed": true },
    { "act": "execute_script", "multiline": true,
      "script": "var d = tree.current_scene._phase_end_confirm\nif d != null and d.visible:\n\td.get_ok_button().pressed.emit()\nreturn true",
      "equals": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_node_visible", "node": "/root/HeroicInterventionDialog", "timeout_s": 3.0 },
    { "act": "screenshot", "label": "01_hi_dialog_examine_toggle_present" },

    { "act": "expect_node_visible",
      "node": "/root/HeroicInterventionDialog/Content/ExamineBoard/ExamineBoardToggle" },
    { "act": "expect_node_property",
      "node": "/root/HeroicInterventionDialog/Content/WindowHint",
      "property": "text",
      "equals": "Take your time — this window waits for you and nothing is declined automatically." },

    { "act": "wait_seconds", "seconds": 8.0 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.root.get_node_or_null(\"HeroicInterventionDialog\") != null",
      "equals": true },
    { "act": "expect_node_visible", "node": "/root/HeroicInterventionDialog" },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 },
    { "act": "screenshot", "label": "02_still_open_after_8s_no_autodecline" },

    { "act": "execute_script", "multiline": true,
      "script": "tree.root.set_meta(\"zoom_dialog_up\", tree.current_scene.view_zoom)\nreturn true", "equals": true },
    { "act": "execute_script", "multiline": true,
      "script": "var p = Vector2(900, 300)\nInput.warp_mouse(p)\nvar mm = InputEventMouseMotion.new()\nmm.position = p\nmm.global_position = p\nInput.parse_input_event(mm)\nfor i in range(2):\n\tvar press = InputEventMouseButton.new()\n\tpress.button_index = MOUSE_BUTTON_WHEEL_DOWN\n\tpress.pressed = true\n\tpress.position = p\n\tpress.global_position = p\n\tInput.parse_input_event(press)\n\tvar rel = InputEventMouseButton.new()\n\trel.button_index = MOUSE_BUTTON_WHEEL_DOWN\n\trel.pressed = false\n\trel.position = p\n\trel.global_position = p\n\tInput.parse_input_event(rel)\nreturn true",
      "equals": true },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.view_zoom < float(tree.root.get_meta(\"zoom_dialog_up\", 99.0))", "equals": true },
    { "act": "expect_node_visible", "node": "/root/HeroicInterventionDialog" },
    { "act": "expect_node_visible",
      "node": "/root/HeroicInterventionDialog/Content/UnitScroll/UnitList/Row_U_WARBOSS_C/Leap_U_WARBOSS_C" },
    { "act": "screenshot", "label": "02b_wheel_zoom_with_dialog_up_window_survives" },

    { "act": "click_node",
      "node": "/root/HeroicInterventionDialog/Content/ExamineBoard/ExamineBoardToggle" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_property",
      "node": "/root/HeroicInterventionDialog", "property": "visible", "equals": false },
    { "act": "expect_node_visible", "node": "/root/Main/ReactiveStratagemOverlay/BoardExamineBar" },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene._reactive_stratagem_overlay.color.a", "equals": 0.0 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.is_board_examining()", "equals": true },

    { "act": "execute_script", "multiline": true,
      "script": "tree.root.set_meta(\"zoom_before\", tree.current_scene.view_zoom)\nreturn true", "equals": true },
    { "act": "hover_board_at", "x": 1200, "y": 1200 },
    { "act": "simulate_wheel", "direction": "down", "count": 4 },
    { "act": "wait_seconds", "seconds": 0.4 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.view_zoom < float(tree.root.get_meta(\"zoom_before\", 99.0))", "equals": true },
    { "act": "screenshot", "label": "03_examining_board_zoomed_out" },

    { "act": "click_node",
      "node": "/root/Main/ReactiveStratagemOverlay/BoardExamineBar/Content/BoardExamineReturnButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_node_visible", "node": "/root/HeroicInterventionDialog" },
    { "act": "expect_node_property",
      "node": "/root/Main/ReactiveStratagemOverlay/BoardExamineBar", "property": "visible", "equals": false },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.is_board_examining()", "equals": false },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene._reactive_stratagem_overlay.color.a > 0.4", "equals": true },
    { "act": "screenshot", "label": "04_back_to_the_decision" },

    { "act": "click_node",
      "node": "/root/HeroicInterventionDialog/Content/ExamineBoard/ExamineBoardToggle" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.is_board_examining()", "equals": true },
    { "act": "simulate_key", "keycode": "Escape" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "multiline": true,
      "script": "return tree.current_scene.is_board_examining()", "equals": false },
    { "act": "expect_node_visible", "node": "/root/HeroicInterventionDialog" },
    { "act": "expect_node_property",
      "node": "/root/HeroicInterventionDialog/Content/ExamineBoard/ExamineBoardToggle",
      "property": "button_pressed", "equals": false },
    { "act": "screenshot", "label": "04b_escape_returns_from_examine" },

    { "act": "click_node",
      "node": "/root/HeroicInterventionDialog/Content/UnitScroll/UnitList/Row_U_WARBOSS_C/Fray_U_WARBOSS_C",
      "emit_pressed": true },
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "expect_cp", "player": 2, "delta_from_start": -1 },
    { "act": "execute_script",
      "script": "PhaseManager.get_current_phase_instance().heroic_intervention_pending_charge[\"mode\"]",
      "equals": "into_the_fray" },
    { "act": "expect_node_property",
      "node": "/root/Main/ReactiveStratagemOverlay", "property": "visible", "equals": false },
    { "act": "screenshot", "label": "05_stratagem_still_selectable_after_zoom" }
  ]
}
