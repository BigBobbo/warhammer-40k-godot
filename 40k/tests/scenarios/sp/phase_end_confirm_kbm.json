{
  "id": "phase_end_confirm_kbm",
  "covers": [
    "ui.phase_end_confirm.kbm",
    "ui.phase_end_confirm.centered",
    "controller.end_phase.discoverability"
  ],
  "fixture": "audit_baseline_postdeploy",
  "transition_to_phase": 7,
  "disable_ai": true,
  "rng_seed": 42,
  "description": "Keyboard-and-mouse players get the same 'End X Phase?' confirmation the pad has always had. Previously a click on the top-right phase button (or Enter while it held focus) ended the phase outright — no way back from a misclick. Drives a REAL click on the PhaseActionButton in the Movement phase and asserts: the confirm opens instead of the phase ending, it is centred and worded for the phase, 'Go Back' leaves the player in Movement, and confirming advances to Shooting exactly once (the replayed press must not re-open the dialog it just answered). Then proves the gate does NOT stack on the Shooting phase, whose own summary dialog is already the confirmation.",
  "steps": [
    { "act": "wait_seconds", "seconds": 1.5 },
    { "act": "expect_state", "path": "meta.phase", "equals": 7 },
    { "act": "execute_script", "multiline": true,
      "script": "InputDeviceManager.input_mode = InputDeviceManager.InputMode.KBM\nreturn InputDeviceManager.is_pad_active()", "equals": false },
    { "act": "execute_script", "script": "main.phase_action_button.text", "equals": "[Enter] End Movement Phase" },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton" },
    { "act": "wait_seconds", "seconds": 0.6 },

    { "act": "expect_state", "path": "meta.phase", "equals": 7 },
    { "act": "execute_script", "script": "main._phase_end_confirm != null and main._phase_end_confirm.visible", "equals": true },
    { "act": "screenshot", "label": "01_kbm_click_opens_confirm" },

    { "act": "execute_script", "script": "main._phase_end_confirm.get_node(\"Content/Headline\").text", "equals": "End Movement Phase?" },
    { "act": "execute_script", "script": "main._phase_end_confirm.get_node(\"Content/Hint\").text.contains(\"Shooting phase\")", "equals": true },
    { "act": "execute_script", "script": "main._phase_end_confirm.ok_button_text", "equals": "End Movement Phase" },
    { "act": "execute_script", "script": "main._phase_end_confirm.cancel_button_text", "equals": "Go Back" },
    { "act": "execute_script", "multiline": true,
      "script": "var d = tree.current_scene._phase_end_confirm\nvar vp = tree.root.get_visible_rect().size\nreturn abs((d.position.y + d.size.y / 2.0) - vp.y / 2.0)",
      "expect_max": 40 },
    { "act": "execute_script", "multiline": true,
      "script": "var d = tree.current_scene._phase_end_confirm\nvar vp = tree.root.get_visible_rect().size\nreturn vp.y - (d.position.y + d.size.y)",
      "expect_min": 250 },

    { "act": "execute_script", "script": "main._phase_end_confirm.get_cancel_button().pressed.emit()" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "script": "main._phase_end_confirm.visible", "equals": false },
    { "act": "expect_state", "path": "meta.phase", "equals": 7 },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "execute_script", "script": "main._phase_end_confirm.visible", "equals": true },
    { "act": "execute_script", "script": "main._phase_end_confirm.get_ok_button().pressed.emit()" },
    { "act": "wait_seconds", "seconds": 1.2 },
    { "act": "execute_script", "script": "main._phase_end_confirm.visible", "equals": false },
    { "act": "expect_state", "path": "meta.phase", "equals": 8 },
    { "act": "screenshot", "label": "02_confirmed_now_in_shooting" },

    { "act": "click_node", "node": "/root/Main/PhaseActionButton" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "script": "main._phase_end_confirm.visible", "equals": false },
    { "act": "execute_script", "script": "tree.root.get_node_or_null(\"ShootingPhaseSummaryDialog\") != null", "equals": true },
    { "act": "screenshot", "label": "03_shooting_summary_not_double_prompted" },
    { "act": "execute_script", "script": "tree.root.get_node(\"ShootingPhaseSummaryDialog/Content/Actions/ConfirmEndShooting\").pressed.emit()" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "expect_state", "path": "meta.phase", "equals": 9 }
  ]
}
