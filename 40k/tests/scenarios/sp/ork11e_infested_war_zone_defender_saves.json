{
  "id": "ork11e_infested_war_zone_defender_saves",
  "covers": [
    "stratagem.window.enemy_unit_has_attacked",
    "stratagem.window.unit_destroyed",
    "stratagem.ork11e.infested_war_zone",
    "phases.BasePhase.event_windows",
    "ui.AllocationGroupOverlay.defender_control"
  ],
  "fixture": "ork11e_orks_reactive",
  "edition": 11,
  "rng_seed": 42,
  "transition_to_phase": 8,
  "disable_ai": true,
  "description": "LIVE-1 / F2 regression (shooting): the enemy_unit_has_attacked window (INFESTED WAR ZONE, Runt Swarm) must open when the last Gretchin dies through the HUMAN defender's AllocationGroupOverlay (auto-allocate OFF — the overlay writes the casualty into GameState before Done sends APPLY_SAVES). Fixture ork11e_orks_reactive (P1 Custodes active, P2 Orks), both seats human. Setup privileges: P2's detachment is switched to Runt Swarm; Gretchin Alpha (U_GRETCHIN_C) is placed ~11\" from Custodian Guard F in the open and 9 of its 10 models are removed; both players have 4 CP; 'Computer allocates wounds' is OFF. The Custodes player shoots through the real shooting panel (click the unit, Quick-assign the Gretchin, Confirm Targets, Fast Roll, Complete Shooting when offered); the Ork player rolls the saves in the allocation overlay. Once the Custodian Guard's attacks are over the window opens for Player 2 with INFESTED WAR ZONE on the destroyed Gretchin; Use adds a fresh Gretchin unit to Strategic Reserves for 2 CP.",
  "steps": [
    {"act": "wait_seconds", "seconds": 0.8},
    {"act": "expect_phase", "equals": 8},
    {"act": "expect_state", "path": "meta.active_player", "equals": 1},
    {"act": "execute_script", "multiline": true, "comment": "setup privileges (see description)", "script": "GameState.state[\"factions\"][\"2\"][\"detachment\"] = \"Runt Swarm\"\nStratagemManager.load_faction_stratagems_for_player(2)\nvar spots = {\"U_GRETCHIN_C\": Vector2(40, 35), \"U_CUSTODIAN_GUARD_F\": Vector2(41, 24)}\nfor uid in spots:\n\tvar u = GameState.state[\"units\"][uid]\n\tvar c = Vector2.ZERO\n\tfor m in u[\"models\"]:\n\t\tc += Vector2(float(m[\"position\"][\"x\"]), float(m[\"position\"][\"y\"]))\n\tc /= u[\"models\"].size()\n\tvar d = spots[uid] * 40.0 - c\n\tfor m in u[\"models\"]:\n\t\tm[\"position\"] = {\"x\": float(m[\"position\"][\"x\"]) + d.x, \"y\": float(m[\"position\"][\"y\"]) + d.y}\nvar grots = GameState.state[\"units\"][\"U_GRETCHIN_C\"]\nfor i in range(9):\n\tgrots[\"models\"][i][\"alive\"] = false\n\tgrots[\"models\"][i][\"current_wounds\"] = 0\nSettingsService.auto_allocate_wounds = false\nGameState.state[\"players\"][\"1\"][\"cp\"] = 4\nGameState.state[\"players\"][\"2\"][\"cp\"] = 4\nSceneRefs.main()._recreate_unit_visuals()\nfor c in tree.root.get_children():\n\tif c is Window and c != tree.root:\n\t\tc.hide()\n\t\tc.queue_free()\nreturn StratagemManager.find_faction_stratagem_by_name(2, \"INFESTED WAR ZONE\")", "equals": "faction_ork_runt_swarm_infested_war_zone"},
    {"act": "execute_script", "script": "SettingsService.get_auto_allocate_wounds()", "equals": false},
    {"act": "execute_script", "script": "GameState.state[\"units\"].has(\"U_GRETCHIN_C_R2\")", "equals": false},
    {"act": "wait_frames", "frames": 4},
    {"act": "click_unit", "unit_id": "U_CUSTODIAN_GUARD_F"},
    {"act": "wait_seconds", "seconds": 0.8},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().active_shooter_id", "equals": "U_CUSTODIAN_GUARD_F"},
    {"act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/ShootingScrollContainer/ShootingPanel/DeclarationBox/QuickAssignContainer/QuickAssign_U_GRETCHIN_C", "timeout_s": 3.0},
    {"act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/ShootingScrollContainer/ShootingPanel/DeclarationBox/QuickAssignContainer/QuickAssign_U_GRETCHIN_C"},
    {"act": "wait_seconds", "seconds": 0.5},
    {"act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/ShootingScrollContainer/ShootingPanel/DeclarationBox/TargetButtonRow/ConfirmTargetsButton"},
    {"act": "wait_seconds", "seconds": 1.0},
    {"act": "click_if_visible", "node": "/root/StratagemDialog/Content/DeclineButton", "comment": "enemy_targets_unit_shooting reactive prompt, if any"},
    {"act": "wait_seconds", "seconds": 0.6},
    {"act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/ShootingScrollContainer/ShootingPanel/ResolutionDock/DockFastButton"},
    {"act": "wait_seconds", "seconds": 1.5},
    {"act": "expect_node_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel", "timeout_s": 4.0},
    {"act": "screenshot", "label": "01_defender_rolls_saves_for_the_last_grot"},
    {"act": "click_node", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ConfirmButton"},
    {"act": "wait_seconds", "seconds": 0.6},
    {"act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/RerollPanel/KeepRollsButton"},
    {"act": "wait_seconds", "seconds": 0.5},
    {"act": "click_if_visible", "node": "/root/Main/AllocationGroupOverlay/PickPanel/PickVBox/PickButtons/AutoPickButton"},
    {"act": "wait_seconds", "seconds": 0.5},
    {"act": "expect_node_visible", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton", "timeout_s": 3.0},
    {"act": "expect_state", "path": "units.U_GRETCHIN_C.models.9.alive", "equals": false, "comment": "the overlay has already written the casualty into GameState"},
    {"act": "click_node", "node": "/root/Main/AllocationGroupOverlay/Center/Panel/Row/DecisionCol/ResultPanel/DoneButton"},
    {"act": "wait_seconds", "seconds": 1.2},
    {"act": "click_if_visible", "node": "/root/Main/HUD_Right/VBoxContainer/ShootingScrollContainer/ShootingPanel/ResolutionDock/DockPrimaryButton", "comment": "Complete Shooting, if the dock still offers it"},
    {"act": "wait_seconds", "seconds": 1.0},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": true, "comment": "WP-C7: no Sentinel Storm shoot-again prompt any more (a 10e rule no codex datasheet has) — the Custodian Guard's attacks are over once its shooting completes, so the window is already pending"},
    {"act": "expect_node_visible", "node": "/root/StratagemDialog", "timeout_s": 4.0},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window()[\"window_id\"]", "equals": "enemy_unit_has_attacked"},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window_decider()", "equals": 2},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window()[\"ctx\"][\"destroyed_unit_ids\"]", "equals": ["U_GRETCHIN_C"]},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().get_pending_stratagem_window()[\"ctx\"][\"attacker_unit_id\"]", "equals": "U_CUSTODIAN_GUARD_F"},
    {"act": "expect_node_property", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_runt_swarm_infested_war_zone/Buttons/Use_faction_ork_runt_swarm_infested_war_zone_U_GRETCHIN_C", "property": "disabled", "equals": false},
    {"act": "dispatch_action", "action": {"type": "END_SHOOTING", "player": 1}},
    {"act": "expect_action_result", "path": "success", "equals": false, "comment": "the Custodes' phase waits for the Ork player's decision"},
    {"act": "screenshot", "label": "02_infested_war_zone_window_after_overlay_kill"},
    {"act": "click_node", "node": "/root/StratagemDialog/Content/StratScroll/StratList/Card_faction_ork_runt_swarm_infested_war_zone/Buttons/Use_faction_ork_runt_swarm_infested_war_zone_U_GRETCHIN_C"},
    {"act": "wait_seconds", "seconds": 0.8},
    {"act": "expect_cp", "player": 2, "equals": 2},
    {"act": "expect_state", "path": "units.U_GRETCHIN_C_R2.owner", "equals": 2},
    {"act": "expect_state", "path": "units.U_GRETCHIN_C_R2.reserve_type", "equals": "strategic_reserves"},
    {"act": "execute_script", "script": "PhaseManager.get_current_phase_instance().has_pending_stratagem_window()", "equals": false},
    {"act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"INFESTED WAR ZONE\")", "expect_min": 1},
    {"act": "wait_seconds", "seconds": 0.5},
    {"act": "screenshot", "label": "03_new_gretchin_unit_in_strategic_reserves"}
  ]
}
