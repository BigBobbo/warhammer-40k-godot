{
  "id": "cus11e_g1_castellans_mark_redeploy",
  "covers": [
    "codex.custodes.enhancements.castellans_mark",
    "phases.RedeploymentPhase",
    "scripts.RedeploymentController",
    "scripts.DeploymentController.is_redeploy_mode"
  ],
  "description": "WP-G1 Codex: Adeptus Custodes (11e) CASTELLAN'S MARK (Guardians of the Throne enhancement): 'When both players have deployed their armies, you can redeploy up to three friendly ADEPTUS CUSTODES units. When doing so, you can set those units up in strategic reserves, regardless of how many units are already in strategic reserves.' Fixture cus11e_c3_custodes_active (P1 Custodes, Guardians of the Throne; P2 Orks). Setup privilege: the Shield-Captain is given the enhancement in the army data (it has no list-build effect), P1 is the Attacker. The Redeployment step opens a right-panel list of P1's ADEPTUS CUSTODES units only (no Ork row) with '3 left'. Real clicks: [Redeploy] the Custodian Guard -> the unit is picked up (DEPLOYING, tokens hidden) and the DeploymentController ghost places it: a click outside the deployment zone places nothing, three clicks inside the zone place the three models; [Confirm Redeploy] dispatches REDEPLOY_UNIT -> models at the clicked spots, 2 uses left. [Reserves] the Witchseekers C -> Strategic Reserves (status IN_RESERVES, reserve_type strategic_reserves), 1 left. [Keep] the Witchseekers D -> stays put. [Done Redeploying] ends the step (P2 has nothing to redeploy).",
  "fixture": "cus11e_c3_custodes_active",
  "edition": 11,
  "rng_seed": 42,
  "disable_ai": true,
  "steps": [
    { "act": "wait_seconds", "seconds": 0.8 },
    { "act": "execute_script", "multiline": true, "comment": "setup privileges (see description)", "script": "GameState.state.units[\"U_SHIELD_CAPTAIN_A\"].meta[\"enhancements\"] = [\"Castellan's Mark\"]\nFactionAbilityManager._razgit_redeploys_used = {\"1\": 0, \"2\": 0}\nGameState.state.meta[\"attacker\"] = 1\nGameState.state.meta[\"defender\"] = 2\nreturn FactionAbilityManager.get_redeploy_enhancement_name(1)", "equals": "Castellan's Mark" },
    { "act": "execute_script", "script": "PhaseManager.transition_to_phase(2)" },
    { "act": "wait_seconds", "seconds": 1.2 },
    { "act": "expect_phase", "equals": 2 },
    { "act": "expect_node_visible", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/UnitRows/Row_U_CUSTODIAN_GUARD_B/Buttons/Redeploy_U_CUSTODIAN_GUARD_B", "timeout_s": 5.0 },
    { "act": "execute_script", "multiline": true, "comment": "header names the enhancement, filter and uses; only Custodes rows", "script": "var p = tree.root.get_node(\"Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel\")\nvar head: String = p.get_node(\"HeaderLabel\").text\nvar rows = p.get_node(\"UnitRows\")\nreturn [head.contains(\"Castellan's Mark\"), head.contains(\"ADEPTUS CUSTODES\"), head.contains(\"(3 left)\"), rows.get_node_or_null(\"Row_U_BOYZ_B\") == null, rows.get_child_count() == 9]", "equals": [true, true, true, true, true] },
    { "act": "screenshot", "label": "01_castellans_mark_redeploy_panel" },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/UnitRows/Row_U_CUSTODIAN_GUARD_B/Buttons/Redeploy_U_CUSTODIAN_GUARD_B" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "execute_script", "script": "main.redeployment_controller.get_placing_unit_id()", "equals": "U_CUSTODIAN_GUARD_B" },
    { "act": "expect_state", "path": "units.U_CUSTODIAN_GUARD_B.status", "equals": 1 },
    { "act": "click_board_at", "x": 880.0, "y": 1000.0, "comment": "outside the deployment zone: nothing is placed" },
    { "act": "wait_frames", "frames": 2 },
    { "act": "execute_script", "script": "main.redeployment_controller._placer.get_placed_count()", "equals": 0 },
    { "act": "click_board_at", "x": 900.0, "y": 400.0 },
    { "act": "click_board_at", "x": 970.0, "y": 400.0 },
    { "act": "click_board_at", "x": 1040.0, "y": 400.0 },
    { "act": "wait_frames", "frames": 2 },
    { "act": "execute_script", "script": "main.redeployment_controller._placer.get_placed_count()", "equals": 3 },
    { "act": "expect_node_property", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/ConfirmRedeployButton", "property": "disabled", "equals": false },
    { "act": "screenshot", "label": "02_custodian_guard_placed_in_zone" },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/ConfirmRedeployButton" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_state", "path": "units.U_CUSTODIAN_GUARD_B.status", "equals": 2 },
    { "act": "execute_script", "script": "Vector2(GameState.state.units.U_CUSTODIAN_GUARD_B.models[0].position.x, GameState.state.units.U_CUSTODIAN_GUARD_B.models[0].position.y).distance_to(Vector2(900, 400)) < 2.0", "equals": true },
    { "act": "execute_script", "script": "FactionAbilityManager.get_razgit_redeploys_remaining(1)", "equals": 2 },
    { "act": "execute_script", "script": "ScenarioRunner.event_log_count_containing(\"CASTELLAN'S MARK\")", "expect_min": 1 },
    { "act": "screenshot", "label": "03_custodian_guard_redeployed" },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/UnitRows/Row_U_WITCHSEEKERS_C/Buttons/Reserves_U_WITCHSEEKERS_C" },
    { "act": "wait_seconds", "seconds": 0.6 },
    { "act": "expect_state", "path": "units.U_WITCHSEEKERS_C.status", "equals": 7 },
    { "act": "expect_state", "path": "units.U_WITCHSEEKERS_C.reserve_type", "equals": "strategic_reserves" },
    { "act": "execute_script", "script": "FactionAbilityManager.get_razgit_redeploys_remaining(1)", "equals": 1 },
    { "act": "screenshot", "label": "04_witchseekers_to_strategic_reserves" },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/UnitRows/Row_U_WITCHSEEKERS_D/Buttons/Skip_U_WITCHSEEKERS_D" },
    { "act": "wait_seconds", "seconds": 0.5 },
    { "act": "expect_state", "path": "units.U_WITCHSEEKERS_D.status", "equals": 2 },
    { "act": "execute_script", "script": "tree.root.get_node(\"Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/UnitRows\").get_node_or_null(\"Row_U_WITCHSEEKERS_D\") == null", "equals": true },
    { "act": "click_node", "node": "/root/Main/HUD_Right/VBoxContainer/RedeploymentScrollContainer/RedeploymentOuter/RedeploymentPanel/DoneButton" },
    { "act": "wait_seconds", "seconds": 1.0 },
    { "act": "execute_script", "script": "int(GameState.state.meta.phase) != 2", "equals": true, "comment": "the Redeployment step ended" },
    { "act": "expect_state", "path": "units.U_WITCHSEEKERS_C.status", "equals": 7 },
    { "act": "screenshot", "label": "05_redeployment_step_ended" }
  ]
}
