{
  "id": "mv02_hold_what_you_score",
  "covers": [
    "ai.movement.stay_on_objective"
  ],
  "fixture": "mirror_custodes_postdeploy",
  "phase": 7,
  "player": 1,
  "difficulty": 2,
  "seed": 4243,
  "rationale": "Primary VP are awarded in the COMMAND phase for objectives you control at that moment (11e 25.1). A unit already standing on a marker in round 3 with nothing contesting it converts to points by doing nothing at all; walking off it trades guaranteed VP for a speculative future position. This exam puts the Telemon (OC 5) on obj_center in round 3 with no enemy within 25 inches and checks it is still there when the phase ends.",
  "setup": [
    "var st = GameState.state",
    "st.meta.battle_round = 3",
    "const KEEP = [\"U_TELEMON_HEAVY_DREADNOUGHT_I\"]",
    "var _u1 = st.units.U_TELEMON_HEAVY_DREADNOUGHT_I",
    "var _k1 = 0",
    "for m in _u1.models:",
    "\tm.position = {\"x\": 870.0 + float(_k1) * 32.0, \"y\": 1195.0}",
    "\t_k1 += 1",
    "for uid in st.units:",
    "\tvar u = st.units[uid]",
    "\tif uid in KEEP:",
    "\t\tcontinue",
    "\tvar j = 0",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 120.0 + float(j / 6) * 40.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 2300.0 - float(j / 6) * 40.0}",
    "\t\tj += 1",
    "return true"
  ],
  "assert": [
    {
      "name": "Telemon is still within control range of obj_center",
      "script": [
        "var u = GameState.state.units.U_TELEMON_HEAVY_DREADNOUGHT_I",
        "var obj = Vector2(880.0, 1200.0)",
        "var best = 1e9",
        "for m in u.models:",
        "\tif not m.get(\"alive\", true):",
        "\t\tcontinue",
        "\tvar p = m.position",
        "\tvar v = Vector2(float(p.x), float(p.y)) if not (p is Vector2) else p",
        "\tbest = min(best, v.distance_to(obj) / 40.0)",
        "return best"
      ],
      "expect_max": 3.0
    }
  ]
}