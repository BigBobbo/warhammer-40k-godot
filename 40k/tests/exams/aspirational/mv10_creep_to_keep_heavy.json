{
  "id": "mv10_creep_to_keep_heavy",
  "covers": [
    "ai.movement.heavy_creep",
    "rules.11e.heavy_24_16",
    "rules.11e.benefit_of_cover_13_08",
    "rules.11e.obscuring_13_10"
  ],
  "fixture": "mirror_custodes_2000_postdeploy",
  "phase": 7,
  "player": 1,
  "seed": 4255,
  "max_seconds": 240,
  "owner": "FIX_HEAVY_CREEP (movement: keep [HEAVY] while moving 3\" or less instead of freezing - OFF-06)",
  "rationale": "11e 24.16 [HEAVY]: each attack made with a [HEAVY] weapon in your Shooting phase adds 1 to the hit roll if the attacking unit is unengaged, was not set up on the battlefield this turn, and no model in it has moved more than 3\" this turn - the 10e rule needed it to Remain Stationary. T7-26 (_should_hold_for_heavy_bonus) still keeps [HEAVY] the 10e way: it freezes the unit (REMAIN_STATIONARY) on centroid range alone, with no line of sight and no move of 3\" or less considered. Here U_CUSTODIAN_GUARD_B (Custodian Guard Beta, 5 models) carries a constructed 36\" BS 4+ [HEAVY] heavy bolter just north of area-medium-7, a LIGHT terrain area it is not within. 13.10: terrain areas containing light or dense features are obscuring, and a line that crosses one is blocked unless one of the two models is within it - so its only target in reach, U_CUSTODIAN_GUARD_A_P2 (Custodian Guard Alpha, in the open corridor ~27\" south, centroid well inside 36\"), cannot be seen from where Beta stands, and T7-26 freezes it for +1 to hit on nothing. A 2.5\" creep south puts every Beta model inside area-medium-7: it sees out (the area a model is within is excluded), every model's centre is in a terrain area (13.08: the Benefit of Cover, -1 BS, against both enemy shooters that can reach it next turn - 6\" moves and 24\" spears) and no model moved more than 3\", so the heavy bolter keeps +1 to hit (BS 4+ -> 3+). The objectives in reach are already held and none is within 4\" of any model, so nothing else is on offer (the plan sends Beta to obj_center, 24\" away). With FIX_HEAVY_CREEP the T7-26 branch looks for a Normal move of 3\" or less for every model - the engine's own distance - toward cover, the objective footprint or a firing lane that keeps every [HEAVY] target it has, and makes it instead of freezing when it wins by HEAVY_CREEP_MIN_GAIN. Guard: U_CUSTODIAN_GUARD_D (Custodian Guard Delta, the same weapon) already sees its target U_CUSTODIAN_GUARD_B_P2 down the east-edge lane and has no terrain within 3.5\" - nothing a 3\" move can buy - so it must still hold still (T7-26's unchanged REMAIN_STATIONARY). Always-hold fails the Beta asserts; always-full-move fails the 3\" assert; creeping without a gain fails the Delta guard; a move that loses [HEAVY] or the target fails the [HEAVY] and eligibility asserts.",
  "setup": [
    "var st = GameState.state",
    "# Behaviour under test ships OFF: switch it on for player 1 only. Loaded",
    "# inline (not from the bench profile) so the exam names exactly the knob",
    "# it depends on.",
    "AIDecisionMaker.load_player_profile(1, {\"parameters\": {\"FIX_HEAVY_CREEP\": 1.0}})",
    "# No 2000-pt fixture fields a [HEAVY] weapon, so two Custodian Guard squads",
    "# swap their guardian spears' ranged profile for a constructed heavy bolter",
    "# (36\", A3, BS 4+, S5, AP-1, D2, [HEAVY]; the melee profile is kept).",
    "# granted_by makes every model carry it whatever the resolved loadout says",
    "# (RulesEngine._get_model_weapon_ids); unique names, because a weapon id",
    "# resolves by name across the board.",
    "var hb = {\"name\": \"Exam heavy bolter\", \"type\": \"Ranged\", \"range\": \"36\", \"attacks\": \"3\", \"ballistic_skill\": \"4\", \"strength\": \"5\", \"ap\": \"-1\", \"damage\": \"2\", \"special_rules\": \"heavy\", \"abilities\": [{\"id\": \"heavy\"}], \"granted_by\": \"exam\"}",
    "var hbd = hb.duplicate(true)",
    "hbd[\"name\"] = \"Exam heavy bolter D\"",
    "var arm = {\"U_CUSTODIAN_GUARD_B\": hb, \"U_CUSTODIAN_GUARD_D\": hbd}",
    "for uid in arm:",
    "\tvar u = st.units[uid]",
    "\tvar kept = []",
    "\tfor w in u.meta.weapons:",
    "\t\tif str(w.get(\"type\", \"\")).to_lower() != \"ranged\":",
    "\t\t\tkept.append(w)",
    "\tkept.append(arm[uid])",
    "\tu.meta.weapons = kept",
    "# Beta just north of area-medium-7 (a LIGHT terrain area, x 1120-1360,",
    "# y 360-520: an obscuring area, 13.10) with every base outside it; its only",
    "# reachable target, Custodian Guard Alpha (P2), stands in the open corridor",
    "# south of it (between the Center ruin and area-medium-35), so every line",
    "# between them crosses area-medium-7. Delta in the open on the north edge,",
    "# far from every terrain area, with a clear line to Custodian Guard Beta",
    "# (P2) on the east-edge lane past area-large-2.",
    "var place = {",
    "\t\"U_CUSTODIAN_GUARD_B\": [Vector2(1160, 320), Vector2(1226, 320), Vector2(1292, 320), Vector2(1193, 265), Vector2(1259, 265)],",
    "\t\"U_CUSTODIAN_GUARD_D\": [Vector2(1560, 220), Vector2(1625, 220), Vector2(1690, 220), Vector2(1592, 165), Vector2(1657, 165)],",
    "\t\"U_CUSTODIAN_GUARD_A_P2\": [Vector2(1160, 1330), Vector2(1226, 1330), Vector2(1160, 1395), Vector2(1226, 1395), Vector2(1193, 1460)],",
    "\t\"U_CUSTODIAN_GUARD_B_P2\": [Vector2(1640, 1150), Vector2(1704, 1150), Vector2(1640, 1214), Vector2(1704, 1214), Vector2(1672, 1278)],",
    "}",
    "for uid in place:",
    "\tvar k = 0",
    "\tfor m in st.units[uid].models:",
    "\t\tm.position = {\"x\": place[uid][k].x, \"y\": place[uid][k].y}",
    "\t\tk += 1",
    "\tif st.units[uid].has(\"flags\"):",
    "\t\tst.units[uid].flags.erase(\"last_shot_idx\")",
    "\t\tst.units[uid].flags.erase(\"shot_recently\")",
    "# Park everyone else, stacked per unit. Player 1 alternates between",
    "# obj_home_1's ruin (area-large-14) and obj_nml_1's ruin (area-large-2), so",
    "# both are already held; player 2 goes to the south-east corner, more than",
    "# 42\" from Beta and Delta.",
    "var alt = 0",
    "for uid in st.units:",
    "\tif place.has(uid):",
    "\t\tcontinue",
    "\tvar u = st.units[uid]",
    "\tvar q = 0",
    "\tvar spot = alt % 2",
    "\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\talt += 1",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tif spot == 0:",
    "\t\t\t\tm.position = {\"x\": 600.0 + 40.0 * float(q % 5), \"y\": 300.0}",
    "\t\t\telse:",
    "\t\t\t\tm.position = {\"x\": 1450.0 + 40.0 * float(q % 4), \"y\": 540.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + 40.0 * float(q % 5), \"y\": 2300.0}",
    "\t\tq += 1",
    "return TerrainManager.area_at(Vector2(1240.0, 440.0)).get(\"id\", \"\")"
  ],
  "assert": [
    {
      "name": "precondition: area-medium-7 is a LIGHT terrain AREA; no Beta base touches any terrain piece where it stands, and Beta shifted 2.5\" south (0,+100 px) has every model's centre in a terrain area and the Benefit of Cover (13.08 first bullet)",
      "script": [
        "var place = {",
        "\t\"U_CUSTODIAN_GUARD_B\": [Vector2(1160, 320), Vector2(1226, 320), Vector2(1292, 320), Vector2(1193, 265), Vector2(1259, 265)],",
        "\t\"U_CUSTODIAN_GUARD_D\": [Vector2(1560, 220), Vector2(1625, 220), Vector2(1690, 220), Vector2(1592, 165), Vector2(1657, 165)],",
        "\t\"U_CUSTODIAN_GUARD_A_P2\": [Vector2(1160, 1330), Vector2(1226, 1330), Vector2(1160, 1395), Vector2(1226, 1395), Vector2(1193, 1460)],",
        "\t\"U_CUSTODIAN_GUARD_B_P2\": [Vector2(1640, 1150), Vector2(1704, 1150), Vector2(1640, 1214), Vector2(1704, 1214), Vector2(1672, 1278)],",
        "}",
        "var a = TerrainManager.area_at(Vector2(1240.0, 440.0))",
        "if str(a.get(\"id\", \"\")) != \"area-medium-7\" or str(a.get(\"piece_class\", \"\")) != \"area\" or str(TerrainManager.category_of(a)) != \"light\":",
        "\treturn -1.0",
        "var u = GameState.state.units.U_CUSTODIAN_GUARD_B.duplicate(true)",
        "var k = 0",
        "for m in u.models:",
        "\tm[\"position\"] = place.U_CUSTODIAN_GUARD_B[k]",
        "\tif not TerrainManager.pieces_model_within(m).is_empty():",
        "\t\treturn -2.0",
        "\tvar p = place.U_CUSTODIAN_GUARD_B[k] + Vector2(0.0, 100.0)",
        "\tm[\"position\"] = p",
        "\tk += 1",
        "\tif TerrainManager.area_at(p).is_empty():",
        "\t\treturn -3.0",
        "if not TerrainManager.unit_has_cover_11e(u, {}):",
        "\treturn -4.0",
        "return 1.0"
      ],
      "equals": 1
    },
