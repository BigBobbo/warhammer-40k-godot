        "\treturn -1.0",
        "if not RulesEngine.get_eligible_targets(\"U_CUSTODIAN_GUARD_B\", snap, false).is_empty():",
        "\treturn -2.0",
        "var cb = Vector2.ZERO",
        "for p in place.U_CUSTODIAN_GUARD_B:",
        "\tcb += p",
