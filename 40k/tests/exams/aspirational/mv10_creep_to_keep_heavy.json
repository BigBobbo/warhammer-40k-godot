        "\t\"U_CUSTODIAN_GUARD_B_P2\": [Vector2(1640, 1150), Vector2(1704, 1150), Vector2(1640, 1214), Vector2(1704, 1214), Vector2(1672, 1278)],",
        "}",
        "var snap = GameState.create_snapshot()",
        "for uid in place:",
        "\tvar k = 0",
        "\tfor m in snap.units[uid].models:",
        "\t\tm[\"position\"] = place[uid][k]",
        "\t\tk += 1",
