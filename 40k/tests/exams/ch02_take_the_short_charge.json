  "rationale": "The mirror image of ch01, and it has to be there \u2014 an AI that never charges passes ch01 trivially. The same Custodian Guard, the same target, 4 inches away: 2D6 makes that on 33 of 36 rolls, the target is a 1-wound OC 1 squad sitting on no-man's-land, and the Guard wins that fight decisively. Declining here is not caution, it is inaction.",
  "setup": [
    "var st = GameState.state",
    "const KEEP = [\"U_CUSTODIAN_GUARD_B\",\"U_CUSTODIAN_GUARD_C_P2\"]",
    "var _u1 = st.units.U_CUSTODIAN_GUARD_B",
    "var _k1 = 0",
    "for m in _u1.models:",
    "\tm.position = {\"x\": 880.0 + float(_k1) * 32.0, \"y\": 1000.0}",
    "\t_k1 += 1",
    "var _u2 = st.units.U_CUSTODIAN_GUARD_C_P2",
    "var _k2 = 0",
    "for m in _u2.models:",
    "\tm.position = {\"x\": 880.0 + float(_k2) * 32.0, \"y\": 1180.0}",
    "\t_k2 += 1",
    "for uid in st.units:",
    "\tvar u = st.units[uid]",
    "\tif uid in KEEP:",
    "\t\tcontinue",
    "\tvar j = 0",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 120.0 + float(j / 6) * 40.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 2300.0 - float(j / 6) * 40.0}",
    "\t\tj += 1",
    "return true"
  ],
  "assert": [
    {
      "name": "a charge was declared at 4 inches",
      "script": [
        "var ai = tree.root.get_node_or_null(\"AIPlayer\")",
        "var n = 0",
