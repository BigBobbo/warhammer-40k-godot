{
  "id": "sc02_screen_covers_the_gap",
  "covers": [
    "ai.movement.screening"
  ],
  "fixture": "mirror_custodes_postdeploy",
  "phase": 7,
  "player": 1,
  "difficulty": 2,
  "seed": 4247,
  "rationale": "A screen is only a screen if it stands between the threat and the thing it protects. The Witchseekers (1 wound, OC 1, the cheapest body in the list) are placed behind the Caladius with an enemy Dreadnought 20 inches up the same lane. The exam asks the weak question deliberately: after the movement phase the screening unit must be no further from the enemy than the unit it screens, i.e. it has not hidden BEHIND its own tank. Anything stronger would be asserting a specific position the AI was never told to reach.",
  "setup": [
    "var st = GameState.state",
    "const KEEP = [\"U_WITCHSEEKERS_C\",\"U_CALADIUS_GRAV-TANK_E\",\"MIR_U_CONTEMPTOR-ACHILLUS_DREADNOUGHT_H\"]",
    "var _u1 = st.units[\"U_CALADIUS_GRAV-TANK_E\"]",
    "var _k1 = 0",
    "for m in _u1.models:",
    "\tm.position = {\"x\": 880.0 + float(_k1) * 32.0, \"y\": 700.0}",
    "\t_k1 += 1",
    "var _u2 = st.units.U_WITCHSEEKERS_C",
    "var _k2 = 0",
    "for m in _u2.models:",
    "\tm.position = {\"x\": 880.0 + float(_k2) * 32.0, \"y\": 640.0}",
    "\t_k2 += 1",
    "var _u3 = st.units[\"MIR_U_CONTEMPTOR-ACHILLUS_DREADNOUGHT_H\"]",
    "var _k3 = 0",
    "for m in _u3.models:",
    "\tm.position = {\"x\": 880.0 + float(_k3) * 32.0, \"y\": 1500.0}",
    "\t_k3 += 1",
    "for uid in st.units:",
    "\tvar u = st.units[uid]",
    "\tif uid in KEEP:",
    "\t\tcontinue",
    "\tvar j = 0",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 120.0 + float(j / 6) * 40.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 2300.0 - float(j / 6) * 40.0}",
    "\t\tj += 1",
    "return true"
  ],
  "assert": [
    {
      "name": "the screen is not hiding behind the unit it protects",
      "script": [
        "var st = GameState.state",
        "var f = func(uid):",
        "\tvar u = st.units[uid]",
        "\tvar best = 1e9",
        "\tfor m in u.models:",
        "\t\tif not m.get(\"alive\", true):",
        "\t\t\tcontinue",
        "\t\tvar p = m.position",
        "\t\tvar v = Vector2(float(p.x), float(p.y)) if not (p is Vector2) else p",
        "\t\tbest = min(best, v.distance_to(Vector2(880.0, 1500.0)) / 40.0)",
        "\treturn best",
        "return f.call(\"U_WITCHSEEKERS_C\") - f.call(\"U_CALADIUS_GRAV-TANK_E\")"
      ],
      "expect_max": 0.5
    }
  ]
}