{
  "id": "sh02_shooting_weighs_alternatives",
  "covers": [
    "ai.records.shooting_alternatives"
  ],
  "fixture": "mirror_custodes_postdeploy",
  "phase": 8,
  "player": 1,
  "difficulty": 2,
  "seed": 4249,
  "rationale": "The A1 guard, as an exam. With two enemy units in range of the same guns the shooting records must contain both as scored options with different marginal values \u2014 if a refactor collapses them back to a restatement of the plan, shooting regret analysis dies quietly and nothing else notices.",
  "setup": [
    "var st = GameState.state",
    "const KEEP = [\"U_CALADIUS_GRAV-TANK_E\",\"U_TELEMON_HEAVY_DREADNOUGHT_I\",\"MIR_U_BLADE_CHAMPION_A\",\"MIR_U_CUSTODIAN_GUARD_B\"]",
    "var _u1 = st.units[\"U_CALADIUS_GRAV-TANK_E\"]",
    "var _k1 = 0",
    "for m in _u1.models:",
    "\tm.position = {\"x\": 880.0 + float(_k1) * 32.0, \"y\": 900.0}",
    "\t_k1 += 1",
    "var _u2 = st.units.U_TELEMON_HEAVY_DREADNOUGHT_I",
    "var _k2 = 0",
    "for m in _u2.models:",
    "\tm.position = {\"x\": 800.0 + float(_k2) * 32.0, \"y\": 900.0}",
    "\t_k2 += 1",
    "var _u3 = st.units.MIR_U_BLADE_CHAMPION_A",
    "var _k3 = 0",
    "for m in _u3.models:",
    "\tm.position = {\"x\": 830.0 + float(_k3) * 32.0, \"y\": 1200.0}",
    "\t_k3 += 1",
    "var _u4 = st.units.MIR_U_CUSTODIAN_GUARD_B",
    "var _k4 = 0",
    "for m in _u4.models:",
    "\tm.position = {\"x\": 950.0 + float(_k4) * 32.0, \"y\": 1200.0}",
    "\t_k4 += 1",
    "for uid in st.units:",
    "\tvar u = st.units[uid]",
    "\tif uid in KEEP:",
    "\t\tcontinue",
    "\tvar j = 0",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 120.0 + float(j / 6) * 40.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 2300.0 - float(j / 6) * 40.0}",
    "\t\tj += 1",
    "return true"
  ],
  "assert": [
    {
      "name": "at least one shooting record weighed 2+ targets with different scores",
      "script": [
        "var ai = tree.root.get_node_or_null(\"AIPlayer\")",
        "var n = 0",
        "for b in ai._all_decision_records:",
        "\tfor r in b.get(\"records\", []):",
        "\t\tif str(r.get(\"decision_type\", \"\")) != \"shooting\":",
        "\t\t\tcontinue",
        "\t\tvar c = r.get(\"candidates\", [])",
        "\t\tif c.size() < 2:",
        "\t\t\tcontinue",
        "\t\tvar lo = 1e9",
        "\t\tvar hi = -1e9",
        "\t\tfor cand in c:",
        "\t\t\tvar sv = float(cand.get(\"score\", 0.0))",
        "\t\t\tlo = min(lo, sv)",
        "\t\t\thi = max(hi, sv)",
        "\t\tif hi - lo > 0.0001:",
        "\t\t\tn += 1",
        "return n"
      ],
      "expect_min": 1
    }
  ]
}