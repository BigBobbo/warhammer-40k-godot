{
  "id": "mv03_prefer_the_reachable_objective",
  "covers": [
    "ai.movement.distance_penalty",
    "ai.movement.reachability"
  ],
  "fixture": "mirror_custodes_2000_postdeploy",
  "phase": 7,
  "player": 1,
  "difficulty": 2,
  "seed": 4244,
  "rationale": "Two uncontested no-man's-land markers are worth the same VP, so the only thing separating them is how many turns of movement each costs \u2014 an objective reached in round 2 scores in rounds 2-5, one reached in round 4 scores twice. A Move 6 unit placed 4 inches from obj_nml_1 and 26 inches from obj_nml_2 should walk to the near one. Getting this wrong is not a judgement call, it is arithmetic.",
  "setup": [
    "var st = GameState.state",
    "const KEEP = [\"U_CUSTODIAN_GUARD_B\"]",
    "var _u1 = st.units.U_CUSTODIAN_GUARD_B",
    "var _k1 = 0",
    "for m in _u1.models:",
    "\tm.position = {\"x\": 400.0 + float(_k1) * 32.0, \"y\": 1050.0}",
    "\t_k1 += 1",
    "for uid in st.units:",
    "\tvar u = st.units[uid]",
    "\tif uid in KEEP:",
    "\t\tcontinue",
    "\tvar j = 0",
    "\tfor m in u.get(\"models\", []):",
    "\t\tif m.get(\"position\") == null:",
    "\t\t\tcontinue",
    "\t\tif int(u.get(\"owner\", 0)) == 1:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 120.0 + float(j / 6) * 40.0}",
    "\t\telse:",
    "\t\t\tm.position = {\"x\": 1500.0 + float(j % 6) * 40.0, \"y\": 2300.0 - float(j / 6) * 40.0}",
    "\t\tj += 1",
    "return true"
  ],
  "assert": [
    {
      "name": "Custodian Guard closed on the near objective, not the far one",
      "script": [
        "var u = GameState.state.units.U_CUSTODIAN_GUARD_B",
        "var obj = Vector2(400.0, 880.0)",
        "var best = 1e9",
        "for m in u.models:",
        "\tif not m.get(\"alive\", true):",
        "\t\tcontinue",
        "\tvar p = m.position",
        "\tvar v = Vector2(float(p.x), float(p.y)) if not (p is Vector2) else p",
        "\tbest = min(best, v.distance_to(obj) / 40.0)",
        "return best"
      ],
      "expect_max": 3.0
    }
  ]
}