# Estimate terrain penalty (in inches) for a charge path between two positions.
# Uses TerrainManager.calculate_charge_terrain_penalty() if available.
static func _estimate_charge_terrain_penalty(from_pos: Vector2, to_pos: Vector2, has_fly: bool, unit_keywords: Array = []) -> float:
	var tm = _terrain_manager()
	if tm and tm.has_method("calculate_charge_terrain_penalty"):
		return tm.calculate_charge_terrain_penalty(from_pos, to_pos, has_fly, unit_keywords)
	return 0.0

# MOVE-TERRAIN-11E (FIX_MOVE_TERRAIN_11E): the extra inches the engine adds to a
# Normal or Advance move, as MovementPhase._get_movement_terrain_penalty sums
# them: 0 for FLY and a Kustom Shokk Box bearer; else TerrainManager's 2" per
# difficult-ground piece the unit cannot move through, plus the climb onto the
# piece at the destination (ascent only, as _get_vertical_climb_cost; none with
# Grapnel Launchers).
static func _estimate_move_terrain_penalty(from_pos: Vector2, to_pos: Vector2, unit_keywords: Array, unit: Dictionary = {}) -> float:
	if "FLY" in unit_keywords:
		return 0.0
	for enh in unit.get("meta", {}).get("enhancements", []):
		var enh_name = enh if enh is String else (enh.get("name", "") if enh is Dictionary else "")
		if str(enh_name).strip_edges().to_lower() == "kustom shokk box":
			return 0.0
	var tm = _terrain_manager()
	if tm == null or not tm.has_method("calculate_movement_terrain_penalty"):
		return 0.0
	var penalty := float(tm.calculate_movement_terrain_penalty(from_pos, to_pos, false, unit_keywords))
	var to_t: Dictionary = tm.get_terrain_at_position(to_pos)
	if to_t.is_empty() or tm.can_unit_move_through_terrain(unit_keywords, to_t):
		return penalty
	var unit_id := str(unit.get("id", ""))
	if unit_id != "" and load("res://scripts/codex/space_marines/SMAbilitiesC.gd").ignores_vertical_distance(unit_id):
		return penalty
	var from_t: Dictionary = tm.get_terrain_at_position(from_pos)
	var from_h := 0.0 if from_t.is_empty() else float(tm.get_height_inches(from_t))
	var to_h := float(tm.get_height_inches(to_t))
	if to_h > from_h:
		penalty += to_h - from_h
	return penalty

# MOVE-TERRAIN-11E: is FIX_MOVE_TERRAIN_11E on for this unit's move? Only for a
# unit of the seat the AI decides for (_current_player, whose profile get_param
# reads). AIPlayer.recompute_destinations_for_cap (after an Advance roll) and
# the staging-failure retry call the class_name AIDecisionMaker's
# _compute_movement_toward_target for BOTH seats; in a two-version bench HEAD's
# _current_player is then the candidate seat, and the candidate's profile would
# act on the base seat's units. decide() sets _current_player to the deciding
# seat before every planned move, so in normal play this changes nothing. Off:
# false as soon as get_param reads < 0.5 (same reads and branches as before).
static func _move_terrain_fix_on(unit: Dictionary) -> bool:
	if get_param("FIX_MOVE_TERRAIN_11E", FIX_MOVE_TERRAIN_11E) < 0.5:
		return false
	return _current_player > 0 and int(unit.get("owner", 0)) == _current_player

# MOVE-TERRAIN-11E: the terrain cost of one Normal/Advance move segment — the
# engine's movement cost with FIX_MOVE_TERRAIN_11E on, the charge cost (the old
# estimate) with it off.
static func _normal_move_terrain_penalty(from_pos: Vector2, to_pos: Vector2, has_fly: bool, unit_keywords: Array, unit: Dictionary) -> float:
	if not _move_terrain_fix_on(unit):
		return _estimate_charge_terrain_penalty(from_pos, to_pos, has_fly, unit_keywords)
	return _estimate_move_terrain_penalty(from_pos, to_pos, unit_keywords, unit)

# MOVE-TERRAIN-11E: the engine (MovementPhase) rejects a staged model whose raw
# distance + movement terrain penalty exceeds the move cap. Collision
# resolution and formation placement move models after their cap was set and
# do not price terrain, so a model can end inside a terrain piece (ascent).
# Returns "" when every destination fits move_cap_px, else the first model
# that does not ("m1 5.3\" + 5.5\" > 9.5\"").
static func _move_terrain_gate_failure(destinations: Dictionary, original_positions: Dictionary,
		unit: Dictionary, move_cap_px: float) -> String:
	var kws: Array = unit.get("meta", {}).get("keywords", [])
	for mid in destinations:
		var orig = original_positions.get(mid, Vector2.INF)
		if not (orig is Vector2) or orig == Vector2.INF:
			continue
		var d := Vector2(float(destinations[mid][0]), float(destinations[mid][1]))
		var raw_px: float = orig.distance_to(d)
		var pen_in := _estimate_move_terrain_penalty(orig, d, kws, unit)
		if raw_px + pen_in * PIXELS_PER_INCH > move_cap_px + 0.5:
			return "%s %.1f\" + %.1f\" > %.1f\"" % [str(mid), raw_px / PIXELS_PER_INCH, pen_in, move_cap_px / PIXELS_PER_INCH]
	return ""

# MOVE-TERRAIN-11E: print one [FIX_MOVE_TERRAIN_11E] line when new_pen (the
# engine's movement cost) differs from the charge cost the old code used for
# the same segment. Returns true when it printed.
static func _log_move_terrain_change(from_pos: Vector2, to_pos: Vector2, has_fly: bool, unit_keywords: Array,
		unit: Dictionary, new_pen: float, what: String) -> bool:
	var old_pen := _estimate_charge_terrain_penalty(from_pos, to_pos, has_fly, unit_keywords)
	if absf(old_pen - new_pen) <= 0.001:
		return false
	print("AIDecisionMaker: [FIX_MOVE_TERRAIN_11E] %s %s old=%.1f new=%.1f" % [
		_dn(unit, str(unit.get("id", "?"))), what, old_pen, new_pen])
	return true

# Check if a shooter unit can see (has LoS to) a target unit for at least one weapon.
# Uses RulesEngine._check_target_visibility if available, otherwise returns true (optimistic).
static func _can_shooter_see_target(shooter_unit_id: String, target_unit_id: String, weapon_id: String, snapshot: Dictionary) -> bool:
	var re = _rules_engine()
	if re and re.has_method("_check_target_visibility"):
		var result = re._check_target_visibility(shooter_unit_id, target_unit_id, weapon_id, snapshot)
		return result.get("visible", true)
	return true  # Optimistic fallback if RulesEngine unavailable

# AIR-2: Hunter profiles (11e 04.01.03) can only target units with their
# keywords (MONSTER/VEHICLE in the shipped catalogue). Same predicate the SHOOT
# validator uses (RulesEngine.validate_shoot -> weapon_profile_can_target), so
# the planner never assigns a pair the engine rejects (which cost the unit its
# whole activation: SHOOT rejected -> SKIP_UNIT).
static func _ai_weapon_can_target(weapon_id: String, target_unit: Dictionary, snapshot: Dictionary) -> bool:
	var re = _rules_engine()
	if re and re.has_method("weapon_profile_can_target"):
		return bool(re.weapon_profile_can_target(weapon_id, target_unit, snapshot))
	return true

## LAST-1: a [BLAST] weapon cannot target a unit within Engagement Range of
## one of the shooter's own units. get_eligible_targets keeps such a target
## when it is a MONSTER/VEHICLE (Big Guns Never Tire — other weapons may still
## shoot it), so this is checked separately with the SAME predicate the SHOOT
## validator calls (RulesEngine.validate_shoot -> validate_blast_targeting,
## which also covers granted BLAST: Deck Fraggers, SYNCHRONISED INFERNO).
static func _ai_blast_target_allowed(unit_id: String, weapon_id: String, target_id: String, snapshot: Dictionary) -> bool:
	var re = _rules_engine()
	if re == null or not re.has_method("validate_blast_targeting") or unit_id == "" or target_id == "":
		return true
	return bool(re.validate_blast_targeting(unit_id, target_id, weapon_id, snapshot).get("valid", true))

## AIR-2 safety net, applied to every SHOOT the planner emits: keep only the
## assignments the engine's own eligibility accepts (get_eligible_targets ->
## weapons_in_range: range, line of sight, Hunter profiles, targets engaged with
## friendlies ...), give each one the models that actually CARRY the weapon
## (the plan used every alive model — "Model 'Boss Nob' does not have weapon
## ..."), let each model fire one profile per weapon (04.01.03), and apply the
## per-model either/or (validator MA-25 for PISTOLs, 11e 24.07 for every
## [CLOSE-QUARTERS] weapon): a non-MONSTER/VEHICLE model fires its Pistol /
## [CLOSE-QUARTERS] weapons OR its other ranged weapons, never both (the other
## weapons win). Returns the cleaned list (possibly empty).
static func _sanitize_shoot_assignments(unit_id: String, assignments: Array, snapshot: Dictionary) -> Array:
	var re = _rules_engine()
	if re == null or not re.has_method("get_eligible_targets") or not re.has_method("get_unit_weapons"):
		return assignments
	var units: Dictionary = snapshot.get("units", {})
	var unit: Dictionary = units.get(unit_id, {})
	var unit_name := _dn(unit, unit_id)
	var eligible: Dictionary = re.get_eligible_targets(unit_id, snapshot)
	var unit_weapons: Dictionary = re.get_unit_weapons(unit_id, snapshot)
	var out: Array = []
	for a in assignments:
		var wid := str(a.get("weapon_id", ""))
		var tid := str(a.get("target_unit_id", ""))
		var target: Dictionary = units.get(tid, {})
		if not _ai_weapon_can_target(wid, target, snapshot):
			print("AIDecisionMaker: [AIR-2] %s: dropping %s -> %s (Hunter profile cannot target it, 04.01.03)" % [unit_name, wid, _dn(target, tid)])
			continue
		if not eligible.has(tid) or not wid in eligible[tid].get("weapons_in_range", []):
			print("AIDecisionMaker: [AIR-2] %s: dropping %s -> %s (not an eligible target for that weapon)" % [unit_name, wid, _dn(target, tid)])
			continue
		if not _ai_blast_target_allowed(unit_id, wid, tid, snapshot):
			print("AIDecisionMaker: [LAST-1] %s: dropping %s -> %s ([BLAST] at a unit in Engagement Range of a friendly unit)" % [unit_name, wid, _dn(target, tid)])
			continue
		var bearers: Array = []
		var asked: Array = a.get("model_ids", [])
		for mid in unit_weapons:
			if wid in unit_weapons[mid] and (asked.is_empty() or mid in asked):
				bearers.append(mid)
		if bearers.is_empty():
			print("AIDecisionMaker: [AIR-2] %s: dropping %s -> %s (no model carries it)" % [unit_name, wid, _dn(target, tid)])
			continue
		var clean: Dictionary = a.duplicate(true)
		clean["model_ids"] = bearers
		out.append(clean)
	# 04.01.03: a model attacks with ONE profile of a multi-profile weapon
	# (Busta Rokkit Launcha – Hunter / – Standard): per model, keep the profile
	# worth most against its assigned target, drop the model from the others.
	var values: Array = []
	for a in out:
		var wd := _ai_weapon_dict(unit, str(a.weapon_id))
		var tgt: Dictionary = units.get(str(a.target_unit_id), {})
		values.append(_estimate_weapon_damage(wd, tgt, snapshot, unit) if not wd.is_empty() else 0.0)
	var best_for := {}  # "model|base" -> assignment index
	for i in range(out.size()):
		var base := _ai_weapon_base_name(str(out[i].weapon_id), snapshot)
		for mid in out[i].model_ids:
			var key := "%s|%s" % [mid, base]
			if not best_for.has(key) or float(values[i]) > float(values[best_for[key]]):
				best_for[key] = i
	for i in range(out.size()):
		var base := _ai_weapon_base_name(str(out[i].weapon_id), snapshot)
		var keep_p: Array = out[i].model_ids.filter(func(m): return int(best_for.get("%s|%s" % [m, base], i)) == i)
		if keep_p.size() != out[i].model_ids.size():
			print("AIDecisionMaker: [AIR-2] %s: %d model(s) fire another profile of %s instead of %s (one profile per weapon)" % [
				unit_name, out[i].model_ids.size() - keep_p.size(), base, str(out[i].weapon_id)])
		out[i]["model_ids"] = keep_p
	out = out.filter(func(a): return not a.model_ids.is_empty())
	if not re.has_method("is_monster_or_vehicle") or re.is_monster_or_vehicle(unit):
		return out
	# Per-model either/or (MA-25 validator for PISTOLs; 11e 24.07 for every
	# [CLOSE-QUARTERS] weapon): models assigned both categories keep their other
	# ranged weapons and drop the close-quarters ones.
	var has_other := {}
	for a in out:
		if not _ai_is_close_quarters(str(a.weapon_id), snapshot):
			for mid in a.model_ids:
				has_other[mid] = true
	var final_out: Array = []
	for a in out:
		if _ai_is_close_quarters(str(a.weapon_id), snapshot):
			var keep: Array = a.model_ids.filter(func(m): return not has_other.has(m))
			if keep.size() != a.model_ids.size():
				print("AIDecisionMaker: [AIR-2] %s: %d model(s) keep their other ranged weapons instead of %s (Pistol / [CLOSE-QUARTERS] either/or)" % [
					unit_name, a.model_ids.size() - keep.size(), str(a.weapon_id)])
			if keep.is_empty():
				continue
			a["model_ids"] = keep
		final_out.append(a)
	return final_out

## The unit's weapon dict (meta.weapons entry) whose generated id is weapon_id.
static func _ai_weapon_dict(unit: Dictionary, weapon_id: String) -> Dictionary:
	for w in unit.get("meta", {}).get("weapons", []):
		if _generate_weapon_id(str(w.get("name", "")), str(w.get("type", ""))) == weapon_id:
			return w
	return {}

## "Busta Rokkit Launcha – Hunter" -> "Busta Rokkit Launcha" (profiles of one weapon).
static func _ai_weapon_base_name(weapon_id: String, snapshot: Dictionary) -> String:
	var re = _rules_engine()
	var wname := weapon_id
	if re != null:
		wname = str(re.get_weapon_profile(weapon_id, snapshot).get("name", weapon_id))
	for sep in [" – ", " — ", " - "]:
		var idx := wname.find(sep)
		if idx > 0:
			return wname.substr(0, idx)
	return wname

## Pistol (keyword) or [CLOSE-QUARTERS] (11e 24.07) — same test as the
## GUN-CRAZY forced picker (ShootingPhase._ork11e_is_close_quarters_weapon).
static func _ai_is_close_quarters(weapon_id: String, snapshot: Dictionary) -> bool:
	var re = _rules_engine()
	if re == null:
		return false
	if re.is_pistol_weapon(weapon_id, snapshot):
		return true
	var abilities: Array = AbilityRegistry.from_weapon(re.get_weapon_profile(weapon_id, snapshot))
	return AbilityRegistry.has_ability(abilities, "close_quarters") or AbilityRegistry.has_ability(abilities, "pistol")

# Focus fire plan cache — built once per shooting phase, consumed per-unit
# Stores {unit_id: [{weapon_id, target_unit_id}]} mapping
static var _focus_fire_plan: Dictionary = {}
static var _focus_fire_plan_built: bool = false

# A1 (audit F-04): the alternatives each weapon was actually weighed against.
# The plan builder scores every weapon x target pair and then throws the losers
# away, so the emitted record used to restate the plan ("shoot at X") with
# chosen_index hardcoded to 0 — which makes shooting regret/credit analysis
# impossible, because the data never contained a rejected option.
# Captured at the moment of assignment (no extra decision-affecting work) as
#   {unit_id: {weapon_id: {"candidates": [...], "chosen_index": int,
#                          "source": "focus_fire"|"fallback"}}}
# and consumed once by _decide_shooting when that unit shoots.
static var _shooting_alternatives: Dictionary = {}
# How many scored alternatives to keep per weapon. The audit asks for K >= 4
# where available; keep a few more so a human reading a record can see the
# shape of the field, not just the podium.
const SHOOTING_ALTERNATIVES_K: int = 6

# Grenade stratagem evaluation — checked once per shooting phase
static var _grenade_evaluated: bool = false

# T7-23: Multi-phase planning cache — built at start of movement phase,
# consumed during shooting and charge phases.
# Coordinates movement→shooting→charge so phases don't work at cross purposes.
# COORD-1: keyed PER PLAYER — previously a single shared plan meant the second
# AI player each round inherited a "built" flag from the first and played the
# whole round with NO plan (no charge intents, no lock targets).
# _phase_plan[player] stores:
#   charge_intent: {unit_id: {target_id, score, distance}} — units likely to charge
#   shooting_lanes: {unit_id: [{target_id, range_inches}]} — shooting targets from post-move positions
#   lock_targets: [target_id, ...] — dangerous enemy shooters to lock in combat
static var _phase_plan: Dictionary = {}        # {player: plan_dict}
static var _phase_plan_built: Dictionary = {}  # {player: bool}
static var _phase_plan_round: int = -1  # Track which round the plan was built for

# COORD-2: Movement intent ledger — what each friendly unit has ALREADY decided
# to do this movement phase. Units are moved one at a time; a unit ordered
# toward an objective 2 turns away contributes no OC there *yet*, so without
# this ledger every later unit re-derives "that objective still needs OC" and
# the AI over-commits. Consumed by _assign_units_to_objectives as "incoming OC".
# {player: {unit_id: {action, objective_id, dest: Vector2, oc, unit_name, description}}}
static var _movement_intents: Dictionary = {}

# ROLLOUT: one-shot forced decisions for counterfactual rollouts
# (tools/ai_lab/rollout.py via AIBenchmarkRunner --bench-override=). Each entry
# fires once, for its player, unit and battle round; everything else is the
# normal AI. Formats:
#   {"kind": "move", "round": 2, "player": 1, "unit": "U_X", "objective": "obj_center", "mode": "move"|"advance"|"hold"}
#   {"kind": "shoot", "round": 2, "player": 1, "unit": "U_X", "target": "U_Y"}
#   {"kind": "charge", "round": 2, "player": 1, "unit": "U_X", "targets": ["U_Y"]}  (targets [] = skip the charge)
static var _rollout_overrides: Array = []

static func set_rollout_overrides(list: Array) -> void:
	_rollout_overrides = list.duplicate(true)
	print("AIDecisionMaker: [ROLLOUT] %d override(s) armed: %s" % [_rollout_overrides.size(), str(_rollout_overrides)])

static func get_rollout_overrides() -> Array:
	return _rollout_overrides

static func _take_rollout_override(kind: String, player: int, unit_id: String, battle_round: int) -> Dictionary:
	for ov in _rollout_overrides:
		if ov.get("used", false):
			continue
		if str(ov.get("kind", "")) != kind or int(ov.get("player", 0)) != player or str(ov.get("unit", "")) != unit_id:
			continue
		if ov.has("round") and int(ov.get("round", 0)) != battle_round:
			continue
		ov["used"] = true
		print("AIDecisionMaker: [ROLLOUT] override applied: %s" % str(ov))
		return ov
	return {}

static func _objective_pos_by_id(snapshot: Dictionary, objective_id: String) -> Vector2:
	for od in snapshot.get("board", {}).get("objectives", []):
		if str(od.get("id", "")) != objective_id:
			continue
		var p = od.get("position", null)
		if p is Vector2:
			return p
		if p is Dictionary:
			return Vector2(float(p.get("x", 0)), float(p.get("y", 0)))
	return Vector2.INF
# COORD-3: units whose movement decision card was already recorded/narrated this
# phase — prevents re-narrating every unit's assignment on every decide() call.
# {player: {unit_id: true}}
static var _movement_recorded_units: Dictionary = {}
# Per-unit candidate lists from the most recent assignment computation, so the
# acted unit's decision record can be emitted at the moment it actually acts.
# {unit_id: [candidate dicts]}
static var _last_movement_candidates: Dictionary = {}

# COORD-4: Persistent movement battle plan — the army-wide unit→objective
# assignment is computed ONCE per movement phase and then CONSUMED as each
# unit acts, instead of being re-solved from scratch before every single
# action. Without persistence the announced plan and the executed moves
# diverge (a unit "planned" to obj_center actually goes to obj_nml_2 because
# a later re-solve shuffled everything), which reads as the AI having no
# holistic intent. Re-planning happens only for cause (new movable unit such
# as a disembark, or a consumed plan) and is narrated when it does.
# {player: {round, phase_signature, assignments: {unit_id: assignment}, replans: int}}
static var _turn_movement_plan: Dictionary = {}

# UNIT-ORDER (K card): the units the current step will act on, in order, and
# why the first one goes first — movement (move order), shooting (focus-fire
# plan), charge (best charge per unit), fight (fight-order plan), deployment.
# Scratch: cleared by suggest_action() and rebuilt by the step that picks a
# unit; suggest_action attaches it to the decision as _ai_unit_order, so the
# card can say "Moving first: … (N more queued)" and let the player cycle.
# {order: [{unit_id, name, action, target, tag?, ...}], first_reason,
#  first_label ("Moving first"), verb ("move"), focused}
static var _last_unit_order: Dictionary = {}
# Suggestion-only: when set, the unit-picking step (move, shoot, charge,
# fight, deploy) acts for THIS unit instead of the one it would pick (the
# card's per-unit cycling). Set and cleared by suggest_action() around its
# decide() — always empty on the live AI path.
static var _suggest_focus_unit_id: String = ""

# T7-46: Fight order optimization cache — built once per fight phase.
# SOAK-3: keyed PER PLAYER — fight activation alternates between players, so a
# single shared plan meant the second AI consumed the first AI's planned unit
