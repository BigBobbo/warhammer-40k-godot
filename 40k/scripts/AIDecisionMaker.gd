# =============================================================================
# T7-40: DIFFICULTY-AWARE SCORING UTILITIES
# =============================================================================

static func _add_thinking_step(text: String) -> void:
	"""Add a verbose thinking/reasoning step for the game log."""
	_thinking_steps.append(text)

static func take_thinking_steps() -> Array:
	"""Return and clear accumulated thinking steps. Used by AIPlayer's reactive
	handlers (fire overwatch, heroic intervention, reroll windows, …) which call
	evaluate_* directly — outside decide() — so their reasoning still reaches the
	game log instead of being dropped."""
	var steps = _thinking_steps.duplicate()
	_thinking_steps.clear()
	return steps

static func _apply_difficulty_noise(score: float) -> float:
	"""Add random noise to a score based on current difficulty level.
	Higher noise makes the AI less optimal (more humanlike / random)."""
	var noise = AIDifficultyConfigData.get_score_noise(_current_difficulty)
	if noise <= 0.0:
		return score
	return score + (ai_randf() - 0.5) * noise * 2.0

static func _get_difficulty_charge_threshold_modifier() -> float:
	"""Get charge threshold modifier for current difficulty."""
	return AIDifficultyConfigData.get_charge_threshold_modifier(_current_difficulty)

# =============================================================================
# FACTION AGGRESSION HELPERS
# =============================================================================

static func _get_faction_aggression(snapshot: Dictionary, player: int) -> float:
	"""Get faction-specific aggression modifier for a player.
	Aggressive factions (Orks, World Eaters) have higher values, encouraging
	melee engagement, advancing, and charging."""
	var faction_name = _get_player_faction_name(snapshot, player).to_upper()
	if "ORK" in faction_name:
		return get_param("FACTION_AGGRESSION_ORKS", FACTION_AGGRESSION_ORKS)
	elif "CUSTODES" in faction_name or "ADEPTUS CUSTODES" in faction_name:
		return get_param("FACTION_AGGRESSION_CUSTODES", FACTION_AGGRESSION_CUSTODES)
	elif "WORLD EATER" in faction_name:
		return get_param("FACTION_AGGRESSION_WORLD_EATERS", FACTION_AGGRESSION_WORLD_EATERS)
	elif "KHORNE" in faction_name:
		return get_param("FACTION_AGGRESSION_KHORNE", FACTION_AGGRESSION_KHORNE)
	return get_param("FACTION_AGGRESSION_DEFAULT", FACTION_AGGRESSION_DEFAULT)

static func _get_player_faction_name(snapshot: Dictionary, player: int) -> String:
	"""Get the faction name for a player from the game state."""
	var meta = snapshot.get("meta", {})
	var config = meta.get("game_config", {})
	# Try to get from army data
	var army_key = "player%d_army" % player
	var army_name = config.get(army_key, "")
	if army_name != "":
		return army_name
	# Fallback: check unit keywords for faction identity
	var units = snapshot.get("units", {})
	for uid in units:
		var unit = units[uid]
		if int(unit.get("owner", 0)) != player:
			continue
		var keywords = unit.get("meta", {}).get("keywords", [])
		for kw in keywords:
			if kw.to_upper() in ["ORKS", "ORK"]:
				return "Orks"
			if kw.to_upper() in ["WORLD EATERS"]:
				return "World Eaters"
		# Also check faction name from unit meta
		var faction = unit.get("meta", {}).get("faction_keyword", "")
		if faction != "":
			return faction
	return ""

static func _is_melee_focused_unit(unit: Dictionary) -> bool:
	"""Determine if a unit is primarily melee-focused.
	True if the unit has melee weapons and either no ranged weapons or weak ranged weapons."""
	var has_melee = _unit_has_melee_weapons(unit)
	if not has_melee:
		return false
	var has_ranged = _unit_has_ranged_weapons(unit)
	if not has_ranged:
		return true
	# Check if ranged weapons are just pistols/weak — still melee-focused
	var weapons = unit.get("meta", {}).get("weapons", [])
	var strong_ranged = false
	for w in weapons:
		if w.get("type", "").to_lower() != "ranged":
			continue
		var special = w.get("special_rules", "").to_lower()
		var strength = int(w.get("strength", 0))
		var attacks = int(w.get("attacks", 0))
		# Pistols and weak weapons don't count as strong ranged
		if "pistol" in special:
			continue
		if strength >= 5 and attacks >= 2:
			strong_ranged = true
			break
		if attacks >= 4:
			strong_ranged = true
			break
	if strong_ranged:
		return false
	# MELEE-CLASS: weak guns alone do not make a melee unit — it also needs a
	# real melee weapon. Prosecutors (boltgun S4 A1, close combat weapon S3 A2
	# AP0 D1) were classed melee-focused and sent 20" to "attack" Custodians.
	return _unit_has_real_melee_weapon(unit)

static func _unit_has_real_melee_weapon(unit: Dictionary) -> bool:
	"""A melee profile worth seeking combat for: S5+, AP-1 or better, D2+ (or
	random damage), or 3+ attacks per model."""
	for w in unit.get("meta", {}).get("weapons", []):
		if w.get("type", "").to_lower() != "melee":
			continue
		var dmg = str(w.get("damage", "1")).to_upper()
		if int(w.get("strength", 0)) >= 5 or int(str(w.get("ap", "0"))) <= -1 \
				or "D" in dmg or int(dmg) >= 2 or int(str(w.get("attacks", "0"))) >= 3:
			return true
	return false

# SOAK-5: single source of truth for "should this unit leave its objective
# assignment to seek melee?" — used by the hold-decision, melee-aggression and
# objective-hold blocks in _select_movement_action, which previously each had
# their own copy of the gate.
#
# Only melee-FOCUSED units seek. The old faction-aggression extension
# (aggression >= 1.5 turned every melee-CAPABLE unit into a seeker unless it
# was a ranged VEHICLE) is deliberately gone: in the 2026-07-10 benchmark it
# marched shooty units (Lootas, Kaptin Badrukk, the Battlewagon) across the
# board while objectives sat unclaimed — see
# tests/bench_baselines/2026-07-10_ork_discipline_ab.md. Note the classifier
# invariant: a unit with melee weapons that is NOT melee-focused necessarily
# has strong ranged weapons (_is_melee_focused_unit returns `not
# strong_ranged`), so any aggression-based widening of this gate re-captures
# exactly the units the benchmark showed should stay on mission. Faction
# aggression still shapes HOW aggressively seekers behave (hold-leave limits,
# stay bonuses, R1 setup moves) — just not WHO seeks.
static func _is_melee_seeker(unit: Dictionary) -> bool:
	return _is_melee_focused_unit(unit)

## COORD-4: The single melee chase gate — decides at PLAN TIME whether a unit
## abandons its objective assignment to seek an enemy, so the battle plan can
## announce "ATTACK <enemy>" truthfully instead of the unit silently deviating
## at execution. Consolidates the three previous inline copies (hold-assigned
## skip, main seek block, on-objective skip) into one place with the SAME
## thresholds. Returns {} for "follow the assignment", or:
##   {target_id, target_name, distance_inches, advance: bool, reason}
static func _melee_chase_gate(unit: Dictionary, unit_id: String, assignment: Dictionary,
		enemies: Dictionary, friendly_units: Dictionary, snapshot: Dictionary, player: int) -> Dictionary:
	if not _is_melee_seeker(unit) or enemies.is_empty():
		return {}
	var nearest = _get_nearest_enemy_for_charge(unit, enemies)
	if nearest.is_empty():
		return {}

	var unit_name = _dn(unit, unit_id)
	var enemy_dist: float = nearest.distance_inches
	var enemy_name: String = _dn(nearest.enemy_unit, "enemy")
	var move_inches = float(unit.get("meta", {}).get("stats", {}).get("move", 6))
	var faction_aggression = _get_faction_aggression(snapshot, player)
	var battle_round = snapshot.get("meta", {}).get("battle_round", snapshot.get("battle_round", 1))
	var alive_count = _get_alive_models(unit).size()
	var is_horde_unit = alive_count >= 10
	var charge_range_inches = 12.0
	var assignment_action = str(assignment.get("action", "move"))
	var assigned_obj_id = assignment.get("objective_id", "")
	var assigned_obj_pos = assignment.get("objective_pos", Vector2.INF)

	# --- Hold-assigned units: only leave the objective for NEARBY enemies ---
	# (port of the former skip_hold_for_melee block — same limits)
	if assignment_action == "hold":
		var hold_dist_limit: float
		if battle_round <= 1:
			if is_horde_unit:
				hold_dist_limit = 12.0
			else:
				hold_dist_limit = 18.0 if faction_aggression >= 1.5 else 14.0
		elif battle_round <= 2:
			if is_horde_unit:
				hold_dist_limit = 10.0
			else:
				hold_dist_limit = 14.0 if faction_aggression >= 1.5 else 12.0
		else:
			hold_dist_limit = 12.0 if faction_aggression >= 1.5 else 10.0
		if enemy_dist > hold_dist_limit:
			print("AIDecisionMaker: [HOLD-PRIORITY] %s staying on objective — enemy %s is %.1f\" away (limit=%.0f\", round=%d)" % [
				unit_name, enemy_name, enemy_dist, hold_dist_limit, battle_round])
			return {}
		print("AIDecisionMaker: [MELEE-AGGRESSION] %s considering leaving hold to seek %s (%.1f\" away, limit=%.0f\", round=%d)" % [
			unit_name, enemy_name, enemy_dist, hold_dist_limit, battle_round])

	# --- Objective context: is the unit standing on its assigned objective? ---
	var centroid = _get_unit_centroid(unit)
	var unit_is_on_objective = false
	var unit_objective_is_contested = false
	if centroid != Vector2.INF and assigned_obj_pos != Vector2.INF:
		unit_is_on_objective = centroid.distance_to(assigned_obj_pos) <= OBJECTIVE_CONTROL_RANGE_PX
		if unit_is_on_objective:
			for e_uid in enemies:
				var e_centroid = _get_unit_centroid(enemies[e_uid])
				if e_centroid != Vector2.INF and e_centroid.distance_to(assigned_obj_pos) <= OBJECTIVE_CONTROL_RANGE_PX:
					unit_objective_is_contested = true
					break
	# OBJ-AREA-HOLD (FIX_OBJ_AREA_HOLD): on / contested = a model (ours / an
	# enemy's) within the objective's range — the hosting area on an 11e
	# terrain objective (OC-03's _unit_on_objective), not the centroids.
	if get_param("FIX_OBJ_AREA_HOLD", FIX_OBJ_AREA_HOLD) >= 0.5 and assigned_obj_pos is Vector2 \
			and assigned_obj_pos != Vector2.INF:
		var oah_on_obj := _unit_on_objective(unit, assigned_obj_pos, snapshot)
		var oah_contested := false
		if oah_on_obj:
			for e_uid in enemies:
				if _unit_on_objective(enemies[e_uid], assigned_obj_pos, snapshot):
					oah_contested = true
					break
		if oah_on_obj != unit_is_on_objective:
			print("AIDecisionMaker: [FIX_OBJ_AREA_HOLD] %s chase_gate_on_objective %s old=%s new=%s" % [
				unit_name, assigned_obj_id, str(unit_is_on_objective), str(oah_on_obj)])
		if (oah_on_obj and oah_contested) != (unit_is_on_objective and unit_objective_is_contested):
			print("AIDecisionMaker: [FIX_OBJ_AREA_HOLD] %s chase_gate_contested %s old=%s new=%s" % [
				unit_name, assigned_obj_id, str(unit_is_on_objective and unit_objective_is_contested), str(oah_on_obj and oah_contested)])
		unit_is_on_objective = oah_on_obj
		unit_objective_is_contested = oah_contested

	# --- Main seek gates (port of the former inline block — same order) ---
	# SOAK-5 chase cap: never chase beyond the tunable threshold (floored at
	# this unit's own move+advance+charge reach).
	var chase_cap_inches = maxf(
		get_param("MELEE_AGGRESSION_ADVANCE_THRESHOLD_INCHES", MELEE_AGGRESSION_ADVANCE_THRESHOLD_INCHES),
		move_inches + 14.0)
	if enemy_dist > chase_cap_inches:
		print("AIDecisionMaker: [CHASE-CAP] %s ignores %s (%.1f\" away > %.0f\" cap) — following its assignment to %s" % [
			unit_name, enemy_name, enemy_dist, chase_cap_inches, assigned_obj_id])
		return {}
	if not unit_is_on_objective and is_horde_unit and battle_round <= 2 and enemy_dist > charge_range_inches:
		if faction_aggression >= 1.5:
			print("AIDecisionMaker: [HORDE-AGGRESSION] %s (horde %d models) advances toward %s (%.1f\" away, aggression=%.1f, round %d)" % [
				unit_name, alive_count, enemy_name, enemy_dist, faction_aggression, battle_round])
		else:
			print("AIDecisionMaker: [OBJ-PRIORITY] %s (horde %d models) prioritizes objective %s over chasing %s (%.1f\" > %.1f\" charge range, round %d)" % [
				unit_name, alive_count, assigned_obj_id, enemy_name, enemy_dist, charge_range_inches, battle_round])
			return {}
	if unit_is_on_objective and unit_objective_is_contested and battle_round >= 2:
		print("AIDecisionMaker: [OBJ-PRIORITY] %s stays on contested objective %s (round %d) instead of chasing %s (%.1f\" away)" % [
			unit_name, assigned_obj_id, battle_round, enemy_name, enemy_dist])
		return {}
	if unit_is_on_objective and battle_round >= 3 and enemy_dist > 14.0:
		print("AIDecisionMaker: [OBJ-PRIORITY] %s holds objective %s late game (round %d) — enemy %s too far (%.1f\")" % [
			unit_name, assigned_obj_id, battle_round, enemy_name, enemy_dist])
		return {}
	if assignment_action == "hold" and enemy_dist > charge_range_inches + move_inches:
		if battle_round <= 1 and faction_aggression >= 1.5 and enemy_dist <= charge_range_inches + move_inches + 6.0:
			print("AIDecisionMaker: [R1-AGGRESSION] %s leaves hold to advance toward %s (%.1f\" away, R1 setup charge, aggression=%.1f)" % [
				unit_name, enemy_name, enemy_dist, faction_aggression])
		else:
			print("AIDecisionMaker: [OBJ-PRIORITY] %s holds as assigned — enemy %s beyond move+charge (%.1f\" > %.1f\")" % [
				unit_name, enemy_name, enemy_dist, charge_range_inches + move_inches])
			return {}

	# --- Advance vs normal move (port of the former advance decision) ---
	var can_advance_and_charge_flag = unit.get("flags", {}).get("effect_advance_and_charge", false)
	if not can_advance_and_charge_flag:
		can_advance_and_charge_flag = AIAbilityAnalyzerData.unit_has_ability_containing(unit, "advance") and AIAbilityAnalyzerData.unit_has_ability_containing(unit, "charge")
	var dist_after_normal_move = enemy_dist - move_inches
	var in_charge_range_after_normal = dist_after_normal_move <= charge_range_inches
	# WAAAGH-ADV-CHARGE: trust the rules engine, not ability text, for "may
	# charge after Advancing this turn" (a dormant Waaagh! does not allow it).
	if can_advance_and_charge_flag and get_param("FIX_WAAAGH_ADVANCE_CHARGE", FIX_WAAAGH_ADVANCE_CHARGE) >= 0.5:
		var engine_adv_charge: bool = EffectPrimitivesData.has_effect_advance_and_charge(unit)
		var fac = snapshot.get("factions", {}).get(str(player), "")
		var owner_tag: String = "P%d %s" % [player, str(fac.get("name", "")) if fac is Dictionary else str(fac)]
		# WAAAGH-ADV-CHARGE: a rile granted at selection (Keep Huntin'! etc.)
		# makes the Advance legal even though no effect is set yet.
		var rile_slug: String = "" if engine_adv_charge else _rile_pending_on_selection(unit_id, player)
		if rile_slug != "":
			if in_charge_range_after_normal:
				print("AIDecisionMaker: [WAAAGH_ADVANCE_CHARGE] %s (%s) keeps the Advance - %s will rile it when it is selected to move" % [
					unit_name, owner_tag, _ork_abilities().display(rile_slug)])
		elif not engine_adv_charge:
			can_advance_and_charge_flag = false
			if in_charge_range_after_normal:
				print("AIDecisionMaker: [WAAAGH_ADVANCE_CHARGE] %s (%s) Normal-moves toward %s (%.1f\" away, %.1f\" after move) — no active advance-and-charge effect, an Advance would forfeit the charge" % [
					unit_name, owner_tag, enemy_name, enemy_dist, maxf(dist_after_normal_move, 0.0)])
	var should_advance = false
	if can_advance_and_charge_flag:
		should_advance = true
	elif not in_charge_range_after_normal:
		should_advance = true

	var reason: String
	if in_charge_range_after_normal:
		reason = "closing to charge range (%.1f\" after move)" % maxf(dist_after_normal_move, 0.0)
	else:
		reason = "closing the distance (%.1f\" away)" % enemy_dist
	return {
		"target_id": nearest.enemy_id,
		"target_name": enemy_name,
		"distance_inches": enemy_dist,
		"advance": should_advance,
		"reason": reason,
	}

# WAAAGH-ADV-CHARGE: the slug of a once-per-battle-round rile ability the
# unit's Attached unit holds and has not used this round ("" when none). The
# ability is offered when the unit is selected to move and rile_up_diffs sets
# effect_advance_and_charge, so an Advance then keeps the charge (11e only).
static func _rile_pending_on_selection(unit_id: String, player: int) -> String:
	if GameConstants.edition < 11:
		return ""
	var oa = _ork_abilities()
	for pair in [["keep_huntin", "BEAST SNAGGA"], ["intimidating_motivation", "ORKS"], ["get_back_in_da_race", "SPEED FREEKS"]]:
		if oa.group_holder(unit_id, pair[0]) != "" and oa.group_has_keyword(unit_id, pair[1]) and not oa.army_used_this_round(player, pair[0]):
			return str(pair[0])
	return ""

static func _get_nearest_enemy_for_charge(unit: Dictionary, enemies: Dictionary) -> Dictionary:
	"""Find the nearest enemy unit and return {enemy_id, enemy_unit, distance_inches, centroid}.
	Factors in terrain penalties to prefer enemies reachable without climbing through terrain."""
	var centroid = _get_unit_centroid(unit)
	if centroid == Vector2.INF:
		return {}
	var unit_keywords = unit.get("meta", {}).get("keywords", [])
	var has_fly = "FLY" in unit_keywords
	var best_effective_dist = INF
	var best_id = ""
	var best_unit = {}
	var best_centroid = Vector2.INF
	var best_raw_dist = INF
	for eid in enemies:
		var enemy = enemies[eid]
		var ec = _get_unit_centroid(enemy)
		if ec == Vector2.INF:
			continue
		var raw_dist_px = centroid.distance_to(ec)
		var raw_dist_inches = raw_dist_px / PIXELS_PER_INCH
		# Add terrain penalty to effective distance so we prefer unobstructed charge paths
		var terrain_penalty = _estimate_charge_terrain_penalty(centroid, ec, has_fly, unit_keywords)
		var effective_dist_inches = raw_dist_inches + terrain_penalty
		if effective_dist_inches < best_effective_dist:
			best_effective_dist = effective_dist_inches
			best_raw_dist = raw_dist_px
			best_id = eid
			best_unit = enemy
			best_centroid = ec
	if best_id == "":
		return {}
	return {
		"enemy_id": best_id,
		"enemy_unit": best_unit,
		"distance_inches": best_raw_dist / PIXELS_PER_INCH,
		"effective_distance_inches": best_effective_dist,
		"centroid": best_centroid
	}

static func _find_flank_around_terrain(from_pos: Vector2, target_pos: Vector2, unit: Dictionary, enemies: Dictionary) -> Vector2:
	# When terrain blocks a direct charge path, find a waypoint that goes around it.
	# Tests positions at various angles from the direct path and picks the one with
	# the lowest terrain penalty while still making progress toward the target.
	var unit_keywords = unit.get("meta", {}).get("keywords", [])
	var has_fly = "FLY" in unit_keywords
	var direct_penalty = _estimate_charge_terrain_penalty(from_pos, target_pos, has_fly, unit_keywords)
	if direct_penalty <= 0.0:
		return Vector2.INF  # No terrain in the way

	var direction = (target_pos - from_pos).normalized()
	var dist_to_target = from_pos.distance_to(target_pos)

	# Try waypoints at different angles but at a moderate distance (half way to target)
	# The unit will move toward this waypoint, then next turn continue to the enemy
	var waypoint_dist = dist_to_target * 0.6  # Aim for 60% of the way
	var best_waypoint = Vector2.INF
	var best_penalty = direct_penalty
	var angles = [30, -30, 45, -45, 60, -60, 75, -75, 90, -90]

	for angle_deg in angles:
		var rotated = direction.rotated(deg_to_rad(angle_deg))
		var waypoint = from_pos + rotated * waypoint_dist
		# Check that the waypoint is within the board (simple bounds check)
		if waypoint.x < 0 or waypoint.y < 0 or waypoint.x > 1760 or waypoint.y > 2400:
			continue
		# Check terrain penalty from waypoint to target
		var wp_to_target_penalty = _estimate_charge_terrain_penalty(waypoint, target_pos, has_fly, unit_keywords)
		# Also check penalty from us to waypoint
		var us_to_wp_penalty = _estimate_charge_terrain_penalty(from_pos, waypoint, has_fly, unit_keywords)
		# Total penalty for this route should be less than going direct
		var total_penalty = us_to_wp_penalty + wp_to_target_penalty
		if total_penalty < best_penalty:
			best_penalty = total_penalty
			best_waypoint = waypoint

	if best_waypoint != Vector2.INF:
		print("AIDecisionMaker: [FLANK] Found flanking waypoint reducing terrain penalty from %.1f\" to %.1f\"" % [
			direct_penalty, best_penalty])
	return best_waypoint

# =============================================================================
# MAIN ENTRY POINT
# =============================================================================

static var _current_player: int = 0  # Active AI player for profile lookups

# T7-40: Current difficulty level for the active AI player
# Set by AIPlayer before each decide() call, used by sub-methods
static var _current_difficulty: int = AIDifficultyConfigData.Difficulty.COMPETITIVE

static func _get_vp_diff(snapshot: Dictionary, player: int) -> int:
	"""Get VP differential (positive = ahead, negative = behind).

	Real victory points live in state.players[<player>].vp, written by
	MissionManager. This previously read meta.player1_vp / meta.player2_vp,
	which a repo-wide search shows are written by exactly ONE test
	(tests/test_ai_movement_coordination.gd) and by nothing in a real game.
	So vp_diff was always 0 in play, which silently disabled all five vp_*
	profile rule conditions: vp_ahead and vp_diff_gte could never fire, and
	vp_behind and vp_diff_lte fired ALWAYS. The legacy keys are still read
	as a fallback so existing tests keep working."""
	var players = snapshot.get("players", {})
	var p1_vp = 0
	var p2_vp = 0
	if players is Dictionary and (players.has("1") or players.has("2")):
		p1_vp = int((players.get("1", {}) as Dictionary).get("vp", 0))
		p2_vp = int((players.get("2", {}) as Dictionary).get("vp", 0))
	else:
		var meta = snapshot.get("meta", {})
		p1_vp = int(meta.get("player1_vp", 0))
		p2_vp = int(meta.get("player2_vp", 0))
	if player == 1:
		return p1_vp - p2_vp
	return p2_vp - p1_vp

static func _get_units_remaining_pct(snapshot: Dictionary, player: int) -> float:
	"""Get percentage of units remaining for a player."""
	var units = snapshot.get("units", {})
	var total = 0
	var alive = 0
	for uid in units:
		var u = units[uid]
		if u.get("player", 0) == player:
			total += 1
			if u.get("alive", true) and not u.get("destroyed", false):
				alive += 1
	if total == 0:
		return 100.0
	return (float(alive) / float(total)) * 100.0

# Late-bound reference to FactionAbilityManager autoload (a preload would drag
# its naked-autoload references into --script test mode where they can't compile)
static func _faction_ability_manager():
	var main = Engine.get_main_loop()
	if main is SceneTree and main.root:
		return main.root.get_node_or_null("FactionAbilityManager")
	return null

# Late-bound wrappers for the FactionAbilityManager Waaagh! helpers. A bare
# `FactionAbilityManager.x()` reference makes this script fail to compile under
# `godot -s` (autoload names are not registered yet), which silently turned
# every test that preloads AIDecisionMaker into a 0-check run (R5 / RV-6).
static func _waaagh_melee_bonus_applies(unit: Dictionary) -> bool:
	var fam = _faction_ability_manager()
	if fam != null:
		return bool(fam.waaagh_melee_bonus_applies(unit))
	# Same predicate as FactionAbilityManager.waaagh_melee_bonus_applies (10e only).
	return GameConstants.edition < 11 and bool(unit.get("flags", {}).get("waaagh_active", false))

static func _waaagh_effects_summary() -> String:
	var fam = _faction_ability_manager()
	if fam != null:
		return str(fam.waaagh_effects_summary())
	if GameConstants.edition >= 11:
		return "riled up: 5+ invuln, ranged [ASSAULT], advance and charge"
	return "advance and charge, +1 S/A melee, 5+ invuln"

static func decide(phase: int, snapshot: Dictionary, available_actions: Array, player: int, difficulty: int = AIDifficultyConfigData.Difficulty.NORMAL) -> Dictionary:
	_current_difficulty = difficulty
	_current_player = player
	# Evaluate profile rules if player has a profile
	if _player_profiles.has(player):
		# Real enum values — a stale literal map here previously fired
		# profile rules in the WRONG phase (e.g. "MOVEMENT" rules during SCOUT)
		var phase_names = {
			GameStateData.Phase.FORMATIONS: "FORMATIONS",
			GameStateData.Phase.DEPLOYMENT: "DEPLOYMENT",
			GameStateData.Phase.SCOUT: "SCOUT",
			GameStateData.Phase.COMMAND: "COMMAND",
			GameStateData.Phase.MOVEMENT: "MOVEMENT",
			GameStateData.Phase.SHOOTING: "SHOOTING",
			GameStateData.Phase.CHARGE: "CHARGE",
			GameStateData.Phase.FIGHT: "FIGHT",
			GameStateData.Phase.SCORING: "SCORING",
		}
		var phase_name = phase_names.get(phase, "UNKNOWN")
		var current_round = snapshot.get("meta", {}).get("battle_round", snapshot.get("battle_round", 1))
		var rule_context = {
			"phase": phase_name,
			"round": current_round,
			"vp_diff": _get_vp_diff(snapshot, player),
			"units_remaining_pct": _get_units_remaining_pct(snapshot, player),
			"on_objective": false,
			"nearest_enemy_inches": 999.0,
			"is_melee_unit": false,
			"is_vehicle": false,
			"unit_points": 0,
		}
		# Populate unit-level context from the active unit in available_actions
		var active_uid = ""
		for a in available_actions:
			var uid = a.get("actor_unit_id", a.get("unit_id", ""))
			if uid != "":
				active_uid = uid
				break
		if active_uid != "":
			var active_unit = snapshot.get("units", {}).get(active_uid, {})
			if not active_unit.is_empty():
				# is_melee_unit
				rule_context["is_melee_unit"] = _is_melee_focused_unit(active_unit)
				# is_vehicle
				var kws = active_unit.get("meta", {}).get("keywords", [])
				rule_context["is_vehicle"] = "VEHICLE" in kws
				# unit_points
				rule_context["unit_points"] = int(active_unit.get("meta", {}).get("points", 0))
				# on_objective — check if unit centroid is within objective control range
				var centroid = _get_unit_centroid(active_unit)
				if centroid != Vector2.INF:
					var objectives = _get_objectives(snapshot)
					for obj_pos in objectives:
						if centroid.distance_to(obj_pos) <= OBJECTIVE_CONTROL_RANGE_PX:
							rule_context["on_objective"] = true
							break
				# nearest_enemy_inches
				var enemy_player = 2 if player == 1 else 1
				var enemies = _get_units_for_player(snapshot, enemy_player)
				var nearest_info = _get_nearest_enemy_for_charge(active_unit, enemies)
				if not nearest_info.is_empty():
					rule_context["nearest_enemy_inches"] = nearest_info.get("distance_inches", 999.0)
		evaluate_rules(player, rule_context)
	_thinking_steps.clear()  # Reset thinking log for this decision
	_decision_records.clear()  # Reset decision records for this decision
	_param_reads.clear()  # A3: parameter reads are attributed per decision
	_thinking_context = {}  # Reset board-link context for this decision
	var diff_name = AIDifficultyConfigData.difficulty_name(difficulty)
	# T7-43: Log round strategy mode
	var current_round = snapshot.get("meta", {}).get("battle_round", snapshot.get("battle_round", 1))
	var strategy = _get_round_strategy_modifiers(current_round)
	# T7-41: Detect army archetype (cached after first detection)
	var army_strategy = _get_army_strategy_modifiers(snapshot, player)
	print("AIDecisionMaker: Deciding for phase %d, player %d, %d available actions (difficulty: %s, round=%d, strategy=%s, archetype=%s)" % [
		phase, player, available_actions.size(), diff_name, current_round, strategy.label, army_strategy.label])
	for a in available_actions:
		print("  Available: %s" % a.get("type", "?"))

	# T7-40: Easy difficulty — pick random valid actions instead of scoring
	if AIDifficultyConfigData.use_random_actions(difficulty):
		return _decide_random(phase, snapshot, available_actions, player)

	# Reset focus fire plan cache and grenade flag when not in shooting phase
	if phase != GameStateData.Phase.SHOOTING:
		if _focus_fire_plan_built:
			_focus_fire_plan_built = false
			_focus_fire_plan.clear()
		_grenade_evaluated = false
		_focus_fire_plan_logged = false

	# T7-46: Reset fight order plan when not in fight phase
	if phase != GameStateData.Phase.FIGHT:
		if not _fight_order_plan_built.is_empty():
			_fight_order_plan_built.clear()
			_fight_order_plan.clear()
		_fight_order_logged = false
		_fight_attack_retry_count.clear()

	# Reset charge coordination when entering a new round's charge phase
	if phase == GameStateData.Phase.CHARGE:
		if _charge_coordination_round != current_round:
			_charge_coordination.clear()
			_charge_coordination_round = current_round
	elif phase != GameStateData.Phase.CHARGE:
		# Clear when we leave the charge phase entirely
		if not _charge_coordination.is_empty():
			_charge_coordination.clear()

	# Reset movement plan log flag when not in movement phase
	if phase != GameStateData.Phase.MOVEMENT:
		_movement_plan_logged = false
		# COORD-4: the battle plan is a per-movement-phase commitment — clear it
		# once the phase is over so the next movement phase re-plans fresh.
		if not _turn_movement_plan.is_empty():
			_turn_movement_plan.clear()

	# T7-23: Reset multi-phase plan when a new round starts or when we enter
	# a phase earlier than movement (i.e., command phase or earlier)
	# Note: current_round already declared above (T7-43) with meta fallback
	if _phase_plan_round != current_round:
		_phase_plan.clear()
		_phase_plan_built.clear()
		_phase_plan_round = current_round
		# COORD-2: movement intents describe THIS round's moves — clear with the plan
		_movement_intents.clear()
		_movement_recorded_units.clear()
		_turn_movement_plan.clear()

	# T7-25: Reset secondary awareness when a new round starts (per-player)
	if player == 1:
		if _secondary_awareness_round_p1 != current_round:
			_secondary_awareness_p1.clear()
			_secondary_awareness_round_p1 = current_round
		if _primary_awareness_round_p1 != current_round:
			_primary_awareness_p1.clear()
	else:
		if _secondary_awareness_round_p2 != current_round:
			_secondary_awareness_p2.clear()
			_secondary_awareness_round_p2 = current_round
		if _primary_awareness_round_p2 != current_round:
			_primary_awareness_p2.clear()

	# T7-40: Normal and below skip multi-phase planning
	if not AIDifficultyConfigData.use_multi_phase_planning(difficulty):
		_phase_plan_built[player] = true  # Prevent building phase plans for this player

	var result: Dictionary = {}
	match phase:
		GameStateData.Phase.FORMATIONS:
			result = _decide_formations(snapshot, available_actions, player)
		GameStateData.Phase.DEPLOYMENT:
			result = _decide_deployment(snapshot, available_actions, player)
		GameStateData.Phase.REDEPLOYMENT:
			result = _decide_redeployment(snapshot, available_actions, player)
		GameStateData.Phase.SCOUT:
			result = _decide_scout(snapshot, available_actions, player)
		GameStateData.Phase.ROLL_OFF:
			result = _decide_roll_off(snapshot, available_actions, player)
		GameStateData.Phase.FIRST_TURN_ROLLOFF:
			result = _decide_first_turn_roll_off(snapshot, available_actions, player)
		GameStateData.Phase.COMMAND:
			result = _decide_command(snapshot, available_actions, player)
		GameStateData.Phase.MOVEMENT:
			result = _decide_movement(snapshot, available_actions, player)
		GameStateData.Phase.SHOOTING:
			result = _decide_shooting(snapshot, available_actions, player)
		GameStateData.Phase.CHARGE:
			result = _decide_charge(snapshot, available_actions, player)
		GameStateData.Phase.FIGHT:
			result = _decide_fight(snapshot, available_actions, player)
		GameStateData.Phase.SCORING:
			result = _decide_scoring(snapshot, available_actions, player)
		_:
			# Unknown phase - try to find an END action
			for action in available_actions:
				var t = action.get("type", "")
				if t.begins_with("END_"):
					result = {"type": t, "_ai_description": "End phase (fallback)"}
					break

	# Attach accumulated thinking steps and decision records to the decision
	if not _thinking_steps.is_empty() and not result.is_empty():
		result["_ai_thinking_steps"] = _thinking_steps.duplicate()
	if not _decision_records.is_empty() and not result.is_empty():
		result["_ai_decision_records"] = _decision_records.duplicate(true)
	if not _thinking_context.is_empty() and not result.is_empty():
		result["_ai_thinking_context"] = _thinking_context.duplicate(true)
		_thinking_context = {}
	# Clear the step buffer NOW that it has been handed off. Reactive handlers
	# (command reroll, overwatch, …) flush take_thinking_steps() between
	# decide() calls — without this clear they swallowed the PREVIOUS
	# decision's steps into their own game-log block (e.g. a "Command Re-roll
	# window" card containing the whole movement plan).
	_thinking_steps.clear()
	return result

# =============================================================================
# ON-DEMAND SUGGESTION — human-facing "what would you do?" preview
# =============================================================================

# Preview the decision the AI would make for `player` in the current situation
# WITHOUT mutating the persistent planning caches the live AI opponent relies on.
# decide() writes several static caches (multi-phase plan, focus-fire plan,
# charge/fight coordination, secondary/primary awareness, bodyguard pairing,
# current player & difficulty). Those are round-keyed, so a human asking for a
# hint on their own turn — the same battle round as the AI's upcoming turn —
# could otherwise leave a stale plan behind that the AI then reuses. We snapshot
# the caches, run the decision, and restore them, so a suggestion is truly
# side-effect-free. Returns the same dict decide() returns, including the
# _ai_thinking_steps / _ai_decision_records / _ai_thinking_context reasoning.
static func suggest_action(phase: int, snapshot: Dictionary, available_actions: Array, player: int, difficulty: int = AIDifficultyConfigData.Difficulty.NORMAL, focus_unit_id: String = "") -> Dictionary:
	# focus_unit_id (movement phase): preview what the plan has THAT unit do,
	# rather than the unit the AI would move next.
	var saved := _snapshot_planning_state()
	# Same position → same answer: the preview draws its difficulty noise from
	# a generator seeded by the board (not the live AI's stream, which a seeded
	# game must not see consumed), so re-asking — or cycling the card to
	# another unit — never reshuffles the order by chance.
	# A seeded game (tests, replays) previews from a COPY of the live
	# generator — same seed and position, never advanced — so runs stay
	# reproducible from the seed; unseeded play seeds from the board.
	var live_rng := _rng()
	var live_seeded := _ai_rng_seeded
	_ai_rng = RandomNumberGenerator.new()
	if live_seeded:
		_ai_rng.seed = live_rng.seed
		_ai_rng.state = live_rng.state
	else:
		_ai_rng.seed = hash("%d|%d|%s" % [phase, player, JSON.stringify(snapshot.get("units", {}))])
	print("AIDecisionMaker: suggest_action preview RNG %s (seed %d, state %d)" % [
		"copied from the seeded live AI" if live_seeded else "seeded from the board", _ai_rng.seed, _ai_rng.state])
	_suggest_focus_unit_id = focus_unit_id
	_last_unit_order = {}
	var decision := {}
	if phase == GameStateData.Phase.MOVEMENT:
		decision = _suggest_in_progress_move(snapshot, available_actions, player, difficulty)
	if decision.is_empty():
		decision = decide(phase, snapshot, available_actions, player, difficulty)
	_suggest_focus_unit_id = ""
	_ai_rng = live_rng
	_ai_rng_seeded = live_seeded
	_restore_planning_state(saved)
	# UNIT-ORDER: say which unit acts and why it goes first (K card) — only
	# when the decision really is about one of the ordered units.
	var actor := str(decision.get("actor_unit_id", decision.get("unit_id", "")))
	if not _last_unit_order.is_empty() and actor != "":
		var in_order := false
		for e in _last_unit_order.get("order", []):
			if str(e.get("unit_id", "")) == actor:
				in_order = true
		if in_order:
			var uo: Dictionary = _last_unit_order.duplicate(true)
			uo["acting_unit_id"] = actor
			if focus_unit_id != "" and actor == focus_unit_id:
				uo["focused"] = true
			decision["_ai_unit_order"] = uo
	_last_unit_order = {}
	_attach_rule_based_record(decision, snapshot, available_actions)
	return decision

# Suggestion-only: a move the player began themselves (Begin Move clicked,
# models maybe dragged) leaves only Confirm/Reset for that unit, and decide()
# answers its safety fallback "confirm it" — no unit named, no plan, nothing
# to learn from. Plan THAT unit instead, as if its move were just starting
# (positions are only committed on confirm, so the snapshot still holds where
# it began), and say where the AI would take it.
static func _suggest_in_progress_move(snapshot: Dictionary, available_actions: Array, player: int, difficulty: int) -> Dictionary:
	var uid := ""
	for a in available_actions:
		if str(a.get("type", "")) == "CONFIRM_UNIT_MOVE":
			uid = str(a.get("actor_unit_id", a.get("unit_id", "")))
			break
	if uid == "":
		return {}
	var move: Dictionary = {}
	var pm = Engine.get_main_loop().root.get_node_or_null("/root/PhaseManager") if Engine.get_main_loop() else null
	var phase_inst = pm.current_phase_instance if pm != null else null
	if phase_inst != null and "active_moves" in phase_inst:
		move = phase_inst.active_moves.get(uid, {})
	var mode := str(move.get("mode", "NORMAL"))
	var begin_type: String = {"NORMAL": "BEGIN_NORMAL_MOVE", "ADVANCE": "BEGIN_ADVANCE", "FALL_BACK": "BEGIN_FALL_BACK"}.get(mode, "BEGIN_NORMAL_MOVE")
	var uname := _dn(snapshot.get("units", {}).get(uid, {}), uid)
	var staged := int(move.get("staged_moves", []).size())
	# An advancing unit may still move less than its cap, so a plain-move plan
	# (sized at M, within any Advance cap) is a valid answer for it too.
	var offer_types: Array = [begin_type]
	if begin_type == "BEGIN_ADVANCE":
		offer_types.append("BEGIN_NORMAL_MOVE")
	var offered: Array = []
	for t in offer_types:
		offered.append({"type": t, "actor_unit_id": uid})
	var plan := decide(GameStateData.Phase.MOVEMENT, snapshot, offered, player, difficulty)
	if not (str(plan.get("type", "")) in offer_types) or str(plan.get("actor_unit_id", "")) != uid:
		print("AIDecisionMaker: suggestion for in-progress move of %s found no plan (got %s) — suggesting confirm" % [uid, str(plan.get("type", ""))])
		return {}
	# The planner sizes an Advance at the average roll (M+2"). This one is
	# already rolled — re-plan to the real cap the same way the live AI does
	# after its own roll, so the suggestion never asks for more than was rolled.
	var cap := float(move.get("move_cap_inches", 0.0))
	var roll_note := ""
	if mode == "ADVANCE" and cap > 0.0 and str(plan.get("type", "")) == "BEGIN_ADVANCE":
		var ai = Engine.get_main_loop().root.get_node_or_null("/root/AIPlayer") if Engine.get_main_loop() else null
		var unit: Dictionary = snapshot.get("units", {}).get(uid, {})
		if ai != null and ai.has_method("recompute_destinations_for_cap"):
			var dests: Dictionary = ai.recompute_destinations_for_cap(player, uid, unit, plan, cap)
			if not dests.is_empty():
				plan["_ai_model_destinations"] = dests
				roll_note = " (planned for your Advance roll of %d — %.0f\" total)" % [int(move.get("advance_roll", 0)), cap]
				print("AIDecisionMaker: suggestion re-planned in-progress advance of %s for actual cap %.1f\"" % [uid, cap])
	if mode == "ADVANCE" and roll_note == "":
		roll_note = " (within your Advance roll of %d — %.0f\" total)" % [int(move.get("advance_roll", 0)), cap]
	var desc := str(plan.get("_ai_description", "%s moves" % uname)) + roll_note
	var next_step := "Move its models that way, then Confirm Move." if staged == 0 \
		else "%d model(s) already placed — adjust them (or Reset Unit Move), then Confirm Move." % staged
	plan["_ai_description"] = "%s's move is in progress — AI plan: %s. %s" % [uname, desc, next_step]
	plan["_ai_in_progress_move"] = true
	print("AIDecisionMaker: suggestion for in-progress %s move of %s -> %s" % [mode, uid, desc])
	return plan

# Suggestion-only: decisions taken by a fixed chain of checks (command phase,
# pile-in, disembark…) score nothing, so the card had nothing to show but a
# warning. Record what was picked and the other actions that were available,
# marked "rule_based" so the card explains it and test-case signatures skip
# it. Not added on the live AI path — the game records feeding offline
# analysis keep only real scored decisions.
const _SIDE_RECORD_TYPES := ["proactive_stratagem", "window_rule", "disembark_check"]

static func _attach_rule_based_record(decision: Dictionary, snapshot: Dictionary, available_actions: Array) -> void:
	if decision.is_empty():
		return
	for r in decision.get("_ai_decision_records", []):
		if not (str(r.get("decision_type", "")) in _SIDE_RECORD_TYPES):
			return  # a real scored record exists
	var chosen_key := _action_key(decision)
	var cands: Array = [{"description": str(decision.get("_ai_description", decision.get("type", ""))), "score": 1.0, "key": chosen_key}]
	var seen := {chosen_key: true}
	for a in available_actions:
		var k := _action_key(a)
		if seen.has(k):
			continue
		seen[k] = true
		cands.append({"description": _describe_available_action(a, snapshot), "score": 0.0, "key": k})
	if cands.size() < 2:
		return  # nothing else was possible — the card says so from the meta
	var recs: Array = decision.get("_ai_decision_records", []).duplicate()
	var rec := {"decision_type": "rule_based", "unit_id": "", "unit_name": "",
		"candidates": cands.slice(0, 16), "chosen_index": 0, "parameters_used": {},
		"context": {"options_considered": cands.size()}}
	recs.push_front(rec)
	decision["_ai_decision_records"] = recs

static func _action_key(a: Dictionary) -> String:
	var who := str(a.get("actor_unit_id", a.get("unit_id", a.get("target_unit_id", ""))))
	return "%s|%s|%s" % [str(a.get("type", "")), who, str(a.get("stratagem_id", a.get("mission_index", "")))]

static func _describe_available_action(a: Dictionary, snapshot: Dictionary) -> String:
	var t := str(a.get("type", "")).replace("_", " ").to_lower()
	var sid := str(a.get("stratagem_id", ""))
	if sid != "":
		var sm = _stratagem_manager()
		var sname := str(sm.get_stratagem(sid).get("name", sid)) if sm else sid
		return "Use stratagem %s" % sname
	var uid := str(a.get("actor_unit_id", a.get("unit_id", "")))
	if uid != "":
		return "%s — %s" % [t.capitalize(), _dn(snapshot.get("units", {}).get(uid, {}), uid)]
	return t.capitalize()

static func suggest_pending_window(phase, difficulty: int) -> Dictionary:
	"""K during a pending stratagem window / shooting reactive window: answer
	THAT decision for the player who owes it, with its reasoning attached, as
	a pure preview. Returns {decider, decision} or {} when nothing is pending.
	Mirrors AIPlayer._answer_ai_owned_pending_window."""
	if phase == null:
		return {}
	var decider := 0
	var result := {}
	var saved := _snapshot_planning_state()
	var prev_difficulty := _current_difficulty
	_current_difficulty = difficulty
	_thinking_steps.clear()
	_decision_records.clear()
	_thinking_context = {}
	if phase.has_method("has_pending_stratagem_window") and phase.has_pending_stratagem_window():
		var w: Dictionary = phase.get_pending_stratagem_window()
		decider = int(w.get("player", 0))
		var wid := str(w.get("window_id", ""))
		var d: Dictionary = decide_window_stratagem(decider, wid, w.get("offers", []), w.get("ctx", {}))
		if d.get("use", false):
			if not d.has("name"):
				for o in w.get("offers", []):
					if str(o.get("stratagem_id", "")) == str(d.get("stratagem_id", "")):
						d["name"] = str(o.get("name", ""))
			var tu = _game_state().state.get("units", {}).get(str(d.get("target_unit_id", "")), {}) if _game_state() else {}
			result = {"type": "USE_WINDOW_STRATAGEM", "player": decider, "window_id": wid,
				"stratagem_id": str(d.get("stratagem_id", "")), "target_unit_id": str(d.get("target_unit_id", "")),
				"context": d.get("context", {}),
				"_ai_description": "Use %s on %s (%s window)" % [str(d.get("name", d.get("stratagem_id", ""))),
					_dn(tu, str(d.get("target_unit_id", ""))), wid.replace("_", " ")]}
		else:
			result = {"type": "DECLINE_WINDOW_STRATAGEM", "player": decider, "window_id": wid,
				"_ai_description": "Decline the %s stratagem window" % wid.replace("_", " ")}
	elif "awaiting_reactive_stratagem" in phase and phase.awaiting_reactive_stratagem and phase.has_method("_check_reactive_stratagems"):
		var gs = _game_state()
		var active := int(gs.get_active_player()) if gs else 1
		decider = 2 if active == 1 else 1
		var opp: Dictionary = phase._check_reactive_stratagems()
		result = evaluate_reactive_stratagem(decider, opp.get("available_stratagems", []),
			opp.get("target_unit_ids", []), gs.create_snapshot(false) if gs else {})
	if not result.is_empty():
		if not _thinking_steps.is_empty():
			result["_ai_thinking_steps"] = _thinking_steps.duplicate()
		if not _decision_records.is_empty():
			result["_ai_decision_records"] = _decision_records.duplicate(true)
	_current_difficulty = prev_difficulty
	_restore_planning_state(saved)
	if result.is_empty():
		return {}
	return {"decider": decider, "decision": result}

static func _snapshot_planning_state() -> Dictionary:
	# Deep-copy every static cache decide() may write that outlives a single call
	# and is consulted on later turns. Config/profile state (_config_overrides,
	# _player_profiles) is intentionally left out — decide() never mutates it.
	return {
		"focus_fire_plan": _focus_fire_plan.duplicate(true),
		"focus_fire_plan_built": _focus_fire_plan_built,
		"focus_fire_plan_logged": _focus_fire_plan_logged,
		"grenade_evaluated": _grenade_evaluated,
		"phase_plan": _phase_plan.duplicate(true),
		"phase_plan_built": _phase_plan_built.duplicate(true),
		"phase_plan_round": _phase_plan_round,
		"movement_intents": _movement_intents.duplicate(true),
		"movement_recorded_units": _movement_recorded_units.duplicate(true),
		"last_movement_candidates": _last_movement_candidates.duplicate(true),
		"turn_movement_plan": _turn_movement_plan.duplicate(true),
		"fight_order_plan": _fight_order_plan.duplicate(true),
		"fight_order_plan_built": _fight_order_plan_built.duplicate(true),
		"fight_order_scores": _fight_order_scores.duplicate(true),
		"target_value_terms": _target_value_terms.duplicate(true),
		"fight_order_logged": _fight_order_logged,
		"fight_attack_retry_count": _fight_attack_retry_count.duplicate(true),
		"charge_coordination": _charge_coordination.duplicate(true),
		"charge_coordination_round": _charge_coordination_round,
		"fight_coordination": _fight_coordination.duplicate(true),
		"fight_coordination_round": _fight_coordination_round,
		"bodyguards_with_leaders": _bodyguards_with_leaders.duplicate(true),
		"movement_plan_logged": _movement_plan_logged,
		"secondary_awareness_p1": _secondary_awareness_p1.duplicate(true),
		"secondary_awareness_p2": _secondary_awareness_p2.duplicate(true),
		"secondary_awareness_round_p1": _secondary_awareness_round_p1,
		"secondary_awareness_round_p2": _secondary_awareness_round_p2,
		"primary_awareness_p1": _primary_awareness_p1.duplicate(true),
		"primary_awareness_p2": _primary_awareness_p2.duplicate(true),
		"primary_awareness_round_p1": _primary_awareness_round_p1,
		"primary_awareness_round_p2": _primary_awareness_round_p2,
		"active_rule_overrides": _active_rule_overrides.duplicate(true),
		"current_player": _current_player,
		"current_difficulty": _current_difficulty,
		# PM-2a: _resolve_plan_for() can auto-match and CACHE a plan during a
		# decide(), so the human-hint preview would otherwise install a plan on
		# the live AI as a side effect of showing a suggestion.
		"player_plans": _player_plans.duplicate(true),
		"plan_auto_match_attempted": _plan_auto_match_attempted.duplicate(true),
		"plan_logged_once": _plan_logged_once.duplicate(true),
		"plan_released_earmarks": _plan_released_earmarks.duplicate(true),
	}

